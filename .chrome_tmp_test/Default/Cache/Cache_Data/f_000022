  if (currentBiome().key === 'forest' && (raw.a === 'nature' || raw.b === 'nature')) dmgMul *= 1.22;
  if (playerSig && playerSig.id === 'boltPlus' && raw.kind === 'boltall') dmgMul *= 1.4;
  const combo = Object.assign({}, raw, {
    dmg: Math.round(raw.dmg * dmgMul),
