// =========================================================================
// DECAL SYSTEM (Non-colliding environmental impact marks with fading opacity)
// =========================================================================
const decals = [];

function spawnDecal(x, y, type, radius, durationSec) {
  decals.push({
    x, y,
    type: type || 'scorch',
    radius: radius || 36,
    maxLife: durationSec || 7.0,
    life: durationSec || 7.0,
    rot: Math.random() * Math.PI * 2
  });
}

function updateDecals(dt) {
  for (let i = decals.length - 1; i >= 0; i--) {
    decals[i].life -= dt;
    if (decals[i].life <= 0) {
      decals.splice(i, 1);
    }
  }
}

function drawDecals(ctx) {
  if (!decals || decals.length === 0) return;
  ctx.save();
  for (let i = 0; i < decals.length; i++) {
    const d = decals[i];
    const dr = (d.radius || 30) + 10;
    if (d.x < cam.x - dr || d.x > cam.x + W + dr || d.y < cam.y - dr || d.y > cam.y + H + dr) continue;
    const alpha = Math.min(0.20, (d.life / (d.maxLife || 180)) * 0.20);
    if (alpha <= 0.01) continue;
    ctx.save();
    ctx.translate(d.x, d.y);
    ctx.globalAlpha = alpha;
    ctx.fillStyle = d.type === 'frost' ? 'rgba(56, 189, 248, 0.25)' : 'rgba(0, 0, 0, 0.32)';
    ctx.beginPath();
    ctx.arc(0, 0, (d.radius || 20) * 0.65, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();
  }

  // Item 1: Dinamik Çevre Etkileşimi (Ezilen otlar, çatlayan buz ayak izleri, duman)
  if (window.footprints && window.footprints.length) {
    for (let f = window.footprints.length - 1; f >= 0; f--) {
      const fp = window.footprints[f];
      fp.life -= 0.007; // ~2.4s yumuşak solma
      if (fp.life <= 0) { window.footprints.splice(f, 1); continue; }
      if (fp.x < cam.x - 20 || fp.x > cam.x + W + 20 || fp.y < cam.y - 20 || fp.y > cam.y + H + 20) continue;
      ctx.save();
      ctx.translate(Math.round(fp.x), Math.round(fp.y));
      ctx.globalAlpha = fp.life * 0.40;
      if (fp.bk === 'forest') {
        ctx.fillStyle = '#14532d';
        ctx.fillRect(-2, -1, 4, 2);
        ctx.fillRect(-1, -3, 2, 2);
      } else if (fp.bk === 'ice') {
        ctx.strokeStyle = '#bae6fd';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(-3, -2); ctx.lineTo(3, 2);
        ctx.moveTo(1, -2); ctx.lineTo(-2, 2);
        ctx.stroke();
      } else if (fp.bk === 'lava' || fp.bk === 'volcano') {
        ctx.fillStyle = '#ea580c';
        ctx.fillRect(-1, -1, 3, 3);
      } else if (fp.bk === 'sand') {
        ctx.fillStyle = '#78350f';
        ctx.beginPath();
        ctx.ellipse(0, 0, 3.5, 2, fp.rot || 0, 0, Math.PI * 2);
        ctx.fill();
      } else {
        ctx.fillStyle = '#334155';
        ctx.fillRect(-1.5, -1, 3, 2);
      }
      ctx.restore();
    }
  }
  ctx.restore();
}

function drawBossTelegraphs(ctx, time) {
  if (!bossTelegraphs || bossTelegraphs.length === 0) return;
  bossTelegraphs.forEach(bt => {
    const btr = Math.max(bt.r || 60, bt.length || 60, bt.w || 60);
    if (bt.x < cam.x - btr || bt.x > cam.x + W + btr || bt.y < cam.y - btr || bt.y > cam.y + H + btr) return;
    const progress = Math.min(1, (bt.t || 0) / (bt.duration || 1));
    ctx.save();

    if (bt.kind === 'circle' || bt.kind === 'blood_trap') {
      // =========================================================================
      // 1. RÜNİK UYARI ÇEMBERLERİ (ATEŞ, DOĞA, BUZ, FIRTINA, SU, KAN VADİSİ)
      // =========================================================================
      const isFire = bt.color === '#ff3d00' || bt.color === '#ff1744' || bt.color === '#d32f2f';
      const isNature = bt.color === '#2e7d32' || bt.color === '#76ff03' || bt.color === '#00e676';
      const isIce = bt.color === '#00e5ff' || bt.color === '#4fc3f7' || bt.color === '#9be7ff' || bt.color === '#0288d1';
      const isStorm = bt.color === '#fbc02d' || bt.color === '#ffd54f' || bt.color === '#ffd600';
      const isWater = bt.color === '#1e88e5' || bt.color === '#26c6da' || bt.color === '#0288d1';
      const isBlood = bt.color === '#b71c1c' || bt.color === '#880e4f' || bt.kind === 'blood_trap';

      const mainCol = isBlood ? '#b71c1c' : isIce ? '#00e5ff' : isStorm ? '#ffd600' : isWater ? '#00b0ff' : (bt.color || '#ff1744');
      const runeCol = isFire ? '#ffd54f' : isNature ? '#b9f6ca' : isIce ? '#e0f7fa' : isStorm ? '#fff9c4' : isWater ? '#e0f7fa' : isBlood ? '#ff8a80' : '#ffffff';
      const glowCol = isFire ? '#ff9100' : isNature ? '#69f0ae' : isIce ? '#00e5ff' : isStorm ? '#ffd600' : isWater ? '#00e5ff' : isBlood ? '#ff1744' : mainCol;

      // A. Dış Diller / Dişler / Yarasa Kanatları / Kar Kristalleri
      const tongueCount = isIce ? 16 : isStorm ? 18 : isBlood ? 12 : 20;
      const rot = time * (isBlood ? -0.02 : 0.02);
      ctx.fillStyle = mainCol;
      ctx.globalAlpha = 0.55 + Math.sin(time * 0.3) * 0.15;

      for (let i = 0; i < tongueCount; i++) {
        const tAng = rot + (i / tongueCount) * Math.PI * 2;
        const wave = Math.sin(time * 0.35 + i * 1.7);
        const tLen = bt.r + (isIce ? 8 : isBlood ? 6 : 5) + wave * 4;

        if (isBlood) {
          // Yarasa silueti dişi
          const bx = bt.x + Math.cos(tAng) * tLen;
          const by = bt.y + Math.sin(tAng) * tLen;
          ctx.beginPath();
          ctx.arc(bx, by, 3.5, 0, Math.PI * 2);
          ctx.fill();
        } else if (isIce) {
          // Sivri prizmatik buz dişi
          const p1x = bt.x + Math.cos(tAng - 0.06) * bt.r;
          const p1y = bt.y + Math.sin(tAng - 0.06) * bt.r;
          const p2x = bt.x + Math.cos(tAng + 0.06) * bt.r;
          const p2y = bt.y + Math.sin(tAng + 0.06) * bt.r;
          const tipX = bt.x + Math.cos(tAng) * tLen;
          const tipY = bt.y + Math.sin(tAng) * tLen;
          ctx.beginPath();
          ctx.moveTo(p1x, p1y); ctx.lineTo(tipX, tipY); ctx.lineTo(p2x, p2y); ctx.closePath();
          ctx.fill();
        } else {
          const p1x = bt.x + Math.cos(tAng - 0.08) * bt.r;
          const p1y = bt.y + Math.sin(tAng - 0.08) * bt.r;
          const p2x = bt.x + Math.cos(tAng + 0.08) * bt.r;
          const p2y = bt.y + Math.sin(tAng + 0.08) * bt.r;
          const tipX = bt.x + Math.cos(tAng) * tLen;
          const tipY = bt.y + Math.sin(tAng) * tLen;
          ctx.beginPath();
          ctx.moveTo(p1x, p1y); ctx.lineTo(tipX, tipY); ctx.lineTo(p2x, p2y); ctx.closePath();
          ctx.fill();
        }
      }

      // B. Çift Konsantrik Rün Çemberi Sınırları
      ctx.strokeStyle = mainCol;
      ctx.lineWidth = 2.4;
      ctx.shadowColor = glowCol;
      ctx.shadowBlur = 0; /* 60fps */
      ctx.globalAlpha = 0.85;
      ctx.beginPath();
      ctx.arc(bt.x, bt.y, bt.r, 0, Math.PI * 2);
      ctx.stroke();

      ctx.lineWidth = 1.2;
      ctx.beginPath();
      ctx.arc(bt.x, bt.y, bt.r - 8, 0, Math.PI * 2);
      ctx.stroke();

      // C. Çember Boyunca Dönen Antik Rün Yazıları
      const runeCount = 14;
      const runeRadius = bt.r - 4;
      ctx.strokeStyle = runeCol;
      ctx.lineWidth = 1.6;
      ctx.shadowColor = glowCol;
      ctx.shadowBlur = 0; /* 60fps */
      ctx.globalAlpha = 0.9;
      for (let i = 0; i < runeCount; i++) {
        const rAng = rot + (i / runeCount) * Math.PI * 2;
        const rx = bt.x + Math.cos(rAng) * runeRadius;
        const ry = bt.y + Math.sin(rAng) * runeRadius;
        ctx.save();
        ctx.translate(rx, ry);
        ctx.rotate(rAng + Math.PI / 2);
        drawVectorRune(ctx, i, 3.2);
        ctx.restore();
      }
      ctx.shadowBlur = 0;

      // D. İç Tersine Dönen Kesikli Rün Yolu
      ctx.strokeStyle = runeCol;
      ctx.lineWidth = 1.4;
      ctx.globalAlpha = 0.6;
      ctx.setLineDash([5, 4]);
      ctx.beginPath();
      ctx.arc(bt.x, bt.y, bt.r * 0.65, 0, Math.PI * 2);
      ctx.stroke();
      ctx.setLineDash([]);

      // E. Genişleyen İç Tehlike Dolgusu (Progress)
      const fillR = bt.r * progress;
      const radG = ctx.createRadialGradient(bt.x, bt.y, fillR * 0.15, bt.x, bt.y, fillR);
      if (isFire) {
        radG.addColorStop(0, 'rgba(255, 235, 59, 0.75)');
        radG.addColorStop(0.6, 'rgba(255, 87, 34, 0.55)');
        radG.addColorStop(1, 'rgba(211, 47, 47, 0.3)');
      } else if (isNature) {
        radG.addColorStop(0, 'rgba(185, 246, 202, 0.7)');
        radG.addColorStop(0.6, 'rgba(76, 175, 80, 0.5)');
        radG.addColorStop(1, 'rgba(27, 94, 32, 0.3)');
      } else if (isIce) {
        radG.addColorStop(0, 'rgba(224, 247, 250, 0.8)');
        radG.addColorStop(0.6, 'rgba(0, 229, 255, 0.5)');
        radG.addColorStop(1, 'rgba(2, 136, 209, 0.3)');
      } else if (isStorm) {
        radG.addColorStop(0, 'rgba(255, 249, 196, 0.85)');
        radG.addColorStop(0.6, 'rgba(255, 214, 0, 0.55)');
        radG.addColorStop(1, 'rgba(245, 127, 23, 0.3)');
      } else if (isBlood) {
        radG.addColorStop(0, 'rgba(255, 23, 68, 0.8)');
        radG.addColorStop(0.6, 'rgba(183, 28, 28, 0.55)');
        radG.addColorStop(1, 'rgba(74, 20, 140, 0.35)');
      } else {
        radG.addColorStop(0, '#ffffff');
        radG.addColorStop(0.6, mainCol);
        radG.addColorStop(1, 'transparent');
      }
      ctx.fillStyle = radG;
      ctx.globalAlpha = 0.25 + progress * 0.45;
      ctx.beginPath();
      ctx.arc(bt.x, bt.y, fillR, 0, Math.PI * 2);
      ctx.fill();

      // F. Merkez Çekirdek
      ctx.fillStyle = runeCol;
      ctx.globalAlpha = 0.7 + Math.sin(time * 0.4) * 0.3;
      ctx.beginPath();
      ctx.arc(bt.x, bt.y, 4.5, 0, Math.PI * 2);
      ctx.fill();

    } else if (bt.kind === 'reticle') {
      // 2. DEV KAYA / BUZ SARKITI FIRLATMASI HEDEFLEME HALKASI
      const retColor = '#ffd54f';
      const retR = bt.r;
      const teethCount = 12;
      const rot = time * 0.035;

      ctx.fillStyle = retColor;
      ctx.strokeStyle = '#ffb300';
      ctx.lineWidth = 1.8;
      ctx.shadowColor = '#ffe082';
      ctx.shadowBlur = 0; /* 60fps */
      ctx.globalAlpha = 0.85;

      for (let i = 0; i < teethCount; i++) {
        const tAng = rot + (i / teethCount) * Math.PI * 2;
        const toothLen = retR + 7;
        const p1x = bt.x + Math.cos(tAng - 0.12) * retR;
        const p1y = bt.y + Math.sin(tAng - 0.12) * retR;
        const p2x = bt.x + Math.cos(tAng + 0.12) * retR;
        const p2y = bt.y + Math.sin(tAng + 0.12) * retR;
        const tipX = bt.x + Math.cos(tAng) * toothLen;
        const tipY = bt.y + Math.sin(tAng) * toothLen;
        ctx.beginPath();
        ctx.moveTo(p1x, p1y);
        ctx.lineTo(tipX, tipY);
        ctx.lineTo(p2x, p2y);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();
      }

      ctx.beginPath();
      ctx.arc(bt.x, bt.y, retR, 0, Math.PI * 2);
      ctx.stroke();

      ctx.setLineDash([6, 5]);
      ctx.beginPath();
      ctx.arc(bt.x, bt.y, retR * 0.65, 0, Math.PI * 2);
      ctx.stroke();
      ctx.setLineDash([]);

      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(bt.x - retR * 1.15, bt.y); ctx.lineTo(bt.x + retR * 1.15, bt.y);
      ctx.moveTo(bt.x, bt.y - retR * 1.15); ctx.lineTo(bt.x, bt.y + retR * 1.15);
      ctx.stroke();

      const fillR = retR * progress;
      ctx.fillStyle = 'rgba(255, 179, 0, 0.35)';
      ctx.beginPath();
      ctx.arc(bt.x, bt.y, fillR, 0, Math.PI * 2);
      ctx.fill();

    } else if (bt.kind === 'line') {
      // 3. HÜCUM HATTI (CHARGE LINE) TELEGRAFI
      const isFire = bt.color === '#ff3d00' || bt.color === '#ff5722' || bt.color === '#ff1744';
      const isIce = bt.color === '#00e5ff' || bt.color === '#4fc3f7' || bt.color === '#9be7ff';
      const isStorm = bt.color === '#ffd600' || bt.color === '#ffd54f' || bt.color === '#fbc02d';
      const isWater = bt.color === '#1e88e5' || bt.color === '#00b0ff';

      const arrowColor = isIce ? '#00e5ff' : isStorm ? '#ffd600' : isWater ? '#00e5ff' : isFire ? '#ff3d00' : (bt.color || '#ff1744');
      const glowColor = isIce ? '#80d8ff' : isStorm ? '#fff9c4' : isWater ? '#80d8ff' : '#ff9100';

      const lineLen = bt.length || 320;
      const halfW = (bt.width || 44) * 0.5;
      const angle = bt.angle || 0;

      ctx.translate(bt.x, bt.y);
      ctx.rotate(angle);

      ctx.strokeStyle = arrowColor;
      ctx.lineWidth = 2.2;
      ctx.shadowColor = glowColor;
      ctx.shadowBlur = 0; /* 60fps */
      ctx.globalAlpha = 0.8;

      ctx.beginPath();
      ctx.moveTo(0, -halfW); ctx.lineTo(lineLen - halfW * 1.5, -halfW);
      ctx.moveTo(0, halfW); ctx.lineTo(lineLen - halfW * 1.5, halfW);
      ctx.stroke();

      ctx.fillStyle = arrowColor;
      ctx.beginPath();
      ctx.moveTo(lineLen - halfW * 1.5, -halfW * 1.8);
      ctx.lineTo(lineLen + halfW * 0.6, 0);
      ctx.lineTo(lineLen - halfW * 1.5, halfW * 1.8);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();

      const fillW = lineLen * progress;
      const lineG = ctx.createLinearGradient(0, 0, fillW, 0);
      if (isIce) {
        lineG.addColorStop(0, 'rgba(2, 136, 209, 0.2)');
        lineG.addColorStop(1, 'rgba(0, 229, 255, 0.65)');
      } else if (isStorm) {
        lineG.addColorStop(0, 'rgba(245, 127, 23, 0.2)');
        lineG.addColorStop(1, 'rgba(255, 214, 0, 0.7)');
      } else if (isWater) {
        lineG.addColorStop(0, 'rgba(1, 87, 155, 0.2)');
        lineG.addColorStop(1, 'rgba(0, 176, 255, 0.65)');
      } else {
        lineG.addColorStop(0, 'rgba(211, 47, 47, 0.2)');
        lineG.addColorStop(1, 'rgba(255, 235, 59, 0.65)');
      }
      ctx.fillStyle = lineG;
      ctx.fillRect(0, -halfW * 0.9, fillW, halfW * 1.8);

      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 1.4;
      ctx.setLineDash([8, 6]);
      ctx.beginPath();
      ctx.moveTo(0, 0); ctx.lineTo(fillW, 0);
      ctx.stroke();
      ctx.setLineDash([]);

    } else if (bt.kind === 'fissure') {
      // 4. SİSMİK ZEMİN ÇATLAĞI
      const angle = bt.angle || 0;
      const len = bt.length || 240;
      ctx.translate(bt.x, bt.y);
      ctx.rotate(angle);

      ctx.strokeStyle = '#1a1822';
      ctx.lineWidth = 7;
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.moveTo(0, 0);
      const segs = 10;
      const segLen = len / segs;
      for (let s = 1; s <= segs; s++) {
        const segProgress = s / segs;
        if (segProgress > progress) break;
        const zx = s * segLen;
        const zy = Math.sin(s * 1.8) * 8;
        ctx.lineTo(zx, zy);
      }
      ctx.stroke();

      ctx.strokeStyle = '#00e5ff';
      ctx.lineWidth = 2.4;
      ctx.shadowColor = '#00e5ff';
      ctx.shadowBlur = 0; /* 60fps */
      ctx.beginPath();
      ctx.moveTo(0, 0);
      for (let s = 1; s <= segs; s++) {
        const segProgress = s / segs;
        if (segProgress > progress) break;
        const zx = s * segLen;
        const zy = Math.sin(s * 1.8) * 8;
        ctx.lineTo(zx, zy);
      }
      ctx.stroke();

    } else {
      // Varsayılan uyarı
      ctx.strokeStyle = bt.color || '#ff1744';
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.arc(bt.x, bt.y, bt.r || 30, 0, Math.PI * 2);
      ctx.stroke();
    }

    ctx.restore();
  });
}

function drawEnemyShot(p, time) {
  if (p.x < cam.x - 48 || p.x > cam.x + W + 48 || p.y < cam.y - 48 || p.y > cam.y + H + 48) return;
  // UNIVERSAL ENEMY THREAT INDICATOR: Crimson/Magenta danger aura & thick dark contrast border
  // Guarantees all enemy projectiles are immediately distinguishable from player spells!
  ctx.save();
  const dPulse = 1.0 + Math.sin(time * 0.32 + (p.ox || 0) * 0.05) * 0.14;
  const dRad = (p.r || 6.5) * dPulse;
  
  // 1. Thick dark outline
  ctx.strokeStyle = '#050505';
  ctx.lineWidth = 2.6;
  ctx.beginPath();
  ctx.arc(p.x, p.y, dRad + 1.2, 0, Math.PI * 2);
  ctx.stroke();

  // 2. High-contrast neon Crimson/Magenta hazard threat aura
  ctx.shadowColor = '#ff0055';
  ctx.shadowBlur = 0; /* 60fps */
  ctx.strokeStyle = '#ff0055';
  ctx.lineWidth = 1.6;
  ctx.beginPath();
  ctx.arc(p.x, p.y, dRad + 2.8, 0, Math.PI * 2);
  ctx.stroke();
  ctx.shadowBlur = 0;
  ctx.restore();

  const ang = p.face != null ? p.face : Math.atan2(p.vy || 0, p.vx || 0);
  if (p.kind === 'bat') {
    const flap = Math.sin(time * 0.45 + (p.ox || 0));
    ctx.save();
    ctx.translate(Math.round(p.x), Math.round(p.y));
    ctx.rotate(ang);
    ctx.fillStyle = '#1c0828';
    ctx.beginPath();
    ctx.moveTo(0, 0);
    ctx.lineTo(-4, -5 - flap * 3);
    ctx.lineTo(-2, -1);
    ctx.lineTo(-5, 0);
    ctx.lineTo(-2, 1);
    ctx.lineTo(-4, 5 + flap * 3);
    ctx.closePath();
    ctx.fill();
    ctx.fillStyle = '#ff1744';
    ctx.fillRect(1, -2, 2, 1.5);
    ctx.fillRect(1, 1, 2, 1.5);
    ctx.restore();
    return;
  }
  if (p.kind === 'marksman_beam') {
    ctx.save();
    ctx.translate(Math.round(p.x), Math.round(p.y));
    ctx.rotate(ang);
    ctx.fillStyle = '#ff1744';
    ctx.shadowColor = '#ff1744';
    ctx.shadowBlur = 0; /* 60fps */
    ctx.fillRect(-12, -2, 24, 4);
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(-8, -1, 16, 2);
    ctx.shadowBlur = 0;
    ctx.restore();
    return;
  }
  if (p.kind === 'icicle') {
    ctx.save();
    ctx.shadowColor = '#00e5ff';
    ctx.shadowBlur = 0; /* 60fps */
    drawPixSprite(p.x, p.y, ang, SPR_ICICLE, ['#80deea', '#e0f7fa', '#ffffff']);
    ctx.shadowBlur = 0;
    ctx.restore();
    return;
  }
  if (p.kind === 'thorn') {
    const rot = p.rot || (time * 0.2);
    ctx.save();
    drawPixSprite(p.x, p.y, rot, SPR_THORN, ['#1b5e20', '#4caf50', '#ffeb3b']);
    ctx.restore();
    return;
  }
  if (p.kind === 'magma' || p.kind === 'magma_mortar') {
    const rot = p.rot || (time * 0.25);
    ctx.save();
    ctx.shadowColor = '#ff5722';
    ctx.shadowBlur = 0; /* 60fps */
    drawPixSprite(p.x, p.y, rot, SPR_MAGMA_CINDER, ['#bf360c', '#ff5722', '#ffeb3b']);
    ctx.shadowBlur = 0;
    if (p.kind === 'magma_mortar') {
      ctx.fillStyle = '#ffffff';
      ctx.beginPath(); ctx.arc(p.x, p.y, 2, 0, Math.PI * 2); ctx.fill();
    }
    ctx.restore();
    return;
  }
  if (p.kind === 'rock_fist') {
    // Dev Kaya & Kaya Parçacıkları (Pafta Image 3'teki kırıklı kaya fırlatması)
    ctx.save();
    ctx.translate(p.x, p.y);
    ctx.rotate(ang + time * 0.15);
    const rad = p.r || 8;
    ctx.fillStyle = '#6d4c41';
    ctx.strokeStyle = '#3e2723';
    ctx.lineWidth = 1.8;
    ctx.beginPath();
    ctx.moveTo(-rad, -rad * 0.4);
    ctx.lineTo(-rad * 0.3, -rad);
    ctx.lineTo(rad * 0.8, -rad * 0.7);
    ctx.lineTo(rad, rad * 0.2);
    ctx.lineTo(rad * 0.4, rad);
    ctx.lineTo(-rad * 0.6, rad * 0.8);
    ctx.closePath();
    ctx.fill();
    ctx.stroke();
    // Kaya iç çatlakları
    ctx.strokeStyle = '#8d6e63';
    ctx.lineWidth = 1.2;
    ctx.beginPath();
    ctx.moveTo(-rad * 0.3, -rad * 0.3); ctx.lineTo(0, 0); ctx.lineTo(rad * 0.4, rad * 0.3);
    ctx.stroke();
    ctx.restore();
    return;
  }
  if (p.kind === 'toxic_spore') {
    // Zehirli Spor Sarmalı (Pafta Image 2'deki arkasında yeşil spor kuyruğu bırakan mermi)
    ctx.save();
    ctx.translate(p.x, p.y);
    ctx.rotate(ang);
    ctx.shadowColor = '#76ff03';
    ctx.shadowBlur = 0; /* 60fps */
    // Arkadaki kuyruk
    ctx.fillStyle = 'rgba(118, 255, 3, 0.35)';
    ctx.beginPath();
    ctx.moveTo(4, 0);
    ctx.lineTo(-14, -4);
    ctx.lineTo(-8, 0);
    ctx.lineTo(-14, 4);
    ctx.closePath();
    ctx.fill();
    // Ön spor gövdesi
    ctx.fillStyle = '#b9f6ca';
    ctx.strokeStyle = '#2e7d32';
    ctx.lineWidth = 1.4;
    ctx.beginPath();
    ctx.ellipse(0, 0, (p.r || 6) * 1.2, p.r || 6, 0, 0, Math.PI * 2);
    ctx.fill();
    ctx.stroke();
    // Zehir damlacığı çekirdeği
    ctx.fillStyle = '#00e676';
    ctx.beginPath(); ctx.arc(1.5, 0, 2.5, 0, Math.PI * 2); ctx.fill();
    ctx.shadowBlur = 0;
    ctx.restore();
    return;
  }
  if (p.kind === 'ball_lightning') {
    // Statik Küre / Orbital Küre Mayınları (Pafta Image 1'deki dönen orbital uydulu şimşek küresi)
    ctx.save();
    ctx.translate(p.x, p.y);
    ctx.shadowColor = '#ffd600';
    ctx.shadowBlur = 0; /* 60fps */
    // Ana elektrik küresi
    ctx.fillStyle = '#fff9c4';
    ctx.strokeStyle = '#ffd600';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(0, 0, p.r || 7, 0, Math.PI * 2);
    ctx.fill();
    ctx.stroke();
    // Etrafında dönen 3 adet orbital enerji uydusu
    const orbCount = 3;
    const orbDist = (p.r || 7) + 6;
    const orbRot = time * 0.12;
    ctx.fillStyle = '#00e5ff';
    for (let o = 0; o < orbCount; o++) {
      const oa = orbRot + (o / orbCount) * Math.PI * 2;
      const ox = Math.cos(oa) * orbDist;
      const oy = Math.sin(oa) * orbDist;
      ctx.beginPath();
      ctx.arc(ox, oy, 2.2, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.shadowBlur = 0;
    ctx.restore();
    return;
  }
  if (p.kind === 'hydro_wave') {
    // Tsunami Dalgaları (Pafta Image 1'deki beyaz köpük tepeli okyanus dalgası)
    ctx.save();
    ctx.translate(p.x, p.y);
    ctx.rotate(ang);
    ctx.shadowColor = '#00b0ff';
    ctx.shadowBlur = 0; /* 60fps */
    // Dalga gövdesi
    ctx.fillStyle = '#0288d1';
    ctx.strokeStyle = '#01579b';
    ctx.lineWidth = 1.6;
    ctx.beginPath();
    ctx.moveTo(12, 0);
    ctx.quadraticCurveTo(0, -14, -10, -10);
    ctx.quadraticCurveTo(-4, 0, -10, 10);
    ctx.quadraticCurveTo(0, 14, 12, 0);
    ctx.closePath();
    ctx.fill();
    ctx.stroke();
    // Dalga tepesindeki beyaz köpük tarağı
    ctx.fillStyle = '#ffffff';
    ctx.beginPath();
    ctx.arc(10, -2, 3, 0, Math.PI * 2);
    ctx.arc(6, -8, 2.5, 0, Math.PI * 2);
    ctx.arc(6, 8, 2.5, 0, Math.PI * 2);
    ctx.fill();
    ctx.shadowBlur = 0;
    ctx.restore();
    return;
  }
  if (p.kind === 'venom_needle') {
    ctx.save();
    ctx.shadowColor = '#00e676';
    ctx.shadowBlur = 0; /* 60fps */
    ctx.translate(Math.round(p.x), Math.round(p.y));
    ctx.rotate(ang);
    ctx.fillStyle = '#00e676';
    ctx.beginPath();
    ctx.moveTo(6, 0); ctx.lineTo(-6, -2); ctx.lineTo(-4, 0); ctx.lineTo(-6, 2);
    ctx.closePath();
    ctx.fill();
    ctx.restore();
    return;
  }
  if (p.kind === 'blood_scythe') {
    ctx.save();
    ctx.shadowColor = '#ff1744';
    ctx.shadowBlur = 0; /* 60fps */
    ctx.translate(Math.round(p.x), Math.round(p.y));
    ctx.rotate(ang);
    ctx.fillStyle = '#ff1744';
    ctx.beginPath();
    ctx.arc(0, 0, p.r || 6.5, -Math.PI * 0.5, Math.PI * 0.5);
    ctx.quadraticCurveTo(-2, 0, 0, -Math.PI * 0.5);
    ctx.fill();
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(-1, -1, 2, 2);
    ctx.restore();
    return;
  }
  if (p.kind === 'rock_boulder') {
    const rot = p.rot || (time * 0.15);
    ctx.save();
    ctx.translate(Math.round(p.x), Math.round(p.y));
    ctx.rotate(rot);
    ctx.shadowColor = '#ffb74d';
    ctx.shadowBlur = 0; /* 60fps */
    pixDisk(0, 0, p.r || 11, '#8d6e63', '#5d4037', '#3e2723');
    ctx.strokeStyle = '#ffb74d';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(-6, -4); ctx.lineTo(0, 0); ctx.lineTo(6, -2);
    ctx.moveTo(0, 0); ctx.lineTo(-2, 7);
    ctx.stroke();
    ctx.restore();
    return;
  }
  if (p.kind === 'mustard_fire') {
    ctx.save();
    ctx.shadowColor = '#fbc02d';
    ctx.shadowBlur = 0; /* 60fps */
    pixDisk(p.x, p.y, p.r || 6.5, '#fff59d', '#fbc02d', '#f57f17');
    ctx.fillStyle = '#d50000';
    ctx.beginPath(); ctx.arc(p.x, p.y, 2, 0, Math.PI * 2); ctx.fill();
    ctx.restore();
    return;
  }
  if (p.kind === 'lollipop_bomb') {
    const rot = p.rot || (time * 0.2);
    ctx.save();
    ctx.translate(Math.round(p.x), Math.round(p.y));
    ctx.rotate(rot);
    ctx.shadowColor = '#ec407a';
    ctx.shadowBlur = 0; /* 60fps */
    pixDisk(0, 0, p.r || 9, '#f48fb1', '#ec407a', '#c2185b');
    ctx.strokeStyle = '#ffffff';
    ctx.lineWidth = 2.5;
    ctx.beginPath();
    ctx.arc(0, 0, 5, 0, Math.PI * 1.5);
    ctx.stroke();
    ctx.restore();
    return;
  }
  if (p.kind === 'icicle_shard') {
    // DEV BUZ SARKITI / PRIZMATIK BUZ KRİSTALİ (Pafta 2 - Kutup Hükümdarı Yeti)
    ctx.save();
    ctx.translate(p.x, p.y);
    ctx.rotate(ang);
    ctx.shadowColor = '#00e5ff';
    ctx.shadowBlur = 0; /* 60fps */
    // Prizmatik sivri buz sarkıtı
    ctx.fillStyle = '#e0f7fa';
    ctx.strokeStyle = '#00e5ff';
    ctx.lineWidth = 1.8;
    ctx.beginPath();
    ctx.moveTo(14, 0);
    ctx.lineTo(-10, -6);
    ctx.lineTo(-6, 0);
    ctx.lineTo(-10, 6);
    ctx.closePath();
    ctx.fill();
    ctx.stroke();
    // Kristal iç faset çizgileri
    ctx.strokeStyle = '#ffffff';
    ctx.lineWidth = 1.2;
    ctx.beginPath();
    ctx.moveTo(14, 0); ctx.lineTo(-6, 0);
    ctx.stroke();
    // Uçuşan kar parçacığı
    ctx.fillStyle = '#ffffff';
    ctx.beginPath(); ctx.arc(-12, -3, 1.5, 0, Math.PI * 2); ctx.fill();
    ctx.beginPath(); ctx.arc(-14, 3, 1.2, 0, Math.PI * 2); ctx.fill();
    ctx.shadowBlur = 0;
    ctx.restore();
    return;
  }
  if (p.kind === 'lightning_javelin') {
    // STATİK ŞİMŞEK MIZRAĞI / ZİKZAK ARK (Pafta 3 - Yıldırım Titanı Raijin)
    ctx.save();
    ctx.translate(p.x, p.y);
    ctx.rotate(ang);
    ctx.shadowColor = '#ffd600';
    ctx.shadowBlur = 0; /* 60fps */
    ctx.strokeStyle = '#ffd600';
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.moveTo(14, 0); ctx.lineTo(6, -5); ctx.lineTo(2, 4); ctx.lineTo(-8, -4); ctx.lineTo(-14, 0);
    ctx.stroke();
    ctx.strokeStyle = '#ffffff';
    ctx.lineWidth = 1.6;
    ctx.beginPath();
    ctx.moveTo(14, 0); ctx.lineTo(6, -5); ctx.lineTo(2, 4); ctx.lineTo(-8, -4); ctx.lineTo(-14, 0);
    ctx.stroke();
    ctx.shadowBlur = 0;
    ctx.restore();
    return;
  }
  if (p.kind === 'bat_swarm' || p.kind === 'blood_drop') {
    // KAN DAMLASI & YARASA SÜRÜSÜ (Pafta 5 - Kan Vadisi / Karanlık Kontu)
    ctx.save();
    ctx.translate(p.x, p.y);
    ctx.rotate(ang);
    ctx.shadowColor = '#ff1744';
    ctx.shadowBlur = 0; /* 60fps */
    // Kanat çırpan yarasa formu
    const wingY = Math.sin(time * 0.4) * 4;
    ctx.fillStyle = '#111827';
    ctx.beginPath();
    ctx.moveTo(6, 0);
    ctx.quadraticCurveTo(0, -7 + wingY, -6, -10 + wingY);
    ctx.lineTo(-3, 0);
    ctx.lineTo(-6, 10 - wingY);
    ctx.quadraticCurveTo(0, 7 - wingY, 6, 0);
    ctx.closePath();
    ctx.fill();
    // Kırmızı parlayan yarasa gözü / kan çekirdeği
    ctx.fillStyle = '#ff1744';
    ctx.beginPath(); ctx.arc(2, -1, 1.5, 0, Math.PI * 2); ctx.fill();
    ctx.shadowBlur = 0;
    ctx.restore();
    return;
  }
  pixDisk(p.x, p.y, p.r || 5, '#ffe0b2', '#ff9800', '#e65100');
}

// 1. Yeti (Glacial Behemoth - Boss)
function drawYetiEnemy(ctx, x, y, r, en, time, fogged) {
  const lift = 5 + r * 0.2 + Math.abs(Math.sin(time * 0.2 + en.phase)) * 2.4;
  const cy = y - lift;
  drawGroundShadow(x + 2, y + r * 0.55, r * 1.15, r * 0.32);

  if (fogged) {
    pixDisk(x, cy, r, '#102218', '#102218', '#0a140f');
    return cy;
  }

  const isRaged = en.raged;
  const furBase = isRaged ? '#b2ebf2' : '#e0f7fa';
  const furHi = '#ffffff';
  const furShade = isRaged ? '#4dd0e1' : '#80deea';
  const hornCol = isRaged ? '#00e5ff' : '#0288d1';
  const hornHi = '#b3e5fc';

  ctx.save();
  pixDisk(x, cy, r, furHi, furBase, furShade);

  // Curved Glacial Horns
  ctx.strokeStyle = hornCol;
  ctx.lineWidth = Math.max(3, r * 0.22);
  ctx.lineCap = 'round';
  ctx.beginPath();
  ctx.moveTo(x - r * 0.55, cy - r * 0.35);
  ctx.quadraticCurveTo(x - r * 1.35, cy - r * 0.85, x - r * 0.95, cy - r * 1.35);
  ctx.stroke();

  ctx.strokeStyle = hornHi;
  ctx.lineWidth = Math.max(1.5, r * 0.1);
  ctx.beginPath();
  ctx.moveTo(x - r * 0.5, cy - r * 0.4);
  ctx.quadraticCurveTo(x - r * 1.25, cy - r * 0.85, x - r * 0.95, cy - r * 1.3);
  ctx.stroke();

  ctx.strokeStyle = hornCol;
  ctx.lineWidth = Math.max(3, r * 0.22);
  ctx.beginPath();
  ctx.moveTo(x + r * 0.55, cy - r * 0.35);
  ctx.quadraticCurveTo(x + r * 1.35, cy - r * 0.85, x + r * 0.95, cy - r * 1.35);
  ctx.stroke();

  ctx.strokeStyle = hornHi;
  ctx.lineWidth = Math.max(1.5, r * 0.1);
  ctx.beginPath();
  ctx.moveTo(x + r * 0.5, cy - r * 0.4);
  ctx.quadraticCurveTo(x + r * 1.25, cy - r * 0.85, x + r * 0.95, cy - r * 1.3);
  ctx.stroke();

  // White chest fur plate
  ctx.fillStyle = furHi;
  ctx.beginPath();
  ctx.ellipse(x, cy + r * 0.22, r * 0.58, r * 0.42, 0, 0, Math.PI * 2);
  ctx.fill();

  // Glowing eyes
  const eyeCol = isRaged ? '#ff1744' : '#00b0ff';
  const eyeR = Math.max(2.5, r * 0.12);
  ctx.fillStyle = eyeCol;
  ctx.shadowColor = eyeCol;
  ctx.shadowBlur = 0;
  ctx.beginPath();
  ctx.arc(x - r * 0.3, cy - r * 0.12, eyeR, 0, Math.PI * 2);
  ctx.arc(x + r * 0.3, cy - r * 0.12, eyeR, 0, Math.PI * 2);
  ctx.fill();
  ctx.shadowBlur = 0;

  // Ice crystal shoulders
  ctx.fillStyle = hornCol;
  ctx.fillRect(Math.round(x - r * 0.95), Math.round(cy - 2), 4, 6);
  ctx.fillRect(Math.round(x + r * 0.82), Math.round(cy - 2), 4, 6);

  if (isRaged || (en && en.phase2)) {
    ctx.strokeStyle = 'rgba(0, 229, 255, 0.65)';
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.arc(x, cy, r + 11 + Math.sin(time * 0.3) * 4, 0, Math.PI * 2);
    ctx.stroke();
  }
  
  // ARCADE WHITE HIT FLASH (Impact Feedback - Boss only)
  if (en.type === 'boss' && en.hitFlash > 0) {
    en.hitFlash--;
    ctx.save();
    ctx.fillStyle = 'rgba(255, 255, 255, 0.72)';
    ctx.beginPath();
    ctx.arc(en.x, cy, en.r + 1.5, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();
  } else if (en.hitFlash > 0) {
    en.hitFlash--;
  }

  ctx.restore();
  return cy;
}

// 2. Vampire (Night Stalker - Shooter & Shaman)
function drawVampireEnemy(ctx, x, y, r, en, time, fogged) {
  const lift = 4 + r * 0.14 + Math.abs(Math.sin(time * 0.2 + en.phase)) * 2.2;
  const cy = y - lift;
  drawGroundShadow(x + 2, y + r * 0.5, r * 1.05, r * 0.26);

  if (fogged) {
    pixDisk(x, cy, r, '#102218', '#102218', '#0a140f');
    return cy;
  }

  ctx.save();
  const flap = Math.sin(time * 0.35 + en.phase);
  ctx.fillStyle = '#180728';
  // Left bat wing
  ctx.beginPath();
  ctx.moveTo(x - r * 0.4, cy);
  ctx.quadraticCurveTo(x - r * 1.4, cy - r * 0.8 + flap * 4, x - r * 1.8, cy + flap * 2);
  ctx.quadraticCurveTo(x - r * 1.1, cy + r * 0.4, x - r * 0.3, cy + r * 0.5);
  ctx.fill();
  // Right bat wing
  ctx.beginPath();
  ctx.moveTo(x + r * 0.4, cy);
  ctx.quadraticCurveTo(x + r * 1.4, cy - r * 0.8 + flap * 4, x + r * 1.8, cy + flap * 2);
  ctx.quadraticCurveTo(x + r * 1.1, cy + r * 0.4, x + r * 0.3, cy + r * 0.5);
  ctx.fill();

  // Dark Vampire Cape with Crimson Lining
  pixDisk(x, cy + 2, r * 0.95, '#2e1040', '#1a0926', '#0d0414');
  ctx.fillStyle = '#b71c1c';
  ctx.beginPath();
  ctx.moveTo(x - r * 0.45, cy - r * 0.2);
  ctx.lineTo(x + r * 0.45, cy - r * 0.2);
  ctx.lineTo(x, cy + r * 0.65);
  ctx.closePath();
  ctx.fill();

  // High Vampire Collar
  ctx.fillStyle = '#d32f2f';
  ctx.beginPath();
  ctx.moveTo(x - r * 0.65, cy - r * 0.7);
  ctx.lineTo(x - r * 0.25, cy - r * 0.1);
  ctx.lineTo(x - r * 0.45, cy + r * 0.2);
  ctx.closePath();
  ctx.fill();
  ctx.beginPath();
  ctx.moveTo(x + r * 0.65, cy - r * 0.7);
  ctx.lineTo(x + r * 0.25, cy - r * 0.1);
  ctx.lineTo(x + r * 0.45, cy + r * 0.2);
  ctx.closePath();
  ctx.fill();

  // Pale Aristocratic Head
  const headR = r * 0.62;
  const headY = cy - r * 0.4;
  pixDisk(x, headY, headR, '#ffffff', '#ede7f6', '#d1c4e9');

  // Widow's peak dark hair
  ctx.fillStyle = '#0a0512';
  ctx.beginPath();
  ctx.moveTo(x - headR, headY - 1);
  ctx.quadraticCurveTo(x, headY - headR * 1.2, x + headR, headY - 1);
  ctx.lineTo(x + headR * 0.7, headY - headR * 0.4);
  ctx.lineTo(x, headY - headR * 0.2);
  ctx.lineTo(x - headR * 0.7, headY - headR * 0.4);
  ctx.closePath();
  ctx.fill();

  // Glowing Ruby Eyes
  ctx.fillStyle = '#ff1744';
  ctx.shadowColor = '#ff1744';
  ctx.shadowBlur = 0; /* 60fps */
  ctx.fillRect(Math.round(x - headR * 0.45), Math.round(headY), 2.5, 2.5);
  ctx.fillRect(Math.round(x + headR * 0.2), Math.round(headY), 2.5, 2.5);
  ctx.shadowBlur = 0;

  // Tiny fangs
  ctx.fillStyle = '#ffffff';
  ctx.fillRect(Math.round(x - 2), Math.round(headY + headR * 0.45), 1.5, 2);
  ctx.fillRect(Math.round(x + 1), Math.round(headY + headR * 0.45), 1.5, 2);

  if (en.type === 'shaman') {
    const orbY = cy - r * 1.25 + Math.sin(time * 0.3) * 3;
    ctx.shadowColor = '#ab47bc';
    ctx.shadowBlur = 0; /* 60fps */
    pixDisk(x, orbY, 4.5, '#f3e5f5', '#ba68c8', '#4a148c');
    ctx.shadowBlur = 0;
  }
  ctx.restore();
  return cy;
}

// 3. Cactus Knight (Desert Nature Guardian - Tank, Armored, Bearer, Walker)
function drawCactusEnemy(ctx, x, y, r, en, time, fogged) {
  const lift = 4 + r * 0.12 + Math.abs(Math.sin(time * 0.18 + en.phase)) * 2;
  const cy = y - lift;
  drawGroundShadow(x + 2, y + r * 0.5, r * 1.12, r * 0.28);

  if (fogged) {
    pixDisk(x, cy, r, '#102218', '#102218', '#0a140f');
    return cy;
  }

  ctx.save();
  const cactusHi = '#81c784';
  const cactusMid = '#388e3c';
  const cactusLo = '#1b5e20';
  pixDisk(x, cy, r, cactusHi, cactusMid, cactusLo);

  ctx.strokeStyle = cactusLo;
  ctx.lineWidth = 1.5;
  ctx.beginPath();
  ctx.ellipse(x, cy, r * 0.45, r * 0.9, 0, 0, Math.PI * 2);
  ctx.stroke();

  // Spines
  ctx.fillStyle = '#fff59d';
  const spineAngles = [-0.6, -0.2, 0.2, 0.6];
  spineAngles.forEach(sa => {
    const sx = x + Math.sin(sa) * (r * 0.85);
    const sy = cy + Math.cos(sa) * (r * 0.7);
    ctx.fillRect(Math.round(sx - 1), Math.round(sy - 1), 2, 2);
  });
  ctx.fillRect(Math.round(x - r * 1.05), Math.round(cy - 2), 2.5, 2.5);
  ctx.fillRect(Math.round(x + r * 0.95), Math.round(cy - 2), 2.5, 2.5);

  // Wide Sombrero Rim
  const hatY = cy - r * 0.65;
  ctx.fillStyle = '#d7ccc8';
  ctx.beginPath();
  ctx.ellipse(x, hatY, r * 1.25, r * 0.38, 0, 0, Math.PI * 2);
  ctx.fill();
  ctx.strokeStyle = '#8d6e63';
  ctx.lineWidth = 1.5;
  ctx.stroke();

  // Sombrero Crown
  ctx.fillStyle = '#bcaaa4';
  ctx.beginPath();
  ctx.roundRect ? ctx.roundRect(x - r * 0.55, hatY - r * 0.45, r * 1.1, r * 0.5, 3) : ctx.fillRect(x - r * 0.55, hatY - r * 0.45, r * 1.1, r * 0.5);
  ctx.fill();

  // Pink Desert Flower on Hat
  const flX = x + r * 0.45;
  const flY = hatY - r * 0.35;
  ctx.fillStyle = '#ff4081';
  ctx.beginPath();
  for (let i = 0; i < 5; i++) {
    const fa = i * (Math.PI * 2 / 5);
    ctx.arc(flX + Math.cos(fa) * 3.5, flY + Math.sin(fa) * 3.5, 2.5, 0, Math.PI * 2);
  }
  ctx.fill();
  ctx.fillStyle = '#ffeb3b';
  ctx.beginPath();
  ctx.arc(flX, flY, 2, 0, Math.PI * 2);
  ctx.fill();

  // Red Bandana
  ctx.fillStyle = '#e53935';
  ctx.beginPath();
  ctx.moveTo(x - r * 0.65, cy + r * 0.25);
  ctx.lineTo(x + r * 0.65, cy + r * 0.25);
  ctx.lineTo(x + 2, cy + r * 0.72);
  ctx.closePath();
  ctx.fill();

  // Spiky Desert Club
  const clubX = x + r * 0.95;
  const clubY = cy + r * 0.15;
  ctx.strokeStyle = '#6d4c41';
  ctx.lineWidth = 2.5;
  ctx.beginPath();
  ctx.moveTo(x + r * 0.5, cy + r * 0.3);
  ctx.lineTo(clubX, clubY);
  ctx.stroke();
  ctx.fillStyle = '#8d6e63';
  ctx.beginPath();
  ctx.arc(clubX, clubY, 4.5, 0, Math.PI * 2);
  ctx.fill();
  ctx.fillStyle = '#ffeb3b';
  ctx.fillRect(Math.round(clubX - 1), Math.round(clubY - 5), 2, 2);
  ctx.fillRect(Math.round(clubX + 3), Math.round(clubY - 1), 2, 2);

  // Cute eyes
  ctx.fillStyle = '#212121';
  ctx.fillRect(Math.round(x - r * 0.42), Math.round(cy - r * 0.15), 3, 4);
  ctx.fillRect(Math.round(x + r * 0.15), Math.round(cy - r * 0.15), 3, 4);
  ctx.fillStyle = '#ffffff';
  ctx.fillRect(Math.round(x - r * 0.42), Math.round(cy - r * 0.15), 1.5, 1.5);
  ctx.fillRect(Math.round(x + r * 0.15), Math.round(cy - r * 0.15), 1.5, 1.5);

  ctx.restore();
  return cy;
}

// 4. Flamewar (Ember Forge - Exploder, Fast)
function drawFlamewarEnemy(ctx, x, y, r, en, time, fogged) {
  const lift = 4 + r * 0.12 + Math.abs(Math.sin(time * 0.28 + en.phase)) * 2.8;
  const cy = y - lift;
  drawGroundShadow(x + 2, y + r * 0.5, r * 1.05, r * 0.25);

  if (fogged) {
    pixDisk(x, cy, r, '#102218', '#102218', '#0a140f');
    return cy;
  }

  ctx.save();
  const flameH = r * 1.2 + Math.sin(time * 0.4 + en.phase) * (r * 0.25);
  ctx.fillStyle = '#ff3d00';
  ctx.beginPath();
  ctx.moveTo(x - r * 0.8, cy - r * 0.3);
  ctx.quadraticCurveTo(x - r * 0.5, cy - flameH, x, cy - flameH * 0.7);
  ctx.quadraticCurveTo(x + r * 0.5, cy - flameH * 1.1, x + r * 0.8, cy - r * 0.3);
  ctx.closePath();
  ctx.fill();

  ctx.fillStyle = '#ffea00';
  ctx.beginPath();
  ctx.moveTo(x - r * 0.4, cy - r * 0.4);
  ctx.quadraticCurveTo(x, cy - flameH * 0.85, x + r * 0.4, cy - r * 0.4);
  ctx.closePath();
  ctx.fill();

  pixDisk(x, cy, r, '#5d4037', '#3e2723', '#211311');

  // Molten Glowing Visor
  ctx.fillStyle = '#ffd600';
  ctx.shadowColor = '#ff6d00';
  ctx.shadowBlur = 0; /* 60fps */
  ctx.fillRect(Math.round(x - r * 0.55), Math.round(cy - r * 0.15), Math.round(r * 1.1), 3.5);
  ctx.shadowBlur = 0;

  // Chest furnace core
  ctx.fillStyle = '#ff3d00';
  ctx.beginPath();
  ctx.arc(x, cy + r * 0.35, Math.max(2, r * 0.22), 0, Math.PI * 2);
  ctx.fill();

  // Forge hammer
  const hamX = x + r * 0.95;
  const hamY = cy - r * 0.1;
  ctx.strokeStyle = '#8d6e63';
  ctx.lineWidth = 2.5;
  ctx.beginPath();
  ctx.moveTo(x + r * 0.4, cy + r * 0.4);
  ctx.lineTo(hamX, hamY);
  ctx.stroke();
  ctx.fillStyle = '#37474f';
  ctx.fillRect(Math.round(hamX - 4), Math.round(hamY - 5), 8, 5);
  ctx.fillStyle = '#ff9100';
  ctx.fillRect(Math.round(hamX - 3), Math.round(hamY - 4), 6, 2);

  ctx.restore();
  return cy;
}

// 5. Slime (Cute Ooze minion - Slime, Leech)
function drawSlimeEnemy(ctx, x, y, r, en, time, fogged) {
  const squash = Math.sin(time * 0.28 + en.phase);
  const lift = 3 + Math.abs(squash) * 3.5;
  const cy = y - lift;
  drawGroundShadow(x + 2, y + r * 0.52, r * (1.18 + squash * 0.18), r * 0.28);

  if (fogged) {
    pixDisk(x, cy, r, '#102218', '#102218', '#0a140f');
    return cy;
  }

  const col = en.type === 'leech' ? '#43a047' : '#00acc1';
  ctx.save();
  // Jelly bounce body
  pixDisk(x, cy, r, shadeHex(col, 65), col, shadeHex(col, -65));

  // Translucent top highlight dome
  ctx.fillStyle = 'rgba(255, 255, 255, 0.45)';
  ctx.beginPath();
  ctx.ellipse(x - r * 0.25, cy - r * 0.35, r * 0.45, r * 0.28, -0.3, 0, Math.PI * 2);
  ctx.fill();

  // Mini bouncy antenna/sprout on head
  const sproutY = cy - r * 0.85 + Math.sin(time * 0.35 + en.phase) * 2;
  ctx.fillStyle = shadeHex(col, 40);
  ctx.beginPath();
  ctx.arc(x, sproutY, Math.max(2, r * 0.24), 0, Math.PI * 2);
  ctx.fill();
  ctx.fillStyle = '#ffffff';
  ctx.fillRect(Math.round(x - 1), Math.round(sproutY - 1), 1.5, 1.5);

  // Big shiny anime eyes
  const eyeXOff = r * 0.36;
  const eyeY = cy - r * 0.08;
  const eyeR = Math.max(3, r * 0.24);

  // Eye background
  ctx.fillStyle = '#102027';
  ctx.beginPath();
  ctx.arc(x - eyeXOff, eyeY, eyeR, 0, Math.PI * 2);
  ctx.arc(x + eyeXOff, eyeY, eyeR, 0, Math.PI * 2);
  ctx.fill();

  // Eye pupil color
  ctx.fillStyle = shadeHex(col, 80);
  ctx.beginPath();
  ctx.arc(x - eyeXOff, eyeY + 0.5, eyeR * 0.65, 0, Math.PI * 2);
  ctx.arc(x + eyeXOff, eyeY + 0.5, eyeR * 0.65, 0, Math.PI * 2);
  ctx.fill();

  // Big sparkle reflections
  ctx.fillStyle = '#ffffff';
  ctx.beginPath();
  ctx.arc(x - eyeXOff - 1, eyeY - 1, eyeR * 0.45, 0, Math.PI * 2);
  ctx.arc(x + eyeXOff - 1, eyeY - 1, eyeR * 0.45, 0, Math.PI * 2);
  ctx.fill();
  ctx.fillRect(Math.round(x - eyeXOff + 1), Math.round(eyeY + 1), 1.5, 1.5);
  ctx.fillRect(Math.round(x + eyeXOff + 1), Math.round(eyeY + 1), 1.5, 1.5);

  // Blushing cute cheeks
  ctx.fillStyle = 'rgba(255, 64, 129, 0.4)';
  ctx.beginPath();
  ctx.ellipse(x - r * 0.62, cy + r * 0.22, 3, 1.8, 0, 0, Math.PI * 2);
  ctx.ellipse(x + r * 0.62, cy + r * 0.22, 3, 1.8, 0, 0, Math.PI * 2);
  ctx.fill();

  ctx.restore();
  return cy;
}

// --- BOSS FOOTPRINTS & ERUPTING ROCKS RENDERING ---
function drawEruptingRock(ctx, rk) {
  if (!rk || rk.currH <= 0.5) return;

  ctx.save();
  const alpha = Math.min(1.0, rk.life * 2.5);
  ctx.globalAlpha = alpha;

  const h = rk.currH;
  const halfW = rk.w * 0.5;

  // Ground fracture crater shadow (Stone Biome uyumlu koyu anakaya gölgesi)
  ctx.fillStyle = 'rgba(10, 14, 18, 0.65)';
  ctx.beginPath();
  ctx.ellipse(rk.x, rk.y, halfW * 1.3, halfW * 0.5, 0, 0, Math.PI * 2);
  ctx.fill();

  // Fractured ground radial fissures
  ctx.strokeStyle = '#1a2327';
  ctx.lineWidth = 1.8;
  ctx.beginPath();
  ctx.moveTo(rk.x - halfW * 1.4, rk.y + 1);
  ctx.lineTo(rk.x - halfW * 0.4, rk.y);
  ctx.moveTo(rk.x + halfW * 0.3, rk.y);
  ctx.lineTo(rk.x + halfW * 1.5, rk.y + 2);
  ctx.moveTo(rk.x, rk.y - halfW * 0.3);
  ctx.lineTo(rk.x + 2, rk.y + halfW * 0.4);
  ctx.stroke();

  // Glowing subterranean cyan runic energy in fissure
  if (rk.glowRune) {
    ctx.strokeStyle = 'rgba(0, 229, 255, ' + (0.75 * alpha) + ')';
    ctx.lineWidth = 2.0;
    ctx.shadowColor = '#00e5ff';
    ctx.shadowBlur = 0; /* 60fps */
    ctx.beginPath();
    ctx.moveTo(rk.x - halfW * 0.8, rk.y);
    ctx.lineTo(rk.x + halfW * 0.8, rk.y);
    ctx.stroke();
    ctx.shadowBlur = 0;
  }

  // 3D Faceted Erupting Jagged Rock Monolith
  ctx.translate(rk.x, rk.y);
  ctx.rotate(rk.rot);

  // Left facet (illuminated / slate highlight)
  ctx.fillStyle = rk.lightCol || '#607d8b';
  ctx.beginPath();
  ctx.moveTo(0, -h); // apex
  ctx.lineTo(-halfW, 0); // left bottom
  ctx.lineTo(0, -h * 0.2); // center lower crease
  ctx.closePath();
  ctx.fill();
  ctx.strokeStyle = '#10171d';
  ctx.lineWidth = 1.2;
  ctx.stroke();

  // Right facet (shadowed / darker granite tone)
  ctx.fillStyle = rk.darkCol || '#1a2327';
  ctx.beginPath();
  ctx.moveTo(0, -h); // apex
  ctx.lineTo(0, -h * 0.2); // center lower crease
  ctx.lineTo(halfW, 0); // right bottom
  ctx.closePath();
  ctx.fill();
  ctx.stroke();

  // Center faceted ridge / granite texture
  ctx.fillStyle = rk.col || '#37474f';
  ctx.beginPath();
  ctx.moveTo(0, -h);
  ctx.lineTo(-halfW * 0.35, -h * 0.6);
  ctx.lineTo(0, -h * 0.2);
  ctx.lineTo(halfW * 0.35, -h * 0.6);
  ctx.closePath();
  ctx.fill();

  // Ancient glowing tectonic rune carving on the rock face
  if (rk.glowRune && h > 12) {
    ctx.save();
    ctx.strokeStyle = '#00e5ff';
    ctx.lineWidth = 1.8;
    ctx.shadowColor = '#00e5ff';
    ctx.shadowBlur = 0; /* 60fps */
    ctx.beginPath();
    const ry = -h * 0.55;
    ctx.moveTo(-4, ry - 5);
    ctx.lineTo(0, ry - 8);
    ctx.lineTo(4, ry - 5);
    ctx.lineTo(0, ry);
    ctx.lineTo(-4, ry - 5);
    ctx.moveTo(0, ry - 8);
    ctx.lineTo(0, ry + 4);
    ctx.stroke();
    ctx.restore();
  }

  ctx.restore();
}

function drawBossFootprints(ctx, en) {
  if (!en || !en.footprints) return;
  for (let i = 0; i < en.footprints.length; i++) {
    const fp = en.footprints[i];
    if (fp.life <= 0) continue;

    ctx.save();
    const a = Math.min(1.0, fp.life * 1.5);
    ctx.globalAlpha = a;

    if (fp.type === 'lava') {
      // Scorched molten magma footprint
      const g = ctx.createRadialGradient(fp.x, fp.y, 2, fp.x, fp.y, fp.r);
      g.addColorStop(0, '#ffff00');
      g.addColorStop(0.35, '#ff5722');
      g.addColorStop(0.8, '#d84315');
      g.addColorStop(1, 'transparent');
      ctx.fillStyle = g;
      ctx.beginPath();
      ctx.ellipse(fp.x, fp.y, fp.r, fp.r * 0.55, 0, 0, Math.PI * 2);
      ctx.fill();

      // Charred crust cracks
      ctx.strokeStyle = '#21110b';
      ctx.lineWidth = 1.6;
      ctx.beginPath();
      ctx.moveTo(fp.x - fp.r * 0.6, fp.y - 2);
      ctx.lineTo(fp.x + fp.r * 0.5, fp.y + 2);
      ctx.moveTo(fp.x - 2, fp.y - fp.r * 0.3);
      ctx.lineTo(fp.x + 2, fp.y + fp.r * 0.3);
      ctx.stroke();
    } else if (fp.type === 'forest') {
      // Sprouting verdant moss and blooming clover
      ctx.fillStyle = 'rgba(46, 125, 50, ' + (0.7 * a) + ')';
      ctx.beginPath();
      ctx.ellipse(fp.x, fp.y, fp.r, fp.r * 0.5, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = '#69f0ae';
      for (let p = -1; p <= 1; p += 2) {
        ctx.beginPath();
        ctx.arc(fp.x + p * (fp.r * 0.45), fp.y + (p * 2), 2.5, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.fillStyle = '#ffeb3b';
      ctx.fillRect(fp.x - 1, fp.y - 1, 2, 2);
    } else if (fp.type === 'ice') {
      // Permafrost shattered ice crystals
      ctx.fillStyle = 'rgba(128, 216, 255, ' + (0.55 * a) + ')';
      ctx.beginPath();
      ctx.ellipse(fp.x, fp.y, fp.r, fp.r * 0.5, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(fp.x - fp.r * 0.7, fp.y);
      ctx.lineTo(fp.x + fp.r * 0.7, fp.y);
      ctx.moveTo(fp.x, fp.y - fp.r * 0.35);
      ctx.lineTo(fp.x, fp.y + fp.r * 0.35);
      ctx.moveTo(fp.x - fp.r * 0.4, fp.y - fp.r * 0.25);
      ctx.lineTo(fp.x + fp.r * 0.4, fp.y + fp.r * 0.25);
