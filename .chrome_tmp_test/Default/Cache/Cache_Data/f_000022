  if (heat > 0) {
    const heatMul = 1 + (heat * 0.35);
    amt = Math.round(amt * heatMul);
  }
  const m = loadMeta();
  m.crystals = (m.crystals || 0) + amt;
  saveMeta(m);
  runCrystals = (runCrystals || 0) + amt;
  if (x != null) {
    if (heat > 0) {
      spawnFloatText(x, y, '+' + amt + '  ( Isı ' + heat + ')', '#ffd700');
    } else {
      spawnFloatText(x, y, '+' + amt + ' ', '#c9a0ff');
