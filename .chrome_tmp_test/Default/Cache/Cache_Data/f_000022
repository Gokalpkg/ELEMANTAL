function drawWeatherAtmosphere(ctx, biome, cam) {
  if (!biome) return;
  const bKey = biome.key || 'forest';
  let isSnow = bKey === 'ice';
  let isCinder = bKey === 'lava';
  let isSand = bKey === 'sand';
  if (!isSnow && !isCinder && !isSand) return;

  ctx.save();
  for (let i = 0; i < weatherParticles.length; i++) {
    const p = weatherParticles[i];
    p.x += p.vx;
    p.y += isCinder ? -p.vy : p.vy;
    if (p.y > H + 20) p.y = -20;
    if (p.y < -20) p.y = H + 20;
    if (p.x > W + 20) p.x = -20;
    if (p.x < -20) p.x = W + 20;

    ctx.globalAlpha = p.alpha;
    ctx.fillStyle = isSnow ? '#e0f2fe' : isCinder ? '#ff5722' : '#fde047';
    ctx.fillRect(Math.round(p.x), Math.round(p.y), p.size, p.size);
  }
  ctx.restore();
}

// --- 11. 2D RADYAL IŞIK MOTORU (2D LIGHTING) ---
function drawRadialTorchLight(ctx, player) {
  if (!player || !running) return;
  
  // Day-Night Cycle: 180 seconds full cycle (10800 ticks)
  let cycle = (time % 10800) / 10800;
  let nightAlpha = 0;
  if (cycle > 0.4 && cycle <= 0.5) {
    nightAlpha = (cycle - 0.4) / 0.1 * 0.7; // Dusk transition
  } else if (cycle > 0.5 && cycle <= 0.85) {
    nightAlpha = 0.7; // Deep night
  } else if (cycle > 0.85 && cycle <= 0.95) {
    nightAlpha = (1.0 - (cycle - 0.85) / 0.1) * 0.7; // Dawn transition
  }

  if (nightAlpha > 0) {
    ctx.save();
    // 1. Draw Darkness
    ctx.fillStyle = `rgba(5, 5, 20, ${nightAlpha})`;
    ctx.fillRect(0, 0, W, H);

    // 2. Punch hole for Torch Light
    const sx = toSX(player.x), sy = toSY(player.y);
    ctx.globalCompositeOperation = 'destination-out';
    const grad = ctx.createRadialGradient(sx, sy, 40, sx, sy, 250);
    grad.addColorStop(0, `rgba(0, 0, 0, ${nightAlpha})`);
    grad.addColorStop(1, 'rgba(0, 0, 0, 0)');
    ctx.fillStyle = grad;
    ctx.beginPath();
    ctx.arc(sx, sy, 250, 0, Math.PI * 2);
    ctx.fill();

    // 3. Add Warm Glow
    ctx.globalCompositeOperation = 'lighter';
    const glow = ctx.createRadialGradient(sx, sy, 20, sx, sy, 180);
    glow.addColorStop(0, `rgba(255, 180, 50, ${nightAlpha * 0.4})`);
    glow.addColorStop(1, 'rgba(255, 180, 50, 0)');
    ctx.fillStyle = glow;
    ctx.beginPath();
    ctx.arc(sx, sy, 180, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();
  } else {
    // Normal minimal glow if day
    const sx = toSX(player.x), sy = toSY(player.y);
    if (sx < -100 || sx > W + 100 || sy < -100 || sy > H + 100) return;
    ctx.save();
    const grad = ctx.createRadialGradient(sx, sy, 35, sx, sy, 220);
    grad.addColorStop(0, 'rgba(255, 235, 180, 0.12)');
    grad.addColorStop(0.6, 'rgba(255, 200, 100, 0.04)');
    grad.addColorStop(1, 'rgba(0, 0, 0, 0)');
    ctx.fillStyle = grad;
    ctx.fillRect(sx - 240, sy - 240, 480, 480);
    ctx.restore();
  }
}

// --- 12. GÖRSEL ZIRH & SİLAH EVRİMİ (VISUAL EVOLUTION) ---
function drawHeroVisualEvolution(ctx, player, time) {
  if (!player) return;
  const sx = player.x, sy = player.y;
  ctx.save();
  // Level 5+: Pauldron Shoulder Guards
  if (player.level >= 5) {
    ctx.fillStyle = player.color || '#38bdf8';
    ctx.globalAlpha = 0.75 + Math.sin(time * 0.1) * 0.2;
    ctx.fillRect(sx - 16, sy - 18, 5, 5);
    ctx.fillRect(sx + 11, sy - 18, 5, 5);
  }
  // Level 10+: Ethereal Elemental Wings
  if (player.level >= 10) {
    const wingSpread = Math.sin(time * 0.15) * 4;
    ctx.strokeStyle = player.color || '#ffd700';
    ctx.lineWidth = 2.2;
    ctx.globalAlpha = 0.65;
    ctx.beginPath();
    ctx.moveTo(sx - 4, sy - 12);
    ctx.quadraticCurveTo(sx - 24 - wingSpread, sy - 28, sx - 32, sy - 8);
    ctx.moveTo(sx + 4, sy - 12);
    ctx.quadraticCurveTo(sx + 24 + wingSpread, sy - 28, sx + 32, sy - 8);
    ctx.stroke();
  }
  ctx.restore();
}

