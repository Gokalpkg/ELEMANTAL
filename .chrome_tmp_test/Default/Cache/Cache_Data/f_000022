function renderHeroThumbnail(cvs, heroId, t) {
  if (!cvs) return;
  const ctx = cvs.getContext('2d');
  if (!ctx) return;
  const w = cvs.width || 82;
  const h = cvs.height || 82;
  ctx.clearRect(0, 0, w, h);

  const hero = HERO_ROSTER[heroId] || HERO_ROSTER.bamsi;
  const px = w / 2;
  const py = h / 2 + 10;
  const cy = py - 8;
  const time = t != null ? t : (performance.now() * 0.0035);

  ctx.save();
  // Ambient radial glow behind character
  const auraG = ctx.createRadialGradient(px, py - 4, 4, px, py - 4, 38);
  auraG.addColorStop(0, hero.color + '44');
  auraG.addColorStop(0.7, hero.color + '12');
  auraG.addColorStop(1, 'transparent');
  ctx.fillStyle = auraG;
  ctx.beginPath();
  ctx.arc(px, py - 4, 38, 0, Math.PI * 2);
  ctx.fill();

  // Platform ring at character feet
  ctx.strokeStyle = hero.color + '77';
  ctx.lineWidth = 1.5;
  ctx.beginPath();
  ctx.ellipse(px, py + 12, 20, 7, 0, 0, Math.PI * 2);
  ctx.stroke();

  // Scale up for high-res crisp portrait
  ctx.translate(px, py);
  ctx.scale(1.35, 1.35);
  ctx.translate(-px, -py);

  const dummyPlayer = {
    r: 16,
    heroId: heroId,
    hp: hero.hp,
    maxHp: hero.hp,
    speed: hero.speed,
    moving: false,
    facing: -Math.PI / 2, // facing forward
    state: (typeof PLAYER_STATE !== 'undefined' ? PLAYER_STATE.IDLE : 'idle'),
    atkSlashFx: 0
  };

  const dummySkin = { hex: hero.color };
  if (typeof drawHeroPlayer === 'function') {
    drawHeroPlayer(ctx, px, py, cy, dummyPlayer, time, dummySkin, 0);
  }
  ctx.restore();
}

