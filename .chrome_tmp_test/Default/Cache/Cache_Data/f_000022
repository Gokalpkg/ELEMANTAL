function triggerPhase2ArenaMetamorphosis(boss, biome) {
  if (!boss) return;
  const bk = boss.bossType || (biome && biome.key) || 'stone';
  // DYNAMIC ARENA CENTER: Anchored directly around the boss fight, NEVER offscreen!
  const cx = boss.arenaCx || boss.x;
  const cy = boss.arenaCy || boss.y;
  const arenaR = 300;

  // 1. Glowing Jagged Floor Fissures Directly Radiating Beneath the Boss
  window.arenaFissures = [];
  const fissureCount = 16;
  const fCol = (bk === 'lava' || bk === 'stone') ? '#ff3d00' :
               bk === 'ice' ? '#00e5ff' :
               bk === 'storm' ? '#facc15' :
               bk === 'forest' ? '#22c55e' :
               bk === 'sand' ? '#ffd700' :
               bk === 'water' ? '#00b0ff' :
               bk === 'pink' ? '#ff4081' :
               bk === 'night' ? '#c084fc' : '#ff1744';

  for (let f = 0; f < fissureCount; f++) {
    const fAng = (f * Math.PI * 2 / fissureCount) + (Math.random() - 0.5) * 0.3;
    const fLen = 140 + Math.random() * 160;
    const pts = [{ x: cx, y: cy }];
    const segs = 5;
    let curX = cx, curY = cy;
    for (let s = 1; s <= segs; s++) {
      const segLen = fLen / segs;
      const jagAng = fAng + (Math.random() - 0.5) * 0.48;
      curX += Math.cos(jagAng) * segLen;
      curY += Math.sin(jagAng) * segLen;
      pts.push({ x: curX, y: curY });
    }
    window.arenaFissures.push({ pts, color: fCol, width: 2.6 + Math.random() * 1.5 });
  }

  // 2. Shrinking Arena Perimeter Hazard Death Ring (16 visible danger hazards enclosing the fight)
  const ringHazards = 16;
  const hType = (bk === 'lava' || bk === 'stone') ? 'lava' :
                bk === 'ice' ? 'ice' :
                bk === 'storm' ? 'water' :
                bk === 'forest' ? 'bramble' :
                bk === 'sand' ? 'sand' :
                bk === 'ketchup' ? 'ketchup' :
                bk === 'pink' ? 'caramel' :
                bk === 'night' ? 'grav_well' : 'lava';

  for (let rIdx = 0; rIdx < ringHazards; rIdx++) {
    const rAng = (rIdx * Math.PI * 2 / ringHazards);
    const hx = cx + Math.cos(rAng) * arenaR;
    const hy = cy + Math.sin(rAng) * arenaR;
    hazards.push({
      x: hx, y: hy, r: 42,
      type: hType,
      isArenaRing: true,
      until: performance.now() + 60000 // Lasts throughout Phase 2 battle!
    });
    burst(hx, hy, fCol, 12, 3.0);
  }

  // 3. Biome-Specific Signature Arena Cataclysm Hazards
  if (bk === 'stone') {
    // Falling Earthquake Boulders
    for (let k = 0; k < 4; k++) {
      const bAng = k * (Math.PI / 2) + 0.3;
      const bx = cx + Math.cos(bAng) * 140;
      const by = cy + Math.sin(bAng) * 140;
      bossTelegraphs.push({
        kind: 'reticle', x: bx, y: by, r: 48, duration: 45, t: 0, color: '#8d6e63',
        onTrigger: (bt) => {
          burst(bt.x, bt.y, '#8d6e63', 20, 3.8);
          burst(bt.x, bt.y, '#ffd700', 10, 2.2);
          shake = Math.max(shake, 14);
          playSfx('explode', 0.35, 160);
          if (Math.hypot(player.x - bt.x, player.y - bt.y) < bt.r + player.r) damagePlayer(14);
        }
      });
    }
  } else if (bk === 'lava') {
    // Erupting Magma Geysers
    for (let k = 0; k < 4; k++) {
      const ga = k * (Math.PI / 2);
      const gx = cx + Math.cos(ga) * 125;
      const gy = cy + Math.sin(ga) * 125;
      hazards.push({ x: gx, y: gy, r: 36, type: 'lava', until: performance.now() + 20000 });
      burst(gx, gy, '#ff3d00', 14, 3.0);
    }
  } else if (bk === 'water') {
    // 4 Swirling Maelstrom Whirlpools
    for (let k = 0; k < 4; k++) {
      const wa = k * (Math.PI / 2) + 0.4;
      const wx = cx + Math.cos(wa) * 135;
      const wy = cy + Math.sin(wa) * 135;
      hazards.push({ x: wx, y: wy, r: 40, type: 'water', until: performance.now() + 25000 });
      burst(wx, wy, '#00b0ff', 12, 2.8);
    }
  } else if (bk === 'forest') {
    // Thorny Bramble Cross
    for (let k = -2; k <= 2; k++) {
      if (k === 0) continue;
      hazards.push({ x: cx + k * 65, y: cy, r: 28, type: 'bramble', until: performance.now() + 22000 });
      hazards.push({ x: cx, y: cy + k * 65, r: 28, type: 'bramble', until: performance.now() + 22000 });
    }
  } else if (bk === 'ice') {
    // Flash-Frozen Ice Arena
    for (let k = 0; k < 5; k++) {
      const ix = cx + (Math.random() - 0.5) * 230;
      const iy = cy + (Math.random() - 0.5) * 230;
      hazards.push({ x: ix, y: iy, r: 40, type: 'ice', until: performance.now() + 25000 });
      burst(ix, iy, '#00e5ff', 10, 2.5);
    }
  } else if (bk === 'storm') {
    // Overloaded Lightning Strikes
    for (let k = 0; k < 4; k++) {
      const sa = k * (Math.PI / 2) + 0.35;
      const sx = cx + Math.cos(sa) * 150;
      const sy = cy + Math.sin(sa) * 150;
      if (typeof addBolt === 'function') addBolt(sx, sy - 240, sx, sy, '#facc15', 0.5, 4.0);
      burst(sx, sy, '#facc15', 14, 3.2);
    }
  } else if (bk === 'sand') {
    // Quicksand Sinking Pools
    for (let k = 0; k < 4; k++) {
      const sa = k * (Math.PI / 2) + 0.5;
      const sx = cx + Math.cos(sa) * 135;
      const sy = cy + Math.sin(sa) * 135;
      hazards.push({ x: sx, y: sy, r: 38, type: 'sand', until: performance.now() + 22000 });
      burst(sx, sy, '#ffd700', 10, 2.4);
    }
  } else if (bk === 'night') {
    // Cosmic Void Gravity Wells
    for (let k = 0; k < 3; k++) {
      const na = k * (Math.PI * 2 / 3);
      const nx = cx + Math.cos(na) * 130;
      const ny = cy + Math.sin(na) * 130;
      hazards.push({ x: nx, y: ny, r: 40, type: 'grav_well', until: performance.now() + 22000 });
      burst(nx, ny, '#c084fc', 14, 3.2);
    }
  } else if (bk === 'pink') {
    // Sticky Caramel Zones
    for (let k = 0; k < 4; k++) {
      const pa = k * (Math.PI / 2);
      const px = cx + Math.cos(pa) * 130;
      const py = cy + Math.sin(pa) * 130;
      hazards.push({ x: px, y: py, r: 38, type: 'caramel', until: performance.now() + 22000 });
      burst(px, py, '#ff4081', 12, 2.5);
    }
  } else if (bk === 'ketchup') {
    // Boiling Condiment Geysers
    for (let k = 0; k < 4; k++) {
      const ka = k * (Math.PI / 2) + 0.25;
      const kx = cx + Math.cos(ka) * 130;
      const ky = cy + Math.sin(ka) * 130;
      hazards.push({ x: kx, y: ky, r: 38, type: 'ketchup', until: performance.now() + 22000 });
      burst(kx, ky, '#ff1744', 12, 2.5);
    }
  }
}

function triggerPhase2Cataclysm(en, bk) {
  if (!player || player.hp <= 0) return;
  const col = (bk === 'lava' || bk === 'stone') ? '#ff3d00' :
              bk === 'ice' ? '#00e5ff' :
              bk === 'storm' ? '#facc15' :
              bk === 'forest' ? '#22c55e' :
              bk === 'sand' ? '#ffd700' :
              bk === 'water' ? '#00b0ff' :
              bk === 'pink' ? '#ff4081' :
              bk === 'night' ? '#c084fc' : '#ff1744';

  const count = 3;
  for (let k = 0; k < count; k++) {
    const strikeOffsetAng = Math.random() * Math.PI * 2;
    const strikeDist = 20 + Math.random() * 85;
    const sx = player.x + Math.cos(strikeOffsetAng) * strikeDist;
    const sy = player.y + Math.sin(strikeOffsetAng) * strikeDist;
    const delay = 36 + k * 10;

    bossTelegraphs.push({
      kind: 'circle',
      x: sx, y: sy, r: 36,
      duration: delay, t: 0,
      color: col,
      onTrigger: (bt) => {
        shake = Math.max(shake, 12);
        playSfx('explode', 0.35, 180);
        burst(bt.x, bt.y, col, 18, 3.8);
        burst(bt.x, bt.y, '#ffffff', 10, 2.4);

        if (bk === 'storm') {
          if (typeof addBolt === 'function') addBolt(bt.x, bt.y - 280, bt.x, bt.y, '#fef08a', 0.32, 3.5);
          if (typeof synthBlip === 'function') synthBlip('elem_storm');
        } else if (bk === 'lava' || bk === 'stone') {
          if (typeof synthBlip === 'function') synthBlip('elem_fire');
          hazards.push({ x: bt.x, y: bt.y, r: 24, type: 'lava', until: performance.now() + 3200 });
        } else if (bk === 'ice') {
          if (typeof synthBlip === 'function') synthBlip('elem_water');
          hazards.push({ x: bt.x, y: bt.y, r: 28, type: 'ice', until: performance.now() + 4500 });
        }

        // STEP 8: Environmental chemistry integration with boss cataclysms
        if (typeof triggerEnvChemistry === 'function') {
          const catElem = (bk === 'storm') ? 'storm' : (bk === 'lava' || bk === 'stone') ? 'fire' : (bk === 'ice' || bk === 'water') ? 'water' : (bk === 'forest') ? 'nature' : 'earth';
          triggerEnvChemistry(bt.x, bt.y, catElem, bt.r + 14, 1.25);
        }

        if (Math.hypot(player.x - bt.x, player.y - bt.y) < bt.r + player.r - 4) {
          damagePlayer(en.phase2 ? 14 : 10);
          player.vx += Math.cos(strikeOffsetAng) * 2.5;
          player.vy += Math.sin(strikeOffsetAng) * 2.5;
        }
      }
    });
  }
  playSfx('skill', 0.25, 220);
}

function updateBossAi(en, dt, player, biome, now) {
  const bk = en.bossType || (biome && biome.key) || 'stone';

  // STEP 7: PHASE 2 PERIODIC ARENA ENVIRONMENTAL CATACLYSM
  if (en.phase2 || en.raged || (en.hp / en.maxHp <= 0.5)) {
    en.phase2CataclysmTimer = (en.phase2CataclysmTimer || 180) - dt;
    if (en.phase2CataclysmTimer <= 0) {
      en.phase2CataclysmTimer = 220 + Math.random() * 60; // Every 3.5-4.5s
      triggerPhase2Cataclysm(en, bk);
    }
  }

  // STRICT BOSS FSM: 'move' | 'telegraph' | 'attack' | 'recovery'
  en.fsmState = en.fsmState || 'move';

  // ZERO VELOCITY LOCK: Boss feet are completely pinned to ground during telegraph, attack, and recovery!
  if (en.fsmState !== 'move') {
    en.vx = 0;
    en.vy = 0;
    en.moving = false;

    if (en.fsmState === 'staggered') {
      en.vx = 0;
      en.vy = 0;
      en.moving = false;
      en.squashScale = 0.72; // Kneeling
      en.staggerTimer -= dt * (1 / 60);
      if (Math.random() < 0.3) {
        burst(en.x + (Math.random() - 0.5) * en.r, en.y + (Math.random() - 0.5) * en.r, '#facc15', 2, 1.2);
      }
      if (en.staggerTimer <= 0) {
        en.fsmState = 'move';
        en.squashScale = 1.0;
        en.specialCd = 1.6;
        burst(en.x, en.y, '#ffffff', 14, 3.0);
        spawnFloatText(en.x, en.y - 30, 'Toparlandı!', '#94a3b8');
      }
      return;
    }

    if (en.fsmState === 'telegraph') {
      en.fsmTimer = (en.fsmTimer || 0) - dt;
      // Weapon charging particles
      if (Math.random() < 0.4) {
        const cAng = Math.random() * Math.PI * 2;
        const cDist = en.r + 16;
        particles.push({
          x: en.x + Math.cos(cAng) * cDist,
          y: en.y + Math.sin(cAng) * cDist,
          vx: -Math.cos(cAng) * 2.2,
          vy: -Math.sin(cAng) * 2.2,
          r: 3, maxR: 1, life: 0.35, color: '#ff3d00', lw: 2
        });
      }
      if (en.fsmTimer <= 0) {
        en.fsmState = 'attack';
        en.fsmTimer = 0.35;
        if (typeof en.onAttackImpact === 'function') {
          en.onAttackImpact();
          en.onAttackImpact = null;
        }
      }
      return;
    } else if (en.fsmState === 'attack') {
      en.fsmTimer = (en.fsmTimer || 0) - dt;
      if (en.fsmTimer <= 0) {
        en.fsmState = 'recovery';
        en.fsmTimer = 0.35;
      }
      return;
    } else if (en.fsmState === 'recovery') {
      en.fsmTimer = (en.fsmTimer || 0) - dt;
      if (en.fsmTimer <= 0) {
        en.fsmState = 'move';
        en.specialCd = en.phase2 ? 2.4 : 3.6;
      }
      return;
    }
  }
  const slowed = en.slowUntil && now < en.slowUntil;
  const timeSlow = timeDodgeTimer > 0 ? 0.45 : 1.0;
  const spd = en.speed * (slowed ? en.slowFactor : 1) * timeSlow;
  let dist = Math.hypot(player.x - en.x, player.y - en.y) || 1;
  if (dist > 720) {
    const bAng = Math.atan2(player.y - en.y, player.x - en.x);
    en.x = player.x - Math.cos(bAng) * 380;
    en.y = player.y - Math.sin(bAng) * 380;
    burst(en.x, en.y, '#ffd700', 16, 3);
    softClamp(en);
    dist = Math.hypot(player.x - en.x, player.y - en.y) || 1;
  }

  // Posture decay when player plays passively
  if (en.posture > 0 && performance.now() - (en.lastHitTime || 0) > 3500) {
    en.posture = Math.max(0, en.posture - dt * 25);
  }

  // 1. Guaranteed Master Phase 2 Transition Check
  const layersGone = !en.layers || en.layers.length === 0;
  if (!en.phase2 && (layersGone || en.hp <= en.maxHp * 0.5)) {
    triggerBossPhase2Transition(en, biome);
  }

  // 2. Dash Movement (Used by Lava, Pink, Ketchup)
  if (en.dashT > 0) {
    en.dashT -= dt;
    tryMove(en, en.dashVx * dt, en.dashVy * dt);
    if (Math.random() < 0.35) {
      if (bk === 'lava') {
        hazards.push({ x: en.x, y: en.y, r: 24, type: 'lava', until: performance.now() + 4000 });
        burst(en.x, en.y, '#ff5722', 4, 1.8);
      } else if (bk === 'sand') {
        hazards.push({ x: en.x, y: en.y, r: 22, type: 'sand', until: performance.now() + 3500 });
        burst(en.x, en.y, '#ffd54f', 4, 1.5);
      }
    }
    if (Math.hypot(player.x - en.x, player.y - en.y) < en.r + player.r) {
      damagePlayer(en.phase2 ? 12 : 9);
      if (bk === 'lava') player.burnUntil = performance.now() + 2500;
      shake = Math.max(shake, 12);
      camKick = Math.max(camKick, 8);
      en.dashT = 0;
    }
    softClamp(en);
    return;
  }

  // 3. Burrow Movement (Used by Sand Boss Akrep Kral)
  if (en.burrowT > 0) {
    en.burrowT -= dt;
    en.invulnerable = true;
    const bAng = Math.atan2(player.y - en.y, player.x - en.x);
    const bSpd = 3.8;
    tryMove(en, Math.cos(bAng) * bSpd * dt, Math.sin(bAng) * bSpd * dt);
    if (Math.random() < 0.4) {
      burst(en.x, en.y, '#ffd54f', 3, 1.2);
    }
    if (en.burrowT <= 0) {
      en.invulnerable = false;
      burst(en.x, en.y, '#ffb300', 25, 4.2);
      shake = Math.max(shake, 14);
      particles.push({ x: en.x, y: en.y, r: 8, maxR: 70, life: 1, color: '#ffb300', lw: 4 });
      if (Math.hypot(player.x - en.x, player.y - en.y) < 70 + player.r) {
        damagePlayer(en.phase2 ? 11 : 8);
        player.slowUntil = performance.now() + 1800;
      }
      playSfx('explode', 0.28, 260);
    }
    softClamp(en);
    return;
  }

  // 4. ARCHETYPE-SPECIFIC BOSS MOVEMENT & ORGANIC KINEMATICS
  let moveDx = 0, moveDy = 0;
  const bAng = Math.atan2(player.y - en.y, player.x - en.x);
  const distToPlayer = Math.hypot(player.x - en.x, player.y - en.y) || 1;
  const isWindingUp = (en.specialCd != null && en.specialCd <= 22 && en.specialCd > 0);

  if (isWindingUp) {
    // Attack Wind-Up Anticipation: Boss anchors/braces in place charging energy
    en.squashScale = (en.squashScale || 1.0) * 0.95 + 0.88 * 0.05;
    moveDx = (Math.random() - 0.5) * 0.6;
    moveDy = (Math.random() - 0.5) * 0.6;
    tryMove(en, moveDx, moveDy);
  } else if (bk === 'water') {
    // 1. LEVIATHAN: Serpentine Undulating Sinusoidal Wave & Multi-Segment Trailing Spine
    en.swimPhase = (en.swimPhase || 0) + (spd * dt * 0.075);
    const undulateAngle = Math.sin(en.swimPhase) * 0.62;
    const finalSwimAngle = bAng + undulateAngle;
    const swimSpd = spd * 1.18;
    moveDx = Math.cos(finalSwimAngle) * swimSpd * dt;
    moveDy = Math.sin(finalSwimAngle) * swimSpd * dt;
    tryMove(en, moveDx, moveDy);

    // 8-Segment Trailing Serpent Spine with Inverse Kinematics
    en.segments = en.segments || [];
    if (en.segments.length === 0) {
      for (let s = 0; s < 8; s++) {
        en.segments.push({
          x: en.x - Math.cos(bAng) * (s * 18),
          y: en.y - Math.sin(bAng) * (s * 18),
          angle: bAng,
          r: Math.max(10, Math.round(en.r * (0.9 - s * 0.08)))
        });
      }
    }
    let prevX = en.x, prevY = en.y;
    const segSpacing = 18;
    for (let s = 0; s < en.segments.length; s++) {
      const seg = en.segments[s];
      const sdx = prevX - seg.x;
      const sdy = prevY - seg.y;
      const targetAngle = Math.atan2(sdy, sdx);
      seg.angle = targetAngle;
      seg.x = prevX - Math.cos(targetAngle) * segSpacing;
      seg.y = prevY - Math.sin(targetAngle) * segSpacing;
      prevX = seg.x;
      prevY = seg.y;
    }
    if (Math.random() < 0.38) {
      particles.push({
        x: en.x - Math.cos(finalSwimAngle) * (en.r * 0.8) + (Math.random() - 0.5) * 16,
        y: en.y - Math.sin(finalSwimAngle) * (en.r * 0.8) + (Math.random() - 0.5) * 16,
        r: 3, maxR: 16, life: 0.45, color: '#e0f7fa', lw: 1.6
      });
    }
  } else if (bk === 'stone') {
    // 2. KADİM TAŞ TİTANI: Heavy 2-Beat Tectonic Gait with Weight-Shift Surges
    en.stepClock = (en.stepClock || 0) + dt * 0.05;
    const cycle = en.stepClock % 1.0;
    const isSurge = cycle > 0.38;
    const stepMul = isSurge ? 1.55 : 0.28;
    moveDx = Math.cos(bAng) * spd * stepMul * dt;
    moveDy = Math.sin(bAng) * spd * stepMul * dt;
    tryMove(en, moveDx, moveDy);
  } else if (bk === 'pink') {
    // 3. ŞEKER PRENSESİ: Graceful Floating Ballet & Tactical Standoff Orbit
    en.hoverAngle = (en.hoverAngle || 0) + dt * 0.035;
    const idealDist = 190;
    let radialSpd = 0;
    if (distToPlayer < idealDist - 35) radialSpd = -spd * 0.85;
    else if (distToPlayer > idealDist + 50) radialSpd = spd * 0.85;
    const strafeSpd = Math.sin(en.hoverAngle * 2) * (spd * 0.95);
    moveDx = (Math.cos(bAng) * radialSpd - Math.sin(bAng) * strafeSpd) * dt;
    moveDy = (Math.sin(bAng) * radialSpd + Math.cos(bAng) * strafeSpd) * dt;
    tryMove(en, moveDx, moveDy);
  } else if (bk === 'storm') {
    // 4. YILDIRIM TİTANİ RAİJİN: Erratic Static Levitation & Zig-Zag Electric Arcs
    en.arcTimer = (en.arcTimer || 0) + dt;
    en.arcJitter = en.arcJitter || 0;
    if (en.arcTimer > 26) {
      en.arcTimer = 0;
      en.arcJitter = (Math.random() - 0.5) * 1.15;
      sparks.push({ x: en.x, y: en.y, vx: (Math.random() - 0.5) * 5, vy: (Math.random() - 0.5) * 5, color: '#00e5ff', r: 3, life: 0.35, glow: true });
    }
    const stormAng = bAng + en.arcJitter;
    moveDx = Math.cos(stormAng) * spd * 1.12 * dt;
    moveDy = Math.sin(stormAng) * spd * 1.12 * dt;
    tryMove(en, moveDx, moveDy);
  } else if (bk === 'night') {
    // 5. KARANLIK KONTU ARCHON: Swooping Bat Arcs & Shadow Phantom Trail
    en.swoopPhase = (en.swoopPhase || 0) + dt * 0.045;
    const swoopOffset = Math.sin(en.swoopPhase) * 0.58;
    const archonAng = bAng + swoopOffset;
    moveDx = Math.cos(archonAng) * spd * 1.15 * dt;
    moveDy = Math.sin(archonAng) * spd * 1.15 * dt;
    tryMove(en, moveDx, moveDy);
    if (Math.random() < 0.32) {
      particles.push({ x: en.x + (Math.random()-0.5)*14, y: en.y + (Math.random()-0.5)*14, r: 4, maxR: 18, life: 0.45, color: '#4a148c', lw: 2 });
    }
  } else if (bk === 'ketchup') {
    // 6. KETÇAP İMPARATORU: Gelatinous Squash-Stretch Bouncing
    en.bounceTimer = (en.bounceTimer || 0) + dt * 0.14;
    const bouncePhase = Math.sin(en.bounceTimer);
    const bounceSpd = bouncePhase > 0 ? spd * 1.48 : spd * 0.42;
    en.squashScale = 1.0 + bouncePhase * 0.22;
    moveDx = Math.cos(bAng) * bounceSpd * dt;
    moveDy = Math.sin(bAng) * bounceSpd * dt;
    tryMove(en, moveDx, moveDy);
  } else {
    // 7. Standard Predatory Stride (Lava, Ice Yeti, Forest Treant, Sand)
    moveDx = Math.cos(bAng) * spd * dt;
    moveDy = Math.sin(bAng) * spd * dt;
    tryMove(en, moveDx, moveDy);
  }

  const movedDist = Math.hypot(moveDx, moveDy);
  const oldWalkTimer = en.walkTimer || 0;
  en.walkTimer = oldWalkTimer + (spd * dt * 0.18);

  // Initialize Boss Ground Collections
  en.eruptingRocks = en.eruptingRocks || [];
  en.footprints = en.footprints || [];

  // Update existing erupting rock crags
  en.eruptingRocks.forEach(rk => {
    if (rk.currH < rk.maxH) {
      rk.currH = Math.min(rk.maxH, rk.currH + rk.growth * dt);
      if (Math.random() < 0.28) {
        burst(rk.x, rk.y - rk.currH * 0.5, rk.col, 2, 1.2);
      }
    } else {
      rk.life -= rk.decay * dt;
    }
  });
  en.eruptingRocks = en.eruptingRocks.filter(rk => rk.life > 0);

  // Update existing footprints
  en.footprints.forEach(fp => { fp.life -= 0.016 * dt; });
  en.footprints = en.footprints.filter(fp => fp.life > 0);

  // A. STONE TITAN: Dinamik Tektonik Zemin Basamakları & Rünik Granit Yarığı Sistemi!
  if (bk === 'stone') {
    en.treadStones = en.treadStones || [];
    // Mevcut basamak taşlarını güncelle ve eskidikçe arkada ufalanmasını sağla
    for (let k = en.treadStones.length - 1; k >= 0; k--) {
      const ts = en.treadStones[k];
      if (ts.rise < 1.0) ts.rise = Math.min(1.0, ts.rise + 0.1 * dt);
      ts.life -= 0.015 * dt;
      const dFromBoss = Math.hypot(ts.wx - en.x, ts.wy - (en.y + en.r * 0.36));
      if (ts.life <= 0 || dFromBoss > en.r * 1.5) {
        burst(ts.wx, ts.wy, '#455a64', 3, 1.2);
        en.treadStones.splice(k, 1);
      }
    }

    if (movedDist > 0.04) {
      en.treadSpawnDist = (en.treadSpawnDist || 0) + movedDist;
      if (en.treadSpawnDist >= 8) {
        en.treadSpawnDist = 0;
        // Bossun ilerlediği yönde önden çıkan yeni anakaya levhaları
        const hAng = bAng;
        const leadDist = en.r * (0.65 + Math.random() * 0.45);
        const flankSpread = (Math.random() - 0.5) * (en.r * 0.85);
        const sx = en.x + Math.cos(hAng) * leadDist - Math.sin(hAng) * flankSpread;
        const sy = en.y + Math.sin(hAng) * (leadDist * 0.45) + en.r * 0.36 + Math.cos(hAng) * flankSpread * 0.25;

        en.treadStones.push({
          wx: sx,
          wy: sy,
          w: 16 + Math.random() * 12,
          h: 9 + Math.random() * 6,
          rot: (Math.random() - 0.5) * 0.3,
          life: 1.0,
          rise: 0.15,
          col: Math.random() < 0.5 ? '#37474f' : '#263238',
          lightCol: '#607d8b',
          darkCol: '#1a2327',
          rune: Math.random() < 0.38
        });
        burst(sx, sy, '#546e7a', 2, 1.2);
      }

      en.rockSpawnDist = (en.rockSpawnDist || 0) + movedDist;
      if (en.rockSpawnDist >= 12) {
        en.rockSpawnDist = 0;
        // Yan flanşlarda yükselen rünlü granit monolitler (Taş Diyar paletiyle tam ahenk içinde)
        [-1, 1].forEach(side => {
          const sideAng = bAng + (side * Math.PI / 2) + (Math.random() - 0.5) * 0.35;
          const flankDist = en.r * (0.85 + Math.random() * 0.45);
          const rx = en.x + Math.cos(sideAng) * flankDist;
          const ry = en.y + Math.sin(sideAng) * flankDist;
          const maxH = 18 + Math.random() * 26;
          en.eruptingRocks.push({
            x: rx,
            y: ry,
            w: 14 + Math.random() * 12,
            maxH: maxH,
            currH: 0,
            growth: 4.5 + Math.random() * 2.5,
            rot: (Math.random() - 0.5) * 0.28,
