    setTimeout(() => {
      if (player && player.hp > 0 && lockedCombos.length < 3) {
        playSfx('level', 0.5);
        triggerScreenFlash('#ffd740', 0.45, 220);
        showLevelUp();
      }
    }, 350);
  } else if (en.isElite) {
    gainCrystals(1, en.x, en.y - 16);
    spawnCrystal(en.x, en.y, 1);
    spawnGroundOrb(en.x, en.y);
    spawnXpGems(en.x, en.y, 4, 12);
    /* elit yazısı yok */
