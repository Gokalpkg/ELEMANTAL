    ctx.fill();
    ctx.lineWidth = 2.4;
    ctx.strokeStyle = ringColor;
    ctx.globalAlpha = 0.55;
    ctx.stroke();

    // 2. Directional vector connection line
    const jvx = (typeof joyVec !== 'undefined' && joyVec) ? joyVec.x : 0;
    const jvy = (typeof joyVec !== 'undefined' && joyVec) ? joyVec.y : 0;
    const kx = Math.round(joyAnchor.x + jvx * 40);
    const ky = Math.round(joyAnchor.y + jvy * 40);
    if (Math.hypot(kx - ax, ky - ay) > 4) {
      ctx.beginPath();
      ctx.moveTo(ax, ay);
      ctx.lineTo(kx, ky);
      ctx.strokeStyle = ringColor;
      ctx.lineWidth = 2.0;
      ctx.globalAlpha = 0.35;
      ctx.stroke();
    }

    // 3. Layered ergonomic thumb knob
    ctx.globalAlpha = 0.90;
    ctx.beginPath();
    ctx.arc(kx, ky, 14, 0, Math.PI * 2);
    ctx.fillStyle = 'rgba(30, 41, 59, 0.92)';
    ctx.fill();
    ctx.lineWidth = 2.2;
    ctx.strokeStyle = '#ffffff';
    ctx.stroke();

    // Center core jewel
    ctx.beginPath();
    ctx.arc(kx, ky, 5.5, 0, Math.PI * 2);
    ctx.fillStyle = ringColor;
    ctx.fill();

    ctx.restore();
  }
  ctx.setTransform(1, 0, 0, 1, 0, 0);
}

