    if (!o) return;
    const px = Math.max(o.x, Math.min(ent.x, o.x + o.w));
    const py = Math.max(o.y, Math.min(ent.y, o.y + o.h));
    let dx = ent.x - px, dy = ent.y - py;
    const pad = ent.r + 2.2;
    if (dx === 0 && dy === 0) {
