  recordEcho(echoShot);
  echoShot = false;
  updateEcho(dt);
  for (let i = weaveFires.length - 1; i >= 0; i--) {
    weaveFires[i].life -= dt * 0.028;
    if (weaveFires[i].life <= 0) weaveFires.splice(i, 1);
  }
  // Vampire Survivors tarzı: Hareket ederken DE ateş eder, durunca daha hızlı ateş açar
  fireTimer -= dt;
  if (fireTimer <= 0 && enemies.length) {
    firePlayerProjectile();
    const as = 1 - Math.min(0.24, flow * 0.0024);
    const overchargeMod = modLv('overcharge') ? 0.75 : 1.0;
    // Koşarken 1.0x, durunca odaklanmış seri ateş (0.82x)
    const moveMul = moving ? 1.0 : 0.82;
    let iv = currentAuto().interval * as * moveMul * overchargeMod;
    if (runFlags().bloodPact || (player && player.cursed === 'bloodPact')) iv *= 0.6;
    if (typeof activeFusionClass === 'function' && activeFusionClass() === 'steam' && steamBand() === 'over') iv *= 0.7;
    fireTimer = iv;
  }
  updateCam(dt);
  const sh = modValue('shield');
  if (sh && sh.cd) {
    shieldTimer += dt;
    if (shieldOn <= 0 && shieldTimer >= sh.cd * 60) { shieldOn = sh.dur * 60; shieldTimer = 0; vibrate('light'); }
  }
  const rk = modValue('rock');
  if (rk && rk.cd) {
    rockTimer += dt;
    if (shieldOn <= 0 && rockTimer >= rk.cd * 60) { shieldOn = rk.dur * 60; rockTimer = 0; vibrate('light'); }
  }
  if (shieldOn > 0) shieldOn -= dt;
  if (player.invuln > 0) player.invuln = Math.max(0, player.invuln - dt);
  if (mirrorCd > 0) mirrorCd -= dt;
  if (timeDodgeTimer > 0) timeDodgeTimer -= dt;
  if (modLv('tesla') && enemies.length > 0) {
    teslaTimer += dt;
    let threshold = (player && player._evolvedPerks && player._evolvedPerks['tesla']) ? 60 : 180; // 1s vs 3s
    if (teslaTimer >= threshold) { 
      teslaTimer = 0;
      let targetCount = (player && player._evolvedPerks && player._evolvedPerks['tesla']) ? 6 : 3;
      const sortedEn = enemies.slice().sort((a,b) => Math.hypot(a.x-player.x, a.y-player.y) - Math.hypot(b.x-player.x, b.y-player.y)).slice(0, targetCount);
      sortedEn.forEach(en => {
        let range = (player && player._evolvedPerks && player._evolvedPerks['tesla']) ? 400 : 250;
        if (Math.hypot(en.x - player.x, en.y - player.y) <= range) {
          addBolt(player.x, player.y - 12, en.x, en.y, '#ffd700', 0.6, 5);
          burst(en.x, en.y, '#ffd700', 10, 2.5);
          let dmg = (player && player._evolvedPerks && player._evolvedPerks['tesla']) ? 80 : 40;
          const tDmg = takeDamage(en, dmg, 'storm');
          punchEnemy(en, player.x, player.y, 10, true);
          applyEffect(en, 'shock', 1.5);
          spawnFloatText(en.x, en.y - 16, '-' + tDmg, '#ffd700', 'crit');
        }
      });
      playSfx('skill', 0.32, 620);
      vibrate([25, 30, 25]);
      pruneDeadEnemies();
    }
  }
  const rg = (modLv('bloodPact') ? 0 : ((modValue('regen') || 0) * synMul('regen', 0.5)));
  if (rg) {
    regenTick += dt;
    if (regenTick >= 60) {
      regenTick = 0;
      const before = player.hp;
      player.hp = Math.min(player.maxHp, player.hp + rg);
      if (player.hp > before) updateHud();
    }
  }
  Object.keys(elemFatigue).forEach(k => {
    elemFatigue[k] = Math.max(0, (elemFatigue[k] || 0) - 0.055 * dt);
  });
  if (splitFlow > 1) splitFlow = Math.max(1, splitFlow - 0.0008 * dt);
  if (time % 18 < dt) updateSplitHud();
  hazards.forEach(h => {
    const isElectrified = h.electrifiedUntil && performance.now() < h.electrifiedUntil;
    const maxHRad = (h.r || 30) + 22;
    const hRadSq = maxHRad * maxHRad;
    for (let ei = 0; ei < enemies.length; ei++) {
      const en = enemies[ei];
      const edx = h.x - en.x;
      if (edx > maxHRad || edx < -maxHRad) continue;
      const edy = h.y - en.y;
      if (edy > maxHRad || edy < -maxHRad) continue;
      if (edx * edx + edy * edy < hRadSq) {
        if (h.type === 'ice') {
          en.onIce = true;
          en.vx = (en.vx || 0) * 1.04;
          en.vy = (en.vy || 0) * 1.04;
        }
        if (h.type === 'water') {
          en.slowUntil = Math.max(en.slowUntil||0, performance.now() + 500);
          en.slowFactor = 0.5;
          en.wetUntil = Math.max(en.wetUntil||0, performance.now() + 1200);
          if (isElectrified && (time % 14 < 1)) {
            const ezap = takeDamage(en, Math.round(9 + wave * 1.2), 'storm', { quiet: true });
            spawnFloatText(en.x, en.y - 10, ' -' + ezap, '#facc15', 'small');
            applyEffect(en, 'shock', 1.0);
            burst(en.x, en.y, '#fde047', 4, 1.8);
          }
        }
      }
    }
    const maxHR = (h.r || 30) - 4;
    const hdx = h.x - player.x, hdy = h.y - player.y;
    if (Math.abs(hdx) < maxHR && Math.abs(hdy) < maxHR && (hdx * hdx + hdy * hdy < maxHR * maxHR)) {
      if (h.isArenaRing) {
        const cb = enemies && enemies.find(e => e.type === 'boss');
        const acx = (cb && (cb.arenaCx || cb.x)) || W / 2;
        const acy = (cb && (cb.arenaCy || cb.y)) || H / 2;
        const toCenterAng = Math.atan2(acy - player.y, acx - player.x);
        player.vx += Math.cos(toCenterAng) * 4.2;
        player.vy += Math.sin(toCenterAng) * 4.2;
        if (player.invuln <= 0 && shieldOn <= 0) {
          damagePlayer(3);
          spawnFloatText(player.x, player.y - 24, ' ARENA ÇEPERİ!', '#ff1744', 'small');
          shake = Math.max(shake, 6.0);
          vibrate(30);
        }
      }
      if (h.type === 'lava' && player.invuln <= 0 && shieldOn <= 0) damagePlayer(2);
      if (h.type === 'water') { player.vx *= 0.92; player.vy *= 0.92; }
      if (h.type === 'sand') { player.vx *= 0.84; player.vy *= 0.84; }
      if (h.type === 'ice') { player.vx *= 0.985; player.vy *= 0.985; }
      if (h.type === 'caramel') { player.vx *= 0.68; player.vy *= 0.68; }
      if (h.type === 'ketchup') { player.vx *= 1.12; player.vy *= 1.12; if (Math.random() < 0.25) burst(player.x, player.y, '#e53935', 2, 1); }
      if (h.type === 'bramble') { player.vx *= 0.78; player.vy *= 0.78; if (Math.random() < 0.05 && player.invuln <= 0 && shieldOn <= 0) damagePlayer(1); }
      if (h.type === 'grav_well') {
        player.slowUntil = Math.max(player.slowUntil || 0, performance.now() + 300);
        player.vx *= 0.75; player.vy *= 0.75;
        const gdx = h.x - player.x, gdy = h.y - player.y;
        const gd = Math.hypot(gdx, gdy) || 1;
        tryMove(player, (gdx / gd) * 0.95 * dt, (gdy / gd) * 0.95 * dt);
        if (Math.random() < 0.2) burst(player.x, player.y, '#c084fc', 2, 1.2);
      }
    }
  });
  if (currentBiome().key === 'forest') {
    forestTick += dt;
    if (forestTick >= 100) {
      forestTick = 0;
      const grove = hazards.some(h => h.type === 'forest' && Math.abs(h.x-player.x) < h.r && Math.abs(h.y-player.y) < h.r && ((h.x-player.x)**2 + (h.y-player.y)**2 < h.r * h.r));
      const pHeal = grove ? 1 : 0;
      const before = player.hp;
      player.hp = Math.min(player.maxHp, player.hp + pHeal);
      if (player.hp > before) spawnFloatText(player.x, player.y-18, '+'+pHeal, '#3ddc84');
      updateHud();
    }
  }
  if (!streakOn && running && lastHurtAt && performance.now() - lastHurtAt >= 8000) {
    streakOn = true;
    spawnFloatText(player.x, player.y - 30, 'Seri', '#ffd740');
    playSfx('confirm', 0.2, 400);
    updateHud();
  }
  if (shake > 0) shake *= Math.pow(0.86, dt);

  trapTick += dt;
  const bk = currentBiome().key;
  if (bk === 'lava' && trapTick > 340) {
    trapTick = 0;
    let hx = randWorldX(80), hy = randWorldY(80);
    if (Math.hypot(hx-player.x, hy-player.y) < 90) {
      hx = clampWorldX(player.x + (Math.random() < 0.5 ? 140 : -140), 40);
      hy = clampWorldY(player.y + (Math.random() < 0.5 ? 90 : -90), 40);
    }
    particles.push({ x:hx, y:hy, r:8, maxR:48, life:1, color:'#ff6b4a' });
    burst(hx, hy, '#ff6b4a', 12, 2.8);
    if (Math.hypot(hx-player.x, hy-player.y) < 46 && player.invuln <= 0) damagePlayer(4);
    enemies.forEach(en => { if (Math.hypot(en.x-hx, en.y-hy) < 52) { takeDamage(en, 6, 'fire', { quiet: true }); applyEffect(en, 'burn', 0.7); } });
    pruneDeadEnemies();
  }
  if (bk === 'storm' && trapTick > 320) {
    trapTick = 0;
    let hx = randWorldX(60), hy = randWorldY(60);
    if (Math.hypot(hx-player.x, hy-player.y) < 80) {
      hx = player.x + (Math.random() < 0.5 ? 120 : -120);
    }
    addBolt(hx, hy - 90, hx + (Math.random()-0.5)*20, hy, '#f4d03f', 0.5, 5);
    burst(hx, hy, '#fff3a0', 8, 2.2);
    if (Math.hypot(hx-player.x, hy-player.y) < 34 && player.invuln <= 0) damagePlayer(5);
    enemies.forEach(en => { if (Math.hypot(en.x-hx, en.y-hy) < 40) { takeDamage(en, 7, 'storm', { quiet: true }); applyEffect(en, 'shock', 0.8); } });
    pruneDeadEnemies();
  }
  // Environmental Hazards tick
  if (_envHazards) {
    for (let hi = _envHazards.length - 1; hi >= 0; hi--) {
      const hz = _envHazards[hi];
      hz.life -= dt;
      if (hz.life <= 0) { _envHazards.splice(hi, 1); continue; }
      const inRange = (ox, oy) => Math.hypot(ox - hz.x, oy - hz.y) < hz.r;
      if (inRange(player.x, player.y) && Math.random() < 0.03) {
        player.hp -= 2;
        if (player.hp <= 0) player.hp = 1; // Don't kill from hazard alone
        spawnFloatText(player.x, player.y - 15, '-2', '#f87171', 'dot');
      }
      enemies.forEach(e => {
        if (!e._dead && inRange(e.x, e.y) && Math.random() < 0.04) {
          takeDamage(e, 5 + wave, hz.type === 'forest' ? 'nature' : hz.type === 'lava' ? 'fire' : hz.type === 'ice' ? 'ice' : 'storm', { quiet: true, noReact: true });
        }
      });
    }
  }

  if (elemStains.length > 0) {
    const nowS = performance.now();
    for (let i = elemStains.length - 1; i >= 0; i--) {
      const s = elemStains[i];
      s.life -= dt;
      const sr = s.r || 36;
      for (let j = 0; j < enemies.length; j++) {
        const en = enemies[j];
        if (!en || en.hp <= 0) continue;
        const maxDist = sr + en.r;
        const dx = en.x - s.x;
        if (dx > maxDist || dx < -maxDist) continue;
        const dy = en.y - s.y;
        if (dy > maxDist || dy < -maxDist) continue;
        if (dx * dx + dy * dy > maxDist * maxDist) continue;
        if (s.kind === 'fire') { en.burnUntil = Math.max(en.burnUntil || 0, nowS + 900); en.burnTick = en.burnTick || 0; }
        else if (s.kind === 'water') { en.slowUntil = Math.max(en.slowUntil || 0, nowS + 700); en.slowFactor = 0.5; en.wetUntil = Math.max(en.wetUntil || 0, nowS + 700); }
        else if (s.kind === 'nature') { en.rootUntil = Math.max(en.rootUntil || 0, nowS + 600); en.slowUntil = Math.max(en.slowUntil || 0, nowS + 600); en.slowFactor = 0.4; }
      }
      if (s.life <= 0) elemStains.splice(i, 1);
    }
  }

  // Çevresel Piksel Kırıntıların Güncellenmesi & Oynanış Etkileşimleri
  if (envDebris && envDebris.length) {
    const nowD = performance.now();
    for (let k = 0; k < enemies.length; k++) {
      if (enemies[k]) enemies[k]._onObsidian = false;
    }
    for (let i = envDebris.length - 1; i >= 0; i--) {
      const d = envDebris[i];
      d.life -= dt;
      if (d.life <= 0) { envDebris.splice(i, 1); continue; }

      // Yalnızca oynanış etkisi olan zemin kırıntıları düşmanları etkiler
      if (!d.hasGameplay) continue;

      d.tickTimer = (d.tickTimer || 0) + dt;
      const canTick = d.tickTimer >= 15; // her 15 tickte bir tetiklenir
      if (canTick) d.tickTimer = 0;

      if (d.kind === 'steam_cloud' && player) {
        if (Math.hypot(player.x - d.x, player.y - d.y) < d.r + (player.r || 14)) {
          player.speedBoostUntil = Math.max(player.speedBoostUntil || 0, nowD + 400);
        }
      }

      if (!canTick && d.kind !== 'water_puddle') continue;
      const maxReach = (d.r || 30) + 24;
      const reachRSq = maxReach * maxReach;
      for (let j = 0; j < enemies.length; j++) {
        const en = enemies[j];
        if (!en || en.hp <= 0) continue;
        const ddx = en.x - d.x;
        if (ddx > maxReach || ddx < -maxReach) continue;
        const ddy = en.y - d.y;
        if (ddy > maxReach || ddy < -maxReach) continue;
        const distSq = ddx * ddx + ddy * ddy;
        const maxDist = (d.r || 30) + (en.r || 12);
        if (distSq > maxDist * maxDist) continue;
        const dist = Math.sqrt(distSq);

        if (d.kind === 'lava_pool' && canTick) {
          // Lav göleti: sürekli yakar ve hasar verir
          const dmg = takeDamage(en, d.dmg || 4, 'fire', { quiet: true });
          applyEffect(en, 'burn', 1.2);
          if (Math.random() < 0.2) burst(en.x, en.y, '#ff6b35', 3, 1.2);
        } else if (d.kind === 'water_puddle') {
          // Su birikintisi: düşmanı belirgin şekilde yavaşlatır
          en.slowUntil = Math.max(en.slowUntil || 0, nowD + 600);
          en.slowFactor = d.slowMul || 0.55;
          en.wetUntil = Math.max(en.wetUntil || 0, nowD + 600);
        } else if (d.kind === 'ground_thorns' && canTick) {
          // Yerden çıkan sivri dikenler: hasar verir ve kökler
          const dmg = takeDamage(en, d.dmg || 5, 'nature', { quiet: true });
          applyEffect(en, 'root', 0.9);
          if (Math.random() < 0.25) burst(en.x, en.y, '#22c55e', 4, 1.5);
        } else if (d.kind === 'rock_spike' && canTick) {
          // Kaya çıkıntısı: sersemletir/tökezletir
          en.stunUntil = Math.max(en.stunUntil || 0, nowD + (d.stunMs || 650));
          if (Math.random() < 0.2) burst(en.x, en.y, '#a8a29e', 3, 1.2);
        } else if (d.kind === 'static_field' && canTick) {
          // Statik şimşek: şok hasarı ve zayıflatma
          const dmg = takeDamage(en, d.dmg || 3, 'storm', { quiet: true });
          applyEffect(en, 'shock', 0.8);
          if (Math.random() < 0.3) burst(en.x, en.y, '#fde047', 3, 1.4);
        } else if (d.kind === 'abyss_rift') {
          // Hiçlik yarığı: girdap gibi içine çeker
          const pull = (d.pullStr || 1.8) * 0.4;
          const ang = Math.atan2(d.y - en.y, d.x - en.x);
          en.x += Math.cos(ang) * pull;
          en.y += Math.sin(ang) * pull;
          en.slowUntil = Math.max(en.slowUntil || 0, nowD + 400);
          en.slowFactor = 0.65;
        } else if (d.kind === 'plasma_trench' && canTick) {
          // Plazma siperi: yüksek akkor enerji hasarı
          const dmg = takeDamage(en, d.dmg || 5, 'storm', { quiet: true });
          applyEffect(en, 'shock', 1.0);
          if (Math.random() < 0.25) burst(en.x, en.y, '#6366f1', 4, 1.8);
        } else if (d.kind === 'mud_quagmire') {
          // Çamur bataklığı: düşmanı aşırı derecede yavaşlatır (%65 yavaşlatma)
          en.slowUntil = Math.max(en.slowUntil || 0, nowD + 600);
          en.slowFactor = d.slowMul || 0.35;
        } else if (d.kind === 'spore_cloud' && canTick) {
          // Zehirli polen: zehir hasarı ve hafif kök
          const dmg = takeDamage(en, d.dmg || 3, 'nature', { quiet: true });
          applyEffect(en, 'poison', 1.4);
          if (Math.random() < 0.2) burst(en.x, en.y, '#84cc16', 3, 1.2);
        } else if (d.kind === 'frost_sheet') {
          // Donmuş buz: sersemletir veya ağır yavaşlatır
          en.stunUntil = Math.max(en.stunUntil || 0, nowD + (d.stunMs || 800));
          en.slowUntil = Math.max(en.slowUntil || 0, nowD + 800);
          en.slowFactor = d.slowMul || 0.45;
        } else if (d.kind === 'gravity_crater') {
          // Yerçekimi krateri: güçlü çekim ve periyodik ezilme
          const pull = (d.pullStr || 2.4) * 0.5;
          const ang = Math.atan2(d.y - en.y, d.x - en.x);
          en.x += Math.cos(ang) * pull;
          en.y += Math.sin(ang) * pull;
          if (canTick) {
            takeDamage(en, d.dmg || 4, 'earth', { quiet: true });
            if (Math.random() < 0.25) burst(en.x, en.y, '#a855f7', 3, 1.4);
          }
        } else if (d.kind === 'electrified_pool' && canTick) {
          // STEP 7: İletken Elektrikli Gölet (Yüksek şok ve felç)
          takeDamage(en, d.dmg || (8 + Math.floor(wave * 0.7)), 'storm', { quiet: true });
          applyEffect(en, 'shock', 1.8);
          en.stunUntil = Math.max(en.stunUntil || 0, nowD + 420);
          if (Math.random() < 0.4) {
            sparks.push({ x: en.x, y: en.y, vx: (Math.random() - 0.5) * 5, vy: (Math.random() - 0.5) * 5, r: 2.5, life: 0.25, maxLife: 0.25, color: '#38bdf8', rot: 0, vr: 0 });
          }
        } else if (d.kind === 'obsidian_crust') {
          // STEP 7: Kırılgan Obsidyen Zemin (Taşlaşma & +%60 Kırılma hasarı zafiyeti)
          en._onObsidian = true;
          en.stunUntil = Math.max(en.stunUntil || 0, nowD + 1200);
          en.slowUntil = Math.max(en.slowUntil || 0, nowD + 1200);
          en.slowFactor = 0.1;
        } else if (d.kind === 'steam_cloud') {
          // STEP 7: Kaynar Buhar Sisi (Düşmanı körleştirir & periyodik haşlar)
          en.slowUntil = Math.max(en.slowUntil || 0, nowD + 500);
          en.slowFactor = 0.55;
          if (canTick) {
            takeDamage(en, d.dmg || 5, 'water', { quiet: true });
            if (Math.random() < 0.3) puff(en.x, en.y, '#e2e8f0', 2);
          }
        }
      }
    }
  }

  if (altar && !altar.done) {
    const ad = Math.hypot(player.x - altar.x, player.y - altar.y);
    if (ad < altar.r && !player.moving) {
      altar.charge += dt;
      if (altar.charge >= 480) {
        altar.done = true;
        altarAggro = true;
        const roll = Math.random();
        if (roll < 0.5) { playerBuff = { as: 26, until: performance.now() + 10000 }; spawnFloatText(player.x, player.y-28, 'Sunak: atış', '#ffd740'); }
        else { shieldOn = Math.max(shieldOn, 160); spawnFloatText(player.x, player.y-28, 'Sunak: kalkan', '#ffd740'); }
        burst(altar.x, altar.y, '#f5c542', 16, 3);
        playSfx('heal', 0.3);
      }
    } else altar.charge = Math.max(0, altar.charge - dt * 1.6);
  }

  if (runGhost && runGhost.life > 0) {
    runGhost.life -= dt;
    if (!runGhost.fired && runGhost.life < 90 && enemies.length) {
      runGhost.fired = true;
      const t = nearestEnemyInRange(280) || enemies[0];
      if (t) {
        const ang = Math.atan2(t.y - runGhost.y, t.x - runGhost.x);
        playerProjectiles.push({
          x: runGhost.x, y: runGhost.y, vx: Math.cos(ang)*8, vy: Math.sin(ang)*8,
          r: 7, dmg: 8, color: runGhost.color || '#a8c0ff', effects: [], hit: new Set(),
          ox: runGhost.x, oy: runGhost.y, maxDist: 240
        });
        burst(runGhost.x, runGhost.y, runGhost.color || '#a8c0ff', 8, 2);
      }
    }
  }

  // breathLeft legacy timer kaldırıldı — sadece breathOverlay

  lockedCombos.forEach((combo, i) => {
    let st = skillState[i];
    if (!st) skillState[i] = st = { charge: combo.cd || 260, ready: true };
    if (!st.ready) {
      st.charge += dt * skillCdMul();
      if (st.charge >= combo.cd) { st.charge = combo.cd; st.ready = true; playSfx('confirm', 0.16, 500); }
    }
  });
  refreshSkillUI();

  ambient.forEach(p => {
    p.y -= p.sp * dt * 0.35;
    if (p.y < originY - 8) { p.y = originY + MAP_H + 8; p.x = originX + Math.random()*MAP_W; }
  });

  // Sürekli Gelen Canavar Desteği (Vampire Survivors Swarm)
  // Dalga 1 ve 2'de ekstra sürü gelmez; oyuncu sakin giriş yapar. Dalga 3+'da ölçülü takviye gelir.
  if (wave >= 3 && running && !paused && !menuOpen && enemies.length < 22 && player.hp > 0) {
    swarmTimer = (swarmTimer || 0) + dt;
    const swarmInterval = wave <= 5 ? 130 : 90; // 2-3 saniyede bir sakin takviye
    if (swarmTimer >= swarmInterval) {
      swarmTimer = 0;
      const spawnCount = wave <= 5 ? 2 : 3;
      for (let s = 0; s < spawnCount; s++) {
        if (enemies.length >= 26) break;
        const sp = spawnAroundPlayer();
        const rRoll = Math.random();
        let sType = 'swarmer';
        if (wave >= 5 && rRoll < 0.12) sType = 'marksman';
        else if (wave >= 6 && rRoll < 0.22) sType = 'bearer';
        else if (wave >= 4 && rRoll < 0.40) sType = 'fast';
        else if (wave >= 3 && rRoll < 0.65) sType = 'slime';
        makeEnemy(sp, sType);
      }
    }
  }

  for (let i=particles.length-1;i>=0;i--) {
    const pt = particles[i];
    pt.r += (pt.maxR-pt.r) * 0.2 * dt;
    pt.life -= 0.035*dt;
    if (pt.life <= 0) particles.splice(i,1);
  }
  if (particles.length > 45) particles.splice(0, particles.length - 45);
  for (let i=sparks.length-1;i>=0;i--) {
    const s = sparks[i];
    s.x += s.vx*dt; s.y += s.vy*dt; s.vy += 0.11*dt; s.life -= 0.05*dt;
    if (s.rot != null) s.rot += (s.vr||0)*dt;
    if (s.life <= 0) sparks.splice(i,1);
  }
  if (sparks.length > 50) sparks.splice(0, sparks.length - 50);
  const nowMark = performance.now();
  for (let i = groundMarks.length - 1; i >= 0; i--) {
    if (groundMarks[i].until < nowMark) groundMarks.splice(i, 1);
  }
  for (let i = hazards.length - 1; i >= 0; i--) {
    if (hazards[i].until && hazards[i].until < nowMark) hazards.splice(i, 1);
  }
  if (hazards.length > 24) hazards.splice(0, hazards.length - 24);
  for (let i=corpses.length-1;i>=0;i--) {
    corpses[i].life -= 0.007*dt;
    if (corpses[i].life <= 0) corpses.splice(i,1);
  }
  if (corpses.length > 35) corpses.splice(0, corpses.length - 35);
  if (bolts) {
    for (let i=bolts.length-1;i>=0;i--) {
      bolts[i].life -= dt * 0.055;
      if (bolts[i].life <= 0) bolts.splice(i,1);
    }
  }

  if (zones.length > 12) zones.splice(0, zones.length - 12);
  for (let i=zones.length-1;i>=0;i--) {
    const z = zones[i];
    if (z.follow) { z.x = player.x; z.y = player.y; }
    z.life -= dt;
    z.tick -= dt;
    if (z.tick <= 0) {
      z.tick = z.tickMax;
      const zr = z.r;
      for (let j = 0; j < enemies.length; j++) {
        const en = enemies[j];
        if (!en || en.hp <= 0) continue;
        const maxDist = zr + en.r;
        const dx = en.x - z.x;
        if (dx > maxDist || dx < -maxDist) continue;
        const dy = en.y - z.y;
        if (dy > maxDist || dy < -maxDist) continue;
        if (dx * dx + dy * dy < maxDist * maxDist) {
          const dealtZ = takeDamage(en, z.dmg, z.el, { quiet: true });
          spawnFloatText(en.x, en.y-8, '-'+dealtZ, z.color);
          if (z.effect) applyEffect(en, z.effect, z.type === 'wrap' ? 1.1 : 0.75);
          if (z.effects) applyAllEffects(en, z.effects, 0.8);
        }
      }
      pruneDeadEnemies();
    }
    if (z.life <= 0) {
      if ((z.type === 'vortex' || z.ashHorizon) && hasGraft('ashHorizon')) ashStartVeil();
      zones.splice(i,1);
    }
  }

  for (let i=playerProjectiles.length-1;i>=0;i--) {
    const p = playerProjectiles[i];
    // FRUSTUM & VIEWPORT CULLING (Cull offscreen projectiles >90px outside view)
    if (typeof cam !== 'undefined' && (p.x < cam.x - 90 || p.x > cam.x + W + 90 || p.y < cam.y - 90 || p.y > cam.y + H + 90)) {
      playerProjectiles.splice(i, 1);
      continue;
    }
    if (p.home) {
      let best = null, bestDSq = 1e18;
      const maxRange = (p.maxDist || AUTO_X) + 40;
      const maxRangeSq = maxRange * maxRange;
      for (let j = 0; j < enemies.length; j++) {
        const en = enemies[j];
        if (!en || en.hp <= 0) continue;
        if (p.hit && p.hit.has(en)) continue;
        const dx = en.x - p.x;
        if (dx > maxRange || dx < -maxRange) continue;
        const dy = en.y - p.y;
        if (dy > maxRange || dy < -maxRange) continue;
        const dSq = dx * dx + dy * dy;
        if (dSq < bestDSq) { bestDSq = dSq; best = en; }
      }
      if (best && bestDSq < maxRangeSq) {
        const ang = Math.atan2(best.y - p.y, best.x - p.x);
        const spd = Math.hypot(p.vx, p.vy) || 7;
        const turn = 0.16;
        p.vx += (Math.cos(ang) * spd - p.vx) * turn;
        p.vy += (Math.sin(ang) * spd - p.vy) * turn;
        const n = Math.hypot(p.vx, p.vy) || 1;
        p.vx = p.vx / n * spd;
        p.vy = p.vy / n * spd;
      }
    }
    // Kullanıcı İsteği: Attığımız auto attack düşmana gitmeden düşman ölürse sonraki düşmana yönelmesin, yok olsun!
    if (p.targetEn && (p.targetEn.hp <= 0 || !enemies.includes(p.targetEn))) {
      burst(p.x, p.y, p.color, 4, 1.2);
      playerProjectiles.splice(i, 1);
      continue;
    }
    const wo = windAt(p.x, p.y);
    p.x += (p.vx + wo.x * 1.6)*dt; p.y += (p.vy + wo.y * 1.6)*dt;
    p.chemTimer = (p.chemTimer || 0) + 1;
    if (p.chemTimer % 4 === 0) {
      triggerEnvChemistry(p.x, p.y, p.el, (p.r || 8) + 12);
    }
    if (shotTooFar(p, p.maxDist || 360)) {
      // BUMERANG YÖRÜNGESİ (Orbit Boomerang) — Menzil sonunda oyuncuya dönerek tekrar vurur (Lv8: %50 hasar)
      if (player && player.mods && player.mods.orbitBoomerang && !p._returning) {
        p._returning = true;
        p.hit = new Set();
        const bDmgMul = (player.mods.orbitBoomerang / 8) * 0.50;
        p.dmg = Math.max(1, Math.round(p.dmg * bDmgMul));
        const bAng = Math.atan2(player.y - p.y, player.x - p.x);
        const bSpd = Math.max(6.5, Math.hypot(p.vx, p.vy) * 1.15);
        p.vx = Math.cos(bAng) * bSpd;
        p.vy = Math.sin(bAng) * bSpd;
        p.maxDist = 99999;
        p.ox = p.x;
        p.oy = p.y;
        continue;
      }
      playerProjectiles.splice(i,1); continue;
    }
    if (p._returning && Math.hypot(p.x - player.x, p.y - player.y) < (player.r || 18) + 8) {
      burst(p.x, p.y, p.color, 4, 1.4);
      playerProjectiles.splice(i, 1);
      continue;
    }
    if (Math.random() < 0.28 && p.el === 'fire') sparks.push({ x:p.x, y:p.y, vx:(p.vx||0)*-0.08, vy:(p.vy||0)*-0.08, life:0.22, maxLife:0.22, color:p.color, r:2 });
    const o = circleHitsObs(p.x,p.y,p.r);
    if (outOfWorld(p.x, p.y, 24) || o) {
      if (o) { hurtBreakable(o, p.dmg); burst(p.x, p.y, p.color, 4, 1.4); }
      playerProjectiles.splice(i,1); continue;
    }
    for (let j=enemies.length-1;j>=0;j--) {
      const en = enemies[j];
      if (p.hit && p.hit.has(en)) continue;
      const maxR = p.r + en.r;
      const dx = p.x - en.x;
      if (dx > maxR || dx < -maxR) continue;
      const dy = p.y - en.y;
      if (dy > maxR || dy < -maxR) continue;
      if (dx * dx + dy * dy < maxR * maxR) {
        triggerEnvChemistry(p.x, p.y, p.el, 36);
        let dealt = p.dmg;
        let crited = false;
        if (Math.random() * 100 < critChancePct()) {
          dealt = Math.round(dealt * CRIT_MUL);
          crited = true;
        }
        const amb = p.ambushMul || 1;
        if (amb > 1) {
          dealt = Math.round(dealt * amb);
          crited = true;
        } else if ((elemStains || []).some(s => s.kind === 'fire' && Math.hypot(s.x - player.x, s.y - player.y) < (s.r || 70)) && !en._ashMistHit) {
          dealt = Math.round(dealt * 1.55);
          en._ashMistHit = true;
        }
        addSteam(3);
        const execBand = runFlags().execBand || 0.35;
        if (typeof activeFusionClass === 'function' && activeFusionClass() === 'shadow' && en.hp / (en.maxHp || 1) <= execBand) {
          dealt = Math.round(dealt * 1.40);
        }
        dealt = takeDamage(en, dealt, p.el);
        classOnAutoHit(en, dealt);
        if (runFlags().waterSheet) spawnElemStain(en.x, en.y, 36, 'water', 90);
        punchEnemy(en, p.x, p.y, crited ? 18 : 10, crited);
        playPunchySubBass(crited ? 75 : 55, 0.14, crited ? 0.45 : 0.28);
        onPlayerHitEnemy(en, { crit: crited, el: p.el, heavy: p.el === 'earth' || p.el === 'fire' });
        en.flashT = (en.type === 'boss') ? 3 : 0;
        // Sade, temiz temas kıvılcımı (2 nokta)
        sparks.push({
          x: p.x, y: p.y,
          vx: (Math.random() - 0.5) * 1.2, vy: (Math.random() - 0.5) * 1.2,
          r: 2.0, life: 0.14, maxLife: 0.14,
          color: p.color || '#ffffff'
        });
        // Position damage text cleanly: For bosses, offset to shoulder so face/body is NEVER obscured!
        const floatTx = en.type === 'boss' ? (en.x + en.r * 0.72) : en.x;
        const floatTy = en.type === 'boss' ? (en.y - en.r - 20) : (en.y - 12);
        // KARAÇOR %300 GÖLGE İNFAZI
        if ((player.heroId === 'karacor' || selectedHeroId === 'karacor') && en._shadowMarked && performance.now() < (en._shadowMarkUntil || 0)) {
          en._shadowMarked = false;
          dealt = Math.round(dealt * 3.0);
          crited = true;
          spawnFloatText(en.x, en.y - 24, ' İNFAZ! -' + dealt, '#a855f7', 'big');
          playSfx('skill', 0.5, 420);
          player.dashCd = Math.round((player.dashCd || 0) * 0.5); // %50 Dash CD iadesi
          burst(en.x, en.y, '#c084fc', 8, 2.5);
        }
        if (crited) {
          spawnFloatText(floatTx, floatTy, dealt + '!', '#ffd700', 'crit');
          playSfx('skill', 0.28, 680);
        } else {
          const elemCol = p.el === 'fire' ? '#ff5722' :
                          (p.el === 'ice' || p.el === 'water') ? '#38bdf8' :
                          (p.el === 'storm' || p.el === 'volt') ? '#facc15' :
                          (p.el === 'nature' || p.el === 'poison') ? '#4ade80' :
                          p.el === 'earth' ? '#f59e0b' :
                          p.el === 'void' ? '#c084fc' : (p.color || '#f1f5f9');
          spawnFloatText(floatTx, floatTy, '-' + dealt, elemCol);
        }
        (p.effects||[]).forEach(ef => applyEffect(en, ef, 1));
        if (pierceCount() && synN('pierce')) applyEffect(en, 'slow', 0.62);
        if (modValue('ember') && synN('ember')) applyEffect(en, 'burn', 1);
        if (crited && synN('crit')) applyEffect(en, 'shock', 0.85);
        const vp = (modValue('vamp') || 0) * synMul('vamp', 0.5);
        if (vp) {
          const heal = Math.min(1.2, dealt * vp / 100);
          if (heal > 0) { player.hp = Math.min(player.maxHp, player.hp + heal); updateHud(); }
        }
        if ((player.heroId === 'ulgen' || selectedHeroId === 'ulgen') && player._ulgenMode === 'nature') {
          const ulgenHeal = Math.min(3.2, dealt * 0.15);
          if (ulgenHeal > 0) {
            player.hp = Math.min(player.maxHp, player.hp + ulgenHeal);
            updateHud();
            if (Math.random() < 0.25) {
              sparks.push({ x: player.x, y: player.y, vx: 0, vy: -1.2, r: 2.0, life: 0.20, maxLife: 0.20, color: '#4ade80' });
            }
          }
        }
        if (en.type === 'boss') {
          burst(p.x, p.y, p.color, crited ? 10 : 6, crited ? 3.0 : 2.0);
          particles.push({ x: p.x, y: p.y, r: 6, maxR: crited ? 32 : 20, life: 0.7, color: crited ? '#ffd740' : p.color, lw: 2.2 });
        } else {
          // Ufak düşmanlara sade, temiz temas parçacığı (ekranı parlatmaz)
          burst(p.x, p.y, p.color, 4, 1.8);
        }
        if (modLv('leech')) {
          let vampAmt = (player && player._evolvedPerks && player._evolvedPerks['leech']) ? 9 : 3;
          player.hp = Math.min(player.maxHp, player.hp + vampAmt);
          shieldOn = Math.min(80, (shieldOn || 0) + 4);
          updateHud();
        }
        if (modLv('vortexPull') && Math.random() < 0.8) {
          zones.push({ x: en.x, y: en.y, r: 110, life: 90, maxLife: 90, color: '#a855f7', kind: 'pull', pull: 6.5, dmgTick: 0 });
        }
        if (!p.hit) p.hit = new Set();
        p.hit.add(en);
        if (p.ricochet > 0) {
          p.ricochet--;
          const nxt = enemies.find(e => e !== en && !(p.hit && p.hit.has(e)));
          if (nxt) {
            const ang = Math.atan2(nxt.y-p.y, nxt.x-p.x);
            const spd = Math.hypot(p.vx,p.vy) || 7;
            p.vx = Math.cos(ang)*spd; p.vy = Math.sin(ang)*spd;
          } else if (!(p.pierce > 0)) { playerProjectiles.splice(i,1); }
        } else if (p.pierce > 0) {
          p.pierce--;
        } else {
          playerProjectiles.splice(i,1);
        }
        if (en.hp <= 0) killEnemy(j);
        break;
      }
    }
  }

  for (let i=skillShots.length-1;i>=0;i--) {
    const p = skillShots[i];
    const wo = windAt(p.x, p.y);
    p.x += (p.vx + wo.x * 1.4)*dt; p.y += (p.vy + wo.y * 1.4)*dt;
    p.chemTimer = (p.chemTimer || 0) + 1;
    if (p.chemTimer % 4 === 0) {
      triggerEnvChemistry(p.x, p.y, p.el, (p.r || 12) + 16, 1.4);
    }
    if (shotTooFar(p, 200)) {
      skillShots.splice(i,1); continue;
    }
    const hitO = circleHitsObs(p.x,p.y,p.r*0.7);
    if (outOfWorld(p.x, p.y, 48) || hitO) {
      if (hitO) { hurtBreakable(hitO, p.dmg); burst(p.x, p.y, p.color, 6, 1.8); }
      skillShots.splice(i,1); continue;
    }
    for (let j=enemies.length-1;j>=0;j--) {
      const en = enemies[j];
      if (p.hit && p.hit.has(en)) continue;
      const maxR = p.r + en.r;
      const dx = p.x - en.x;
      if (dx > maxR || dx < -maxR) continue;
      const dy = p.y - en.y;
      if (dy > maxR || dy < -maxR) continue;
      if (dx * dx + dy * dy < maxR * maxR) {
        triggerEnvChemistry(p.x, p.y, p.el, (p.r || 16) + 32, 1.5);
        const dealt = takeDamage(en, p.dmg, p.el);
        punchEnemy(en, p.x, p.y, 12, false);
        onPlayerHitEnemy(en, { el: p.el, heavy: p.el === 'earth' || p.el === 'fire' });
        en.flashT = en.type === 'boss' ? 3 : 0;
        const sFloatTx = en.type === 'boss' ? (en.x + en.r * 0.72) : en.x;
        const sFloatTy = en.type === 'boss' ? (en.y - en.r - 20) : (en.y - 12);
        spawnFloatText(sFloatTx, sFloatTy, '-' + dealt, p.color);
        applyAllEffects(en, p.effects || (p.effect ? [p.effect] : []), p.fxPower || 1);
        burst(p.x, p.y, p.color, en.type === 'boss' ? 14 : 5, en.type === 'boss' ? 3.2 : 2.0);
        if (en.type === 'boss') {
          directionalBurst(en.x, en.y, p.x - (p.vx || 1), p.y - (p.vy || 1), p.color, 10, 3.8);
          particles.push({ x: p.x, y: p.y, r: 8, maxR: 52, life: 1, color: p.color, lw: 3.5 });
          particles.push({ x: en.x, y: en.y, r: 12, maxR: 44, life: 0.9, color: '#ffffff', lw: 2 });
          camKick = Math.max(camKick, 6);
          shake = Math.max(shake, 6);
        }
        if (!p.hit) p.hit = new Set();
        p.hit.add(en);
        if (p.bounces > 0) {
          p.bounces--;
          const nxt = enemies.find(e => e !== en) || en;
          const ang = Math.atan2(nxt.y-p.y, nxt.x-p.x);
          const spd = Math.hypot(p.vx,p.vy) || 7;
          p.vx = Math.cos(ang)*spd; p.vy = Math.sin(ang)*spd;
        } else if (!p.pierce) {
          skillShots.splice(i,1);
        }
        if (en.hp <= 0) killEnemy(j);
        break;
      }
    }
  }

  enemies.forEach(en => {
    if (en.burnUntil && now < en.burnUntil) {
      en.burnTick = (en.burnTick || 0) - dt;
      if (en.burnTick <= 0) {
        const burnDmg = Math.max(1, Math.round((en.hitDmgRef || 8) * 0.22 * (en.burnStack || 1) + (modValue('ember') || 0) + synN('ember')));
        takeDamage(en, burnDmg, 'fire', { quiet: true, noReact: true });
        en.burnTick = synN('ember') ? 24 : 30;
        
        // SCOPE 6: DOT Batching (Hasar Birleştirme) - Ekranı temiz tutup tok hasar basar
        en._burnBatch = (en._burnBatch || 0) + burnDmg;
        en._burnBatchTimer = (en._burnBatchTimer || 0) + 1;
        if (en._burnBatchTimer >= 2 || en._burnBatch >= 12) {
          spawnFloatText(en.x, en.y - 10, '-' + en._burnBatch, '#ff8a65', 'dot');
          en._burnBatch = 0;
          en._burnBatchTimer = 0;
        }
        burst(en.x, en.y, '#ff8a65', 3, 1.2);
      }
    }
    if (en.poisonUntil && now < en.poisonUntil) {
      en.poisonTick = (en.poisonTick || 0) - dt;
      if (en.poisonTick <= 0) {
        const poiDmg = Math.max(1, Math.round((en.hitDmgRef || 8) * 0.14 * (en.poisonStack || 1)));
        takeDamage(en, poiDmg, 'nature', { quiet: true, noReact: true });
        en.poisonTick = 45;

        // SCOPE 6: Poison DOT Batching
        en._poiBatch = (en._poiBatch || 0) + poiDmg;
        en._poiBatchTimer = (en._poiBatchTimer || 0) + 1;
        if (en._poiBatchTimer >= 2 || en._poiBatch >= 10) {
          spawnFloatText(en.x, en.y - 8, '-' + en._poiBatch, '#84cc16', 'dot');
          en._poiBatch = 0;
          en._poiBatchTimer = 0;
        }
      }
    }
  });
  pruneDeadEnemies();


  // Step 5: Disruptor Aura Pre-Pass (Zero-allocation fast check)
  let hasDisruptor = false;
  for (let di = 0; di < enemies.length; di++) {
    if (enemies[di].type === 'disruptor' && enemies[di].hp > 0) { hasDisruptor = true; break; }
  }

  enemies.forEach(en => {
    if (en.type === 'boss') {
      updateBossAi(en, dt, player, currentBiome(), now);
      return;
    }
    en.hasDisruptorBuff = false;
    if (en.type !== 'disruptor' && hasDisruptor) {
      for (let di = 0; di < enemies.length; di++) {
        const de = enemies[di];
        if (de.type === 'disruptor' && de.hp > 0) {
          const ddx = de.x - en.x, ddy = de.y - en.y;
          if (ddx * ddx + ddy * ddy < 14400) { // 120^2
            en.hasDisruptorBuff = true;
            break;
          }
        }
      }
    }

    // STAGGER / KNOCKBACK REEL: enemy drifts backward and pathing briefly halts
    if (en.staggerTimer > 0) {
      en.staggerTimer -= dt * (1 / 60);
      if (en.vx || en.vy) {
        tryMove(en, (en.vx || 0) * dt, (en.vy || 0) * dt);
        en.vx = (en.vx || 0) * 0.82;
        en.vy = (en.vy || 0) * 0.82;
        for (let b = 0; b < Math.min(enemies.length, 6); b++) {
          const bump = enemies[b];
          if (bump && bump !== en && bump.type !== 'boss' && bump.hp > 0) {
            const bdx = bump.x - en.x, bdy = bump.y - en.y;
            if (bdx * bdx + bdy * bdy < 380) {
              bump.vx = (bump.vx || 0) + en.vx * 0.22;
              bump.vy = (bump.vy || 0) + en.vy * 0.22;
            }
          }
        }
      }
      return; // Reeling from impact, cannot advance!
    }
    const stunned = (en.stunUntil && now < en.stunUntil) || (en.rootUntil && now < en.rootUntil && en.type !== 'shaman');
    if (stunned) return;
    const slowed = en.slowUntil && now < en.slowUntil;
    const timeSlow = timeDodgeTimer > 0 ? 0.45 : 1.0;
    const heatSpeedMul = (typeof isPactActive === 'function' && isPactActive('bloodSpeed')) ? 1.22 : 1.0;
    const spd = en.speed * (slowed ? en.slowFactor : 1) * timeSlow * heatSpeedMul;
    if (typeof ashCanSee === 'function' && !ashCanSee(en)) {
      en.wanderA = (en.wanderA || Math.random() * Math.PI * 2) + 0.03 * dt;
      tryMove(en, Math.cos(en.wanderA) * spd * 0.32 * dt, Math.sin(en.wanderA) * spd * 0.32 * dt);
      return;
    }
    let dx = player.x - en.x, dy = player.y - en.y;
    let dist = Math.hypot(dx, dy) || 1;
    // --- DÜŞMAN LASTİĞİ (LEASH / RUBBERBANDING) ---
    // Düşman oyuncunun görüş alanından çok uzaklaşırsa (>540px), oyuncunun ekran kenarına (350-420px) taşınır.
    // Oyuncu sonsuza kadar kaçamaz, düşmanlar haritada kaybolup dalgayı kilitleyemez!
    if (dist > 540) {
      const sp = spawnAroundPlayer();
      en.x = sp.x;
      en.y = sp.y;
      softClamp(en);
      dx = player.x - en.x;
      dy = player.y - en.y;
      dist = Math.hypot(dx, dy) || 1;
    }
    let goalX = player.x, goalY = player.y;

    // STEP 5: SWARM FLOCKING & ENCIRCLEMENT (Boids pincer behavior & soft separation)
    const isMeleeMob = (en.type === 'swarmer' || en.type === 'walker' || en.type === 'fast' || en.type === 'slime' || en.type === 'bearer' || en.type === 'golem');
    if (isMeleeMob && dist > 50) {
      const flankDir = ((en.phase || 0) > Math.PI) ? 1 : -1;
      const flankAng = flankDir * 0.62; // ~35 deg tangential flanking pincer
      const baseAng = Math.atan2(player.y - en.y, player.x - en.x);
      const targetAng = baseAng + flankAng;
      const tDist = Math.max(16, dist - 18);
      goalX = en.x + Math.cos(targetAng) * tDist;
      goalY = en.y + Math.sin(targetAng) * tDist;
    }
    // Soft Boid Repulsion from nearby packmates within 28px
    if (enemies && dist > 35) {
      for (let oi = 0; oi < Math.min(enemies.length, 12); oi++) {
        const other = enemies[oi];
        if (other && other !== en && other.hp > 0) {
          const odx = en.x - other.x;
          const ody = en.y - other.y;
          const oDist = Math.hypot(odx, ody) || 1;
          if (oDist < 26) {
            goalX += (odx / oDist) * 12;
            goalY += (ody / oDist) * 12;
          }
        }
      }
    }

    if (en.type === 'shaman' && en.summoned) {
      goalX = en.x - dx; goalY = en.y - dy;
    } else if (en.type === 'shooter' && !(en.cover && en.cover.hp > 0)) {
      if (dist < 118) { goalX = en.x - dx; goalY = en.y - dy; }
    } else if (en.type === 'marksman') {
      // Keskin Nişancı: 200-300px ideal menzilini korur, yaklaşırsa geri kaçar
      if (dist < 170) {
        goalX = en.x - dx; goalY = en.y - dy;
      } else if (dist > 290) {
        goalX = player.x; goalY = player.y;
      } else {
        // Yanlara strafe yapar
        const strafeDir = ((en.phase || 0) > Math.PI) ? 1 : -1;
        goalX = en.x + Math.cos(Math.atan2(dy, dx) + Math.PI / 2 * strafeDir) * 60;
        goalY = en.y + Math.sin(Math.atan2(dy, dx) + Math.PI / 2 * strafeDir) * 60;
      }
    } else if (en.type === 'disruptor') {
      // Bozucu: Orta mesafede (160-220px) havada süzülür
      if (dist < 140) {
        goalX = en.x - dx; goalY = en.y - dy;
      } else if (dist > 230) {
        goalX = player.x; goalY = player.y;
      }
    }

    const st = villagerStep(en, goalX, goalY);
    const speedAuraMul = en.hasDisruptorBuff ? 1.22 : 1.0;
    const spdH = spd * (st.flee ? 1.35 : 1) * speedAuraMul;

    // STEP 5: SHIELD BEARER FACING & BLOCK TIMER
    if (en.type === 'bearer') {
      en.facingAngle = Math.atan2(player.y - en.y, player.x - en.x);
      if (en.shieldBlocked > 0) en.shieldBlocked -= dt;
    }

    // STEP 5: MARKSMAN CHARGE & SNIPER BEAM
    if (en.type === 'marksman') {
      en.sniperTimer = (en.sniperTimer || 140) - dt;
      if (en.snipeAimT > 0) {
        // Hedefe kilitlenme: Oyuncuyu hafif gecikmeyle takip eder (dash ile kaçılabilir)
        en.aimX += (player.x - en.aimX) * 0.10;
        en.aimY += (player.y - en.aimY) * 0.10;
        if (en.snipeAimT <= 16 && !en._warnedShoot) {
          en._warnedShoot = true;
          synthBlip('hit'); // 250ms sharp lock-on audio warning
        }
        en.snipeAimT -= dt;
        if (en.snipeAimT <= 0) {
          en._warnedShoot = false;
          const sang = Math.atan2(en.aimY - en.y, en.aimX - en.x);
          enemyProjectiles.push({
            x: en.x, y: en.y,
            vx: Math.cos(sang) * 7.5, vy: Math.sin(sang) * 7.5,
            r: 5.5, dmg: 7 + Math.round(wave * 0.6),
            ox: en.x, oy: en.y, maxDist: 420,
            kind: 'marksman_beam', face: sang
          });
          playSfx('skill', 0.32, 180);
          shake = Math.max(shake, 3.2);
          burst(en.x, en.y, '#ef4444', 8, 2.8);
        }
      } else if (en.sniperTimer <= 0 && dist >= 90 && dist <= 380) {
        en.snipeAimT = 48; // ~0.8 sn kırmızı lazer uyarısı
        en.sniperTimer = 200 + Math.random() * 60;
        en.aimX = player.x;
        en.aimY = player.y;
        synthBlip('charge');
      }
    }

    // STEP 5: DISRUPTOR GRAV-WELL VORTEX SUMMON
    if (en.type === 'disruptor') {
      en.disruptTimer = (en.disruptTimer || 180) - dt;
      if (en.disruptTimer <= 0 && dist < 320) {
        en.disruptTimer = 300 + Math.random() * 80;
        hazards.push({
          x: player.x, y: player.y, r: 46,
          type: 'grav_well',
          until: performance.now() + 4000
        });
        burst(player.x, player.y, '#a855f7', 18, 3.4);
        spawnFloatText(en.x, en.y - 26, ' Çekim Girdabı!', '#c084fc');
        playSfx('wave', 0.35, 280);
      }
    }
    if (en.type === 'shaman' && !en.summoned && en.hp <= en.maxHp * 0.4) {
      en.summoned = true;
      spawnFloatText(en.x, en.y - 22, 'Yarasa Kaçışı', '#ce93d8');
      for (let k = 0; k < 2; k++) {
        const a = Math.random() * Math.PI * 2;
        makeEnemy({ x: en.x + Math.cos(a) * 28, y: en.y + Math.sin(a) * 28 }, 'slime');
      }
      for (let k = 0; k < 3; k++) {
        const ba = (Math.PI * 2 / 3) * k + Math.random() * 0.3;
        enemyProjectiles.push({
          x: en.x, y: en.y, vx: Math.cos(ba) * 2.8, vy: Math.sin(ba) * 2.8,
          r: 5, dmg: 5, ox: en.x, oy: en.y, maxDist: 220,
          kind: 'bat', face: ba
        });
      }
    }
    if (en.type === 'shaman' && en.summoned) {
      tryMove(en, st.x * spd * 1.55 * dt, st.y * spd * 1.55 * dt);
    }
    if (en.type === 'tank' || en.type === 'armored') {
      en.thornCd = (en.thornCd || (120 + Math.random() * 60)) - dt;
      if (en.thornCd <= 0 && dist < 210 && dist > 45) {
        en.thornCd = 160 + Math.random() * 80;
        const tang = Math.atan2(player.y - en.y, player.x - en.x);
        enemyProjectiles.push({
          x: en.x, y: en.y,
          vx: Math.cos(tang) * 2.6, vy: Math.sin(tang) * 2.6,
          r: 6.5, dmg: 5, ox: en.x, oy: en.y, maxDist: 220,
          kind: 'thorn', rot: 0
        });
        burst(en.x, en.y, '#81c784', 8, 2);
        playSfx('skill', 0.15, 360);
      }
    }
    if (en.type === 'golem') {
      en.stompCd = (en.stompCd || (110 + Math.random() * 40)) - dt;
      if (en.stompCd <= 0 && dist < 180) {
        en.stompCd = 140 + Math.random() * 40;
        shake = Math.max(shake, 6);
        burst(en.x, en.y, '#78716c', 14, 3.2);
        burst(en.x, en.y, '#d6d3d1', 8, 2.0);
        particles.push({ x: en.x, y: en.y, r: 8, maxR: 55, life: 0.75, color: '#78716c', lw: 4 });
        if (Math.hypot(player.x - en.x, player.y - en.y) < 55 + player.r) {
          damagePlayer(5);
          player.vx += (player.x - en.x) * 0.05;
          player.vy += (player.y - en.y) * 0.05;
        }
      }
    }
    if (en.type === 'specter') {
      en.phaseCd = (en.phaseCd || (85 + Math.random() * 30)) - dt;
      if (en.phaseCd <= 0) {
        en.phaseCd = 120 + Math.random() * 40;
        burst(en.x, en.y, '#a855f7', 10, 2.5);
        const sa = Math.atan2(player.y - en.y, player.x - en.x);
        enemyProjectiles.push({
          x: en.x, y: en.y, vx: Math.cos(sa) * 2.8, vy: Math.sin(sa) * 2.8,
          r: 5.5, dmg: 5, ox: en.x, oy: en.y, maxDist: 260,
          kind: 'bat', face: sa
        });
      }
    }
    if (en.type === 'behemoth') {
      en.chargeCd = (en.chargeCd || (120 + Math.random() * 40)) - dt;
      if (en.chargeT > 0) {
        en.chargeT -= dt;
        tryMove(en, en.chargeVx * dt, en.chargeVy * dt);
        if (Math.random() < 0.35) {
          hazards.push({ x: en.x, y: en.y, r: 16, type: 'lava', until: performance.now() + 2000 });
          burst(en.x, en.y, '#ff5722', 3, 1.4);
        }
        if (Math.hypot(player.x - en.x, player.y - en.y) < en.r + player.r) {
          damagePlayer(7);
          en.chargeT = 0;
        }
      } else if (en.chargeCd <= 0 && dist < 220) {
        en.chargeCd = 150 + Math.random() * 40;
        const ca = Math.atan2(player.y - en.y, player.x - en.x);
        en.chargeVx = Math.cos(ca) * 4.2;
        en.chargeVy = Math.sin(ca) * 4.2;
        en.chargeT = 22;
        burst(en.x, en.y, '#ea580c', 14, 3.0);
        spawnFloatText(en.x, en.y - 28, 'Hücum!', '#f97316');
      }
    }
    if (en.type === 'exploder' && Math.random() < 0.25) {
      sparks.push({
        x: en.x + (Math.random() - 0.5) * 8, y: en.y + (Math.random() - 0.5) * 8,
        r: 2.5, life: 18, maxLife: 18, color: Math.random() < 0.5 ? '#ff5722' : '#ffeb3b'
      });
    }
    const melee = (en.type === 'swarmer' || en.type === 'walker' || en.type === 'fast' || en.type === 'tank'
      || en.type === 'exploder' || en.type === 'slime' || en.type === 'leech' || en.type === 'armored'
      || en.type === 'bearer' || en.type === 'golem' || en.type === 'behemoth' || en.type === 'specter' || (en.type === 'shaman' && !en.summoned));
    if (melee) {
      tryMove(en, st.x*spdH*dt, st.y*spdH*dt);
      const reach = en.r+player.r+4;
      if (dist < reach) {
        en.hitCooldown -= dt;
        if (en.hitCooldown <= 0) {
          let md = en.type==='swarmer' ? (wave <= 5 ? 2 : 3) :
                   en.type==='golem' ? (wave <= 5 ? 7 : 10) :
                   en.type==='behemoth' ? (wave <= 5 ? 6 : 9) :
                   en.type==='specter' ? (wave <= 5 ? 4 : 6) :
                   en.type==='tank'||en.type==='armored'||en.type==='bearer' ? (wave <= 5 ? 5 : wave <= 9 ? 7 : 9) :
                   en.type==='fast' ? (wave <= 5 ? 2 : wave <= 9 ? 3 : 4) :
                   en.type==='exploder' ? 6 :
                   en.type==='leech' ? 4 : (wave <= 6 ? 3 : wave <= 10 ? 4 : 5);
          setDeathReason(en.type==='boss' ? 'Boss darbesi' : (en.isElite ? 'Elit canavar' : (en.type==='fast'||en.type==='swarmer' ? 'Hızlı düşman' : 'Yakın hasar')));
          damagePlayer(md);
          if (en.isElite && en.eliteAffix && en.eliteAffix.id === 'vampir') {
            en.hp = Math.min(en.maxHp, en.hp + Math.max(1, Math.round(md * 0.2)));
          }
          if (en.type==='slime') player.slowUntil = performance.now() + 1100;
          if (en.type==='leech') {
            en.hp = Math.min(en.maxHp, en.hp + 6);
            en.r = Math.min(22, en.r + 1.5);
          }
          en.hitCooldown = (en.type === 'fast' || en.type === 'swarmer') ? 36 : 58;
        }
      }
    }
    if (en.type === 'shooter') {
      const er = ENEMY_AUTO['shooter'];
      if (en.cover && en.cover.hp > 0) {
        const bx = en.cover.x, by = en.cover.y;
        const pdx = player.x - bx, pdy = player.y - by;
        const pd = Math.hypot(pdx, pdy) || 1;
        const tx = bx - (pdx / pd) * 36;
        const ty = by - (pdy / pd) * 36;
        const cs = villagerStep(en, tx, ty);
        tryMove(en, cs.x * spd * dt, cs.y * spd * dt);
      } else if (st.flee || dist < 118 || dist > 158) {
        tryMove(en, st.x * spdH * dt, st.y * spdH * dt);
      }
      en.shootTimer -= dt;
      const canShoot = dist >= (er.min || 88) && dist <= er.range + 20;
      if (en.aimT > 0) {
        if (distToSeg(player.x, player.y, en.x, en.y, en.aimX, en.aimY) < 12 && player.moving) tryPerfectDodge();
        en.aimT -= dt;
        if (en.aimT <= 0) {
          const ang = Math.atan2(en.aimY - en.y, en.aimX - en.x);
          const spdB = er.speed * 1.55;
          enemyProjectiles.push({
            x: en.x, y: en.y, vx: Math.cos(ang) * spdB, vy: Math.sin(ang) * spdB,
            r: 5, dmg: 6,
            ox: en.x, oy: en.y, maxDist: 280,
            pierce: true, laser: true,
            kind: 'bat', face: ang
          });
          playSfx('skill', 0.16, 420);
        }
      } else if (en.shootTimer <= 0 && canShoot) {
        en.shootTimer = er.interval + Math.random()*20;
        en.aimX = player.x; en.aimY = player.y;
        en.aimT = 60;
      } else if (en.shootTimer <= 0) {
        en.shootTimer = 12;
      }
    }
    // Düşman engel takılma denetçisi (2 saniyede kesin kurtulma)
    const curObs = circleHitsObs(en.x, en.y, en.r + 2);
    if (curObs) {
      en.stuckTimer = (en.stuckTimer || 0) + dt;
      pushOutOfObstacles(en);
      if (en.stuckTimer >= 120) {
        const toPlayer = Math.atan2(player.y - en.y, player.x - en.x);
        const escapeDist = en.r + Math.max(curObs.w, curObs.h) * 0.75 + 16;
        en.x = curObs.x + curObs.w / 2 + Math.cos(toPlayer) * escapeDist;
        en.y = curObs.y + curObs.h / 2 + Math.sin(toPlayer) * escapeDist;
        pushOutOfObstacles(en);
        softClamp(en);
        en.stuckTimer = 0;
        burst(en.x, en.y, '#ffffff', 8, 2.2);
      }
    } else {
      en.stuckTimer = Math.max(0, (en.stuckTimer || 0) - dt * 0.8);
    }
    softClamp(en);
  });

  // Kademe 1: Düşmanların Üst Üste Yığılmasını Önleyen Yumuşak İtme (Soft-Body Pushback) - 60 FPS HIZLI
  const eLen = enemies ? enemies.length : 0;
  if (eLen > 1) {
    const maxPushCheck = Math.min(eLen, 64);
    for (let a = 0; a < maxPushCheck; a++) {
      const e1 = enemies[a];
      if (!e1 || e1.hp <= 0) continue;
      if (e1.isElite && e1.affix === 'molten' && Math.random() < 0.15) {
        if (sparks.length < 35) sparks.push({ x: e1.x + (Math.random() - 0.5) * 12, y: e1.y + (Math.random() - 0.5) * 12, r: 2.5, life: 15, maxLife: 15, color: '#ff3d00' });
      }
      const r1 = e1.r || 12;
      for (let b = a + 1; b < maxPushCheck; b++) {
        const e2 = enemies[b];
        if (!e2 || e2.hp <= 0) continue;
        const edx = e2.x - e1.x;
        if (edx > 30 || edx < -30) continue;
        const edy = e2.y - e1.y;
        if (edy > 30 || edy < -30) continue;
        const distSq = edx * edx + edy * edy;
        const minD = r1 + (e2.r || 12);
        if (distSq < minD * minD && distSq > 0.001) {
          const edist = Math.sqrt(distSq);
          const overlap = (minD - edist) * 0.45;
          const pushX = (edx / edist) * overlap;
          const pushY = (edy / edist) * overlap;
          if (e1.type !== 'boss') { e1.x -= pushX * 0.5; e1.y -= pushY * 0.5; }
          if (e2.type !== 'boss') { e2.x += pushX * 0.5; e2.y += pushY * 0.5; }
        }
      }
    }
  }

  // Boss Tehlike Alanı (Telegraph) Güncellemesi & Patlama Tetikleyicileri
  if (bossTelegraphs && bossTelegraphs.length > 0) {
    for (let i = bossTelegraphs.length - 1; i >= 0; i--) {
      const bt = bossTelegraphs[i];
      bt.t = (bt.t || 0) + dt;
      if (bt.t >= bt.duration) {
        try {
          if (typeof bt.onTrigger === 'function') bt.onTrigger(bt);
        } catch (err) {
          console.error('[Telegraph] Error in onTrigger:', err);
        }
        bossTelegraphs.splice(i, 1);
      }
    }
  }

  for (let i=enemyProjectiles.length-1;i>=0;i--) {
    const p = enemyProjectiles[i];
    let bDt = dt;
    if (!p.isFriendly && (player.heroId === 'kayra' || selectedHeroId === 'kayra')) {
      bDt *= 0.35; // Kayra Han Zaman Bozulması: Düşman mermilerini %65 yavaşlatır
      if (Math.random() < 0.08) {
        sparks.push({ x: p.x, y: p.y, vx: 0, vy: -0.6, r: 1.8, life: 0.25, maxLife: 0.25, color: '#38bdf8' });
      }
    }
    p.x += p.vx*bDt; p.y += p.vy*bDt;
    if (p.kind === 'bat') {
      p.face = Math.atan2(p.vy, p.vx);
    } else if (p.kind === 'thorn' || p.kind === 'magma' || p.kind === 'rock_boulder' || p.kind === 'lollipop_bomb') {
      p.rot = (p.rot || 0) + 0.15 * dt;
    }
    if (p.kind === 'magma' || p.kind === 'mustard_fire') {
      triggerEnvChemistry(p.x, p.y, 'fire', (p.r || 8) + 8, 0.85);
    } else if (p.kind === 'icicle') {
      triggerEnvChemistry(p.x, p.y, 'ice', (p.r || 8) + 8, 0.85);
    }
    if (shotTooFar(p, 172) || (typeof cam !== 'undefined' && (p.x < cam.x - 110 || p.x > cam.x + W + 110 || p.y < cam.y - 110 || p.y > cam.y + H + 110))) {
      enemyProjectiles.splice(i,1); continue;
    }
    if (outOfWorld(p.x, p.y, 24) || circleHitsObs(p.x,p.y,p.r)) {
      enemyProjectiles.splice(i,1); continue;
    }

    // BAMSI YANSITILMIŞ DOST MERMİ ETKİLEŞİMİ (PARRIED PROJECTILES)
    if (p.isFriendly) {
      let hitEnemy = false;
      if (enemies && enemies.length) {
        for (let ei = enemies.length - 1; ei >= 0; ei--) {
          const en = enemies[ei];
          const maxPR = en.r + p.r;
          const edx = p.x - en.x, edy = p.y - en.y;
          if (Math.abs(edx) <= maxPR && Math.abs(edy) <= maxPR && (edx * edx + edy * edy < maxPR * maxPR)) {
            const dealt = takeDamage(en, p.dmg || 40, 'wind');
            punchEnemy(en, p.x, p.y, 16, true);
            spawnFloatText(en.x, en.y - 12, '' + dealt, '#38bdf8', 'crit');
            burst(p.x, p.y, '#38bdf8', 12, 3.0);
            hitEnemy = true;
            if (en.hp <= 0) killEnemy(ei);
            break;
          }
        }
      }
      if (hitEnemy) {
        enemyProjectiles.splice(i, 1);
        continue;
      }
      continue;
    }

    const hitR = p.r + player.r;
    const nearR = hitR + 16;
    const pdx = p.x - player.x, pdy = p.y - player.y;
    if (Math.abs(pdx) <= nearR && Math.abs(pdy) <= nearR) {
      const dSq = pdx * pdx + pdy * pdy;
      const hitRSq = hitR * hitR;
      if (!p.nearDodged && dSq > hitRSq && dSq < nearR * nearR && player.moving) {
        p.nearDodged = true;
        tryPerfectDodge();
      }
      if (dSq < hitRSq) {
        if (!p.hitPlayer) {
          damagePlayer(p.dmg);
          p.hitPlayer = true;
          const bColor = p.kind === 'icicle' ? '#80deea' :
                         p.kind === 'bat' ? '#e91e63' :
                         p.kind === 'thorn' ? '#81c784' :
                         p.kind === 'rock_boulder' ? '#8d6e63' :
                         p.kind === 'lollipop_bomb' ? '#ec407a' :
                         p.kind === 'mustard_fire' ? '#fbc02d' : '#ff9800';
          burst(p.x, p.y, bColor, 8, 2.4);
        }
        if (!p.pierce) enemyProjectiles.splice(i,1);
      }
    }
  }

  const mag = magnetRange();
  for (let i=drops.length-1;i>=0;i--) {
    const d = drops[i];
    const py = pickupY(d);
    pullPickup(d, py, mag, dt);
    const hitDist = d.isBossChest ? (player.r + 24) : (player.r + 18);
    if (Math.hypot(d.x-player.x, py-player.y) < hitDist) {
      const isChest = d.isBossChest;
      drops.splice(i,1);
      if (isChest) {
        // Boss Chest: Süper Evrim Kontrolü (Evolution Climax)
        if (player && !player._hasApexEvolution && runLock && runLock.root && runLock.secondary) {
          const cPair = pairKey(runLock.root, runLock.secondary);
          if (APEX_EVOLUTIONS[cPair]) {
            triggerApexEvolution(APEX_EVOLUTIONS[cPair]);
          }
        }
        // Boss Chest: Instant dopamine rewards (XP, Crystals, Shield) without freezing combat!
        const roll = Math.random();
        const jackpotMulti = roll < 0.12 ? 3 : roll < 0.35 ? 2 : 1;
        playSfx('confirm', 0.45, 520);
        triggerScreenFlash(jackpotMulti === 3 ? '#ff007f' : '#ffd740', 0.4, 180);
        vibrate([30, 50, 40, 60, 40, 70]);
        shake = Math.max(shake, jackpotMulti === 3 ? 16 : 10);
        
        particles.push({ x: d.x, y: py, r: 16, maxR: 180, life: 1.4, color: '#ffd740', lw: 8 });
        particles.push({ x: d.x, y: py, r: 10, maxR: 120, life: 1.2, color: '#ffffff', lw: 5 });
        burst(d.x, py, '#ffd740', 30, 5.5);
        burst(d.x, py, '#ff6eb4', 22, 4.2);
        burst(d.x, py, '#00e5ff', 22, 4.2);
        
        const crys = 2 * jackpotMulti;
        const xpBoost = 12 * jackpotMulti;
        gainCrystals(crys, player.x, player.y - 18);
        gainXp(xpBoost);
        player.hp = Math.min(player.maxHp, player.hp + 20 * jackpotMulti);
        shieldOn = Math.min(80, (shieldOn || 0) + 25 * jackpotMulti);
        updateHud();

        if (jackpotMulti === 3) {
          spawnFloatText(d.x, py - 40, ` 3X MEGA JACKPOT! +${xpBoost} XP · +${crys} `, '#ff007f', 'big');
          showStreakBanner(` 3X MEGA JACKPOT! +${xpBoost} XP · +${crys} `, '#ff007f');
        } else if (jackpotMulti === 2) {
          spawnFloatText(d.x, py - 36, ` 2X ÇİFTE HAZİNE! +${xpBoost} XP · +${crys} `, '#ffd740', 'big');
          showStreakBanner(` 2X ÇİFTE ÖDÜL! +${xpBoost} XP · +${crys} `, '#ffd740');
        } else {
          spawnFloatText(d.x, py - 32, ` EFSANEVİ HAZİNE! +${xpBoost} XP · +${crys} `, '#ffd740', 'big');
          showStreakBanner(` HAZİNE! +${xpBoost} XP · +${crys} `, '#ffd740');
        }
        if (running && enemies.length === 0 && !overlayBusy()) {
          scheduleWaveClear(400);
        }
      } else if (d.isMagnetPearl) {
        // Mıknatıs İncisi: Tüm haritadaki XP ve Kristalleri tek salisede oyuncuya çeker!
        playSfx('skill', 0.45, 780);
        triggerScreenFlash('#00e5ff', 0.35, 140);
        vibrate([30, 45, 30]);
        shake = Math.max(shake, 8);
        particles.push({ x: d.x, y: py, r: 12, maxR: 220, life: 1.2, color: '#00e5ff', lw: 6 });
        burst(d.x, py, '#00e5ff', 24, 4.5);
        burst(d.x, py, '#ffffff', 16, 3.5);
        spawnFloatText(player.x, player.y - 36, 'KUTUPSAL ÇEKİM!', '#00e5ff', 'big');
        // Haritadaki tüm ganimetleri yüksek hızlı manyetik çekimle çek
        if (typeof vacuumAllPickups === 'function') vacuumAllPickups();
      } else {
        vibrate('light');
        playSfx('bubble', 0.25, 120);
        gainCrystals(1, d.x, py);
        gainXp(5);
        burst(d.x, py, '#ffd740', 6, 2.2);
        const nowMs = performance.now();
        if (window._lastDropFloatAt && (nowMs - window._lastDropFloatAt < 320) && window._activeDropFloat && window._activeDropFloat.curLife > 0) {
          window._accDropXp = (window._accDropXp || 0) + 5;
          window._accDropCrys = (window._accDropCrys || 0) + 1;
          window._activeDropFloat.text = `+${window._accDropXp} XP · +${window._accDropCrys} Kristal`;
          window._activeDropFloat.curLife = window._activeDropFloat.maxLife;
          window._activeDropFloat.x = d.x;
          window._activeDropFloat.y = py - 20;
          window._lastDropFloatAt = nowMs;
        } else {
          window._accDropXp = 5;
          window._accDropCrys = 1;
          window._lastDropFloatAt = nowMs;
          window._activeDropFloat = spawnFloatText(d.x, py - 20, '+5 XP · +1 kristal', '#ffd740', 'small');
        }
      }
    }
  }

  for (let i=orbs.length-1;i>=0;i--) {
    const o = orbs[i];
    const py = pickupY(o);
    pullPickup(o, py, mag, dt);
    if (Math.hypot(o.x-player.x, pickupY(o)-player.y) < player.r+16) {
      const healAmt = 5;
      if (player.hp < player.maxHp) {
        player.hp = Math.min(player.maxHp, player.hp + healAmt);
        spawnFloatText(player.x, player.y-16, '+5', '#3ddc84');
      } else if (player.mods && player.mods.bloodTithe) {
        const maxReserve = Math.round(player.maxHp * 0.22);
        player._bloodTitheReserve = Math.min(maxReserve, (player._bloodTitheReserve || 0) + healAmt);
        spawnFloatText(player.x, player.y - 24, '🩸 Kan Rezervi: ' + Math.round(player._bloodTitheReserve) + '/' + maxReserve, '#ff1744', 'small');
      }
      burst(o.x, o.y, '#3ddc84', 8, 2);
      playSfx('heal', 0.22, 280);
      updateHud(); orbs.splice(i,1);
    }
  }

  // --- MINECRAFT STİLİ XP KÜRELERİ GÜNCELLEMESİ (Süzülme, Sabit Kalma & Oyuncuya Çekilme) ---
  for (let i = xpGems.length - 1; i >= 0; i--) {
    const g = xpGems[i];

    // 1. İlk düşüş anı: Kısa bir yay çizerek yere yumuşakça konma
    if (g.popProgress != null && g.popProgress < 1) {
      g.popProgress = Math.min(1, g.popProgress + (1 / (g.popDuration || 16)) * dt);
      const t = g.popProgress;
      g.x = g.spawnX + (g.groundX - g.spawnX) * t;
      const arcH = Math.sin(t * Math.PI) * 16;
      g.y = (g.spawnY + (g.groundY - g.spawnY) * t) - arcH;
      g.by = g.groundY;
      continue;
    }

    // 2. Yere konduktan sonra: Konumu kesinlikle SABİTTİR (Yer Değiştirmez!)
    if (!g.attracting) {
      g.x = g.groundX != null ? g.groundX : g.x;
      g.y = g.groundY != null ? g.groundY : g.y;
      g.by = g.y;
    }

    // 3. Oyuncuya olan mesafe kontrolü (Oyuncu yaklaştığında çekilme)
    const dx = player.x - g.x;
    const dy = player.y - g.y;
    const dist = Math.hypot(dx, dy);

    // Mıknatıs / Toplama menziline girdi mi? (Gidip toplayabilme mesafesi)
    const pickRange = Math.max(75, mag);
    if (dist < pickRange || g.forceMagnet) {
      g.attracting = true;
    }

    // Oyuncuya çekilme fiziği (Minecraft yerçekimsel kavis ve ivmelenme)
    if (g.attracting && dist > 0.1) {
      const proximity = Math.max(0.15, 1 - dist / pickRange);
      const speed = (g.forceMagnet ? Math.max(14, dist / 18 + 8) : Math.max(6.2, proximity * 15.0 + 4.8)) * dt;
      g.x += (dx / dist) * speed;
      g.y += (dy / dist) * speed;
      g.groundX = g.x;
      g.groundY = g.y;
      g.by = g.y;
    }

    // 4. Oyuncuya temas ve toplanma (Gidip toplayabileyim)
    if (dist < player.r + 16) {
      const val = g.val || 6;
      const isBossGem = !!g.isBossLoot || val >= 15;
      xpGems.splice(i, 1);
      gainXp(val);

      const now = performance.now();
      if (!window._lastGemAt || now - window._lastGemAt > 650) window._gemStreak = 0;
      else window._gemStreak = ((window._gemStreak || 0) + 1) % 12;
      window._lastGemAt = now;

      // Minecraft XP toplama sesi (Tırmanan berrak ding / plink)
      playSfx('tick', isBossGem ? 0.45 : 0.35, 600 + (window._gemStreak * 55));
      synthBlip('pick');

      // Minecraft parıltılı piksel partikül patlaması (Canlı yeşil, limon sarısı, saf beyaz)
      burst(g.x, g.y, '#76ff03', isBossGem ? 12 : 6, isBossGem ? 3.4 : 2.2);
      burst(g.x, g.y, '#ffff55', isBossGem ? 8 : 4, isBossGem ? 2.6 : 1.8);
      burst(g.x, g.y, '#ffffff', isBossGem ? 6 : 3, isBossGem ? 2.0 : 1.4);
      particles.push({ x: g.x, y: g.y, r: 4, maxR: isBossGem ? 38 : 24, life: 0.6, color: '#a6ff00', lw: 2.2 });

      if (isBossGem) {
        spawnFloatText(player.x, player.y - 20, '+' + val + ' XP ', '#ffd700');
        vibrate([18, 25]);
      } else if (window._gemStreak === 8) {
        spawnFloatText(player.x, player.y - 24, ' XP SERİSİ!', '#76ff03');
        vibrate([15, 20]);
      }
    }
  }

  if (crystals.length > 70) {
    const excess = crystals.length - 55;
    for (let c = 0; c < excess; c++) {
      if (crystals.length > 55) {
        const removed = crystals.shift();
        if (crystals[0]) {
          crystals[0].n = (crystals[0].n || 1) + (removed.n || 1);
        }
      }
    }
  }

  for (let i=crystals.length-1;i>=0;i--) {
    const g = crystals[i];
    const py = pickupY(g);
    pullPickup(g, py, mag, dt);
    if (Math.hypot(g.x-player.x, pickupY(g)-player.y) < player.r + 16) {
      gainCrystals(g.n || 1, g.x, g.y);
      crystals.splice(i,1);
      playSfx('bubble', 0.2, 320);
    }
  }

  if (typeof tickClassSystems === 'function') tickClassSystems(dt);
  const isBossWave = (wave >= 5 && wave % 5 === 0);
  const hasBossLoot = isBossWave && drops && drops.some(d => d.isBossChest);
  if (running && enemies.length === 0 && !overlayBusy() && !menuOpen && breathLeft <= 0) {
    if (!hasBossLoot) {
      // Kesintisiz akış: Oyun donmaz, kristal ve XP akmaya devam eder, 180ms sonra yeni dalga devreye girer
      if (!waveTimer) scheduleWaveClear(180);
    } else {
      drops.forEach(d => {
        if (d.isBossChest) {
          d._autoTimer = (d._autoTimer || 180) - dt;
          if (d._autoTimer <= 0) {
            d.forceMagnet = true;
          }
        }
      });
      if (drops.some(d => d.isBossChest && d._autoTimer <= -120)) {
        if (!waveTimer) scheduleWaveClear(120);
      }
    }
  }
}

function onWaveCleared() {
  checkSpawnTreasureChest();
  saveActiveRunState();
  if (!running) return;
  if (enemies && enemies.length > 0) {
    if (waveTimer) { clearTimeout(waveTimer); waveTimer = null; }
    paused = false;
    return;
  }
  if (overlayBusy()) {
    // Kullanıcı seçim yapıyorsa ekranı YAKMA — sadece tekrar dene
    scheduleWaveClear(400);
    return;
  }
  if (waveTimer) { clearTimeout(waveTimer); waveTimer = null; }
  try {
    if (drops && drops.length) {
      for (let i = drops.length - 1; i >= 0; i--) {
        if (drops[i].isBossChest) {
          gainCrystals(4, player.x, player.y - 18);
          gainXp(18);
          player.hp = Math.min(player.maxHp, player.hp + 25);
          drops.splice(i, 1);
        }
      }
    }
    const clearedWave = wave;
    const isBossCleared = (clearedWave >= 5 && clearedWave % 5 === 0);
    // Dalga temizlendiğinde haritadaki ganimetleri akıcı vakum fiziğiyle çek
    if (typeof vacuumAllPickups === 'function') {
      vacuumAllPickups();
    }
    if (!(player.cursed === 'curseGreed')) {
      player.hp = Math.min(player.maxHp, player.hp + 14);
    }
    score += 20 + wave * 15;
    if (wave % 3 === 0) {
      gainCrystals(1, player.x, player.y - 18);
    }
    resolveWaveQuest();
    xpWaveMul = 1;
    wagerHard = false;

    // Boss temizlendiğinde: Yeni biyoma geç ve boss zafer ödüllerini ver
    if (isBossCleared) {
      const nextKey = pickNextBiome();
      if (nextKey !== currentBiome().key) {
        biomeHist.push(nextKey);
        seedBiome(biomeIndexOf(nextKey));
        obstacles = [];
        const isEn = (typeof getGameLang === 'function' && getGameLang() === 'en');
        spawnFloatText(player.x, player.y - 44, (isEn ? 'New Realm: ' : 'Yeni diyar: ') + currentBiome().name, currentBiome().accent);
        spawnMinDist = 180;
      }
    }

    addWaveObstacles();
    unstickEveryone();
    updateHud();

    if (isBossCleared) {
      resetJoystick();
      const isEn = (typeof getGameLang === 'function' && getGameLang() === 'en');
      spawnFloatText(player.x, player.y - 36, isEn ? 'Victory! Boss Vanquished ' : 'Zafer! Boss Mağlup ', '#ffd740');
      playSfx('wave', 0.32);

      // Boss Zafer Ödülü: Eğer bekleyen element henüz seçilmediyse ödül kuyruğuna ekle
      if (pendingElement && lockedCombos.length < 3) {
        pendingRewards.unshift('element');
      }

      // KESİNTİSİZ AKICI PACING: Yeni dalga anında hazırlanır ve düşmanlar oluşturulur
      wave = clearedWave + 1;
      applyWaveUnlocks();
      spawnWave();
      ensureEnemiesSpawned();

      // Boss zaferinden sonra bekleyen ödül varsa önce ödül seçim ekranını aç
      // Kart seçildiği anda closeReward() doğrudan oyuna döner (çift onWaveCleared tetiklenmez!)
      if (pendingRewards && pendingRewards.length) {
        paused = true;
        flushReward();
        return;
      }

      paused = false;
      return;
    }

    // Tüccar sadece Dalga 5'te (Büyük Ara Dinlenme) açılır, her 2 dalgada bir duraksatmaz
    if (clearedWave === 5) {
      openMerchant();
      return;
    }

    wave = clearedWave + 1;
    applyWaveUnlocks();
    spawnWave();
    ensureEnemiesSpawned();
    spawnFloatText(player.x, player.y - 24, 'Dalga ' + wave, '#f1c40f');
    playSfx('wave', 0.28);
    if (pendingRewards && pendingRewards.length) {
      paused = true;
      flushReward();
      return;
    }
    paused = false;
  } catch (err) {
    console.error('Error in onWaveCleared:', err);
    wave = (wave || 1) + 1;
    paused = false;
    try { spawnWave(); ensureEnemiesSpawned(); } catch (_) {}
  }
}

function triggerVolcanicEruption(x, y) {
  triggerScreenFlash('#ff5722', 0.45, 180);
  shake = Math.max(shake, 16);
  camKick = 12;
  vibrate([60, 80]);
  if (typeof playPunchySubBass === 'function') playPunchySubBass(50, 0.45, 0.8, true);
  if (typeof synthBlip === 'function') synthBlip('elem_fire');
  burst(x, y, '#ff5722', 24, 4.8);
  burst(x, y, '#ffd700', 16, 3.2);
  spawnFloatText(x, y - 28, ' VOLKANİK SİPER!', '#ff5722', 'big');
  if (typeof spawnElemStain === 'function') spawnElemStain(x, y, 90, 'fire', 180);
  if (enemies && enemies.length) {
    enemies.forEach(en => {
      const d = Math.hypot(en.x - x, en.y - y);
      if (d < 160) {
        punchEnemy(en, x, y, 22, true);
        takeDamage(en, 45, 'fire');
        applyEffect(en, 'burn', 3);
      }
    });
  }
}

function damagePlayer(dmg, opt) {
  if (!player || player.hp <= 0) return;
  if (player.invuln > 0 || shieldOn > 0) return;
  opt = opt || {};
  if (!opt.raw) dmg = Math.max(1, Math.round(dmg * getWaveDmgMul(wave)));
  else dmg = Math.max(1, Math.round(dmg));
  const rk = modValue('rock');
  if (rk && rk.armor) dmg = Math.max(1, Math.round(dmg * (1 - Math.min(0.42, rk.armor * synMul('rock', 0.38)))));
  dmg = Math.max(1, Math.round(dmg * (wave <= 5 ? 1.0 : wave <= 9 ? 1.05 : 1.12)));
  if (player.curseTaken && player.curseTaken !== 1) dmg = Math.max(1, Math.round(dmg * player.curseTaken));
  if (modLv('bloodPact')) dmg = Math.max(1, Math.round(dmg * 1.15));
  const tough = (modValue('tough') || 0) * synMul('tough', 0.4);
  if (tough) dmg = Math.max(1, Math.round(dmg * (1 - tough / 100)));
  const heroDef = (player.heroId === 'korhan' || selectedHeroId === 'korhan') ? 0.20 : ((player.mods && player.mods.def) || 0);
  if (heroDef > 0) dmg = Math.max(1, Math.round(dmg * (1 - heroDef)));
  // KAYRA HAN: ZAMAN GERİ SARMA (Ölümcül Hasardan Kurtulma - 90s CD)
  if ((player.heroId === 'kayra' || selectedHeroId === 'kayra') && player.hp - dmg <= 0 && (!player._kayraCd || performance.now() > player._kayraCd)) {
    player._kayraCd = performance.now() + 90000;
    player.hp = Math.round(player.maxHp * 0.65);
    player.invuln = 120; // 2s dokunulmazlık
    triggerScreenFlash('#38bdf8', 0.5, 300);
    spawnFloatText(player.x, player.y - 32, ' ZAMAN GERİ SARILDI!', '#38bdf8', 'big');
    playSfx('legendary', 0.6);
    shake = Math.max(shake, 14);
    // Push away enemies
    if (enemies && enemies.length) {
      enemies.forEach(en => {
        if (Math.hypot(en.x - player.x, en.y - player.y) < 220) punchEnemy(en, player.x, player.y, 28, true);
      });
    }
    return;
  }

  // AYAZ HAN: KIRAĞI ZIRHI (Hasar Azaltma)
  if ((player.heroId === 'ayaz' || selectedHeroId === 'ayaz') && player._frostShield) {
    player._frostShield = false;
    dmg = Math.max(1, Math.round(dmg * 0.60)); // %40 hasar azaltma
    burst(player.x, player.y, '#00e5ff', 16, 3.0);
    spawnFloatText(player.x, player.y - 28, ' BUZ KALKANI KORUDU!', '#00e5ff', 'crit');
    playSfx('shield', 0.5);
  }

  // KABARCIK KALKANI (Aegis Bubble) — İlk darbeyi %100 engeller ve patlar
  if (player.mods && player.mods.aegisBubble && _aegisReady) {
    _aegisReady = false;
    _aegisTimer = 0;
    player.invuln = 45; // 0.75s dokunulmazlık
    burst(player.x, player.y, '#38bdf8', 30, 4.5);
    shake = Math.max((typeof shake !== 'undefined' ? shake : 0), 8);
    spawnFloatText(player.x, player.y - 30, '🫧 KABARCIK KORUDU! (0 Hasar)', '#38bdf8', 'big');
    playSfx('block', 0.65, 250);
    if (enemies && enemies.length) {
      enemies.forEach(en => {
        if (!en._dead && Math.hypot(en.x - player.x, en.y - player.y) < 180) {
          punchEnemy(en, player.x, player.y, 22, true);
        }
      });
    }
    return;
  }
  _aegisTimer = 0; // Hasar alındığında sayaç sıfırlanır

  // KAN BEDELİ (Blood Tithe) — Ölümcül hasarda birikmiş kan rezerviyle hayatta kalma
  if (player.hp - dmg <= 0 && player.mods && player.mods.bloodTithe && (player._bloodTitheReserve || 0) > 0) {
    player.hp = Math.max(1, Math.round(player._bloodTitheReserve));
    player._bloodTitheReserve = 0;
    player.invuln = 90; // 1.5s dokunulmazlık
    triggerScreenFlash('#ff1744', 0.65, 350);
    burst(player.x, player.y, '#ff1744', 36, 5.5);
    spawnFloatText(player.x, player.y - 34, '🩸 KAN BEDELİ KURTARDI!', '#ff1744', 'big');
    playSfx('legendary', 0.75);
    shake = Math.max((typeof shake !== 'undefined' ? shake : 0), 12);
    return;
  }

  player.hp -= dmg;
  player._lastDamageSource = opt.source || 'Bilinmeyen';
  if (typeof runStats !== 'undefined' && runStats) {
    runStats.tookDamageThisRun = true;
    runStats.totalDamageTaken = (runStats.totalDamageTaken || 0) + dmg;
  }
  spawnFloatText(player.x, player.y - 20, '-' + dmg, '#ef4444', 'big');

  // TULPAR: ŞİMŞEK İNTİKAMI (Darbe Alınca Zincirleme Elektrik Boşalması)
  if ((player.heroId === 'tulpar' || selectedHeroId === 'tulpar') && player.hp > 0 && Math.random() < 0.65) {
    const nearby = (enemies || []).filter(e => e && e.hp > 0 && Math.hypot(e.x - player.x, e.y - player.y) < 260).slice(0, 3);
    if (nearby.length > 0) {
      playSfx('spark', 0.4);
      nearby.forEach(en => {
        takeDamage(en, Math.round(dmg * 1.5) + 20, 'storm');
        burst(en.x, en.y, '#facc15', 8, 2.5);
      });
      spawnFloatText(player.x, player.y - 28, ' ŞİMŞEK İNTİKAMI!', '#facc15', 'crit');
    }
  }

  // KORHAN VOLKANİK SİPER (MAGMA PÜSKÜRMESİ) MEKANİĞİ
  if (player && (player.heroId === 'korhan' || selectedHeroId === 'korhan') && player.hp > 0) {
    player._volcanicAccum = (player._volcanicAccum || 0) + dmg;
    const threshold = player.maxHp * 0.20;
    if (player._volcanicAccum >= threshold) {
      player._volcanicAccum = 0;
      triggerVolcanicEruption(player.x, player.y);
    }
  }

  if (modLv('mirrorShield') && (!mirrorCd || mirrorCd <= 0)) {
    mirrorCd = 15 * 60;
    player.invuln = 55;
    burst(player.x, player.y, '#ffd740', 16, 3);
    playSfx('shield', 0.45);
    enemies.forEach(en => {
      if (Math.hypot(en.x - player.x, en.y - player.y) <= 180 + en.r) {
        takeDamage(en, Math.max(20, dmg), 'earth');
      }
    });
    spawnFloatText(player.x, player.y - 28, 'Ayna Yansıması!', '#ffd740');
    pruneDeadEnemies();
  }
  if (streakOn) {
    streakOn = false;
    spawnFloatText(player.x, player.y - 28, 'Ah', '#ff8a80');
  }
  addFlow(-24);
  killCombo = 0;
  lastHurtAt = performance.now();
  steamLastHurt = lastHurtAt;
  addSteam(-8);
  ashBreakVeil(false);
  waveHurt = true;
  const rf = (modValue('reflect') || 0) * synMul('reflect', 0.45);
  if (rf) {
    let near = null, nd = 52;
    enemies.forEach(en => {
      const d = Math.hypot(en.x-player.x, en.y-player.y);
      if (d < nd) { nd = d; near = en; }
    });
    if (near) {
      const back = Math.max(1, Math.round(dmg * rf / 100));
      near.hp -= back;
      spawnFloatText(near.x, near.y-8, '-'+back, '#9ccc65');
      pruneDeadEnemies();
    }
  }
  // STEP 9: Break Flawless Challenge on damage
  if (flawlessTimer > 0) {
    flawlessTimer = 0;
    spawnFloatText(player.x, player.y - 36, ' Kusursuz İmtihan Bozuldu!', '#ef4444');
    playSfx('hurt', 0.4);
    vibrate([40, 80]);
  }
  player.invuln = 56;
  player.recoilT = 14;
  triggerHitStop(5); // 5 frames micro-freeze on player damage
  shake = Math.max(shake, 7);
  vibrate([30, 40, 30]);
  playSfx('hit', 0.28, 260);
  hitFlashEl.style.opacity = '1';
  setTimeout(() => { hitFlashEl.style.opacity = '0'; }, 90);
  updateHud();
  if (!deathReason) setDeathReason('Yakın hasar');
  if (player.hp <= 0) {
    player.hp = 0;
    const activeBoss = enemies.find(e => e.type === 'boss');
    if (activeBoss) recordBossDeath(activeBoss.bossType || currentBiome().key);
    updateHud();
    offerContinue();
  }
}

let _killRecursionDepth = 0;

