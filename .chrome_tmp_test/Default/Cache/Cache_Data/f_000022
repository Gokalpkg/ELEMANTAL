      ctx.fillRect(h.x - h.r * 0.3, h.y - 3, 4, 3);
      ctx.fillRect(h.x + h.r * 0.2, h.y + 2, 5, 3);

    } else if (h.type === 'grav_well') {
      // ÇEKİM GİRDABI (GRAVITATIONAL WELL - STEP 5)
      ctx.fillStyle = 'rgba(88, 28, 135, 0.40)';
      ctx.beginPath();
      ctx.ellipse(h.x, h.y, h.r, h.r * 0.65, 0, 0, Math.PI * 2);
      ctx.fill();

      // Kozmik girdap spirali
      const rot = time * 0.12;
      ctx.strokeStyle = '#c084fc';
      ctx.lineWidth = 2.2;
      ctx.shadowColor = '#a855f7';
      ctx.shadowBlur = 0; /* 60fps */
      for (let arm = 0; arm < 3; arm++) {
        const sa = rot + (arm * Math.PI * 2 / 3);
        ctx.beginPath();
        ctx.moveTo(h.x, h.y);
        ctx.quadraticCurveTo(
          h.x + Math.cos(sa + 0.6) * (h.r * 0.7),
          h.y + Math.sin(sa + 0.6) * (h.r * 0.45),
          h.x + Math.cos(sa + 1.2) * h.r,
          h.y + Math.sin(sa + 1.2) * (h.r * 0.65)
        );
        ctx.stroke();
      }
      ctx.shadowBlur = 0;
      // Core singularity
      ctx.fillStyle = '#ffffff';
      ctx.beginPath();
      ctx.arc(h.x, h.y, 3.5, 0, Math.PI * 2);
      ctx.fill();
    } else if (h.type === 'sand') {
      // ÇÖL GİRDABI & BATAK KUM ÇUKURU (SWIRLING QUICKSAND VORTEX)
      const sandG = ctx.createRadialGradient(h.x, h.y, 2, h.x, h.y, h.r);
      sandG.addColorStop(0, '#78350f');
      sandG.addColorStop(0.5, '#b45309');
      sandG.addColorStop(0.85, '#d97706');
      sandG.addColorStop(1, 'transparent');
      ctx.fillStyle = sandG;
      ctx.beginPath();
      ctx.ellipse(h.x, h.y, h.r, h.r * 0.52, 0, 0, Math.PI * 2);
      ctx.fill();

      // Dönen kum spirali & tanecikleri
      ctx.strokeStyle = '#fde68a';
      ctx.lineWidth = 1.6;
      ctx.beginPath();
      const sRot = time * 0.08;
      for (let ring = 0; ring < 3; ring++) {
        const rad = h.r * (0.35 + ring * 0.25);
        ctx.ellipse(h.x, h.y, rad, rad * 0.5, sRot + ring, 0, Math.PI * 1.5);
      }
      ctx.stroke();

      // Kum partikülleri
      ctx.fillStyle = '#fef08a';
      for (let sp = 0; sp < 4; sp++) {
        const sa = time * 0.12 + sp * 1.57;
        const sr = h.r * 0.55;
        ctx.fillRect(h.x + Math.cos(sa) * sr, h.y + Math.sin(sa) * (sr * 0.5), 2, 2);
      }
    } else {
      // =========================================================================
      // KADİM ZEHİRLİ ASİT & BATAKLIK GÖLETİ (BUBBLING TOXIC SLUDGE MIRE)
      // =========================================================================
      // 1. Koyu organik bataklık tabanı
      const mireG = ctx.createRadialGradient(h.x, h.y, 2, h.x, h.y, h.r);
      mireG.addColorStop(0, '#052e16');
      mireG.addColorStop(0.65, '#14532d');
      mireG.addColorStop(0.9, '#166534');
      mireG.addColorStop(1, 'transparent');
      ctx.fillStyle = mireG;
      ctx.beginPath();
      ctx.ellipse(h.x, h.y, h.r, h.r * 0.55, 0, 0, Math.PI * 2);
      ctx.fill();

      // 2. Neon asit çeper çizgisi
      ctx.strokeStyle = '#22c55e';
      ctx.lineWidth = 2.0;
      ctx.globalAlpha = 0.85;
      ctx.beginPath();
      ctx.ellipse(h.x, h.y, h.r * 0.95, h.r * 0.52, 0, 0, Math.PI * 2);
      ctx.stroke();

      // 3. İçte fokurdayan parlak toksik asit köpükleri (Bubbling slime)
      ctx.fillStyle = '#86efac';
      for (let b = 0; b < 5; b++) {
        const bPhase = time * 0.14 + b * 1.35;
        const bScale = Math.abs(Math.sin(bPhase));
        const bOffX = Math.cos(b * 1.8) * (h.r * 0.55);
        const bOffY = Math.sin(b * 1.8) * (h.r * 0.28);
        const bRad = 1.5 + bScale * 3.0;

        ctx.beginPath();
        ctx.arc(h.x + bOffX, h.y + bOffY, bRad, 0, Math.PI * 2);
        ctx.fill();

        // Küçük parlama noktası
        if (bScale > 0.4) {
          ctx.fillStyle = '#ffffff';
          ctx.fillRect(h.x + bOffX - 1, h.y + bOffY - bRad * 0.5, 1.5, 1.5);
          ctx.fillStyle = '#86efac';
        }
      }

      // 4. Göletten yukarı yükselen zehirli spor buharları
      ctx.fillStyle = '#4ade80';
      for (let v = 0; v < 3; v++) {
        const vAng = time * 0.09 + v * 2.1;
        const vx = h.x + Math.sin(vAng) * (h.r * 0.4);
        const vy = h.y - 3 - Math.abs(Math.sin(time * 0.12 + v)) * 14;
        ctx.fillRect(vx, vy, 2, 2);
      }
    }
    ctx.restore();
  });

  obstacles.forEach(o => {
    if (o.x < cullL - (o.r || 40) || o.x > cullR + (o.r || 40) || o.y < cullT - (o.r || 40) || o.y > cullB + (o.r || 40)) return;
    drawBlock3d(o, biome);
  });

  zones.forEach(z => {
    const zr = (z.r || 60) + 10;
    if (z.x < cullL - zr || z.x > cullR + zr || z.y < cullT - zr || z.y > cullB + zr) return;
    if (z.type === 'steam_cloud') {
      // ─── BUHAR BULUTU (SCALDING STEAM CLOUD - STEP 6) ───
      ctx.save();
      const pAlpha = Math.min(1.0, z.life / (z.maxLife || 3.5));
      const sGrad = ctx.createRadialGradient(z.x, z.y, 4, z.x, z.y, z.r);
      sGrad.addColorStop(0, 'rgba(241, 245, 249, ' + (0.55 * pAlpha) + ')');
      sGrad.addColorStop(0.6, 'rgba(186, 230, 253, ' + (0.35 * pAlpha) + ')');
      sGrad.addColorStop(1, 'transparent');
      ctx.fillStyle = sGrad;
      ctx.beginPath();
      ctx.arc(z.x, z.y, z.r, 0, Math.PI * 2);
      ctx.fill();
      for (let sp = 0; sp < 4; sp++) {
        const pa = time * 0.08 + (sp * Math.PI / 2);
        const px = z.x + Math.cos(pa) * (z.r * 0.45);
        const py = z.y + Math.sin(pa) * (z.r * 0.45);
        ctx.fillStyle = 'rgba(255, 255, 255, ' + (0.28 * pAlpha) + ')';
        ctx.beginPath();
        ctx.arc(px, py, z.r * 0.35, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.restore();
    } else if (z.type === 'thorn') {
      // ─── DİKEN TARLASI (ÖZEL NET GÖRSEL ETKİ ALANI & YERDEN FIRLAYAN SİVRİ DİKENLER) ───
      const pulse = 1 + Math.sin(time * 0.16) * 0.03;
      const zr = z.r * pulse;
      const grow = Math.min(1.0, ((z.maxLife || 280) - z.life) / 16);

      ctx.save();
      // 1. Zemin Etki Alanı Dolgusu (Net görülebilen zümrüt/yosun yarıçap alanı)
      const zG = ctx.createRadialGradient(z.x, z.y, zr * 0.15, z.x, z.y, zr);
      zG.addColorStop(0, 'rgba(20, 83, 45, 0.52)');
      zG.addColorStop(0.7, 'rgba(22, 101, 52, 0.35)');
      zG.addColorStop(0.95, 'rgba(34, 197, 94, 0.18)');
      zG.addColorStop(1, 'transparent');
      ctx.fillStyle = zG;
      ctx.beginPath();
      ctx.arc(z.x, z.y, zr, 0, Math.PI * 2);
      ctx.fill();

      // Net ve Keskin Dış Sınır Çemberi (AoE Boundary)
      ctx.strokeStyle = '#22c55e';
      ctx.lineWidth = 3.2;
      ctx.shadowColor = '#4ade80';
      ctx.shadowBlur = 0; /* 60fps */
      ctx.beginPath();
      ctx.arc(z.x, z.y, zr, 0, Math.PI * 2);
      ctx.stroke();
      ctx.shadowBlur = 0;

      // İç Rehber Konsantrik Çemberi (Kesikli Parlayan Neon Yeşil Rün)
      ctx.strokeStyle = 'rgba(163, 230, 53, 0.65)';
      ctx.lineWidth = 1.6;
      ctx.setLineDash([7, 5]);
      ctx.beginPath();
      ctx.arc(z.x, z.y, zr * 0.55, 0, Math.PI * 2);
      ctx.stroke();
      ctx.setLineDash([]);

      // Çember Çevresindeki Koruyucu Diken Dişleri (14 Adet Dışa Bakan Sivri Bramble)
      const teethCount = 14;
      ctx.fillStyle = '#166534';
      ctx.strokeStyle = '#052e16';
      ctx.lineWidth = 1.2;
      for (let tIdx = 0; tIdx < teethCount; tIdx++) {
        const tAng = (tIdx / teethCount) * Math.PI * 2 + (z.spin || 0);
        const tipX = z.x + Math.cos(tAng) * (zr + 8 * grow);
        const tipY = z.y + Math.sin(tAng) * (zr + 8 * grow);
        const p1X = z.x + Math.cos(tAng - 0.12) * (zr - 4);
        const p1Y = z.y + Math.sin(tAng - 0.12) * (zr - 4);
        const p2X = z.x + Math.cos(tAng + 0.12) * (zr - 4);
        const p2Y = z.y + Math.sin(tAng + 0.12) * (zr - 4);
        ctx.beginPath();
        ctx.moveTo(p1X, p1Y);
        ctx.lineTo(tipX, tipY);
        ctx.lineTo(p2X, p2Y);
        ctx.closePath();
        ctx.fill();
        ctx.stroke();
      }

      // 2. Alan İçinde Konsantrik Halkalar Halinde Yerden Yükselen Sivri Piksel Dikenler
      const thornDefs = [
        // Dış halka (8 adet uzun zümrüt diken)
        { ring: 0.82, count: 8, baseH: 24, baseW: 9, rotOff: 0 },
        // Orta halka (6 adet orta diken)
        { ring: 0.52, count: 6, baseH: 19, baseW: 8, rotOff: 0.4 },
        // İç halka (3 adet merkez koruyucu diken)
        { ring: 0.24, count: 3, baseH: 15, baseW: 7, rotOff: 0.8 }
      ];

      thornDefs.forEach(td => {
        for (let k = 0; k < td.count; k++) {
          const kAng = (k / td.count) * Math.PI * 2 + td.rotOff + (z.spin || 0) * 0.5;
          const kDist = z.r * td.ring;
          const thX = z.x + Math.cos(kAng) * kDist;
          const thY = z.y + Math.sin(kAng) * kDist;
          const h = td.baseH * grow;
          const halfW = (td.baseW * 0.5) * grow;
          const sway = Math.sin(time * 0.18 + k + td.ring) * 1.6;

          ctx.save();
          ctx.translate(Math.round(thX), Math.round(thY));

          // Diken altındaki çatlamış zemin gölgesi
          ctx.fillStyle = 'rgba(10, 30, 15, 0.75)';
          ctx.beginPath();
          ctx.ellipse(0, 1, halfW * 1.4, halfW * 0.55, 0, 0, Math.PI * 2);
          ctx.fill();

          // Diken gövdesi (3D Piksel Fasetli Sivri Diken)
          // Sol faset (ışık alan parlak zümrüt)
          ctx.fillStyle = '#22c55e';
          ctx.beginPath();
          ctx.moveTo(sway, -h); // uç
          ctx.lineTo(-halfW, 0); // sol taban
          ctx.lineTo(sway * 0.3, -h * 0.3); // orta sırt
          ctx.closePath();
          ctx.fill();

          // Sağ faset (koyu gölge orman yeşili)
          ctx.fillStyle = '#166534';
          ctx.beginPath();
          ctx.moveTo(sway, -h); // uç
          ctx.lineTo(sway * 0.3, -h * 0.3); // orta sırt
          ctx.lineTo(halfW, 0); // sağ taban
          ctx.closePath();
          ctx.fill();

          // Diken dış kenar çizgisi
          ctx.strokeStyle = '#052e16';
          ctx.lineWidth = 1.3;
          ctx.beginPath();
          ctx.moveTo(-halfW, 0);
          ctx.lineTo(sway, -h);
          ctx.lineTo(halfW, 0);
          ctx.stroke();

          // Diken ucundaki parlak zehir damlası
          if (grow > 0.6) {
            ctx.fillStyle = '#facc15';
            ctx.fillRect(Math.round(sway - 1.5), Math.round(-h - 2), 3, 3);
            ctx.fillStyle = '#ffffff';
            ctx.fillRect(Math.round(sway - 0.5), Math.round(-h - 1.5), 1.5, 1.5);
          }
          ctx.restore();
        }
      });
      ctx.restore();
      return;
    }

    const pulse = 1 + Math.sin(time*0.12)*0.04;
    ctx.beginPath(); ctx.arc(z.x,z.y,z.r*pulse,0,Math.PI*2);
    ctx.fillStyle = visHex(z.color, 'char'); ctx.globalAlpha = z.type==='wrap' ? 0.12 : 0.16; ctx.fill();
    ctx.globalAlpha = 0.55; ctx.strokeStyle = visHex(z.color, 'char'); ctx.lineWidth = 2; ctx.stroke();
    ctx.globalAlpha = 1;
    if (z.spin == null) z.spin = (z.x * 0.013 + z.y * 0.021) % (Math.PI * 2);
    if (z.type === 'wrap') {
      const n = 7;
      for (let i = 0; i < n; i++) {
        const a = z.spin + i * (Math.PI * 2 / n);
        const rr = z.r * 0.78;
        const bx = z.x + Math.cos(a) * rr;
        const by = z.y + Math.sin(a) * rr * 0.62;
        drawBall3d(bx, by, 6.5, visHex('#c48a4a', 'char'), 5);
      }
    }
    if (z.type === 'vine') {
      ctx.strokeStyle = visHex('#1b7a40', 'char');
      ctx.lineWidth = 3;
      ctx.globalAlpha = 0.7;
      for (let i = 0; i < 8; i++) {
        const a = z.spin + i * (Math.PI * 2 / 8);
        ctx.beginPath();
        ctx.moveTo(Math.round(z.x), Math.round(z.y));
        ctx.lineTo(Math.round(z.x + Math.cos(a + 0.4) * z.r * 0.45), Math.round(z.y + Math.sin(a + 0.4) * z.r * 0.45));
        ctx.lineTo(Math.round(z.x + Math.cos(a) * z.r * 0.92), Math.round(z.y + Math.sin(a) * z.r * 0.92));
        ctx.stroke();
      }
      ctx.globalAlpha = 1;
    }
  });

  // Item 5: Düşman Ölüm Kalıntıları (Fade-out Çürüyen İskeletler & Savaş İzi)
  corpses.forEach(c => {
    if (c.x < cullL || c.x > cullR || c.y < cullT || c.y > cullB) return;
    const a = Math.max(0, Math.min(1, c.life));
    ctx.save();
    ctx.translate(Math.round(c.x), Math.round(c.y));
    ctx.globalAlpha = a * 0.40;
    ctx.fillStyle = '#0f172a';
    ctx.beginPath();
    ctx.ellipse(0, 0, c.r * 0.85, c.r * 0.45, 0, 0, Math.PI * 2);
    ctx.fill();

    // Küçük beyaz kemik / kalıntı pikselleri
    if (a > 0.25) {
      ctx.fillStyle = '#e2e8f0';
      ctx.fillRect(-2, -1, 3, 2);
      ctx.fillRect(1, 1, 2, 2);
    }
    ctx.restore();
  });

  enemies.forEach(en => {
    if (en.type !== 'boss' && (en.x < cullL || en.x > cullR || en.y < cullT || en.y > cullB)) return;
    if (en.slamT > 0) {
      if (en.slamT === 90) synthBlip('charge');
      const t = 1 - en.slamT / 90;
      ctx.save();
      ctx.globalAlpha = 0.2 + t * 0.35;
      ctx.fillStyle = '#00bcd4';
      ctx.beginPath(); ctx.arc(en.slamX, en.slamY, en.slamR, 0, Math.PI * 2); ctx.fill();
      ctx.strokeStyle = '#e0f7fa';
      ctx.lineWidth = 2.5;
      ctx.globalAlpha = 0.75 + t * 0.25;
      for (let i = 0; i < 6; i++) {
        const a = (time * 0.04) + i * (Math.PI / 3);
        const ex = en.slamX + Math.cos(a) * en.slamR;
        const ey = en.slamY + Math.sin(a) * en.slamR;
        ctx.beginPath();
        ctx.moveTo(en.slamX, en.slamY);
        ctx.lineTo(ex, ey);
        ctx.moveTo(en.slamX + Math.cos(a) * en.slamR * 0.6, en.slamY + Math.sin(a) * en.slamR * 0.6);
        ctx.lineTo(en.slamX + Math.cos(a + 0.35) * en.slamR * 0.85, en.slamY + Math.sin(a + 0.35) * en.slamR * 0.85);
        ctx.stroke();
      }
      ctx.strokeStyle = '#80deea';
      ctx.lineWidth = 3;
      ctx.beginPath(); ctx.arc(en.slamX, en.slamY, en.slamR * t, 0, Math.PI * 2); ctx.stroke();
      ctx.restore();
    }
    if (en.aimT > 0) {
      ctx.save();
      const aimCol = en.type === 'shooter' || en.type === 'shaman' ? 'rgba(233, 30, 99, 0.85)' : 'rgba(0, 229, 255, 0.85)';
      ctx.strokeStyle = aimCol;
      ctx.lineWidth = 2;
      ctx.setLineDash([5, 4]);
      ctx.beginPath();
      ctx.moveTo(en.x, en.y);
      ctx.lineTo(en.aimX, en.aimY);
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.restore();
    }
    if (en.pole && en.poleUntil && now < en.poleUntil) {
      ctx.save();
      ctx.strokeStyle = en.pole > 0 ? '#ef5350' : '#42a5f5';
      ctx.lineWidth = 2.2;
      ctx.globalAlpha = 0.88;
      ctx.beginPath();
      ctx.arc(en.x, en.y, en.r + 4, 0, Math.PI * 2);
      ctx.stroke();
      ctx.restore();
    }
    const fogged = false;
    let cy;
    if (en.isElite) {
      // Rotating Champion Mini Aura Ring under enemy
      ctx.save();
      const auraCol = en.titleCol || '#ffd700';
      ctx.strokeStyle = auraCol;
      ctx.lineWidth = 3.2;
      ctx.globalAlpha = 0.82 + Math.sin(time * 6) * 0.18;
      const baseR = en.r + 5.5 + Math.sin(time * 5) * 1.5;
      ctx.beginPath();
      ctx.arc(en.x, en.y, baseR, 0, Math.PI * 2);
      ctx.stroke();

      for (let dot = 0; dot < 3; dot++) {
        const dotAngle = (time * 0.08) + (dot * (Math.PI * 2 / 3));
        const dx = en.x + Math.cos(dotAngle) * baseR;
        const dy = en.y + Math.sin(dotAngle) * baseR;
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.arc(dx, dy, 2.2, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.restore();
    }
    if (en.type === 'boss') {
      cy = drawBiomeBoss(ctx, en.x, en.y, en.r, en, time, biome, fogged);
      if (en.fsmState === 'staggered') {
        ctx.save();
        // 3 Orbiting Daze Stars / Golden Runes
        const starCount = 3;
        const starDist = en.r + 14;
        const starAngle = time * 0.25;
        for (let s = 0; s < starCount; s++) {
          const sa = starAngle + (s / starCount) * Math.PI * 2;
          const sx = en.x + Math.cos(sa) * starDist;
          const sy = cy - en.r * 0.6 + Math.sin(sa) * (starDist * 0.38);
          ctx.fillStyle = '#ffd700';
          ctx.shadowColor = '#ffd700';
          ctx.shadowBlur = 0; /* 60fps */
          ctx.beginPath();
          ctx.arc(sx, sy, 3.8, 0, Math.PI * 2);
          ctx.fill();
        }
        // Pulsing Stagger Sign
        ctx.fillStyle = '#38bdf8';
        ctx.font = '900 13px sans-serif';
        ctx.textAlign = 'center';
        ctx.shadowColor = '#38bdf8';
        ctx.shadowBlur = 0; /* 60fps */
        const bob = Math.sin(time * 0.4) * 3;
        ctx.fillText('SERSEMLİK (%300 İNFAZ)', en.x, cy - en.r - 20 + bob);
        ctx.restore();
      }

      // STEP 8: VISUAL METAMORPHOSIS IN PHASE 2 (Enraged Crown, Orbiting Spheres & Rage Eyes)
      if (en.phase2) {
        ctx.save();
        const crownCol = (en.bossType === 'lava' || en.bossType === 'stone') ? '#ff3d00' :
                         en.bossType === 'ice' ? '#00e5ff' :
                         en.bossType === 'storm' ? '#facc15' :
                         en.bossType === 'forest' ? '#22c55e' :
                         en.bossType === 'sand' ? '#ffd700' :
                         en.bossType === 'water' ? '#00b0ff' :
                         en.bossType === 'pink' ? '#ff4081' :
                         en.bossType === 'night' ? '#c084fc' : '#ff1744';
        ctx.shadowColor = crownCol;
        ctx.shadowBlur = 0; /* 60fps */
        ctx.strokeStyle = crownCol;
        ctx.lineWidth = 2.5;

        // 1. Spiked Radiant Crown / Horns
        const crownP = Math.sin(time * 0.35) * 4;
        ctx.beginPath();
        ctx.moveTo(en.x - en.r * 0.7, cy - en.r * 0.8);
        ctx.lineTo(en.x - en.r * 1.0, cy - en.r * 1.4 - crownP);
        ctx.lineTo(en.x - en.r * 0.4, cy - en.r * 0.9);
        ctx.lineTo(en.x, cy - en.r * 1.6 - crownP * 1.2);
        ctx.lineTo(en.x + en.r * 0.4, cy - en.r * 0.9);
        ctx.lineTo(en.x + en.r * 1.0, cy - en.r * 1.4 - crownP);
        ctx.lineTo(en.x + en.r * 0.7, cy - en.r * 0.8);
        ctx.stroke();

        // 2. Dual Orbiting Elemental Plasma Spheres
        const orbR = en.r + 24;
        const orbSpeed = time * 0.18;
        for (let oi = 0; oi < 2; oi++) {
          const oAng = orbSpeed + oi * Math.PI;
          const ox = en.x + Math.cos(oAng) * orbR;
          const oy = cy + Math.sin(oAng) * (orbR * 0.45);
          ctx.fillStyle = crownCol;
          ctx.beginPath();
          ctx.arc(ox, oy, 5.5, 0, Math.PI * 2);
          ctx.fill();
          ctx.fillStyle = '#ffffff';
          ctx.beginPath();
          ctx.arc(ox, oy, 2.5, 0, Math.PI * 2);
          ctx.fill();
        }

        // 3. Menacing Enraged Red Eye Flares
        ctx.fillStyle = '#ff1744';
        ctx.shadowColor = '#ff1744';
        ctx.shadowBlur = 0; /* 60fps */
        ctx.fillRect(en.x - 7, cy - en.r * 0.25, 5, 3);
        ctx.fillRect(en.x + 2, cy - en.r * 0.25, 5, 3);
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(en.x - 6, cy - en.r * 0.25 + 1, 2, 2);
        ctx.fillRect(en.x + 3, cy - en.r * 0.25 + 1, 2, 2);

        ctx.restore();
      }
    } else {
      cy = drawBiomeEnemy(ctx, en, time, biome, fogged);
    }
    if (en.type === 'boss' && en.flashT > 0) {
