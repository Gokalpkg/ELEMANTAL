function getUnlockedEvolutions() {
  try {
    return JSON.parse(localStorage.getItem('elementer_unlocked_evolutions') || '[]');
  } catch(_) {
    return [];
  }
}

function triggerApexEvolution(apex, pairKeyStr) {
  if (!player || player._hasApexEvolution === apex.id) return;
  player._hasApexEvolution = apex.id;
  try {
    const list = getUnlockedEvolutions();
    if (!list.includes(apex.id)) {
      list.push(apex.id);
      localStorage.setItem('elementer_unlocked_evolutions', JSON.stringify(list));
    }
    if (typeof markComboSeen === 'function') {
      if (pairKeyStr) {
        markComboSeen(pairKeyStr.replace('+', '_'));
      }
      for (const [pk, def] of Object.entries(APEX_EVOLUTIONS)) {
        if (def.id === apex.id) {
          markComboSeen(pk.replace('+', '_'));
          break;
        }
      }
    }
  } catch(_) {}
  
  if (typeof showStreakBanner === 'function') {
    showStreakBanner(' EFSANEVİ SÜPER EVRİM: ' + apex.name + ' KİLİDİ AÇILDI! ', apex.color);
  }
  if (typeof spawnFloatText === 'function') {
    spawnFloatText(player.x, player.y - 48, ' ' + apex.name + '!', apex.color, 'big');
  }
  if (typeof triggerScreenFlash === 'function') {
    triggerScreenFlash(apex.color, 0.45, 240);
  }
  if (typeof playPunchySubBass === 'function') {
    playPunchySubBass(55, 0.35, 1.0);
  }
  if (typeof synthBlip === 'function') {
    synthBlip('stagger_gong');
  }
  if (typeof vibrate === 'function') {
    vibrate([40, 60, 40, 80]);
  }
}

