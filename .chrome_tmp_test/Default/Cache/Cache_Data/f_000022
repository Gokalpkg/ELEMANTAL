  meta.crystals = (meta.crystals || 0) + totalRefund;
  saveMeta(meta);
  fillCrystalHud();
  renderTreeNodes();
  synthBlip('legendary');
  playMetallicRing(1800, true);
  spawnFloatText(W / 2, H / 2, ' ' + totalRefund + ' KRİSTAL İADE EDİLDİ!', '#facc15', true);
}

