      ? (ELEMENTS[pendingElement].name + ' ile birleşecek 2. elementi seç · ' + slotIdx + '. SKİLL TAMAMLANACAK!')
      : (isFirstPick ? 'Tüm elementlerden başlangıç gücünü seç.' : ('Güç ' + slotIdx + ' için bir temel element seç.'));
  }

  const row = document.getElementById('choiceRow');
  if (!row) { paused = false; return; }
  row.innerHTML = '';

  // Oyun başında tüm elementleri göster, füzyon için 3 aday sun (Saf Mono-Element füzyonları dahil!)
  let allKeys = Object.keys(ELEMENTS);
  let keys;
  if (isFirstPick) {
    keys = allKeys;
  } else {
    keys = shuffle(allKeys).slice(0, 3);
  }
  row.className = 'choice-row' + (isFirstPick ? ' all-elements' : '');

  keys.forEach(k => {
    const e = ELEMENTS[k];
    const div = document.createElement('button');
    div.type = 'button';
    div.className = 'choice-card ' + k;
    div.style.borderColor = e.color;
    div.style.boxShadow = '0 0 22px ' + e.color + '55, inset 0 0 14px ' + e.color + '22';

    let title = e.name;
    let hint = ELEMENT_QUICK_HINTS[k] || ('Sürekli ' + e.name + ' atışı');
    let iconHtml = '<img src="img/rune-' + k + '.png" class="card-rune-img" alt="' + e.name + '">';

    const isMonoFusion = isSecondOfPair && k === pendingElement;
    if (pendingElement) {
      const kit = COMBO_KITS[pendingElement + '_' + k] || COMBO_KITS[k + '_' + pendingElement];
      title = COMBO_NAMES[pendingElement + '_' + k] || COMBO_NAMES[k + '_' + pendingElement] || (ELEMENTS[pendingElement].name + ' + ' + e.name);
      hint = kit ? ((kit.tag || '') + (kit.desc ? ' · ' + kit.desc.split(',')[0].slice(0, 44) : '')) : (e.name + ' füzyonu');
      iconHtml = '<div class="card-combo-icons"><img src="img/rune-' + pendingElement + '.png" class="card-rune-img small"><span class="combo-plus">+</span><img src="img/rune-' + k + '.png" class="card-rune-img small"></div>';
    }

    const badgeText = isMonoFusion ? 'SAF FÜZYON' : isSecondOfPair ? 'FÜZYON ADAYI' : 'TEMEL ELEMENT';
    const badgeBg = isMonoFusion ? '#ffd70030' : e.color + '25';
    const badgeBorder = isMonoFusion ? '#ffd700aa' : e.color + '88';
    const badgeColor = isMonoFusion ? '#ffd700' : e.glow;
    const badgeHtml = '<div class="card-rarity-badge" style="background:' + badgeBg + ';color:' + badgeColor + ';border:1px solid ' + badgeBorder + ';display:flex;align-items:center;justify-content:center;gap:5px;">' + renderPixelIcon(k, 'px-anim-float', 12) + ' ' + badgeText + '</div>';
    const runeWrapHtml = '<div class="card-rune-wrap" style="border:2px solid ' + e.color + '99;background:' + e.color + '18;border-radius:12px;box-shadow:0 0 14px ' + e.color + '40;">' + iconHtml + '</div>';
    const nameHtml = '<span class="name" style="font-size:15px;font-weight:900;display:flex;align-items:center;justify-content:center;gap:7px;">' + renderPixelIcon(k, 'px-anim-float', 16) + ' ' + title + '</span>';
    const hintHtml = '<span class="hint" style="font-size:12px;line-height:1.4;color:#e2e8f0;">' + hint + '</span>';

    div.innerHTML = badgeHtml + runeWrapHtml + nameHtml + hintHtml;

    let picked = false;
    bindTouchButton(div, () => {
      if (picked) return;
      picked = true;
      div.style.pointerEvents = 'none';
      pickElement(k);
    });
    row.appendChild(div);
  });

  document.getElementById('levelUpOverlay').classList.add('show');
  syncRerollFab();
}

function pickElement(k) {
  pickHistory.push(k);
  if (!runLock.root) {
    runLock.root = k;
    updateAdaptiveQuest(k);
  }
  const e = ELEMENTS[k];

  if (pactEl && k === pactEl) {
    pactHave++;
    if (pactHave >= 2 && !pactArmed) {
      pactArmed = true;
      spawnFloatText(player.x, player.y - 48, 'Sözleşme tamam', e.color);
    }
  }

  const copies = pickHistory.filter(x => x === k).length;
  if (copies >= 3) {
    overchargeEl = k;
    spawnFloatText(player.x, player.y - 36, 'AŞIRI YÜKLEME: ' + e.name, e.color);
    const R = 150;
    enemiesInRange(R).forEach(en => takeDamage(en, 18, k));
    pruneDeadEnemies();
    burst(player.x, player.y, e.color, 22, 4);
    particles.push({ x: player.x, y: player.y, r: 12, maxR: R, life: 1, color: e.color, lw: 4 });
    playSfx('skill', 0.4, 400);
    vibrate([25, 35, 25]);
  }

  if (pendingElement) {
    const combo = comboInfo(pendingElement, k);
    lockedCombos.push(combo);
    markComboSeen(combo.key);
    skillState.push({ charge: combo.cd, ready: true });

    if (!runLock.secondary && lockedCombos.length === 1) {
      runLock.secondary = k;
      runLock.forkDone = true;
      runLock.path = FUSION_CLASS_MAP[pairSorted(runLock.root, k)] || 'stain';
      applyClassForkBonuses();
    }

    const skillNum = lockedCombos.length;
    pendingElement = null;

    spawnFloatText(player.x, player.y - 32, ' ' + skillNum + '. SKİLL TAMAMLANDI! ' + combo.name, combo.color, 'big');
    showStreakBanner(' ' + skillNum + '. SKİLL TAMAMLANDI: ' + combo.name.toUpperCase() + '!', combo.color);
    burst(player.x, player.y, combo.color, 26, 4.5);
    triggerScreenFlash(combo.color, 0.4, 250);
    playSfx('confirm', 0.55);
    vibrate([40, 60, 40, 70]);
  } else {
    pendingElement = k;
    // Removed floating element name on player to maintain combat visual clarity
    burst(player.x, player.y, e.color, 12, 2.5);
    playSfx('tick', 0.4);
  }

  refreshSkillUI(true);
  closeReward();
}

function loadBest() {
  try { return JSON.parse(localStorage.getItem('elementer-best') || 'null'); } catch (e) { return null; }
}
function saveBest() {
  const prev = loadBest() || { score: 0, wave: 0 };
  if (score >= prev.score) {
    try { localStorage.setItem('elementer-best', JSON.stringify({ score, wave, level: player.level })); } catch (e) {}
  }
  try {
    const m = loadMeta();
    m.bestWave = Math.max(m.bestWave || 0, wave || 0);
    m.bestScore = Math.max(m.bestScore || 0, score || 0);
    saveMeta(m);
  } catch (e) {}
}
function fillBestLabel() {
  try {
