/* --- Mobil Safe-Area & Ergonomi İyileştirmeleri --- */
:root {
  --sat: env(safe-area-inset-top, 0px);
  --sab: env(safe-area-inset-bottom, 0px);
  --sal: env(safe-area-inset-left, 0px);
  --sar: env(safe-area-inset-right, 0px);
}
#hud {
  top: max(10px, env(safe-area-inset-top, 0px)) !important;
  left: max(10px, env(safe-area-inset-left, 0px)) !important;
  right: calc(max(10px, env(safe-area-inset-right, 0px)) + 52px) !important;
  max-width: min(480px, 94vw);
}
#skillBar {
  bottom: max(14px, calc(env(safe-area-inset-bottom, 0px) + 10px)) !important;
}
#rerollFab {
  bottom: max(14px, calc(env(safe-area-inset-bottom, 0px) + 14px)) !important;
  right: max(14px, env(safe-area-inset-right, 0px)) !important;
}
.overlay {
  padding: max(16px, env(safe-area-inset-top, 0px)) 16px max(20px, env(safe-area-inset-bottom, 0px)) !important;
  overflow-y: auto !important;
  -webkit-overflow-scrolling: touch;
}
.choice-row {
  max-height: 70vh;
  overflow-y: auto;
}
@media (max-width: 380px) {
  .btn { padding: 10px 14px; font-size: 13px; }
  .choice-card { padding: 12px 10px; }
  #skillBar { gap: 6px; }
  .skill-btn { width: 50px; height: 50px; }
}
@media (max-height: 640px) {
  #hud { top: max(6px, env(safe-area-inset-top, 0px)) !important; }
  #bossHud { top: max(74px, calc(env(safe-area-inset-top, 0px) + 64px)) !important; }
  .overlay h1 { font-size: 20px; margin-bottom: 4px; }
  .overlay h2 { font-size: 18px; margin-bottom: 4px; }
  .menu-btn-col { gap: 8px; }
}
@media (orientation: landscape) and (max-height: 480px) {
  #skillBar { bottom: 6px !important; }
  .skill-btn { width: 44px; height: 44px; }
}


