// =========================================================================
function triggerScaledHitstop(type) {
  const now = performance.now();
  let ms = 18; // Normal hit: 1 frame
  if (type === 'crit') ms = 48; // Crit: 3 frames
  else if (type === 'parry') ms = 70; // Parry: 4-5 frames
  else if (type === 'boss_stagger') ms = 90; // Boss Stagger: 5-6 frames
  hitStopUntil = Math.max(hitStopUntil || 0, now + ms);
}

function triggerHitStop(val) {
  const now = performance.now();
  if (now - lastHitStopAt < 220) return; // 220ms throttle prevents boss combat stutter and keeps 60/120 FPS buttery smooth
  lastHitStopAt = now;
  let dur = 24;
  if (typeof val === 'number') {
    if (val <= 12) {
      dur = Math.round(val * 16.67);
    } else {
      dur = val;
    }
  }
  dur = Math.min(66, Math.max(16, dur)); // Capped at 4 frames max
  hitStopUntil = now + dur;
  hitStopFrames = Math.ceil(dur / 16.67);
}
function tryPerfectDodge() {
  const now = performance.now();
  if (now > dodgeUntil) return false;
  if (now - lastDodgeAt < 700) return false;
  lastDodgeAt = now;
  perfectUntil = now + 2000;
  window.bulletTimeTimer = 28;
  if (player) player._guaranteedCrit = true;
  triggerScreenFlash('#ffd700', 0.25, 120);
  showStreakBanner(' KADER ANI: KUSURSUZ KAÇIŞ!', '#ffd700');
  playerBuff.as = Math.max(playerBuff.as || 0, 50);
  playerBuff.until = Math.max(playerBuff.until || 0, now + 2000);
  if (modLv('timeDodge')) {
    timeDodgeTimer = 120;
    spawnFloatText(player.x, player.y - 45, ' Zaman Büküldü!', '#9b7dff');
  } else {
    spawnFloatText(player.x, player.y - 30, 'Kusursuz!', '#7ee8ff');
  }
  addFlow(12, 'Kaçış');
  playSfx('confirm', 0.28, 620);
  return true;
}
function onPlayerHitEnemy(en, opts) {
  opts = opts || {};
  const isBoss = en && en.type === 'boss';
  const heavy = opts.heavy || opts.el === 'earth' || opts.el === 'fire';
  const crit = !!opts.crit;
  
  // Dynamic Hit-Stop
  if (crit || (isBoss && heavy)) {
    triggerHitStop(crit && isBoss ? 4 : crit ? 3 : 2);
  } else if (heavy) {
    triggerHitStop(2);
  }
  
  // Screen Shake & Camera Kick
  const addedShake = crit ? (isBoss ? 16 : 9) : heavy ? 6 : 3.5;
  shake = Math.max(shake, addedShake);
  camKick = Math.max(camKick, crit ? 8 : 4);
  
  // Squash & Stretch impact reaction on enemy
  if (en) {
    en.squashT = 1.0;
    en.squashScale = crit ? 0.78 : 0.88;
    en.flashT = Math.max(en.flashT || 0, crit ? 6 : 4);
  }
  
  // Haptic feedback
  if (crit) {
    vibrate([25, 30, 25]);
  } else if (heavy) {
    vibrate('light');
  }

  // Kademe 2: Nihai Süper Yetenek (Rage) Enerjisi Biriktirme
  if (ultEnergy < MAX_ULT_ENERGY) {
    const gain = crit ? 2.5 : 1.2;
    ultEnergy = Math.min(MAX_ULT_ENERGY, ultEnergy + gain);
    if (ultEnergy >= MAX_ULT_ENERGY) {
      spawnFloatText(player.x, player.y - 36, ' KADİM ULTİ HAZIR! ', '#ffd700', 'big');
      synthBlip('legendary');
      playSfx('skill', 0.45, 880);
      vibrate([40, 60, 40]);
    }
    syncUltFab();
  }

  // Çevresel Kırıntı — element vuruşları arka plana iz bırakır
  if (opts.el && en) {
