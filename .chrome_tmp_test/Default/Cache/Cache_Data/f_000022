    const now = performance.now();
    if (now - _crystalChimeLastTime > 900) {
      _crystalChimeStreak = 0;
    }
    _crystalChimeLastTime = now;
    const freq = PENTATONIC_FREQS[_crystalChimeStreak % PENTATONIC_FREQS.length];
