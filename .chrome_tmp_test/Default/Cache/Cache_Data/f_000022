function playSfx(name, vol, gap) {
  if (!sfxOn || sfxVol <= 0.02) return;
  forceResumeAudio();
  // Tactile instant synthesis for UI & ticks
  if (name === 'tick' || name === 'ui') {
    if (typeof playTactileClick === 'function') playTactileClick(name === 'ui' ? 'high' : 'low');
  }
  // Try audio tag buffer if available
  const ch = SFX_CH[name] || 'ui';
  const now = performance.now();
  const wait = gap != null ? gap : (SFX_GAP[ch] || 120);
  if (sfxLast[ch] && now - sfxLast[ch] < wait) return;
  sfxLast[ch] = now;

  let audioPlayed = false;
  if (sfxBuf[name]) {
    try {
      let a = sfxOne[name];
      if (!a) { a = sfxBuf[name].cloneNode(true); sfxOne[name] = a; }
      a.pause();
      try { a.currentTime = 0; } catch (e) {}
      a.volume = Math.max(0, Math.min(1, (vol == null ? 0.85 : vol) * sfxVol));
      a.playbackRate = 0.92 + Math.random() * 0.16;
      const p = a.play();
      if (p && typeof p.then === 'function') {
        p.then(() => { audioPlayed = true; }).catch(() => {
          fallbackSynthVoice(name);
        });
      }
    } catch (e) {
      fallbackSynthVoice(name);
    }
  } else {
    fallbackSynthVoice(name);
  }
}
function fallbackSynthVoice(name) {
  if (typeof synthBlip === 'function') {
    if (name === 'legendary') synthBlip('legendary');
    else if (name === 'charge' || name === 'laser_charge') synthBlip('charge');
    else if (name === 'dash') synthBlip('dash_whoosh');
    else if (name === 'shield') { synthBlip('elem_earth'); if (typeof playPunchySubBass === 'function') playPunchySubBass(120, 0.2, 0.4); }
    else if (name === 'hurt') synthBlip('hit');
    else if (name === 'shock') synthBlip('elem_storm');
    else if (name === 'shatter') synthBlip('elem_water');
    else if (name === 'block') { if (typeof playMetallicRing === 'function') playMetallicRing(1300, false); else synthBlip('hit'); }
    else if (name === 'bubble') synthBlip('elem_water');
    else if (name === 'glass') { synthBlip('elem_water'); if (typeof playMetallicRing === 'function') playMetallicRing(1800, false); }
    else if (name === 'heal') synthBlip('elem_nature');
    else if (name === 'level') synthBlip('level');
    else if (name === 'kill') { synthBlip('hit'); if (typeof playPunchySubBass === 'function') playPunchySubBass(100, 0.15, 0.35); }
    else if (name === 'explode') { synthBlip('elem_fire'); if (typeof playPunchySubBass === 'function') playPunchySubBass(80, 0.35, 0.6); }
    else synthBlip('hit');
  }
}
