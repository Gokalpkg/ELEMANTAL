}
function updateWeave() {
  if (weaveLock > 0) weaveLock -= 1;
  if (!player.moving) return;
  const last = weavePts[weavePts.length - 1];
  if (last && Math.hypot(player.x - last.x, player.y - last.y) < 10) return;
  const np = { x: player.x, y: player.y };
  const start = weavePts[0];
  weaveNear = !!(start && weavePts.length >= 10 && Math.hypot(player.x - start.x, player.y - start.y) < 52);
  if (start && weavePts.length >= 12 && weaveLock <= 0 && Math.hypot(np.x - start.x, np.y - start.y) < 28) {
    const poly = weavePts.concat([np]);
    const area = polyArea(poly);
    if (area >= 1400 && area < 120000) {
      closeWeave(poly);
      weavePts = [];
      weaveLock = 36;
      weaveNear = false;
      return;
    }
  }
  if (weavePts.length >= 5 && weaveLock <= 0) {
    const a = weavePts[weavePts.length - 1];
    for (let i = 0; i < weavePts.length - 3; i++) {
      const hit = segsHit(a, np, weavePts[i], weavePts[i + 1]);
      if (!hit) continue;
      const poly = [hit].concat(weavePts.slice(i + 1), [np]);
      if (poly.length < 6) continue;
      const area = polyArea(poly);
      if (area < 1400 || area > 120000) continue;
      closeWeave(poly);
      weavePts = [];
      weaveLock = 36;
      return;
    }
  }
  weavePts.push(np);
  if (weavePts.length > 100) weavePts.shift();
}

