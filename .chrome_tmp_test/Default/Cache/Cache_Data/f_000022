function checkAchievements() {
  const lt = getLifetimeStats();
  const ach = getAchievements();
  let newUnlocks = [];
  GAME_ACHIEVEMENTS.forEach(a => {
    if (ach[a.id]) return;
    const val = lt[a.stat] || 0;
    if (val >= a.target) {
      ach[a.id] = { at: Date.now() };
      newUnlocks.push(a);
      let m = typeof meta !== 'undefined' ? meta : loadMeta();
      m.crystals = (m.crystals || 0) + a.reward;
      saveMeta(m);
      if (typeof crystals !== 'undefined') crystals += a.reward;
    }
  });
  if (newUnlocks.length) {
    saveAchievements(ach);
    if (typeof saveCrystals === 'function') saveCrystals();
    newUnlocks.forEach(a => {
      if (typeof showStreakBanner === 'function') showStreakBanner('🏆 BAŞARIM: ' + a.name + ' (+' + a.reward + '💎)', '#ffd700');
    });
  }
}

function updateLifetimeStats() {
  const lt = getLifetimeStats();
  lt.totalKills = (lt.totalKills || 0) + (runStats.kills || 0);
  lt.maxWave = Math.max(lt.maxWave || 0, wave || 0);
  lt.maxStreak = Math.max(lt.maxStreak || 0, runStats.maxStreak || killCombo || 0);
  lt.peakDps = Math.max(lt.peakDps || 0, runStats.peakDps || 0);
  lt.eliteKills = (lt.eliteKills || 0) + (runStats.eliteKills || 0);
  lt.evolutions = (lt.evolutions || 0) + (runStats.evolutions || 0);
  saveLifetimeStats(lt);
  checkAchievements();
}

