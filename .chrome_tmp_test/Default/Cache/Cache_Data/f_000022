function syncRerollFab() {
  const show = overlayBusy() && rerollsLeft > 0;
  const fab = document.getElementById('rerollFab');
  if (fab) {
    fab.classList.toggle('show', !!show);
    fab.innerHTML = renderPixelIcon('respec') + ' Yenile (' + (rerollsLeft || 0) + ')';
  }
  const btns = document.querySelectorAll('[data-reroll], .reroll-card-btn');
  btns.forEach(btn => {
    btn.disabled = !show;
    const countEl = btn.querySelector('.reroll-count');
    if (countEl) countEl.textContent = `(${rerollsLeft || 0})`;
    else btn.innerHTML = `${renderPixelIcon('respec')} Yenile (${rerollsLeft || 0})`;
