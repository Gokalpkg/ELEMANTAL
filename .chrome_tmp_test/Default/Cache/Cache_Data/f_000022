function devJumpToWave(targetWave) {
  targetWave = Math.max(1, parseInt(targetWave, 10) || 1);

  emptyState();

  selectedKit = 'balanced';
  dailyRun = false;
  document.body.classList.remove('in-menu');
  hideAllOverlays();
  deathReason = '';
  endlessMode = (targetWave >= 20);
  running = true;
  paused = false;
  menuOpen = false;
  resetJoystick();

  if (waveTimer) { clearTimeout(waveTimer); waveTimer = null; }

  wave = targetWave;

  const bIdx = Math.floor((wave - 1) / 2) % BIOMES.length;
  biomeIndex = bIdx;
  seedBiome(bIdx);
  obstacles = [];
  addWaveObstacles();

  const expectedLv = Math.max(1, 1 + (wave - 1) * 2);
  player.level = expectedLv;
  player.xp = 0;
  player.xpNeed = xpToNext(player.level);

  const curHero = getSelectedHero();
  const heroBaseHp = curHero.hp || 160;
  const heroBaseSpeed = curHero.speed || 4.2;
  const hpBonus = (player.level - 1) * 8;
  player.maxHp = Math.round(heroBaseHp * (1 + treeLv('hp') * 0.05) + hpBonus);
  player.hp = player.maxHp;
  player.speed = heroBaseSpeed * (1 + treeLv('speed') * 0.04);
  if (!player.mods) player.mods = {};
  if (curHero.atkSpeedBonus) {
    player.mods.atkSpeed = (player.mods.atkSpeed || 0) + curHero.atkSpeedBonus;
  }
  if (curHero.critBonus) {
    player.mods.crit = (player.mods.crit || 0) + curHero.critBonus;
  }
  if (curHero.def) {
    player.mods.def = (player.mods.def || 0) + curHero.def;
  }
  player.invuln = 90;
  player.x = originX + MAP_W / 2;
  player.y = originY + MAP_H / 2;
  player.vx = 0;
  player.vy = 0;
  cam.x = player.x - W / 2;
  cam.y = player.y - H / 2;
  camX = cam.x;
  camY = cam.y;

  pickHistory = [];
  lockedCombos = [];
  skillState = [];
  pendingElement = null;

  const sampleCombos = [
    { a: 'fire', b: 'earth' },
    { a: 'water', b: 'storm' },
    { a: 'nature', b: 'void' }
  ];

  let completedCombosCount = 0;
  let hasPending = false;

  if (wave <= 2) {
    pickHistory = ['fire'];
    pendingElement = 'fire';
    runLock.root = 'fire';
  } else if (wave <= 4) {
    completedCombosCount = 1;
    if (wave === 4) hasPending = true;
  } else if (wave <= 6) {
    completedCombosCount = 2;
    if (wave === 6) hasPending = true;
  } else {
    completedCombosCount = 3;
  }

  for (let i = 0; i < completedCombosCount; i++) {
    const pair = sampleCombos[i];
    if (!pickHistory.includes(pair.a)) pickHistory.push(pair.a);
    if (!pickHistory.includes(pair.b)) pickHistory.push(pair.b);
    const combo = comboInfo(pair.a, pair.b);
    lockedCombos.push(combo);
    markComboSeen(combo.key);
    skillState.push({ charge: combo.cd, ready: true });
    if (i === 0) {
      runLock.root = pair.a;
      runLock.secondary = pair.b;
      runLock.forkDone = true;
      runLock.path = FUSION_CLASS_MAP[pairSorted(pair.a, pair.b)] || 'stain';
    }
  }

  if (hasPending && completedCombosCount < 3) {
    const nextRoot = sampleCombos[completedCombosCount].a;
    if (!pickHistory.includes(nextRoot)) pickHistory.push(nextRoot);
    pendingElement = nextRoot;
  }

  if (!runLock.root) runLock.root = 'fire';

  applyClassForkBonuses();
  buildSkillButtons();
  refreshSkillUI(true);

  player.mods = {};
  const modProgression = [
    'overcharge',
    'chainExplode',
    'bloodPact',
    'leech',
    'multishot',
    'mirrorShield',
    'midas',
    'antimatter',
    'tesla',
    'vortexPull',
    'clover'
  ];

  const modsToGive = Math.min(modProgression.length, Math.floor(wave * 0.9));
  for (let m = 0; m < modsToGive; m++) {
    player.mods[modProgression[m]] = 1;
  }

  if (wave >= 8 && SIGNATURES && SIGNATURES.length) {
    playerSig = SIGNATURES[0];
  } else {
    playerSig = null;
  }

  applyWaveUnlocks();
  spawnWave();
  ensureEnemiesSpawned();
  updateHud();
  syncDevModeUI();

  paused = false;
  menuOpen = false;
  running = true;
  lastTime = performance.now();
  lastHurtAt = performance.now();

  try {
    if (typeof audioCtx !== 'undefined' && audioCtx && audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
  } catch (_) {}

  triggerScreenFlash('#ea580c', 0.4, 260);
  playSfx('start', 0.4);
  vibrate([50, 70, 50]);
  showStreakBanner(' DALGA ' + wave + ' (SEVİYE ' + player.level + ')', '#ea580c');
  spawnFloatText(player.x, player.y - 36, ' Dalga ' + wave + ' Yüklendi! (' + lockedCombos.length + ' Skill, ' + modsToGive + ' Mod)', '#ffd740', 'big');
}

