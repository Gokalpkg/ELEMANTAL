    const bestEl = document.getElementById('bestLabel');
    if (bestEl) {
      const b = loadBest();
      const bw = Math.max(m.bestWave || 0, (b && b.wave) || 0);
      const bs = Math.max(m.bestScore || 0, (b && b.score) || 0);
      bestEl.textContent = bs ? ('En iyi · Dalga ' + bw + ' · Skor ' + bs) : 'Rekor yok henüz';
