    ctx.fillRect(Math.round(caneX - 1.5), Math.round(caneY - 6), 3, 14);
    ctx.fillStyle = '#e91e63';
    ctx.fillRect(Math.round(caneX - 1.5), Math.round(caneY - 4), 3, 2);
    ctx.fillRect(Math.round(caneX - 1.5), Math.round(caneY + 1), 3, 2);
