let mythicChests = [];

function checkSpawnTreasureChest() {
  if (wave % 3 === 0 && mythicChests.length === 0) {
    const ang = Math.random() * Math.PI * 2;
    const dist = 160 + Math.random() * 120;
    mythicChests.push({
      x: player.x + Math.cos(ang) * dist,
      y: player.y + Math.sin(ang) * dist,
      r: 16,
      hp: 3,
      maxHp: 3,
      opened: false,
      color: '#f59e0b'
    });
    spawnFloatText(player.x, player.y - 30, ' GİZEMLİ SANDIK BELİRDİ!', '#facc15', true);
  }
}

function updateMythicChests() {
  for (let i = mythicChests.length - 1; i >= 0; i--) {
    const ch = mythicChests[i];
    // Check player slash collision
    if (Math.hypot(player.x - ch.x, player.y - ch.y) < 48 && (player.atkSlashFx > 0 || player.attacking)) {
      ch.hp--;
      playMetallicRing(1600, false);
      shake = Math.max(shake, 6);
      if (ch.hp <= 0) {
        // Open chest!
        playMetallicRing(2000, true);
        synthBlip('legendary');
        crystals += 25;
        // Grant 15s speed & shield buff
        player.speedBoostUntil = performance.now() + 15000;
        spawnFloatText(ch.x, ch.y - 20, ' +25 KRİSTAL & HIZ İKSİRİ!', '#facc15', true);
        mythicChests.splice(i, 1);
      }
    }
  }
}

function drawMythicChests(ctx) {
  if (!mythicChests || mythicChests.length === 0) return;
  for (let ch of mythicChests) {
    ctx.save();
    // Chest ground shadow
    ctx.fillStyle = 'rgba(0, 0, 0, 0.4)';
    ctx.beginPath(); ctx.ellipse(ch.x, ch.y + 10, 16, 6, 0, 0, Math.PI * 2); ctx.fill();

    // Golden runic chest body
    ctx.fillStyle = '#b45309';
    ctx.fillRect(ch.x - 12, ch.y - 10, 24, 20);
    ctx.fillStyle = '#f59e0b';
    ctx.fillRect(ch.x - 10, ch.y - 8, 20, 16);

    // Glowing lock
    ctx.fillStyle = '#fef08a';
    ctx.fillRect(ch.x - 3, ch.y - 2, 6, 5);
    ctx.strokeStyle = '#ffffff';
    ctx.lineWidth = 1;
    ctx.strokeRect(ch.x - 12, ch.y - 10, 24, 20);
    ctx.restore();
  }
}

let _envHazards = [];
function spawnEnvHazards(biome) {
  _envHazards = [];
  const bk = biome && biome.key || 'stone';
  const count = 4 + Math.floor(Math.random() * 4);
  for (let i = 0; i < count; i++) {
    const angle = Math.random() * Math.PI * 2;
    const dist = 100 + Math.random() * 350;
    _envHazards.push({
      x: player.x + Math.cos(angle) * dist,
      y: player.y + Math.sin(angle) * dist,
      r: 25 + Math.random() * 20,
      type: bk,
      life: 600 + Math.random() * 300, // 10-15 seconds
      maxLife: 900,
      warned: false
    });
  }
}

function spawnWave() {
  if (typeof _activeMutations !== 'undefined' && _activeMutations.has('chaos_biome')) {
    biomeIndex = Math.floor(Math.random() * BIOMES.length);
  }
  const biome = currentBiome();
  spawnEnvHazards(biome);
  
  // Treasure vault portal (wave 8, 15)
  if ((wave === 8 || wave === 15) && Math.random() < 0.30 && !_treasurePortal) {
    const angle = Math.random() * Math.PI * 2;
    const dist = 150 + Math.random() * 100;
    _treasurePortal = {
      x: player.x + Math.cos(angle) * dist,
      y: player.y + Math.sin(angle) * dist,
      r: 22, life: 600, // 10 seconds to enter
      glow: 0
    };
    showStreakBanner('✨ HAZİNE PORTALI BELİRDİ!', '#ffd700');
  }
  if (!obstacles || obstacles.length === 0) addWaveObstacles();
  if (typeof spawnArenaBarrels === 'function') spawnArenaBarrels();
  if (typeof checkSpawnRiftPortal === 'function') checkSpawnRiftPortal(wave);
  if (wave > 10 && !window.endlessMode && typeof triggerTamagEndless === 'function') {
    triggerTamagEndless();
  }
  const WAVES_PER_BIOME = 5;
  const isBossWave = (wave >= WAVES_PER_BIOME && wave % WAVES_PER_BIOME === 0);
  const waveInBiome = ((wave - 1) % WAVES_PER_BIOME) + 1;
  const isMidBoss = (waveInBiome === 3 && wave >= 8 && Math.random() < 0.35);

  let baseCount;
  if (isBossWave) {
    baseCount = 6;
  } else if (waveInBiome === 1) {
    baseCount = 5; // Dalga 1: Hafif başlangıç, 5 adet basit sürü düşmanı
  } else if (waveInBiome === 2) {
    baseCount = 8;
  } else if (waveInBiome === 3) {
    baseCount = 12;
  } else {
    baseCount = 15;
  }
  if (typeof isPactActive === 'function' && isPactActive('swarmCalamity')) {
    baseCount = Math.round(baseCount * 1.30);
  }
  if (_activeMutations.has('double_enemies')) {
    baseCount = Math.round(baseCount * 2);
  }
  const count = baseCount;

  // Taktiksel Sürü Formasyon Tetikleyicisi (Sadece ileri seviye dalga 12+ ve sakin bir olasılıkla)
  if (!isBossWave && wave >= 12 && waveInBiome >= 3 && Math.random() < 0.25) {
    const fTypes = ['encirclement', 'phalanx', 'spiral'];
    const chosenForm = fTypes[Math.floor(Math.random() * fTypes.length)];
    setTimeout(() => {
      if (running && !paused) triggerSwarmFormation(chosenForm);
    }, 1800);
  }
  const shooterChance = waveInBiome >= 4 ? Math.min(0.08 + wave * 0.015, 0.25) : 0;
  const fastChance = waveInBiome >= 3 ? Math.min(0.12 + wave * 0.01, 0.22) : 0;
  const tankChance = (waveInBiome >= 4 && wave >= 6) ? Math.min(0.06 + wave * 0.008, 0.16) : 0;
  waveEvent = null;
  if (!isBossWave && !isMidBoss && waveInBiome >= 4 && wave >= 4 && Math.random() < 0.25) {
    const kinds = ['eliteHunt', 'chestGuard'];
    waveEvent = { kind: kinds[(Math.random() * kinds.length) | 0], t: 0, need: 20 * 60, done: false };
  }
  const minD = (altarAggro ? 140 : (spawnMinDist || 170));
  const maxD = minD + 90;
  function placeAway() {
    return spawnAroundPlayer(minD, maxD);
  }
  if (isMidBoss) {
    makeEnemy(placeAway(), 'tank', {
      isElite: true, affix: 'molten', titleCol: '#ff9800',
      hp: 38 + wave * 6, maxHp: 38 + wave * 6, r: 22, speed: 0.75 + wave * 0.01
    });
    spawnFloatText(player.x, player.y - 40, 'Ara boss!', '#ff9800');
  }
  // Risk & Reward Sunak: Sadece Dalga 2'de veya Dalga 4'te
  if (waveInBiome === 2 && !arenaShrine && Math.random() < 0.5) {
    spawnArenaShrine();
  }

  // Çevresel tuzaklar ve tehlikeler sadece Dalga 3+'da başlar (Dalga 1 ve 2 tertemiz açık arena!)
  if (waveInBiome >= 3 && biome && player && typeof spawnEnvDebris === 'function') {
    const biomeKey = biome.key || '';
    const numDebris = Math.min(3, 1 + Math.floor(wave * 0.25));
    for (let s = 0; s < numDebris; s++) {
      const ang = Math.random() * Math.PI * 2;
      const dist = 110 + Math.random() * 150;
      const sx = player.x + Math.cos(ang) * dist;
      const sy = player.y + Math.sin(ang) * dist;
      if (typeof outOfWorld === 'function' && !outOfWorld(sx, sy, 32)) {
        if (biomeKey === 'water' || biomeKey === 'sazlik' || Math.random() < 0.35) {
          spawnEnvDebris(sx, sy, 'water', 1, 'water_puddle');
        } else if (biomeKey === 'volcano' || biomeKey === 'fire' || Math.random() < 0.30) {
          spawnEnvDebris(sx, sy, 'fire', 1, 'lava');
        } else if (biomeKey === 'nature' || biomeKey === 'forest' || Math.random() < 0.35) {
          spawnEnvDebris(sx, sy, 'nature', 1, 'pollen');
        } else if (biomeKey === 'storm' || Math.random() < 0.25) {
          spawnEnvDebris(sx, sy, 'storm', 1, 'spark');
        }
      }
    }
  }

  if (isBossWave) {
    if (typeof synthBlip === 'function') synthBlip('boss_roar');
    if (typeof playBassDrop === 'function') playBassDrop(80, 1.2, 0.7);
    const cfg = getBiomeBossConfig(biome.key, wave);
    const isOverload = (typeof isPactActive === 'function' && isPactActive('titanOverload'));
    const isFastPact = (typeof isPactActive === 'function' && isPactActive('bloodSpeed'));
    let bScale = 1, bHpMul = 1;
    if (player && player._transcendenceMode) {
      bHpMul = 1.5;
      const tWaves = wave - (player._transcendenceStartWave || 20);
      if (tWaves > 0 && tWaves % 5 === 0) {
        bScale = 1.5; bHpMul = 4.0;
        cfg.title = 'MEGA ' + (cfg.title || 'BOSS');
      }
    }
