      color: isThorn ? '#22c55e' : combo.color,
      follow: combo.kind === 'aura' || extra.wrap,
      type: isThorn ? 'thorn' : (extra.wrap ? 'wrap' : (extra.type || 'aura')),
      stunOnce: extra.stunOnce || 0
    });
  } else if (combo.kind === 'blast') {
    const aim = aimPoint(combo);
    const t = aim.target || { x: aim.x, y: aim.y };
    const r = extra.r || 90;
    particles.push({ x:t.x, y:t.y, life:1.1, maxLife:1.1, type:'mushroom', scale: 1.4 });
    particles.push({ x:t.x, y:t.y, life:0.7, maxLife:0.7, type:'starburst', r: 30, rot: Math.random()*6.28 });
    particles.push({ x:t.x, y:t.y, r:12, maxR:r, life:1, color:combo.color });
    burst(t.x, t.y, combo.color, 18, 4);
    spawnEnvDebris(t.x, t.y, combo.a || 'fire', 4);
    damageEnemiesInRadius(t.x, t.y, r, combo.dmg, combo.effects, 1.3);
  } else if (combo.kind === 'quake') {
    particles.push({ x:player.x, y:player.y, life:0.85, maxLife:0.85, type:'starburst', r: 40, rot: 0 });
    particles.push({ x:player.x, y:player.y, r:20, maxR:combo.range, life:1, color:combo.color });
    shake = 10;
    spawnEnvDebris(player.x, player.y, 'earth', 5);
    enemies.forEach(en => {
      if (Math.hypot(en.x-player.x, en.y-player.y) > combo.range) return;
      const dealt = takeDamage(en, combo.dmg, combo.a || 'earth');
      spawnFloatText(en.x, en.y-10, '-'+dealt, combo.color);
      applyAllEffects(en, combo.effects, extra.stun||1);
      burst(en.x, en.y, '#e8c48a', 6, 2);
    });
    pruneDeadEnemies();
    if (extra.wrap) {
      zones.push({
        x: player.x, y: player.y,
        r: (extra.r || 94) * (1 + (modValue('skillArea') || 0) / 100),
        life: (extra.life || 270) * skillDurMul(), tick: 0, tickMax: extra.tick || 16,
        dmg: Math.max(3, Math.round(combo.dmg * 0.32)),
        effects: ['slow'],
        effect: 'slow',
        color: combo.color, follow: true, type: 'wrap'
      });
    }
  } else if (combo.kind === 'stomp') {
    const ang = player.facing;
    const d = extra.r || 58;
    const nx = player.x + Math.cos(ang)*d;
    const ny = player.y + Math.sin(ang)*d;
    particles.push({ x:nx, y:ny, r:12, maxR:d, life:1, color:combo.color });
    damageEnemiesInRadius(nx, ny, d, combo.dmg, combo.effects, 1.15);
  } else if (combo.kind === 'thorns') {
    const zRadius = (extra.r || 98) * (1 + (modValue('skillArea') || 0) / 100);
    const zLife = (extra.life || 280) * skillDurMul();
    shake = Math.max(shake, 7);
    playSfx('glass', 0.45, 260);
    playSfx('skill', 0.4, 340);
    particles.push({ x: player.x, y: player.y, r: 8, maxR: zRadius, life: 1, color: '#22c55e', lw: 4 });
    particles.push({ x: player.x, y: player.y, r: 16, maxR: zRadius * 0.7, life: 0.8, color: '#a3e635', lw: 2.5 });
    burst(player.x, player.y, '#22c55e', 14, 3.5);

    for (let di = 0; di < 10; di++) {
      const dAng = (di / 10) * Math.PI * 2 + (Math.random() - 0.5) * 0.25;
      const dDist = zRadius * (0.4 + (di % 2) * 0.45);
      spawnEnvDebris(player.x + Math.cos(dAng) * dDist, player.y + Math.sin(dAng) * dDist, 'nature', 1, 'ground_thorns');
    }

    damageEnemiesInRadius(player.x, player.y, zRadius, combo.dmg * 1.5, ['root', 'poison'], 1.6, 'nature');
    spawnFloatText(player.x, player.y - 32, ' DİKEN TARLASI!', '#4ade80', 'big');

    zones.push({
      x: player.x, y: player.y, r: zRadius, life: zLife, maxLife: zLife, tick: 0, tickMax: extra.tick || 16,
      dmg: combo.dmg, effects: ['root', 'poison'], effect: 'root', color: '#22c55e', follow: false, type: 'thorn'
    });
  } else if (combo.kind === 'mist') {
    const heal = extra.heal || 3;
    player.hp = Math.min(player.maxHp, player.hp + heal);
    updateHud();
    spawnFloatText(player.x, player.y-20, '+'+heal, '#3ddc84');
    damageEnemiesInRadius(player.x, player.y, combo.range * 0.7, combo.dmg, combo.effects, 1);
  } else if (combo.kind === 'dash') {
    const dist = extra.dist || 196;
    const splash = extra.splash || 48;
    let ang = player.facing;
    if (player.moving && (Math.abs(player.vx) > 0.06 || Math.abs(player.vy) > 0.06)) {
      ang = Math.atan2(player.vy, player.vx);
    }
    player.facing = ang;
    player.invuln = Math.max(player.invuln, 48);
    const ox = player.x, oy = player.y;
    burst(ox, oy, '#4aa3ff', 10, 2.4);
    burst(ox, oy, combo.color, 8, 2);
    // Su Sıçraması: Sıçradığımız ilk yerde su birikintisi ve kırağı bırak
    spawnEnvDebris(ox, oy, 'water', 3);
    damageEnemiesInRadius(ox, oy, splash * 0.75, Math.round(combo.dmg * 0.6), combo.effects, 0.75);
    let nx = ox, ny = oy;
    const steps = 16;
    for (let i = 1; i <= steps; i++) {
      const tx = ox + Math.cos(ang) * dist * (i / steps);
      const ty = oy + Math.sin(ang) * dist * (i / steps);
      const cx = clampWorldX(tx, player.r);
      const cy = clampWorldY(ty, player.r);
      if (circleHitsObs(cx, cy, player.r + 1)) break;
      nx = cx; ny = cy;
    }
    player.x = nx;
    player.y = ny;
    pushOutOfObstacles(player);
    particles.push({ x:player.x, y:player.y, r:10, maxR:splash, life:1, color:'#4aa3ff' });
    burst(player.x, player.y, '#4aa3ff', 14, 3);
    burst(player.x, player.y, combo.color, 8, 2.2);
    // İndiğimiz yerde de su birikintisi ve ıslaklık bırak
    spawnEnvDebris(player.x, player.y, 'water', 4);
    damageEnemiesInRadius(player.x, player.y, splash, combo.dmg, combo.effects, 1);
    player.vx = 0;
    player.vy = 0;
  } else if (combo.kind === 'bind') {
    enemies.forEach(en => {
      if (Math.hypot(en.x-player.x, en.y-player.y) > combo.range) return;
      const dealt = takeDamage(en, combo.dmg, combo.a || combo.b);
      spawnFloatText(en.x, en.y-10, '-'+dealt, combo.color);
      applyAllEffects(en, combo.effects, extra.stun||1);
      spawnEnvDebris(en.x, en.y, combo.b || 'nature', 2, 'ground_thorns');
    });
    pruneDeadEnemies();
  } else if (combo.kind === 'rain' || combo.kind === 'healburst') {
    const heal = Math.min(5, extra.heal||4);
    player.hp = Math.min(player.maxHp, player.hp + heal);
    updateHud();
    spawnFloatText(player.x, player.y-20, '+'+heal, '#3ddc84');
    spawnEnvDebris(player.x, player.y, 'water', 4, 'water_puddle');
    damageEnemiesInRadius(player.x, player.y, 110, combo.dmg, combo.effects, 1);
  } else if (combo.kind === 'roots') {
    const list = enemies.slice()
      .filter(en => Math.hypot(en.x-player.x, en.y-player.y) <= combo.range)
      .sort((a,b)=>Math.hypot(a.x-player.x,a.y-player.y)-Math.hypot(b.x-player.x,b.y-player.y));
    list.slice(0, extra.count||3).forEach(en => {
      const dealt = takeDamage(en, combo.dmg, 'nature');
      spawnFloatText(en.x, en.y-10, '-'+dealt, combo.color);
      applyAllEffects(en, combo.effects, extra.stun || 1);
      applyEffect(en, 'root', 1.2);
      burst(en.x, en.y, '#3ddc84', 8, 2);
      // Yerden fırlayan sivri pixel art dikenler
      spawnEnvDebris(en.x, en.y, 'nature', 4, 'ground_thorns');
    });
    pruneDeadEnemies();
  } else if (combo.kind === 'execute') {
    const R = (extra.r || combo.range || 250) * (1 + (modValue('skillArea') || 0) / 100);
    const exec = extra.exec || 0.34;
    particles.push({ x:player.x, y:player.y, r:18, maxR:R, life:1, color:combo.color });
    burst(player.x, player.y, '#3ddc84', 18, 3.4);
    spawnEnvDebris(player.x, player.y, 'nature', 6, 'ground_thorns');
    zones.push({
      x: player.x, y: player.y, r: R, life: (extra.life || 200) * skillDurMul(),
      tick: 0, tickMax: extra.tick || 18, dmg: Math.max(2, Math.round(combo.dmg * 0.4)),
      effects: (combo.effects || []).filter(e => e !== 'lifesteal'),
      effect: 'slow', color: combo.color, follow: false, type: 'vine'
    });
    enemies.forEach(en => {
      if (Math.hypot(en.x - player.x, en.y - player.y) > R + en.r) return;
      applyEffect(en, 'slow', 1.1);
      applyEffect(en, 'root', 1.15);
      const ratio = en.hp / (en.maxHp || en.hp || 1);
      if (ratio <= exec && (!en.layers || !en.layers.length)) {
        tryMove(en, 0, 42);
        spawnFloatText(en.x, en.y - 16, 'İnfaz', '#7cff9a');
        burst(en.x, en.y, '#1b7a40', 14, 3);
        noteFx('exec');
        en.hp = 0;
        spawnEnvDebris(en.x, en.y, 'nature', 3, 'ground_thorns');
      } else {
        const dealt = takeDamage(en, combo.dmg, 'nature');
        spawnFloatText(en.x, en.y-10, '-'+dealt, combo.color);
        applyAllEffects(en, combo.effects, 1);
        burst(en.x, en.y, '#3ddc84', 8, 2);
        spawnEnvDebris(en.x, en.y, 'nature', 2, 'ground_thorns');
      }
    });
    pruneDeadEnemies();
    spawnElemStain(player.x, player.y, R * 0.85, 'nature', 175);
  } else if (combo.kind === 'chain') {
    const origin = extra.fromSelf || !aimPoint(combo).target ? player : aimPoint(combo).target;
    spawnEnvDebris(origin.x, origin.y, combo.b || 'storm', 3, 'static_field');
    chainLightning(origin, combo.dmg, extra.jumps || 4, extra.jump || 130, combo.color, combo.effects);
  } else if (combo.kind === 'boltall') {
    const list = enemies.slice();
    list.forEach(en => {
      addBolt(player.x, player.y, en.x, en.y, combo.color, 0.55, 4.2);
      const dealt = takeDamage(en, combo.dmg, combo.a || combo.b);
      spawnFloatText(en.x, en.y-10, '-'+dealt, combo.color);
      applyAllEffects(en, combo.effects, 1);
      burst(en.x, en.y, combo.color, 8, 2.4);
      spawnEnvDebris(en.x, en.y, 'storm', 2, 'spark');
    });
    shake = Math.max(shake, 7);
    pruneDeadEnemies();
  } else if (combo.kind === 'beam') {
    const aim = aimPoint(combo);
    const beamDmg = hasGraft('collapseRift') ? Math.round(combo.dmg * 0.88) : combo.dmg;
    beamStrike(aim.ang, combo.range, (extra.w || 7) + (runFlags().beamW || 0), beamDmg, combo.color, combo.effects, combo.a || combo.b);
    spawnEnvDebris(player.x + Math.cos(aim.ang) * (combo.range * 0.5), player.y + Math.sin(aim.ang) * (combo.range * 0.5), combo.b || 'storm', 4, 'plasma');
    if (hasGraft('collapseRift')) {
      const tx = player.x + Math.cos(aim.ang) * combo.range;
      const ty = player.y + Math.sin(aim.ang) * combo.range;
      zones.push({ x: tx, y: ty, r: 72, life: 90, maxLife: 90, color: '#a855f7', type: 'vortex', dmg: Math.round(combo.dmg * 0.4), tickTimer: 0, tickInterval: 14 });
      pullEnemies(tx, ty, 150, 4.2);
      spawnFloatText(tx, ty - 18, 'Cokus', '#c084fc');
      spawnEnvDebris(tx, ty, 'void', 4, 'vortex');
    }
  } else if (combo.kind === 'pull') {
    const aim = aimPoint(combo);
    let cx = aim.target ? aim.target.x : aim.x;
    let cy = aim.target ? aim.target.y : aim.y;
    if (Math.hypot(cx - player.x, cy - player.y) < 75) {
      const face = player.facing || 0;
      cx = player.x + Math.cos(face) * 115;
      cy = player.y + Math.sin(face) * 115;
    }
    spawnEnvDebris(cx, cy, combo.b || 'earth', 5, 'gravity');
    spawnEnvDebris(cx, cy, 'storm', 4, 'static_field');
    burst(cx, cy, '#facc15', 14, 3.2);
    burst(cx, cy, '#c48a4a', 10, 2.4);
    playSfx('shock', 0.35);

    pullEnemies(cx, cy, combo.range || 210, extra.str || 36, { safeFromPlayer: true, minPlayerDist: 68, stunDuration: 600, shock: true });
    damageEnemiesInRadius(cx, cy, 70, combo.dmg || 18, ['shock', 'stun'], 1.0, 'storm');

    const pulledList = enemies.filter(en => en && en.hp > 0 && Math.hypot(en.x - cx, en.y - cy) <= 85);
    if (pulledList.length >= 2) {
      for (let p = 0; p < Math.min(pulledList.length, 3); p++) {
        chainLightning(pulledList[p], Math.round((combo.dmg || 18) * 0.55), 2, 90, '#facc15', 'shock');
      }
    }
  } else if (combo.kind === 'vacuum') {
    spawnEnvDebris(player.x, player.y, 'earth', 3, 'gravity');
    vacuumPickups(extra.pull || 240);
    damageEnemiesInRadius(player.x, player.y, combo.range * 0.55, combo.dmg, combo.effects, 0.6);
  } else if (combo.kind === 'wrath') {
    spawnEnvDebris(player.x, player.y, combo.a || 'fire', 4, 'lava');
    enemies.forEach(en => {
      const dealt = takeDamage(en, combo.dmg, combo.a || combo.b);
      spawnFloatText(en.x, en.y-10, '-'+dealt, combo.color);
      applyAllEffects(en, combo.effects, 1);
      spawnEnvDebris(en.x, en.y, combo.a || 'fire', 2, 'lava');
    });
    pruneDeadEnemies();
  }
  const role = noteSplit(combo.kind);
  applySplitForce(combo, role);
}

function pushSkillShot(ang, speed, combo, r, bounces) {
  skillShots.push({
    x:player.x, y:player.y, vx:Math.cos(ang)*speed, vy:Math.sin(ang)*speed,
    r:r||6, dmg:combo.dmg, effects:combo.effects, effect:combo.effect, color:combo.color, style:combo.style,
    bounces: bounces||0, hit:new Set(),
    ox: player.x, oy: player.y, maxDist: combo.range || 200,
    fxPower: (combo.extra && combo.extra.puff) ? 1.6 : 1,
    el: combo.b || combo.a,
    face: ang
  });
}
function shotTooFar(p, fallback) {
  if (p.ox == null) { p.ox = p.x; p.oy = p.y; }
  const cap = (p.maxDist != null && p.maxDist > 0) ? p.maxDist : (fallback || 200);
  return Math.hypot(p.x - p.ox, p.y - p.oy) > cap;
}

// --- STEP 6: ELEMENTAL ENVIRONMENTAL REACTION ENGINE ---
const envReactionLast = {};
function triggerEnvReaction(x, y, el, power) {
  if (!el || !hazards || hazards.length === 0) return;
  const now = performance.now();
  power = power || 20;

  for (let i = hazards.length - 1; i >= 0; i--) {
    const h = hazards[i];
    const dist = Math.hypot(h.x - x, h.y - y);
    if (dist > h.r + 34) continue;

    const rKey = (h.id || i) + '_' + el;
    if (envReactionLast[rKey] && now - envReactionLast[rKey] < 450) continue;
    envReactionLast[rKey] = now;

    // 1. STORM ON WATER PUDDLE -> ELECTRIFIED CONDUCTIVE PUDDLE
    if (h.type === 'water' && el === 'storm') {
      h.electrifiedUntil = now + 4200;
      synthBlip('elem_storm');
      playSfx('skill', 0.35, 180);
      shake = Math.max(shake, 6);
      burst(h.x, h.y, '#facc15', 24, 4.0);
      burst(h.x, h.y, '#38bdf8', 16, 3.0);
      spawnFloatText(h.x, h.y - 20, ' İLETKEN SU HAVUZU!', '#fde047', 'crit');
      // Chain shock all enemies in puddle immediately
      enemies.forEach(en => {
        if (Math.hypot(en.x - h.x, en.y - h.y) < h.r + en.r + 18) {
          const dealtS = takeDamage(en, Math.round(28 + wave * 4), 'storm', { quiet: true });
          applyEffect(en, 'shock', 2.0);
          en.stunUntil = Math.max(en.stunUntil || 0, now + 1200);
          addBolt(h.x, h.y, en.x, en.y, '#fde047', 0.28, 2.8);
          spawnFloatText(en.x, en.y - 12, ' -' + dealtS, '#facc15');
        }
      });
      pruneDeadEnemies();
    }

    // 2. FIRE ON WATER / ICE -> SCALDING STEAM CLOUD
    else if ((h.type === 'water' || h.type === 'ice') && el === 'fire') {
      const origR = h.r;
      h.r = Math.max(16, h.r * 0.7);
      if (h.r <= 18) {
        hazards.splice(i, 1);
      }
      zones.push({
        x: h.x, y: h.y, r: origR * 1.35,
        life: 3.5, maxLife: 3.5,
        tick: 0, tickMax: 18,
        dmg: Math.round(14 + wave * 2.2),
        el: 'fire',
        type: 'steam_cloud',
        effects: ['burn', 'slow']
      });
      synthBlip('elem_fire');
      playSfx('wave', 0.35, 200);
      burst(h.x, h.y, '#e0f2fe', 26, 4.2);
      burst(h.x, h.y, '#f8fafc', 18, 3.0);
      spawnFloatText(h.x, h.y - 20, ' BUHARLAŞMA İNFİLAKI!', '#e0f2fe', 'big');
      shake = Math.max(shake, 7);
    }

    // 3. ICE / FREEZE ON WATER -> SOLID ICE GLACIATION
    else if (h.type === 'water' && (el === 'water' || el === 'ice')) {
      h.type = 'ice';
      h.r = Math.min(85, h.r * 1.2);
      h.until = now + 7000;
      synthBlip('elem_water');
      playSfx('skill', 0.3, 150);
      burst(h.x, h.y, '#38bdf8', 20, 3.8);
      burst(h.x, h.y, '#ffffff', 14, 2.5);
      spawnFloatText(h.x, h.y - 20, ' DONMUŞ BUZ PİSTİ!', '#38bdf8', 'crit');
      enemies.forEach(en => {
        if (Math.hypot(en.x - h.x, en.y - h.y) < h.r + en.r) {
          applyEffect(en, 'slow', 3.0);
          en.frozenOnIce = now + 4000;
        }
      });
    }

    // 4. FIRE ON BRAMBLE / FOREST / SLIME / CARAMEL -> WILDFIRE INFERNO
    else if ((h.type === 'bramble' || h.type === 'forest' || h.type === 'slime' || h.type === 'caramel') && el === 'fire') {
      h.type = 'lava';
      h.r = Math.min(80, h.r * 1.25);
      h.until = now + 5000;
      synthBlip('elem_fire');
      playSfx('explode', 0.38, 220);
      burst(h.x, h.y, '#ff4500', 25, 4.5);
      burst(h.x, h.y, '#ffea00', 16, 3.0);
      spawnFloatText(h.x, h.y - 20, ' ÇEVRESEL ALEV SIÇRAMASI!', '#ff4500', 'crit');
      shake = Math.max(shake, 8);
      // Chain ignite nearby flammable hazards within 95px
      for (let j = hazards.length - 1; j >= 0; j--) {
        if (j === i) continue;
        const hj = hazards[j];
        if ((hj.type === 'bramble' || hj.type === 'slime') && Math.hypot(hj.x - h.x, hj.y - h.y) < 95) {
          hj.type = 'lava';
          hj.until = now + 4000;
          burst(hj.x, hj.y, '#ff5722', 14, 3.0);
        }
      }
    }

    // 5. EARTH ON LAVA -> OBSIDIAN ERUPTION
    else if (h.type === 'lava' && el === 'earth') {
      h.type = 'stone';
      h.until = now + 5000;
      synthBlip('elem_earth');
      playSfx('explode', 0.42, 250);
      shake = Math.max(shake, 11);
      burst(h.x, h.y, '#78716c', 28, 4.8);
      burst(h.x, h.y, '#f59e0b', 18, 3.6);
      spawnFloatText(h.x, h.y - 24, ' OBSİDİYEN İNFİLAKI!', '#fbbf24', 'big');
      for (let j = enemies.length - 1; j >= 0; j--) {
        const en = enemies[j];
        if (Math.hypot(en.x - h.x, en.y - h.y) < h.r + en.r + 35) {
          const dealtOb = takeDamage(en, Math.round(35 + wave * 5), 'earth', { quiet: true });
          applyEffect(en, 'stun', 1.5);
          spawnFloatText(en.x, en.y - 12, ' -' + dealtOb, '#fbbf24');
        }
      }
      pruneDeadEnemies();
    }
  }
}

function damageEnemiesInRadius(x, y, r, dmg, effect, power, el) {
  el = el || lastElemUsed;
  triggerEnvReaction(x, y, el, dmg);
  for (let j=enemies.length-1;j>=0;j--) {
    const en = enemies[j];
    if (Math.hypot(en.x-x, en.y-y) <= r + en.r) {
      const dealt = takeDamage(en, dmg, el);
      spawnFloatText(en.x, en.y-10, '-'+dealt, '#f1c40f');
      applyAllEffects(en, effect, power||1);
    }
  }
  pruneDeadEnemies();
}

function pruneDeadEnemies() {
  for (let j=enemies.length-1;j>=0;j--) if (enemies[j].hp<=0) killEnemy(j);
}

function syncUltFab() {
  const el = document.getElementById('ultFab');
  if (el) el.style.display = 'none';
}

function syncDashFab() {
  const btn = document.getElementById('dashFab');
  if (btn) btn.style.display = 'none';
}

function triggerDash() {
  if (!running || paused || menuOpen || !player || player.hp <= 0) return;
  if (player.dashCd > 0 || player.dashTime > 0) return;

  // STEP 5: ANIMATION CANCELING - Instantly breaks attack delay, cast lock & flinch
  player.castLock = 0;
  player.attackWindup = 0;
  player.staggerTimer = 0;
  if (typeof player.state !== 'undefined') player.state = PLAYER_STATE.DASH;

  let dx = (typeof joyVec !== 'undefined' && joyVec) ? joyVec.x : 0;
  let dy = (typeof joyVec !== 'undefined' && joyVec) ? joyVec.y : 0;
  if (Math.hypot(dx, dy) < 0.12) {
    const fAng = player.facing != null ? player.facing : -Math.PI / 2;
    dx = Math.cos(fAng);
    dy = Math.sin(fAng);
  }
  const len = Math.hypot(dx, dy) || 1;
  player.dashDirX = dx / len;
  player.dashDirY = dy / len;
  player.dashTime = 13; // 13 frames (~216ms) of crisp, snappy dash
