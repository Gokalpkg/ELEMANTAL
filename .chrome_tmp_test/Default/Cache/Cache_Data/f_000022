        playSfx('wave', 0.35);
        shake = Math.max(shake, 14);
        camKick = Math.max(camKick, 8);
        burst(en.x, en.y, '#00e5ff', 26, 4.2);
        burst(en.x, en.y, '#ffffff', 16, 3.2);

        en.atkLungeX = Math.cos(atAng) * 38;
        en.atkLungeY = Math.sin(atAng) * 38;
        en.atkSlashFx = 24;
        en.atkSlashCol = '#00e5ff';

        particles.push({ x: en.x, y: en.y, r: 14, maxR: 120, life: 0.75, color: '#00e5ff', lw: 4.5 });
        particles.push({ x: en.x, y: en.y, r: 8, maxR: 80, life: 0.55, color: '#ffffff', lw: 2.8 });

        const wCount = en.phase2 ? 10 : 7;
        for (let k = 0; k < wCount; k++) {
          const wa = (Math.PI * 2 / wCount) * k;
          enemyProjectiles.push({
            x: en.x + Math.cos(wa) * 18, y: en.y + Math.sin(wa) * 18,
            vx: Math.cos(wa) * 3.4, vy: Math.sin(wa) * 3.4,
            r: 8.5, dmg: 8, ox: en.x, oy: en.y, maxDist: 260,
            kind: 'hydro_wave', face: wa
          });
        }
      }
    }
  } else if (bk === 'sand') {
    // 7. Çöl Firavunu Akrep Kral
    if (en.specialCd <= 0) {
      en.specialCd = cdLimit;
      en.sandAlt = !en.sandAlt;
      const atAng = Math.atan2(player.y - en.y, player.x - en.x);
      en.atkLungeX = Math.cos(atAng) * 22;
      en.atkLungeY = Math.sin(atAng) * 22;
      en.atkSlashFx = 16;
      en.atkSlashCol = '#00e676';
      en.squashT = 0.45;
      en.squashScale = 1.18;
      if (en.sandAlt) {
        // Attack A: Batak Kum Tuzağı
        spawnFloatText(en.x, en.y - 36, 'Batak Kum!', '#ffd54f');
        playSfx('skill', 0.22, 260);
        bossTelegraphs.push({
          kind: 'circle', x: player.x, y: player.y, r: 60,
          duration: 48, t: 0, color: '#ffd54f',
          onTrigger: (bt) => {
            burst(bt.x, bt.y, '#ffd54f', 18, 3.5);
            hazards.push({ x: bt.x, y: bt.y, r: 45, type: 'sand', until: performance.now() + 4500 });
            if (Math.hypot(player.x - bt.x, player.y - bt.y) < bt.r) {
              damagePlayer(en.phase2 ? 9 : 6);
              player.slowUntil = performance.now() + 2000;
              player.slowFactor = 0.45;
            }
          }
        });
      } else {
        // Attack B: Zehir İğnesi Hamlesi
        const vAng = atAng;
        bossTelegraphs.push({
          kind: 'line', x: en.x, y: en.y,
          targetX: en.x + Math.cos(vAng) * 270, targetY: en.y + Math.sin(vAng) * 270,
          w: 24, duration: 40, t: 0, color: '#00e676',
          onTrigger: (bt) => {
            spawnFloatText(en.x, en.y - 32, 'Ölümcül İğne!', '#00e676');
            playSfx('skill', 0.24, 440);
            const vCount = en.phase2 ? 6 : 4;
            for (let k = 0; k < vCount; k++) {
              const va = vAng + (k - (vCount - 1) / 2) * 0.22;
              enemyProjectiles.push({
                x: en.x, y: en.y, vx: Math.cos(va) * 3.6, vy: Math.sin(va) * 3.6,
                r: 6, dmg: 7, ox: en.x, oy: en.y, maxDist: 280,
                kind: 'venom_needle', face: va
              });
            }
          }
        });
      }
    }
  } else if (bk === 'night') {
    // 8. Karanlık Kontu Archon
    if (en.specialCd <= 0) {
      en.specialCd = cdLimit;
      en.nightAlt = !en.nightAlt;
      const atAng = Math.atan2(player.y - en.y, player.x - en.x);
      en.atkLungeX = Math.cos(atAng) * 22;
      en.atkLungeY = Math.sin(atAng) * 22;
      en.atkSlashFx = 16;
      en.atkSlashCol = '#ff1744';
      en.squashT = 0.45;
      en.squashScale = 1.18;
      if (en.nightAlt) {
        // Attack A: Kan Tırpanı
        spawnFloatText(en.x, en.y - 36, 'Kan Tırpanı!', '#ff1744');
        playSfx('skill2', 0.24, 340);
        const bBase = atAng;
        for (let k = -1; k <= 1; k++) {
          const ba = bBase + k * 0.32;
          enemyProjectiles.push({
            x: en.x, y: en.y, vx: Math.cos(ba) * 3.3, vy: Math.sin(ba) * 3.3,
            r: 7, dmg: 8, ox: en.x, oy: en.y, maxDist: 270,
            kind: 'blood_scythe', face: ba
          });
        }
      } else {
        // Attack B: Yarasa Sürüsü Nova & Kesikli Mor Daire (Pafta Image 4)
        spawnFloatText(en.x, en.y - 36, 'Yarasa Sürüsü Nova!', '#d500f9');
        playSfx('skill2', 0.24, 400);
        // Kesikli Mor Telegraf Dairesi
        bossTelegraphs.push({
          kind: 'circle', x: player.x, y: player.y, r: 65,
          duration: 38, t: 0, color: '#d500f9',
          onTrigger: (bt) => {
            burst(bt.x, bt.y, '#d500f9', 22, 4.0);
            burst(bt.x, bt.y, '#ff1744', 14, 2.8);
            shake = Math.max(shake, 10);
            if (Math.hypot(player.x - bt.x, player.y - bt.y) < bt.r) {
              damagePlayer(en.phase2 ? 12 : 9);
              spawnFloatText(player.x, player.y - 20, 'Sülük Isırığı!', '#d500f9');
            }
          }
        });
        const batN = en.phase2 ? 10 : 6;
        for (let k = 0; k < batN; k++) {
          const bAng = (Math.PI * 2 / batN) * k;
          enemyProjectiles.push({
            x: en.x, y: en.y, vx: Math.cos(bAng) * 2.8, vy: Math.sin(bAng) * 2.8,
            r: 6.0, dmg: 7, ox: en.x, oy: en.y, maxDist: 240,
            kind: 'bat', face: bAng, bossRef: en
          });
        }
      }
    }
  } else if (bk === 'pink') {
    // 9. Şeker Diyarı Kraliçesi
    if (en.specialCd <= 0) {
      en.specialCd = cdLimit;
      en.pinkAlt = !en.pinkAlt;
      const atAng = Math.atan2(player.y - en.y, player.x - en.x);
      en.atkLungeX = Math.cos(atAng) * 20;
      en.atkLungeY = Math.sin(atAng) * 20;
      en.atkSlashFx = 16;
      en.atkSlashCol = '#ec407a';
      en.squashT = 0.45;
      en.squashScale = 1.18;
      if (en.pinkAlt) {
        // Attack A: Yapışkan Karamel Göletleri
        spawnFloatText(en.x, en.y - 36, 'Karamel Tuzağı!', '#ec407a');
        playSfx('bubble', 0.25);
        const count = en.phase2 ? 4 : 3;
        for (let k = 0; k < count; k++) {
          const cx = clampWorldX(player.x + (Math.random() - 0.5) * 130, 50);
          const cy = clampWorldY(player.y + (Math.random() - 0.5) * 130, 50);
          bossTelegraphs.push({
            kind: 'circle', x: cx, y: cy, r: 44,
            duration: 45 + k * 8, t: 0, color: '#ec407a',
            onTrigger: (bt) => {
              burst(bt.x, bt.y, '#ec407a', 18, 3.8);
              burst(bt.x, bt.y, '#f48fb1', 12, 2.5);
              playSfx('bubble', 0.22);
              hazards.push({ x: bt.x, y: bt.y, r: 35, type: 'caramel', until: performance.now() + 4500 });
              if (Math.hypot(player.x - bt.x, player.y - bt.y) < bt.r) {
                damagePlayer(en.phase2 ? 9 : 7);
                player.slowUntil = performance.now() + 1800;
                player.slowFactor = 0.35;
                spawnFloatText(player.x, player.y - 20, 'Yapıştı!', '#ec407a');
              }
            }
          });
        }
      } else {
        // Attack B: Lolipop Bombardımanı
        spawnFloatText(en.x, en.y - 36, 'Lolipop Yağmuru!', '#f06292');
        playSfx('skill', 0.24, 380);
        // Touhou / Soul Knight: Spiral Pastel Star Barrage from Princess Wand
        const starCount = en.phase2 ? 12 : 8;
        for (let s = 0; s < starCount; s++) {
          const sAng = atAng + (s * (Math.PI * 2 / starCount));
          enemyProjectiles.push({
            x: en.x, y: en.y, vx: Math.cos(sAng) * 3.4, vy: Math.sin(sAng) * 3.4,
            r: 7.0, dmg: en.phase2 ? 10 : 8, ox: en.x, oy: en.y, maxDist: 280,
            kind: 'sugar_crystal', face: sAng
          });
        }
        const count = en.phase2 ? 4 : 3;
        for (let k = 0; k < count; k++) {
          const lx = clampWorldX(player.x + (Math.random() - 0.5) * 120, 50);
          const ly = clampWorldY(player.y + (Math.random() - 0.5) * 120, 50);
          bossTelegraphs.push({
            kind: 'reticle', x: lx, y: ly, r: 42,
            duration: 48 + k * 10, t: 0, color: '#f06292',
            onTrigger: (bt) => {
              burst(bt.x, bt.y, '#ec407a', 20, 4.0);
              burst(bt.x, bt.y, '#ffffff', 10, 2.5);
              burst(bt.x, bt.y, '#00e5ff', 8, 2.0);
              shake = Math.max(shake, 10);
              playSfx('explode', 0.25, 420);
              if (Math.hypot(player.x - bt.x, player.y - bt.y) < bt.r) {
                damagePlayer(en.phase2 ? 11 : 8);
              }
            }
          });
        }
      }
    }
  } else if (bk === 'ketchup') {
    // 10. Ketçap İmparatoru
    if (en.specialCd <= 0) {
      en.specialCd = cdLimit;
      en.ketchupAlt = !en.ketchupAlt;
      const atAng = Math.atan2(player.y - en.y, player.x - en.x);
      en.atkLungeX = Math.cos(atAng) * 22;
      en.atkLungeY = Math.sin(atAng) * 22;
      en.atkSlashFx = 16;
      en.atkSlashCol = '#fbc02d';
      en.squashT = 0.45;
      en.squashScale = 1.18;
      if (en.ketchupAlt) {
        // Attack A: Kızgın Hardal Alev Püskürtücü
        spawnFloatText(en.x, en.y - 36, 'Acı Hardal Alevi!', '#fbc02d');
        playSfx('skill', 0.25, 240);
        const mAng = atAng;
        bossTelegraphs.push({
          kind: 'cone', x: en.x, y: en.y, angle: mAng, range: 220,
          spread: Math.PI * 0.38, duration: 44, t: 0, color: '#fbc02d',
          onTrigger: (bt) => {
            shake = Math.max(shake, 9);
            playSfx('explode', 0.28, 260);
            const mCount = en.phase2 ? 8 : 5;
            for (let k = 0; k < mCount; k++) {
              const ka = bt.angle + (Math.random() - 0.5) * bt.spread;
              const kSpd = 2.4 + Math.random() * 1.6;
              enemyProjectiles.push({
                x: en.x, y: en.y, vx: Math.cos(ka) * kSpd, vy: Math.sin(ka) * kSpd,
                r: 7, dmg: 7, ox: en.x, oy: en.y, maxDist: bt.range,
                kind: 'mustard_fire', face: ka
              });
            }
          }
        });
      } else {
        // Attack B: Kaygan Ketçap Şeridi
        const kAng = atAng;
        bossTelegraphs.push({
          kind: 'line', x: en.x, y: en.y,
          targetX: en.x + Math.cos(kAng) * 250, targetY: en.y + Math.sin(kAng) * 250,
          w: 34, duration: 38, t: 0, color: '#d32f2f',
          onTrigger: (bt) => {
            const kSpd = en.phase2 ? 8.5 : 6.8;
            en.dashVx = Math.cos(kAng) * kSpd;
            en.dashVy = Math.sin(kAng) * kSpd;
            en.dashT = en.phase2 ? 30 : 24;
            spawnFloatText(en.x, en.y - 32, 'Ketçap Kaydırağı!', '#d32f2f');
            playSfx('skill', 0.26, 260);
            burst(en.x, en.y, '#d32f2f', 18, 4);
            for (let s = 1; s <= 4; s++) {
              const kx = en.x + Math.cos(kAng) * (s * 50);
              const ky = en.y + Math.sin(kAng) * (s * 50);
              hazards.push({ x: kx, y: ky, r: 28, type: 'ketchup', until: performance.now() + 4500 });
            }
          }
        });
      }
    }
  }

  // 6. Standard periodic aimed shooting
  en.shootTimer = (en.shootTimer || 60) - dt;
  if (en.type === 'boss' && en.slamCd != null && en.slamCd < 36 && en.slamCd > 0) { // BOSS_SLAM_WARN
      ctx.save();
      ctx.strokeStyle = 'rgba(255, 82, 82, 0.75)';
      ctx.lineWidth = 3;
      ctx.setLineDash([6, 5]);
      ctx.beginPath();
      ctx.arc(en.x, en.y, en.r + 28 + (36 - en.slamCd) * 0.8, 0, Math.PI * 2);
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.restore();
    }
    if (en.aimT > 0) {
    if (distToSeg(player.x, player.y, en.x, en.y, en.aimX, en.aimY) < 12 && player.moving) tryPerfectDodge();
    en.aimT -= dt;
    if (en.aimT <= 0) {
      const ang = Math.atan2(en.aimY - en.y, en.aimX - en.x);
      const spdB = 2.6;
      let pKind = bk === 'lava' ? 'magma' : bk === 'forest' ? 'toxic_spore' : bk === 'storm' ? 'ball_lightning' : bk === 'water' ? 'hydro_wave' : bk === 'night' ? 'bat' : bk === 'sand' ? 'venom_needle' : 'icicle';
      enemyProjectiles.push({
        x: en.x, y: en.y, vx: Math.cos(ang) * spdB, vy: Math.sin(ang) * spdB,
        r: 7, dmg: en.phase2 ? 8 : 7, ox: en.x, oy: en.y, maxDist: 260,
        kind: pKind, face: ang
      });
      const n = en.phase2 ? 8 : 5;
      for (let k = 1; k < n; k++) {
        const a = ang + k * (Math.PI * 2 / n);
        enemyProjectiles.push({
          x: en.x, y: en.y, vx: Math.cos(a) * spdB, vy: Math.sin(a) * spdB,
          r: 6.5, dmg: en.phase2 ? 8 : 7, ox: en.x, oy: en.y, maxDist: 260,
          kind: pKind, face: a
        });
      }
      playSfx('skill2', 0.18, 400);
    }
  } else if (en.shootTimer <= 0 && dist >= 70 && dist <= 280) {
    en.shootTimer = (en.phase2 ? 45 : 80) + Math.random() * 20;
    en.aimX = player.x; en.aimY = player.y;
    en.aimT = 32;
  }

  softClamp(en);
}


function update(dt, now) {
  if (player && player.hp > 0) {
    window._ghostFrameCount = (window._ghostFrameCount || 0) + 1;
    if (window._ghostFrameCount >= 60) {
      window._ghostFrameCount = 0;
      if (window._ghostPath) window._ghostPath.push({x: player.x, y: player.y});
      if (window._pastGhostPath && window._pastGhostIndex < window._pastGhostPath.length - 1) {
        window._pastGhostIndex++;
      }
    }
  }
  // Hit-stop halts animation & motion briefly to accentuate critical strikes
  if (hitStopFrames > 0) {
    hitStopFrames--;
    return;
  }
  if (window.bulletTimeTimer > 0) {
    window.bulletTimeTimer--;
    dt *= 0.42;
  }
  if (typeof playShamanicBattleDrum === 'function') {
    playShamanicBattleDrum(now);
  }
  if (activeRiftPortal && player && typeof triggerRiftPortalEvent === 'function') {
    const rDist = Math.hypot(player.x - activeRiftPortal.x, player.y - activeRiftPortal.y);
    if (rDist < 35) triggerRiftPortalEvent();
  }
  if (enemies && enemies.length && typeof triggerBossExecutionFinisher === 'function') {
    for (let bi = 0; bi < enemies.length; bi++) {
      const en = enemies[bi];
      if (en && en.type === 'boss' && en.fsmState === 'staggered') {
        const bDist = Math.hypot(player.x - en.x, player.y - en.y);
        if (bDist < 65) {
          triggerBossExecutionFinisher(en);
          break;
        }
      }
    }
  }
  if (typeof checkRelicSetBonuses === 'function' && Math.random() < 0.04) {
    checkRelicSetBonuses(player);
  }
  time += dt;

  // 1. KABARCIK KALKANI (Aegis Bubble) — Hasarsız kalınca küre oluşumu (Lv1: 30s, Lv2: 20s, Lv3: 10s)
  if (player && player.mods && player.mods.aegisBubble && !_aegisReady) {
    _aegisTimer += dt;
    const reqSeconds = player.mods.aegisBubble === 1 ? 30 : (player.mods.aegisBubble === 2 ? 20 : 10);
    if (_aegisTimer >= reqSeconds * 60) {
      _aegisReady = true;
      spawnFloatText(player.x, player.y - 30, '🫧 KABARCIK HAZIR!', '#38bdf8', 'big');
      playSfx('shield', 0.5);
      burst(player.x, player.y, '#38bdf8', 16, 3.2);
    }
  }

  // 2. YAŞAM TOHUMLAYICI (Seed Spreader) — Zeminde şifalı filizler bırakma
  if (player && player.mods && player.mods.seedSpreader) {
    _seedTimer += dt;
    const dropFreq = player.mods.seedSpreader >= 2 ? 200 : 380;
    if (_seedTimer >= dropFreq) {
      _seedTimer = 0;
      _lifeSeeds.push({
        x: player.x + (Math.random() - 0.5) * 20,
        y: player.y + (Math.random() - 0.5) * 20,
        life: 720,
        r: 12
      });
    }
  }
  for (let si = _lifeSeeds.length - 1; si >= 0; si--) {
    const s = _lifeSeeds[si];
    s.life -= dt;
    if (s.life <= 0) { _lifeSeeds.splice(si, 1); continue; }
    if (player && Math.hypot(player.x - s.x, player.y - s.y) < (player.r || 18) + s.r) {
      const healAmt = (player.mods && player.mods.seedSpreader >= 2) ? 8 : 4;
      player.hp = Math.min(player.maxHp, player.hp + healAmt);
      player._seedSpeedBoost = 120; // 2 saniyelik hız artışı
      spawnFloatText(player.x, player.y - 20, '+' + healAmt + ' CAN!', '#34d399');
      burst(s.x, s.y, '#34d399', 10, 2.2);
      playSfx('pickup', 0.3);
      _lifeSeeds.splice(si, 1);
    }
  }
  if (player && player._seedSpeedBoost > 0) player._seedSpeedBoost -= dt;

  // 3. TERS KUTUPLANMA (Polarity Shift) — 8 saniyede bir aura ve mekanik değişimi
  if (player && player.mods && player.mods.polarityShift) {
    _polarityTimer += dt;
    if (_polarityTimer >= 480) { // 8 saniye
      _polarityTimer = 0;
      _polarityPhase = (_polarityPhase === 'blue') ? 'red' : 'blue';
      const col = (_polarityPhase === 'blue') ? '#38bdf8' : '#ef4444';
      const pName = (_polarityPhase === 'blue') ? '⚡ MAVİ FAZ (Hız & Mermi İtme)' : '🔥 KIRMIZI FAZ (Düşman Çekim & Patlama)';
      spawnFloatText(player.x, player.y - 32, pName, col, 'big');
      playSfx('switch', 0.45);
      burst(player.x, player.y, col, 20, 3.8);
    }
    // Faz Etkileri:
    if (_polarityPhase === 'blue') {
      if (typeof enemyBullets !== 'undefined' && enemyBullets && enemyBullets.length) {
        enemyBullets.forEach(b => {
          const bDist = Math.hypot(b.x - player.x, b.y - player.y);
          if (bDist < 110) {
            const bAng = Math.atan2(b.y - player.y, b.x - player.x);
            b.vx = Math.cos(bAng) * 4.5;
            b.vy = Math.sin(bAng) * 4.5;
          }
        });
      }
    } else {
      if (enemies && enemies.length && Math.random() < 0.25) {
        enemies.forEach(e => {
          if (!e._dead && e.type !== 'boss') {
            const eDist = Math.hypot(e.x - player.x, e.y - player.y);
            if (eDist < 190 && eDist > 35) {
              const eAng = Math.atan2(player.y - e.y, player.x - e.x);
              e.x += Math.cos(eAng) * 0.9;
              e.y += Math.sin(eAng) * 0.9;
            }
          }
        });
      }
    }
  }

  // 4. ZAMAN HIRSIZI (Chronos Siphon) Cooldown
  if (_chronosCd > 0) _chronosCd -= dt;

  // 5. YENİDEN DOĞUŞ / ARINMA MİHRABI (Respec Shrine) — Dalga 6, 12, 18'de beliren kutsal sıfırlama alanı
  if ((wave === 6 || wave === 12 || wave === 18) && !_respecShrine && (!window._respecShrineWaves || !window._respecShrineWaves.has(wave))) {
    if (!window._respecShrineWaves) window._respecShrineWaves = new Set();
    window._respecShrineWaves.add(wave);
    const rAng = Math.random() * Math.PI * 2;
    const rDist = 180 + Math.random() * 90;
    _respecShrine = {
      x: player.x + Math.cos(rAng) * rDist,
      y: player.y + Math.sin(rAng) * rDist,
      r: 36,
      stayTimer: 0,
      active: true
    };
    showStreakBanner('✨ ARINMA MİHRABI BELİRDİ! (Tüm Yeteneklerini Sıfırla)', '#ffd700');
    playSfx('legendary', 0.6);
  }
  if (_respecShrine && _respecShrine.active && player && player.hp > 0) {
    const sDist = Math.hypot(player.x - _respecShrine.x, player.y - _respecShrine.y);
    if (sDist < _respecShrine.r + (player.r || 18)) {
      _respecShrine.stayTimer += dt;
      if (_respecShrine.stayTimer >= 60) { // 1 saniye içinde durunca tetiklenir
        _respecShrine.active = false;
        let totalRefund = 0;
        if (player.mods) {
          Object.keys(player.mods).forEach(k => {
            totalRefund += (player.mods[k] || 0);
            player.mods[k] = 0;
          });
        }
        _banishedMods.clear();
        burst(_respecShrine.x, _respecShrine.y, '#ffd700', 45, 6.0);
        burst(player.x, player.y, '#c084fc', 35, 5.0);
        triggerScreenFlash('#ffd700', 0.6, 500);
        playSfx('legendary', 0.85);
        shake = Math.max((typeof shake !== 'undefined' ? shake : 0), 12);
        _respecShrine = null;

        if (totalRefund > 0) {
          _pendingRespecPicks = totalRefund - 1;
          showStreakBanner('✨ ' + totalRefund + ' YETENEK SIFIRLANDI! YENİDEN SEÇ!', '#ffd700');
          setTimeout(() => {
            showModPick();
          }, 180);
        } else {
          showStreakBanner('Mihrap Boş: Sıfırlanacak eklenti bulunamadı!', '#94a3b8');
        }
      }
    } else {
      _respecShrine.stayTimer = Math.max(0, _respecShrine.stayTimer - dt * 2);
    }
