    if (player.mods[evo.base] > 0 && player.mods[evo.req] > 0 && !player._evolvedPerks[evo.base]) {
      player._evolvedPerks[evo.base] = true;
      if (typeof showStreakBanner === 'function') showStreakBanner('🌟 YETENEK EVRİMİ: ' + evo.name, evo.desc);
