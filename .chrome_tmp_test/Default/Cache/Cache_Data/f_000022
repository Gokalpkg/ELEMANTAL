    // Boss mağlup edildiğinde kalan minyonları temizle
    for (let m = enemies.length - 1; m >= 0; m--) {
      if (enemies[m] && enemies[m] !== en) {
        enemies[m]._dead = true;
        burst(enemies[m].x, enemies[m].y, '#ffd740', 8, 2);
      }
    }
    enemies = enemies.filter(e => !e._dead);

    // İlk boss veya bekleyen elementi olan boss mağlubiyetinde anında 2. element seçimi tetiklensin
    if (!pendingElement && lockedCombos.length === 0) {
