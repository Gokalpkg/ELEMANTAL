// ── 13. ÇATALLANAN PİKSEL ŞİMŞEK ARKI (Image 2: Branching Lightning Bolt & Radial Spark) ──
function drawPixelBranchingLightning(b, time) {
  const minX = Math.min(b.x1, b.x2), maxX = Math.max(b.x1, b.x2);
  const minY = Math.min(b.y1, b.y2), maxY = Math.max(b.y1, b.y2);
  if (maxX < cam.x - 30 || minX > cam.x + W + 30 || maxY < cam.y - 30 || minY > cam.y + H + 30) return;
  const a = Math.max(0, b.life / (b.max || 0.28));
  ctx.save();
  ctx.globalAlpha = 0.35 + a * 0.65;

  const x1 = b.x1, y1 = b.y1, x2 = b.x2, y2 = b.y2;
  const dx = x2 - x1, dy = y2 - y1;
  const dist = Math.hypot(dx, dy) || 1;
  const steps = Math.max(7, Math.min(14, Math.round(dist / 14)));

  // 1. Ana Şimşek Yolu
  let prevX = Math.round(x1), prevY = Math.round(y1);
  for (let i = 1; i <= steps; i++) {
    const t = i / steps;
    const isMid = i < steps;
    const jig = isMid ? ((i % 2 === 0 ? 1 : -1) * (3 + (i % 3) * 2)) : 0;
    const normX = -dy / dist, normY = dx / dist;
    const curX = Math.round(x1 + dx * t + normX * jig);
    const curY = Math.round(y1 + dy * t + normY * jig);

    // Mavi/Camgöbeği Elektrik Halesi (Cyan Outer Arc)
    ctx.fillStyle = '#0284c7';
    ctx.fillRect(curX - 2, curY - 2, 4, 4);

    // Canlı Açık Mavi İç Kordon
    ctx.fillStyle = '#38bdf8';
    ctx.fillRect(curX - 1.5, curY - 1.5, 3, 3);

    // Akkor Beyaz Çekirdek
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(curX - 0.5, curY - 0.5, 2, 2);

    // Yan Şimşek Çatalı (Branching Fork) - 2 yerde yana 45° sıçrama
    if (i === Math.floor(steps * 0.4) || i === Math.floor(steps * 0.7)) {
      const bSign = (i % 2 === 0 ? 1 : -1);
      const bAng = Math.atan2(dy, dx) + bSign * 0.85;
      const bLen = 12 + (i % 3) * 4;
      const bx2 = curX + Math.cos(bAng) * bLen;
      const by2 = curY + Math.sin(bAng) * bLen;

      ctx.fillStyle = '#38bdf8';
      ctx.fillRect(Math.round((curX + bx2) / 2) - 1, Math.round((curY + by2) / 2) - 1, 2, 2);
      ctx.fillRect(Math.round(bx2) - 1, Math.round(by2) - 1, 2, 2);
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(Math.round(bx2) - 0.5, Math.round(by2) - 0.5, 1, 1);
    }

    prevX = curX;
    prevY = curY;
  }

  // 2. Darbe Noktasında Radial Elektrik Örümcek Ağı Kıvılcımı (Radial Spark Discharge)
  ctx.fillStyle = '#ffffff';
  ctx.fillRect(Math.round(x2) - 1, Math.round(y2) - 1, 3, 3);
  ctx.fillStyle = '#7dd3fc';
  for (let s = 0; s < 4; s++) {
    const sAng = s * (Math.PI / 2) + ((time * 0.4) % 1);
    ctx.fillRect(Math.round(x2 + Math.cos(sAng) * 6) - 1, Math.round(y2 + Math.sin(sAng) * 6) - 1, 2, 2);
  }

  ctx.restore();
}

