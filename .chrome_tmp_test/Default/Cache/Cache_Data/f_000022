 'Ketçap Kaydırağı!': 'Ketchup Slide!',
 ' Çekim Girdabı!': ' Gravity Vortex!',
 'Yarasa Kaçışı': 'Bat Escape',
 'Hücum!': 'Charge!',
 'KUTUPSAL ÇEKİM!': 'POLAR MAGNET!',
 ' XP SERİSİ!': ' XP STREAK!',
 ' VOLKANİK SİPER!': ' VOLCANIC SHIELD!',
 ' ZAMAN GERİ SARILDI!': ' TIME REWOUND!',
 'Ayna Yansıması!': 'Mirror Reflect!',
 ' Kusursuz İmtihan Bozuldu!': ' Perfect Trial Failed!',
 ' MİHRAP MUHAFIZI KATLEDİLDİ!': ' SHRINE GUARDIAN SLAIN!',
 ' KADİM ULTİ HAZIR! ': ' ANCIENT ULTI READY! ',
 ' Can İksiri!': ' Health Elixir!',
 ' Şanslı Kristal!': ' Lucky Crystal!',
 ' EFSANEVİ CAM TOP! (4x HASAR)': ' LEGENDARY GLASS CANNON! (4x DAMAGE)',
 ' KAN BÜYÜSÜ! (-%70 CD)': ' BLOOD MAGIC! (-70% CD)',
 'MIKNATIS KIYAMETİ!': 'MAGNET APOCALYPSE!',
 '+%20 hız': '+20% Speed'
    };
    if (FLOAT_EN_MAP[str]) {
      str = FLOAT_EN_MAP[str];
    } else {
      str = str.replace('PARÇALANDI!', 'SHATTERED!')
               .replace('İNFAZ! -', 'EXECUTE! -')
               .replace('%300 İNFAZ!', '300% EXECUTION!')
               .replace('CAN DİRİLİŞ!', 'HP REVIVAL!')
               .replace('2X ÇİFTE HAZİNE!', '2X DOUBLE TREASURE!')
               .replace('EFSANEVİ HAZİNE!', 'LEGENDARY TREASURE!')
               .replace('Kuşandı!', 'Equipped!')
               .replace('SKİLL TAMAMLANDI!', 'SKILL COMPLETED!')
               .replace('Dalga ', 'Wave ')
               .replace(' Yüklendi!', ' Loaded!')
 .replace('Titreşim: Açık', 'Vibration: On')
 .replace('Titreşim: Kapalı', 'Vibration: Off');
    }
  }

  const isCrit = type === 'crit' || str.startsWith('!') || color === '#ffd740' || color === '#ffd700';
  const isKill = type === 'kill';
  const isBig = type === 'big' || str.length > 8;
  const isDot = type === 'dot' || type === 'small';

  const now = performance.now();
  // STEP 1: STATUS DEBOUNCING & STACKING (Prevents overlapping blobs like "BLOK! BLOK! FİLİZLENME")
  const isStatusText = isNaN(parseInt(str.replace(/[^0-9]/g, ''), 10)) || isBig;
  for (let i = _canvasFloatTexts.length - 1; i >= Math.max(0, _canvasFloatTexts.length - 8); i--) {
    const prev = _canvasFloatTexts[i];
    const dist = Math.hypot(prev.x - x, prev.y - y);
    if (dist < 42 && (now - prev.birth < 450)) {
      // If identical status text spawned on same target (e.g. BLOK!, FİLİZLENME)
      if (prev.baseText === str || prev.text.startsWith(str)) {
        prev.stackCount = (prev.stackCount || 1) + 1;
        prev.text = str + ' x' + prev.stackCount;
        prev.curLife = prev.maxLife;
        prev.scale = Math.min(1.45, prev.scale + 0.14);
        prev.vy = -1.05;
        return;
      }
      // If consecutive damage numbers, aggregate into one
      if (!isStatusText && !isCrit && prev.type !== 'kill') {
        const pNum = parseInt(prev.text.replace(/[^0-9]/g, ''), 10);
        const cNum = parseInt(str.replace(/[^0-9]/g, ''), 10);
        if (!isNaN(pNum) && !isNaN(cNum)) {
          prev.text = '-' + (pNum + cNum);
          prev.curLife = prev.maxLife;
          prev.vy = -1.1;
          prev.scale = Math.min(1.4, prev.scale + 0.12);
          return;
        }
      }
      // Vertical Collision Avoidance: push older text upward so they cascade neatly
      if (Math.abs(prev.y - y) < 14) {
        y -= 14;
      }
    }
  }

  // Strictly cap active float texts to 36 for zero-DOM, buttery smooth 60 FPS
  if (_canvasFloatTexts.length >= 36) {
    const culled = _canvasFloatTexts.shift();
    if (culled && _floatTextPool.length < 64) _floatTextPool.push(culled);
  }

  // Fanning arc trajectory
  _floatCascadeIndex = (_floatCascadeIndex + 1) % 7;
  const arcAngles = [-0.65, 0.65, -0.35, 0.35, -0.9, 0.9, 0];
  const arcAng = arcAngles[_floatCascadeIndex];
  const arcDist = isCrit ? 22 : 14;
  const scatterX = Math.sin(arcAng) * arcDist;
  const scatterY = -Math.cos(arcAng) * (arcDist * 0.6) - (isCrit ? 8 : 4);

  const durationFrames = isCrit ? 48 : isBig ? 44 : isKill ? 46 : 34;

  let ftObj = _floatTextPool.length > 0 ? _floatTextPool.pop() : {};
  ftObj.x = x + scatterX;
  ftObj.y = y + scatterY;
  ftObj.text = str;
  ftObj.baseText = str;
  ftObj.stackCount = 1;
  ftObj.color = isCrit ? '#ffd700' : (color || '#ffffff');
  ftObj.type = type || 'normal';
  ftObj.isCrit = isCrit;
  ftObj.birth = now;
  ftObj.curLife = durationFrames;
  ftObj.maxLife = durationFrames;
  ftObj.scale = isCrit ? 1.4 : isBig ? 1.25 : 1.0;
  ftObj.vy = isCrit ? -1.35 : -0.95;
  _canvasFloatTexts.push(ftObj);
  return ftObj;
}

function drawCanvasFloatTexts(ctx) {
  if (!_canvasFloatTexts.length) return;
  ctx.save();
  ctx.textAlign = 'center';
  ctx.textBaseline = 'middle';
  for (let i = _canvasFloatTexts.length - 1; i >= 0; i--) {
    const ft = _canvasFloatTexts[i];
    ft.curLife--;
    ft.y += ft.vy;
    ft.vy *= 0.94;
    if (ft.curLife <= 0) {
      _canvasFloatTexts.splice(i, 1);
      if (_floatTextPool.length < 64) _floatTextPool.push(ft);
      continue;
    }
    const alpha = Math.min(1.0, ft.curLife / (ft.maxLife * 0.28));
    ctx.globalAlpha = alpha;
    const lifeRatio = ft.curLife / ft.maxLife;
    let animScale = ft.scale;
    if (lifeRatio > 0.82 && ft.isCrit) {
      animScale *= 1.22; // Punchy crit pop in the first few frames
    }
    const baseSize = ft.isCrit ? 15 : (ft.type === 'big' || ft.type === 'kill') ? 13 : 11;
    ctx.font = '900 ' + Math.round(baseSize * animScale) + 'px "Outfit", "Segoe UI", system-ui, -apple-system, sans-serif';
    // Crisp 2.5px dark outline for crystal-clear readability over any background or boss
    ctx.strokeStyle = 'rgba(0, 0, 0, 0.95)';
    ctx.lineWidth = 2.5;
    ctx.strokeText(ft.text, Math.round(ft.x), Math.round(ft.y));
    // Crisp colored fill
    ctx.fillStyle = ft.color;
    ctx.fillText(ft.text, Math.round(ft.x), Math.round(ft.y));
  }
  ctx.restore();
}

function pushAutoShot(ang, auto, extra) {
  const spd = (extra && extra.speed) || auto.speed;
  const r = (extra && extra.r) || auto.r;
  const dmg = (extra && extra.dmg) || auto.dmg;
  const isAnti = modLv('antimatter') > 0;
  const combo = player.comboStep || 1;
  playerProjectiles.push({
    x: player.x + Math.cos(ang)*10, y: player.y + Math.sin(ang)*10,
    vx: Math.cos(ang)*spd, vy: Math.sin(ang)*spd,
    r: isAnti ? r + 2 : r, dmg,
    color: isAnti ? '#c084fc' : ((extra && extra.color) || auto.color),
    effects: extra && extra.effects ? extra.effects : auto.effects,
    life: 1,
    pierce: isAnti ? 999 : (pierceCount() + (extra && extra.pierce ? extra.pierce : 0)),
    ricochet: extra && extra.ricochet != null ? extra.ricochet : (modValue('ricochet') || 0),
    home: extra && extra.home,
    face: ang,
    comboStep: combo,
    hit: new Set(),
    ox: player.x, oy: player.y,
    maxDist: (extra && extra.range != null ? extra.range : (auto.range || AUTO_X)) * (modLv('sniper') > 0 && !player.moving ? 2.0 : 1.0),
    el: extra && extra.el,
    fuse: extra && extra.fuse,
    special: extra && extra.special,
    targetEn: extra && extra.targetEn,
    ambushMul: extra && extra.ambushMul
  });
}

function firePlayerProjectile() {
  const auto = currentAuto();
  const isSniperStance = modLv('sniper') > 0 && !player.moving;
  const autoRange = (auto.range || AUTO_X) * (isSniperStance ? 2.0 : 1.0);
  let target = nearestEnemyInRange(autoRange);

  // 3-Hit Kılıç Kombo Döngüsü (Pafta: Attack Combo - 3 hit)
  const now = performance.now();
  if (player.lastAttackTime && (now - player.lastAttackTime > 1200)) {
    player.comboStep = 0;
  }
  player.lastAttackTime = now;
  player.comboStep = ((player.comboStep || 0) % 3) + 1;
  player.atkSlashFx = 16;
  if (typeof playHeroAttackSfx === 'function') {
    playHeroAttackSfx(selectedHeroId);
  }
  if (!target && enemies.length) {
    target = nearestEnemy();
  }
  if (!target) return;

  // UMAY ANA: STATİK İVME TOP YILDIRIMI DEŞARJI
  if ((player.heroId === 'umay' || selectedHeroId === 'umay') && player._umayReady) {
    player._umayReady = false;
    player._umayCharge = 0;
    const isEn = (typeof getGameLang === 'function' && getGameLang() === 'en');
    spawnFloatText(player.x, player.y - 34, isEn ? ' BALL LIGHTNING!' : ' TOP YILDIRIMI!', '#facc15', 'big');
    if (typeof synthBlip === 'function') synthBlip('elem_storm');
    if (typeof playPunchySubBass === 'function') playPunchySubBass(160, 0.28, 0.55);
    shake = Math.max(shake, 7);
    vibrate([30, 45]);
    const stormTargets = enemies.filter(en => Math.hypot(en.x - player.x, en.y - player.y) < 380 && !en._dead).slice(0, 5);
    stormTargets.forEach((en, ti) => {
      setTimeout(() => {
        if (!en || en._dead) return;
        takeDamage(en, Math.round((auto.dmg || 12) * 2.2), 'storm');
        burst(en.x, en.y, '#facc15', 14, 3.8);
        sparks.push({ x: en.x, y: en.y, vx: 0, vy: -1.2, life: 0.25, maxLife: 0.25, color: '#facc15', r: 3.5 });
      }, ti * 65);
    });
  }

  // KORHAN: 3. VURUŞTA MAGMA TOKMAĞI ŞOK DALGASI
  if ((player.heroId === 'korhan' || selectedHeroId === 'korhan') && player.comboStep === 3) {
    shake = Math.max(shake, 6.5);
    burst(player.x, player.y, '#ff5722', 18, 3.5);
    playSfx('explode', 0.4, 200);
    spawnFloatText(player.x, player.y - 30, ' MAGMA TOKMAĞI!', '#ff5722', 'crit');
    (enemies || []).forEach(en => {
      if (en && en.hp > 0 && Math.hypot(en.x - player.x, en.y - player.y) < 140) {
        takeDamage(en, Math.round((auto.dmg || 15) * 1.4), 'fire');
        punchEnemy(en, player.x, player.y, 16, true);
        applyEffect(en, 'burn', 3.0);
      }
    });
  }

  // KAYRA HAN: BÜYÜ YANKISI (HER 4. ATIŞTA ÇİFT BÜYÜ)
  if (player.heroId === 'kayra' || selectedHeroId === 'kayra') {
    player._kayraSpellCount = ((player._kayraSpellCount || 0) + 1) % 4;
    if (player._kayraSpellCount === 0) {
      spawnFloatText(player.x, player.y - 28, ' BÜYÜ YANKISI!', '#38bdf8', 'crit');
      playSfx('legendary', 0.35);
      setTimeout(() => {
        if (running && !paused && target && target.hp > 0) {
          shootSingle(target, auto, { dmg: Math.round((auto.dmg || 15) * 0.75), color: '#38bdf8' });
        }
      }, 110);
    }
  }

  let volleyAmbush = 1;
  if (ashVeil && (ashVeil.hidden || ashVeil.ambush)) volleyAmbush = consumeAshAmbush(target);
  echoShot = true;
  noteElemUse(auto.els && auto.els.length ? [auto.shots[0] && auto.shots[0].key || auto.els[0]] : [], 5);
  const baseAngle = Math.atan2(target.y-player.y, target.x-player.x);
  player.facing = baseAngle;
  shotCount++;
  const shots = auto.shots && auto.shots.length ? auto.shots : [{
    speed: auto.speed, r: auto.r, dmg: auto.dmg, color: auto.color, effects: auto.effects, special: auto.special
  }];
  const isSpecial = auto.specialEvery && shotCount % auto.specialEvery === 0;
  shots.forEach((sh, i) => {
    const n = shots.length;
    const off = n > 1 ? (i - (n - 1) / 2) * 0.16 : 0;
    const ang = baseAngle + off;
    const curHeroData = getSelectedHero();
    const heroDmgMul = (curHeroData && curHeroData.dmgMul) || 1.0;
    let packDmg = Math.round((sh.dmg != null ? sh.dmg : (auto.dmg || 10)) * (1 + (modValue('dmg') || 0) / 100) * (1 + treeLv('damage') * 0.06) * heroDmgMul);
    if ((player.heroId === 'ulgen' || selectedHeroId === 'ulgen') && player._ulgenMode === 'fire') {
      packDmg = Math.round(packDmg * 1.40);
    }
    if (modLv('bloodPact')) packDmg = Math.round(packDmg * 1.5);
    if (modLv('resonance')) {
      const unCount = new Set(autoRoots()).size;
      packDmg = Math.round(packDmg * (1 + unCount * 0.20));
    }
    if (isSniperStance) packDmg = Math.round(packDmg * 2.0);
    const packColor = isSniperStance ? '#ffd740' : (modLv('antimatter') ? '#c084fc' : sh.color);
    const fusedKey = (sh && sh.fuse) || (auto && auto.fusePair) || null;
    const pack = {
      speed: sh.speed, r: sh.r, dmg: packDmg, color: packColor,
      effects: sh.effects, range: autoRange, el: sh.key,
      home: sh.home, fuse: fusedKey, special: sh.special,
      targetEn: target
    };
    const stainN = runFlags().stainEvery || 5;
    if (runLock && runLock.forkDone && runLock.secondary && shotCount % stainN === 0) {
      const secFx = ELEMENTS[runLock.secondary] && ELEMENTS[runLock.secondary].effect;
      if (secFx) pack.effects = (pack.effects || []).concat(secFx);
    }
    if (runFlags().pierce) pack.pierce = (pack.pierce || 0) + 1;
    if (volleyAmbush > 1) pack.ambushMul = volleyAmbush;
    if (streakOn) { pack.color = '#ffd740'; pack.dmg = Math.round(pack.dmg * 1.24); pack.r = (sh.r || auto.r) + 1.4; }
    // SÜPER EVRİM APEX ÖZEL MERMİ DAVRANIŞLARI
    if (auto.isApex || (player && player._hasApexEvolution)) {
      pack.dmg = Math.round(pack.dmg * 1.5);
      pack.pierce = (pack.pierce || 0) + 3;
      if (auto.special === 'solar_disk') {
        pack.r = 16;
        pack.color = '#fde047';
        pack.speed = 8.5;
        if (Math.random() < 0.35) spawnElemStain(player.x, player.y, 35, 'fire', 80);
      } else if (auto.special === 'cataclysm_meteor') {
        pack.r = 18;
        pack.color = '#ff3d00';
        shake = Math.max(shake, 4);
      }
    }

    if (modLv('multishot') && i === 0 && !isSpecial) {
      pushAutoShot(ang - 0.30, auto, { ...pack, dmg: Math.round(pack.dmg * 0.8) });
      pushAutoShot(ang + 0.30, auto, { ...pack, dmg: Math.round(pack.dmg * 0.8) });
      if (player && player._evolvedPerks && player._evolvedPerks['multishot']) {
        pushAutoShot(ang - 0.15, auto, { ...pack, dmg: Math.round(pack.dmg * 0.8), pierce: 999 });
        pushAutoShot(ang + 0.15, auto, { ...pack, dmg: Math.round(pack.dmg * 0.8), pierce: 999 });
      }
    }

    if (i === 0 && isSpecial && auto.special === 'burst') {
      for (let k=-1;k<=1;k++) pushAutoShot(ang + k*0.22, auto, { ...pack, dmg: sh.dmg });
    } else if (i === 0 && isSpecial && auto.special === 'freeze') {
      pushAutoShot(ang, auto, { ...pack, r: sh.r+3, dmg: sh.dmg+2, effects: ['slow','stun'], speed: sh.speed*0.85 });
    } else if (i === 0 && isSpecial && auto.special === 'heavy') {
      pushAutoShot(ang, auto, { ...pack, r: sh.r+4, dmg: sh.dmg+4, effects: ['stun'], speed: sh.speed*0.75 });
    } else if (i === 0 && isSpecial && auto.special === 'sap') {
      pushAutoShot(ang, auto, { ...pack, dmg: sh.dmg+1 });
      player.hp = Math.min(player.maxHp, player.hp+1); updateHud();
    } else if (i === 0 && isSpecial && auto.special === 'chain') {
      pushAutoShot(ang, auto, pack);
      const hops = 3 + (runFlags().chainHops || ((typeof activeFusionClass === 'function' && activeFusionClass() === 'thunder') ? 2 : 0));
      chainLightning(target, Math.max(3, Math.round(sh.dmg * 0.7)), hops, 110, auto.color, 'shock');
    } else if (i === 0 && isSpecial && auto.special === 'blackhole') {
      pushAutoShot(ang, auto, { ...pack, r: sh.r+3, dmg: sh.dmg+3 });
      pullEnemies(target.x, target.y, 110, 4.2);
    } else if (i === 0 && isSpecial && auto.special === 'super_conduct') {
      pushAutoShot(ang, auto, { ...pack, r: sh.r+2, dmg: Math.round(sh.dmg * 1.3) });
      chainLightning(target, Math.round(sh.dmg * 0.85), 5, 175, '#60a5fa', 'shock');
    } else if (i === 0 && isSpecial && auto.special === 'spore_flare') {
      for (let k=-1;k<=1;k++) pushAutoShot(ang + k*0.25, auto, { ...pack, dmg: Math.round(sh.dmg * 0.9) });
      spawnElemStain(target.x, target.y, 70, 'fire', 180);
      spawnEnvDebris(target.x, target.y, 'nature', 3, 'spore_cloud');
    } else if (i === 0 && isSpecial && auto.special === 'abyss_maelstrom') {
      pushAutoShot(ang, auto, { ...pack, r: sh.r+3, dmg: sh.dmg+3 });
      pullEnemies(target.x, target.y, 120, 5.2);
      applyEffect(target, 'slow', 1.5);
      spawnEnvDebris(target.x, target.y, 'void', 4, 'vortex');
    } else if (i === 0 && isSpecial && auto.special === 'thermal_steam') {
      for (let k=-1;k<=1;k++) pushAutoShot(ang + k*0.18, auto, { ...pack, dmg: sh.dmg, r: sh.r+1.5 });
      burst(target.x, target.y, '#e0f2fe', 14, 2.8);
      spawnEnvDebris(target.x, target.y, 'water', 3, 'water_puddle');
      enemyProjectiles = enemyProjectiles.filter(ep => Math.hypot(ep.x - target.x, ep.y - target.y) > 70);
    } else if (i === 0 && isSpecial && auto.special === 'magnet_pulse') {
      pushAutoShot(ang, auto, { ...pack, dmg: sh.dmg+3 });
      pullEnemies(target.x, target.y, 110, 3.8, { safeFromPlayer: true, minPlayerDist: 68, stunDuration: 450, shock: true });
      chainLightning(target, Math.round(sh.dmg * 0.6), 3, 100, '#eab308', 'shock');
      spawnEnvDebris(target.x, target.y, 'storm', 3, 'static_field');
    } else if (i === 0 && isSpecial && auto.special === 'dark_execute') {
      const isLow = (target.hp / target.maxHp) <= 0.35;
      const bonusDmg = isLow ? Math.round(sh.dmg * 2.5) : sh.dmg;
      pushAutoShot(ang, auto, { ...pack, dmg: bonusDmg, r: sh.r+2 });
      spawnEnvDebris(target.x, target.y, 'void', 2, 'void_smoke');
    } else if (i === 0 && isSpecial && auto.special === 'cosmic_rift') {
      pushAutoShot(ang, auto, { ...pack, dmg: sh.dmg+3 });
      const nearby = enemiesInRange(220).filter(e => e !== target).slice(0, 2);
      nearby.forEach(en => {
        takeDamage(en, Math.round(sh.dmg * 0.75), 'void');
        burst(en.x, en.y, '#c084fc', 8, 2.2);
        spawnEnvDebris(en.x, en.y, 'void', 2, 'abyss_rift');
      });
    } else if (i === 0 && isSpecial && auto.special === 'lava_pool') {
      pushAutoShot(ang, auto, { ...pack, dmg: sh.dmg+2 });
      spawnElemStain(target.x, target.y, 75, 'fire', 210);
      spawnEnvDebris(target.x, target.y, 'fire', 4, 'lava_pool');
    } else if (i === 0 && isSpecial && auto.special === 'heal_dew') {
      pushAutoShot(ang, auto, pack);
      player.hp = Math.min(player.maxHp, player.hp + 2.5);
      shieldOn = Math.max(shieldOn, 60);
      spawnEnvDebris(player.x, player.y, 'nature', 2, 'leaf_drift');
      updateHud();
    } else if (i === 0 && isSpecial && auto.special === 'shadow_leech') {
      pushAutoShot(ang, auto, { ...pack, dmg: sh.dmg+2 });
      const healAmt = 2.0;
      player.hp = Math.min(player.maxHp, player.hp + healAmt);
      shieldOn = Math.max(shieldOn, 90);
      updateHud();
      applyEffect(target, 'slow', 1.5);
      spawnEnvDebris(target.x, target.y, 'void', 2, 'void_smoke');
    } else if (i === 0 && isSpecial && auto.special === 'entangle') {
      pushAutoShot(ang, auto, { ...pack, dmg: sh.dmg+3, r: sh.r+2 });
      applyEffect(target, 'root', 2.0);
      applyEffect(target, 'stun', 0.8);
      shieldOn = Math.max(shieldOn, 120);
      spawnEnvDebris(target.x, target.y, 'nature', 4, 'ground_thorns');
    } else if (i === 0 && isSpecial && auto.special === 'mud_bog') {
      pushAutoShot(ang, auto, pack);
      spawnElemStain(target.x, target.y, 80, 'water', 240);
      spawnEnvDebris(target.x, target.y, 'earth', 4, 'mud_quagmire');
      applyEffect(target, 'slow', 2.0);
    } else if (i === 0 && isSpecial && auto.special === 'plasma_pierce') {
      pushAutoShot(ang, auto, { ...pack, dmg: sh.dmg+4, pierce: 3, speed: sh.speed*1.2 });
      spawnEnvDebris(target.x, target.y, 'storm', 3, 'plasma_trench');
    } else if (i === 0 && isSpecial && auto.special === 'crush') {
      pushAutoShot(ang, auto, { ...pack, dmg: sh.dmg+5, r: sh.r+3 });
      damageEnemiesInRadius(target.x, target.y, 85, Math.round(sh.dmg * 0.7), ['stun'], 1.8);
      spawnEnvDebris(target.x, target.y, 'earth', 5, 'gravity_crater');
    } else if (i === 0 && isSpecial && auto.special === 'spark_thorn') {
      pushAutoShot(ang, auto, { ...pack, ricochet: 3, dmg: sh.dmg+1 });
      playerBuff.as = 0.15;
      playerBuff.until = performance.now() + 3000;
    } else if (i === 0 && isSpecial && (auto.special === 'solar_disk' || auto.special === 'cataclysm_meteor')) {
      pushAutoShot(ang, auto, { ...pack, r: sh.r + 3, dmg: Math.round(sh.dmg * 1.35) });
      if (auto.special === 'solar_disk') {
        spawnElemStain(target.x, target.y, 85, 'fire', 220);
        spawnEnvDebris(target.x, target.y, 'fire', 4, 'lava_pool');
