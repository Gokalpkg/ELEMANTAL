function getAchievements() {
  try { return JSON.parse(localStorage.getItem('elementer_achievements') || '{}'); } catch(e) { return {}; }
}
function saveAchievements(a) {
  try { localStorage.setItem('elementer_achievements', JSON.stringify(a)); } catch(e) {}
}
function getLifetimeStats() {
  try { return JSON.parse(localStorage.getItem('elementer_lifetime') || '{}'); } catch(e) { return {}; }
}
