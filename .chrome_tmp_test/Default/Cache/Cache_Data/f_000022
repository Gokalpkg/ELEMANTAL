function getWaveHpMul(w) {
  const curWave = w != null ? w : (typeof wave !== 'undefined' ? wave : 1);
  if (curWave <= 1) return 1.0;
  if (curWave <= 2) return 1.25;
  if (curWave <= 3) return 1.65;
  if (curWave <= 4) return 2.15;
  if (curWave <= 5) return 2.75;
  if (curWave <= 7) return 3.35;
  return Math.min(5.2, 3.35 + (curWave - 7) * 0.42);
}

function getWaveDmgMul(w) {
  const curWave = w != null ? w : (typeof wave !== 'undefined' ? wave : 1);
  if (curWave <= 1) return 1.0;
  if (curWave <= 2) return 1.25;
  if (curWave <= 3) return 1.60;
  if (curWave <= 4) return 2.05;
  if (curWave <= 5) return 2.60;
  if (curWave <= 7) return 3.10;
  return Math.min(4.8, 3.10 + (curWave - 7) * 0.35);
}

