    ctx.fillStyle = '#00e5ff';
    ctx.shadowColor = '#00e5ff';
    ctx.shadowBlur = 0; /* 60fps */
    ctx.beginPath();
    ctx.arc(x - r * 1.15 + 2, cy - r * 0.8 - 2, 3, 0, Math.PI * 2);
    ctx.arc(x + r * 0.85 + 2, cy - r * 0.8 - 2, 3, 0, Math.PI * 2);
    ctx.fill();
    // High Voltage Visor
    ctx.fillStyle = '#ffff00';
    ctx.shadowColor = '#ffff00';
    ctx.shadowBlur = 0; /* 60fps */
    ctx.fillRect(Math.round(x - r * 0.45), Math.round(cy - r * 0.15), Math.round(r * 0.9), 3);
    ctx.shadowBlur = 0;
  } else if (isCaster) {
    // Tempest Cloud Sorcerer (Shooter / Shaman)
    const cy = y + Math.sin(time * 0.3 + en.phase) * 2.6;
    // Dark Storm-Cloud Cloak
    pixDisk(x, cy + 2, r * 0.95, '#7e57c2', '#4527a0', '#1a0f3d');
    // Crackling Plasma Lightning Orb Hovering Overhead
    const orbY = cy - r * 1.2 + Math.sin(time * 0.35) * 2.5;
    ctx.fillStyle = '#ffeb3b';
    ctx.shadowColor = '#ffea00';
    ctx.shadowBlur = 0; /* 60fps */
    ctx.beginPath();
    ctx.arc(x, orbY, 4.5, 0, Math.PI * 2);
    ctx.fill();
    // Mini Electric Arc Sparks
    ctx.strokeStyle = '#ffffff';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(x - 5, orbY);
    ctx.lineTo(x, orbY - 4);
    ctx.lineTo(x + 5, orbY);
    ctx.stroke();
    ctx.shadowBlur = 0;
    // Piercing Yellow Spark Eyes
    ctx.fillStyle = '#ffff00';
    ctx.shadowColor = '#ffff00';
    ctx.shadowBlur = 0; /* 60fps */
    ctx.fillRect(Math.round(x - r * 0.35), Math.round(cy - r * 0.1), 3, 2.5);
    ctx.fillRect(Math.round(x + r * 0.12), Math.round(cy - r * 0.1), 3, 2.5);
    ctx.shadowBlur = 0;
  } else if (isRusher) {
    // Thunder Wasp / Sparkfly (Fast / Exploder)
    const buzz = Math.sin(time * 0.6 + en.phase);
    const cy = y + buzz * 2.8;
    // Buzzing Electric Wings
    ctx.fillStyle = 'rgba(128, 222, 234, 0.65)';
    ctx.fillRect(Math.round(x - r * 1.3), Math.round(cy - r * 0.8 + buzz * 3), Math.round(r * 0.9), 4);
    ctx.fillRect(Math.round(x + r * 0.4), Math.round(cy - r * 0.8 + buzz * 3), Math.round(r * 0.9), 4);
    // Striped Abdomen
    pixDisk(x, cy, r, '#fff59d', '#fbc02d', '#212121');
    ctx.fillStyle = '#212121';
    ctx.fillRect(Math.round(x - r * 0.7), Math.round(cy - 2), Math.round(r * 1.4), 2.5);
    ctx.fillRect(Math.round(x - r * 0.6), Math.round(cy + 4), Math.round(r * 1.2), 2.5);
    // Lightning Needle Stinger
    ctx.fillStyle = '#00e5ff';
    ctx.shadowColor = '#00e5ff';
    ctx.shadowBlur = 0; /* 60fps */
    ctx.fillRect(Math.round(x - 1), Math.round(cy + r * 0.75), 2.5, 6);
    ctx.shadowBlur = 0;
  } else {
    // Static Plasma Jelly (Slime / Swarmer / Leech)
    pixDisk(x, y, r, '#fffde7', '#ffd600', '#f57f17');
    // Mini Antennae
    ctx.fillStyle = '#ffd54f';
    ctx.fillRect(Math.round(x - 3), Math.round(y - r * 0.9), 2, 4);
    ctx.fillRect(Math.round(x + 2), Math.round(y - r * 0.9), 2, 4);
    // Internal Electric Filament
    ctx.fillStyle = '#00e5ff';
    ctx.shadowColor = '#00e5ff';
    ctx.shadowBlur = 0; /* 60fps */
    ctx.fillRect(Math.round(x - 2), Math.round(y - 1), 4, 2);
    ctx.shadowBlur = 0;
    // Eyes
    ctx.fillStyle = '#263238';
    ctx.fillRect(Math.round(x - r * 0.35), Math.round(y - r * 0.1), 3, 3);
    ctx.fillRect(Math.round(x + r * 0.15), Math.round(y - r * 0.1), 3, 3);
  }
}

// --- 7.5 WATER BIOME (Sazlık / Okyanus): Abyssal Crabs, Sirens, Angler Piranhas, Bioluminescent Jelly ---
function drawWaterPixelEnemy(ctx, en, x, y, r, role, time) {
  const isCaster = role === 'caster';
  const isHeavy = role === 'heavy';
  const isRusher = role === 'rusher';

  if (isHeavy) {
    // Coral Abyssal Crab (Heavy Tank / Walker)
    const cy = y + Math.sin(time * 0.2 + en.phase) * 1.4;
    // Hard Turquoise/Teal Carapace
    pixDisk(x, cy, r, '#4dd0e1', '#00838f', '#004d40');
    // Twin Periscope Stalk Eyes
    ctx.fillStyle = '#004d40';
    ctx.fillRect(Math.round(x - r * 0.45), Math.round(cy - r * 0.9), 3, 6);
    ctx.fillRect(Math.round(x + r * 0.25), Math.round(cy - r * 0.9), 3, 6);
    ctx.fillStyle = '#ffff00';
    ctx.fillRect(Math.round(x - r * 0.45), Math.round(cy - r * 0.95), 3, 3);
    ctx.fillRect(Math.round(x + r * 0.25), Math.round(cy - r * 0.95), 3, 3);
    // Giant Heavy Crusher Pincer Claw
    const clawX = x + r * 1.0;
    const clawY = cy - r * 0.2;
    ctx.fillStyle = '#ff7043';
    ctx.beginPath();
    ctx.arc(clawX, clawY, 6, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = '#d84315';
    ctx.fillRect(Math.round(clawX - 3), Math.round(clawY - 8), 3, 6);
    ctx.fillRect(Math.round(clawX + 1), Math.round(clawY - 8), 3, 6);
  } else if (isCaster) {
    // Abyssal Siren Priestess (Shooter / Shaman)
    const cy = y + Math.sin(time * 0.26 + en.phase) * 2.3;
    // Finned Deep-Sea Hood
    pixDisk(x, cy + 2, r * 0.92, '#80cbc4', '#00695c', '#00332c');
    // Side Fins
    ctx.fillStyle = '#26a69a';
    ctx.beginPath();
    ctx.moveTo(x - r * 0.7, cy);
    ctx.lineTo(x - r * 1.2, cy - r * 0.4);
    ctx.lineTo(x - r * 0.6, cy + r * 0.3);
    ctx.closePath();
    ctx.fill();
    ctx.beginPath();
    ctx.moveTo(x + r * 0.7, cy);
    ctx.lineTo(x + r * 1.2, cy - r * 0.4);
    ctx.lineTo(x + r * 0.6, cy + r * 0.3);
    ctx.closePath();
    ctx.fill();
    // Swirling Aqua Whirlpool Orb
    const orbY = cy - r * 1.2 + Math.sin(time * 0.35) * 3;
    ctx.fillStyle = '#00e5ff';
    ctx.shadowColor = '#00e5ff';
    ctx.shadowBlur = 0; /* 60fps */
    ctx.beginPath();
    ctx.arc(x, orbY, 4.5, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = '#ffffff';
    ctx.beginPath();
    ctx.arc(x - 1, orbY - 1, 2, 0, Math.PI * 2);
    ctx.fill();
    ctx.shadowBlur = 0;
    // Eyes
    ctx.fillStyle = '#00b4d8';
    ctx.fillRect(Math.round(x - r * 0.35), Math.round(cy - r * 0.1), 3, 2.5);
    ctx.fillRect(Math.round(x + r * 0.12), Math.round(cy - r * 0.1), 3, 2.5);
  } else if (isRusher) {
    // Abyssal Angler Piranha (Fast / Exploder)
    const swim = Math.sin(time * 0.45 + en.phase);
    const cy = y + swim * 2.2;
    // Piranha Body
    pixDisk(x, cy, r, '#4dd0e1', '#0097a7', '#004d40');
    // Dorsal Razor Fin
    ctx.fillStyle = '#ff7043';
    ctx.beginPath();
    ctx.moveTo(x - r * 0.3, cy - r * 0.5);
    ctx.lineTo(x, cy - r * 1.1);
    ctx.lineTo(x + r * 0.4, cy - r * 0.4);
    ctx.closePath();
    ctx.fill();
    // Dangling Angler Lure Bulb in Front
    const lureX = x - r * 1.05;
    const lureY = cy - r * 0.5;
    ctx.fillStyle = '#ffff00';
    ctx.shadowColor = '#ffff00';
    ctx.shadowBlur = 0; /* 60fps */
    ctx.beginPath();
    ctx.arc(lureX, lureY, 3, 0, Math.PI * 2);
    ctx.fill();
    ctx.shadowBlur = 0;
    // Sharp Needle Fangs
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(Math.round(x - r * 0.7), Math.round(cy + 2), 2, 3);
    ctx.fillRect(Math.round(x - r * 0.5), Math.round(cy + 2), 2, 3);
  } else {
    // Bioluminescent Jelly-Poly (Slime / Swarmer / Leech)
    const squash = Math.sin(time * 0.28 + en.phase);
    pixDisk(x, y, r, '#b2ebf2', '#00acc1', '#006064');
    // 4 Undulating Tentacles Trailing Beneath
    ctx.fillStyle = '#80deea';
    for (let t = 0; t < 4; t++) {
      const tx = x - r * 0.45 + t * (r * 0.3);
      const ty = y + r * 0.5 + Math.sin(time * 0.4 + t) * 3;
      ctx.fillRect(Math.round(tx), Math.round(ty), 2, 5);
    }
    // Bioluminescent Glowing Heart
    ctx.fillStyle = '#00e5ff';
    ctx.shadowColor = '#00e5ff';
    ctx.shadowBlur = 0; /* 60fps */
    ctx.beginPath();
    ctx.arc(x, y, 3, 0, Math.PI * 2);
    ctx.fill();
    ctx.shadowBlur = 0;
  }
}

// --- 7.6 FOREST BIOME (Sisli Orman): Barkskin Treants, Mushroom Druids, Thorn Stalkers, Moss Sproutlings ---
function drawForestPixelEnemy(ctx, en, x, y, r, role, time) {
  const isCaster = role === 'caster';
  const isHeavy = role === 'heavy';
  const isRusher = role === 'rusher';

  if (isHeavy) {
    // Ancient Barkskin Treant (Heavy Tank / Walker)
    const cy = y + Math.sin(time * 0.18 + en.phase) * 1.6;
    // Wood Trunk Body
    pixDisk(x, cy, r, '#6d4c41', '#4e342e', '#271711');
    // Lush Moss Mantle on Shoulders
    ctx.fillStyle = '#43a047';
    ctx.fillRect(Math.round(x - r * 1.15), Math.round(cy - r * 0.45), Math.round(r * 0.5), Math.round(r * 0.4));
