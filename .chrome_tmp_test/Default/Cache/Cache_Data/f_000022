function triggerReroll() {
  if (rerollsLeft <= 0 || !overlayBusy()) return;
  rerollsLeft--;
  playSfx('ui', 0.35);
  if (document.getElementById('modOverlay') && document.getElementById('modOverlay').classList.contains('show')) showModPick();
  else if (document.getElementById('sigOverlay') && document.getElementById('sigOverlay').classList.contains('show')) showSignaturePick();
  else if (document.getElementById('levelUpOverlay') && document.getElementById('levelUpOverlay').classList.contains('show')) {
    if (lastNodePickKind) showNodePick(lastNodePickKind);
