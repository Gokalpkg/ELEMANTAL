const STATUS_TR = { burn:'Yakma', slow:'Yavaş', stun:'Stun', shock:'Şok', lifesteal:'Can' };
function statusList(els) {
  const have = new Set();
  (els || []).forEach(k => {
    const e = ELEMENTS[k] && ELEMENTS[k].effect;
    if (e) have.add(e);
  });
  return STATUS_ORDER.filter(e => have.has(e));
}
function statusTag(effects) {
  return (effects || []).map(e => STATUS_TR[e]).filter(Boolean).join('+');
}
function applyAllEffects(en, effects, power) {
  if (!effects) return;
  const list = Array.isArray(effects) ? effects : [effects];
  list.forEach(e => applyEffect(en, e, power));
}

const SOFT_K = 1.85;
const CRIT_BASE = 10;
const CRIT_MUL = 2.0;
const CRIT_AMBUSH_MUL = 2.35;
const CRIT_CAP = 85;
const RESIST_FLOOR = 0.35;
const FUSION_WEIGHT_ROOT = 0.55;
const FUSION_WEIGHT_SEC = 0.45;
const FUSION_HYBRID_K = 0.28;
const EFFECT_EL = {
  burn:'fire', slow:'water', freeze:'water', stun:'earth',
  shock:'storm', root:'nature', lifesteal:'nature', poison:'nature',
  pull:'void', mark:'void'
};

function softMul(linear) {
  return 1 + Math.log(1 + Math.max(0, Number(linear) || 0) * SOFT_K);
}
function critChancePct() {
  const crBonus = (modValue('crit') || 0) * synMul('crit', 0.4);
  const comboB = killCombo >= 10 ? 15 : killCombo >= 5 ? 8 : 0;
  const treeCrit = treeLv('crit') * 3;
  return Math.min(CRIT_CAP, CRIT_BASE + crBonus + comboB + treeCrit);
}
function resolveFusionMul(hitEl) {
  const pair = lockedCombos && lockedCombos[0];
  if (!pair) return 1;
  const root = pair.a;
  const sec = pair.b || pair.a;
  if (!root) return 1;
  if (!sec || root === sec) return 1.12;
  const scaleRoot = elemMul(root) * fatigueMul(root);
  const scaleSec = elemMul(sec) * fatigueMul(sec);
  const harmony = 1 - Math.abs(scaleRoot - scaleSec) / Math.max(scaleRoot + scaleSec, 0.001);
  const hybrid = 1 + FUSION_HYBRID_K * harmony;
  if (hitEl === sec && hitEl !== root) return hybrid * 0.86;
  return hybrid;
}
function statusCcMul(en) {
  if (!en) return 1;
  if (en.type === 'boss') return 0.25;
  if (en.isElite || en.type === 'tank') return 0.6;
  return 1;
}

const statusStore = {
  has(en, id) {
    if (!en) return false;
    const now = performance.now();
    if (id === 'burn') return !!(en.burnUntil && now < en.burnUntil);
    if (id === 'wet') return !!(en.wetUntil && now < en.wetUntil);
    if (id === 'shock') return !!(en.shockUntil && now < en.shockUntil);
    if (id === 'root') return !!(en.rootUntil && now < en.rootUntil);
    if (id === 'poison') return !!(en.poisonUntil && now < en.poisonUntil);
    if (id === 'stun') return !!(en.stunUntil && now < en.stunUntil);
    if (id === 'shred') return (en.shred || 0) > 0.001;
    if (id === 'mark') return (en.markStored || 0) > 0.5;
    return false;
  },
  remove(en, id) {
    if (!en) return;
    if (id === 'burn') { en.burnUntil = 0; en.burnStack = 0; }
    if (id === 'wet') { en.wetUntil = 0; }
    if (id === 'shock') { en.shockUntil = 0; en.shockStack = 0; }
    if (id === 'root') { en.rootUntil = 0; }
    if (id === 'poison') { en.poisonUntil = 0; en.poisonStack = 0; }
    if (id === 'stun') { en.stunUntil = 0; }
    if (id === 'mark') { en.markStored = 0; }
  },
  addShred(en, amt) {
    const cap = 0.40;
    const add = en && en.type === 'boss' ? amt * 0.5 : amt;
    en.shred = Math.min(cap, (en.shred || 0) + add);
  },
  addMark(en, dealt) {
    const cap = (en.maxHp || 80) * 0.35;
    en.markStored = Math.min(cap, (en.markStored || 0) + Math.max(0, dealt) * 0.22);
  },
  clearAll() {
    if (!enemies) return;
    enemies.forEach(en => {
      en.burnStack = 0; en.poisonStack = 0; en.shockStack = 0;
      en.shred = 0; en.markStored = 0; en.hitDmgRef = 0;
    });
  }
};

function emitReactionBurst(en, label, color, r, dmg, effects, el) {
  if (!en || typeof en.x !== 'number') return;
  // STEP 6: Environmental Reaction Propagation
  if (el) triggerEnvReaction(en.x, en.y, el, dmg);
  // STEP 2: Elemental Fusion Shockwaves & Visual Synergies
  spawnFloatText(en.x, en.y - 28, ' ' + label + ' ', color, 'big');

  // Expanding Multi-Layer Plasma Shockwave Ring
  particles.push({
    x: en.x, y: en.y,
    r: 14, maxR: r * 1.45,
    life: 0.65, maxLife: 0.65,
    color: color,
    type: 'fusion_ring',
    lw: 7.0
  });

  // Secondary Radiant Impact Starburst
  particles.push({
    x: en.x, y: en.y,
    life: 0.85, maxLife: 0.85,
    type: 'starburst',
    r: Math.round(r * 0.75),
    rot: Math.random() * Math.PI * 2
  });

  // Radial Sparks & Elemental Shrapnel
  burst(en.x, en.y, color, 24, 4.5);
  burst(en.x, en.y, '#ffffff', 14, 3.2);

  // Micro-Freeze Hit Stop & Juicy Camera Impact (Boss only)
  if (en.type === 'boss') triggerHitStop(6);
  triggerScreenFlash(color, 0.34, 130);
  shake = Math.max(shake, 14);
  camKick = Math.max(camKick, 9);
  vibrate([35, 55, 35]);
  playSfx('explode', 0.44, 330);
  synthBlip('fusion_detonation');

  // Radial Physical Knockback & Area Damage
  const blastRadius = r * 1.35;
  for (let j = enemies.length - 1; j >= 0; j--) {
    const o = enemies[j];
    const dist = Math.hypot(o.x - en.x, o.y - en.y);
    if (dist <= blastRadius + o.r) {
      takeDamage(o, dmg, el, { noReact: true });
      if (effects) applyAllEffects(o, effects, 0.7);

      // Radial knockback sending mobs flying away from the explosion
      if (o.type !== 'boss' && dist > 1) {
        const kAng = Math.atan2(o.y - en.y, o.x - en.x);
        const kForce = 9.5 * (1 - dist / blastRadius);
        o.vx = Math.cos(kAng) * Math.max(Math.abs(o.vx || 0), kForce);
        o.vy = Math.sin(kAng) * Math.max(Math.abs(o.vy || 0), kForce);
        o.staggerTimer = 0.22;
      }
    }
  }
  pruneDeadEnemies();
}

const reactionResolver = {
  peek(en, incomingEl) {
    if (!en) return 1;
    if (statusStore.has(en, 'wet') && incomingEl === 'storm') return 1.60;
    if (statusStore.has(en, 'mark') && (incomingEl === 'fire' || incomingEl === 'storm')) return 1.45;
    if (statusStore.has(en, 'burn') && (incomingEl === 'void' || incomingEl === 'earth')) return 1.40;
    if (statusStore.has(en, 'wet') && incomingEl === 'earth') return 1.45;
    if (statusStore.has(en, 'root') && (incomingEl === 'fire' || incomingEl === 'storm')) return 1.35;
    if (statusStore.has(en, 'shock') && incomingEl !== 'storm') {
      return Math.pow(1.22, Math.max(1, en.shockStack || 1));
    }
    return 1;
  },
  resolve(en, incomingEl, hit) {
    if (!en) return;
    const now = performance.now();
    const dealt = (hit && hit.dealt) || en.hitDmgRef || 10;
    const burn = statusStore.has(en, 'burn');
    const wet = statusStore.has(en, 'wet');
    const shock = statusStore.has(en, 'shock');
    const rooted = statusStore.has(en, 'root');
    const marked = statusStore.has(en, 'mark');

    // STEP 7: Elemental reactions impact ground environmental chemistry
    if (typeof triggerEnvChemistry === 'function') {
      triggerEnvChemistry(en.x, en.y, incomingEl, 45, 1.25);
    }

    if (burn && wet && (!en.reactSteamAt || now - en.reactSteamAt > 1500)) {
      en.reactSteamAt = now;
      noteFx('steam');
      const burstDmg = Math.max(10, Math.round(0.90 * Math.max(dealt, (en.hitDmgRef || 8) * 0.22 * (en.burnStack || 1))));
      emitReactionBurst(en, 'BUHAR PATLAMASI', '#9ec9e6', 54, burstDmg, ['slow'], 'water');
      enemies.forEach(o => {
        const d = Math.hypot(o.x - en.x, o.y - en.y);
        if (d > 0 && d < 90 && o.type !== 'boss') {
          o.x += (o.x - en.x) / d * 18;
          o.y += (o.y - en.y) / d * 18;
        }
      });
      if (en.type !== 'boss') {
        en.stunUntil = Math.max(en.stunUntil || 0, now + 350);
      }
      statusStore.remove(en, 'burn');
      statusStore.remove(en, 'wet');
    }

    if (shock && wet && (!en.reactVoltAt || now - en.reactVoltAt > 1400)) {
      en.reactVoltAt = now;
      noteFx('volt');
      spawnFloatText(en.x, en.y - 22, 'ILETKEN ARK', '#f4d03f', 'big');
      particles.push({ x: en.x, y: en.y, r: 8, maxR: 70, life: 0.9, color: '#facc15', lw: 3 });
      chainLightning(en, Math.max(12, Math.round(dealt * 0.7)), 7, 180, '#f4d03f', 'shock');
      playSfx('skill', 0.32, 540);
    }

    if (rooted && burn && (!en.reactGrassAt || now - en.reactGrassAt > 1400)) {
      en.reactGrassAt = now;
      noteFx('grass');
      spawnElemStain(en.x, en.y, 85, 'fire', 180);
      emitReactionBurst(en, 'YANICI OZSU', '#ff8a4a', 75, 12, ['burn'], 'fire');
    }

    if (en.type !== 'boss' && burn && shock && (!en.reactPlasmaAt || now - en.reactPlasmaAt > 1400)) {
      en.reactPlasmaAt = now;
      emitReactionBurst(en, 'PLAZMA İNFİLAKI', '#f59e0b', 85, Math.max(16, Math.round(dealt * 1.1)), ['shock'], 'storm');
      chainLightning(en, Math.max(14, Math.round(dealt * 0.75)), 5, 200, '#f59e0b', 'shock');
    }

    // Magma Fissure: Burn + Earth
    if (burn && incomingEl === 'earth' && (!en.reactMagmaAt || now - en.reactMagmaAt > 1400)) {
      en.reactMagmaAt = now;
      noteFx('steam');
      emitReactionBurst(en, 'MAGMA DEPREMİ', '#ef4444', 80, Math.max(18, Math.round(dealt * 1.25)), ['burn', 'stun'], 'fire');
      spawnElemStain(en.x, en.y, 75, 'fire', 220);
    }

    // Shatter Frost: Wet/Slow + Earth
    if ((wet || (en.slowFactor && en.slowFactor < 0.7)) && incomingEl === 'earth' && (!en.reactShatterAt || now - en.reactShatterAt > 1500)) {
      en.reactShatterAt = now;
      emitReactionBurst(en, 'KRİSTAL KIRILMA', '#38bdf8', 75, Math.max(20, Math.round(dealt * 1.4)), ['slow'], 'water');
      // Flying ice shrapnel
      for (let s = 0; s < 8; s++) {
        const sAng = s * (Math.PI * 2 / 8) + (Math.random() - 0.5) * 0.3;
        sparks.push({
          x: en.x, y: en.y,
          vx: Math.cos(sAng) * (4 + Math.random() * 3),
          vy: Math.sin(sAng) * (4 + Math.random() * 3),
          r: 2.2, life: 0.35, maxLife: 0.35, color: '#e0f2fe', rot: 0, vr: 0
        });
      }
    }

    if (wet && incomingEl === 'earth') {
      statusStore.addShred(en, 0.10);
      en.slowFactor = Math.min(en.slowFactor || 1, en.type === 'boss' ? 0.80 : 0.55);
    }
    if (wet && incomingEl === 'nature') {
      en.slowFactor = Math.min(en.slowFactor || 1, 0.50);
      if (en.rootUntil) en.rootUntil += 400;
    }
    if (rooted && incomingEl === 'earth' && en.type !== 'boss' && (!en.reactThornAt || now - en.reactThornAt > 1600)) {
      en.reactThornAt = now;
      en.stunUntil = Math.max(en.stunUntil || 0, now + 200);
      spawnFloatText(en.x, en.y - 16, 'DIKEN KILIT', '#81c784');
    }
    if (marked && incomingEl === 'void') {
      const pop = Math.max(1, Math.round((en.markStored || 0) * 1.25));
      statusStore.remove(en, 'mark');
      takeDamage(en, pop, 'void', { noReact: true });
      spawnFloatText(en.x, en.y - 20, 'DAMGA ' + pop, '#a855f7', 'big');
      burst(en.x, en.y, '#a855f7', 16, 3.5);
    } else if (marked && incomingEl === 'storm' && (!en.reactRiftAt || now - en.reactRiftAt > 1600)) {
      en.reactRiftAt = now;
      const half = Math.max(1, Math.round((en.markStored || 0) * 0.50));
      en.markStored = Math.max(0, (en.markStored || 0) - half);
      takeDamage(en, half, 'void', { noReact: true });
      spawnFloatText(en.x, en.y - 18, 'YARIK ' + half, '#c084fc');
    }

    // Singularity Collapse: Burn + Void (or Marked + Fire)
    if (((burn && incomingEl === 'void') || (marked && incomingEl === 'fire')) && (!en.reactSingularityAt || now - en.reactSingularityAt > 1400)) {
      en.reactSingularityAt = now;
      emitReactionBurst(en, 'SÜPERNOVA ÇÖKÜŞÜ', '#c084fc', 95, Math.max(22, Math.round(dealt * 1.55)), ['burn'], 'void');
      enemies.forEach(o => {
        const d = Math.hypot(o.x - en.x, o.y - en.y);
        if (d > 0 && d < 140 && o.type !== 'boss') {
          o.vx = (en.x - o.x) / d * 10;
          o.vy = (en.y - o.y) / d * 10;
          o.staggerTimer = 0.25;
        }
      });
      spawnElemStain(en.x, en.y, 80, 'void', 240);
    }

    // Verdant Bloom: Wet + Nature (or Rooted + Water)
    if (((wet && incomingEl === 'nature') || (rooted && incomingEl === 'water')) && (!en.reactBloomAt || now - en.reactBloomAt > 1400)) {
      en.reactBloomAt = now;
      emitReactionBurst(en, 'CANLI FİLİZLENME', '#22c55e', 80, Math.max(16, Math.round(dealt * 1.25)), ['slow', 'root'], 'nature');
      player.hp = Math.min(player.maxHp, player.hp + 6);
      spawnFloatText(player.x, player.y - 20, '+6 CAN', '#4ade80');
      for (let s = 0; s < 5; s++) {
        const ang = Math.random() * Math.PI * 2;
        sparks.push({
          x: en.x, y: en.y,
          vx: Math.cos(ang) * 4.5, vy: Math.sin(ang) * 4.5,
          r: 3, life: 0.45, maxLife: 0.45, color: '#86efac', rot: 0, vr: 0
        });
      }
    }

    // Magnetic Overload: Shock + Earth
    if (shock && incomingEl === 'earth' && (!en.reactMagnetAt || now - en.reactMagnetAt > 1400)) {
      en.reactMagnetAt = now;
      emitReactionBurst(en, 'MANYETİK ŞOK', '#eab308', 85, Math.max(20, Math.round(dealt * 1.35)), ['stun'], 'storm');
      statusStore.addShred(en, 0.25);
      enemies.forEach(o => {
        const d = Math.hypot(o.x - en.x, o.y - en.y);
        if (d > 0 && d < 120 && o.type !== 'boss') {
          o.vx = (en.x - o.x) / d * 9;
          o.vy = (en.y - o.y) / d * 9;
          o.stunUntil = Math.max(o.stunUntil || 0, now + 400);
        }
      });
    }

    // Galvanic Thorns: Rooted + Storm
    if (rooted && incomingEl === 'storm' && (!en.reactGalvanicAt || now - en.reactGalvanicAt > 1400)) {
      en.reactGalvanicAt = now;
      emitReactionBurst(en, 'GALVANİK DİKEN', '#a3e635', 80, Math.max(18, Math.round(dealt * 1.25)), ['shock'], 'storm');
      chainLightning(en, Math.max(14, Math.round(dealt * 0.8)), 6, 190, '#a3e635', 'shock');
    }

    // Abyssal Maelstrom: Wet + Void
    if (wet && incomingEl === 'void' && (!en.reactAbyssAt || now - en.reactAbyssAt > 1500)) {
      en.reactAbyssAt = now;
      emitReactionBurst(en, 'HİÇLİK GİRDABI', '#06b6d4', 90, Math.max(20, Math.round(dealt * 1.3)), ['slow'], 'void');
      en.slowFactor = Math.min(en.slowFactor || 1, 0.35);
      if (en.type !== 'boss' && en.hp / en.maxHp < 0.25) {
        takeDamage(en, en.hp + 10, 'void', { noReact: true });
        spawnFloatText(en.x, en.y - 24, ' İNFAZ!', '#a855f7', 'big');
      }
    }

    // Gravitational Crush: Marked + Earth
    if (marked && incomingEl === 'earth' && (!en.reactCrushAt || now - en.reactCrushAt > 1500)) {
      en.reactCrushAt = now;
      emitReactionBurst(en, 'YERÇEKİMİ EZMESİ', '#8b5cf6', 85, Math.max(22, Math.round(dealt * 1.45)), ['stun'], 'earth');
      en.stunUntil = Math.max(en.stunUntil || 0, now + 650);
      statusStore.addShred(en, 0.30);
    }

    // Toxic Vortex: Root/Poison + Wind/Nature (Zehirli Girdap)
    if ((rooted || (typeof statusStore !== 'undefined' && statusStore && statusStore.has(en, 'poison'))) && (incomingEl === 'wind' || incomingEl === 'nature') && (!en.reactToxinAt || now - en.reactToxinAt > 1400)) {
      en.reactToxinAt = now;
      emitReactionBurst(en, 'ZEHİRLİ GİRDAP', '#10b981', 95, Math.max(18, Math.round(dealt * 1.35)), ['slow'], 'nature');
      enemies.forEach(o => {
        const d = Math.hypot(o.x - en.x, o.y - en.y);
        if (d > 0 && d < 120 && o.type !== 'boss') {
          o.vx = (en.x - o.x) / d * 10;
          o.vy = (en.y - o.y) / d * 10;
          o.staggerTimer = 0.22;
        }
      });
      if (typeof puff === 'function') puff(en.x, en.y, '#10b981', 10);
      playSfx('skill', 0.35, 620);
    }

    // Soul Drain / Essence Syphon: Root/Poison + Void (or Marked + Nature)
    if ((((rooted || (typeof statusStore !== 'undefined' && statusStore && statusStore.has(en, 'poison'))) && incomingEl === 'void') || (marked && incomingEl === 'nature')) && (!en.reactSoulAt || now - en.reactSoulAt > 1400)) {
      en.reactSoulAt = now;
      emitReactionBurst(en, 'RUH EMİŞİ', '#a855f7', 85, Math.max(18, Math.round(dealt * 1.35)), ['slow'], 'void');
      player.hp = Math.min(player.maxHp, player.hp + 4.0);
      shieldOn = Math.max(shieldOn, 70);
      updateHud();
      spawnFloatText(player.x, player.y - 22, '+4 CAN', '#c084fc');
      puff(en.x, en.y, '#9333ea', 8);
      playSfx('skill', 0.35, 480);
    }
  }
};

function tryReactions(en, incomingEl, hit) {
  reactionResolver.resolve(en, incomingEl || lastElemUsed, hit || {});
}

