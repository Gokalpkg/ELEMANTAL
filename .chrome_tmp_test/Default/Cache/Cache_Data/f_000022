    spawnGroundOrb(en.x, en.y);
  }
  if (en.type === 'boss' && waveQuest && waveQuest.kind === 'bossFast' && (performance.now() - waveQuest.t0) <= waveQuest.need) grantQuest(waveQuest);
  if (waveQuest && !waveQuest.done && (waveQuest.kind === 'kills' || waveQuest.kind === 'elKill')) {
    if (waveQuest.kind === 'kills' || (waveQuest.kind === 'elKill' && autoRoots().indexOf(waveQuest.el) >= 0)) {
      waveQuest.n = (waveQuest.n || 0) + 1;
      updateQuestHud();
      if (waveQuest.n >= waveQuest.need) grantQuest(waveQuest);
    }
  }
  if (runQuest && !runQuest.done) {
    let match = false;
    if (runQuest.kind === 'elementKills') {
      if (!runQuest.el || runQuest.el === 'any' || autoRoots().indexOf(runQuest.el) >= 0 || (runLock && runLock.root === runQuest.el)) {
        match = true;
      }
    } else if (runQuest.kind === 'waterKills' && autoRoots().indexOf('water') >= 0) {
      match = true;
    }
    if (match) {
      runQuest.n = (runQuest.n || 0) + 1;
      updateQuestHud();
      if (runQuest.n >= runQuest.need) grantQuest(runQuest);
    }
  }
  if (en.type === 'boss') {
    gainCrystals(3 + Math.floor(wave / 4), en.x, en.y - 18);
