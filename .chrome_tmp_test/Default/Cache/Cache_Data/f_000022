function renderCodexCards(filterEl) {
  if (filterEl) window._curCodexFilter = filterEl;
  const f = window._curCodexFilter || 'all';
  const container = document.getElementById('codexCardsList');
  if (!container) return;

  const m = loadMeta();
  const seen = m.seenCombos || [];
  const claimed = m.claimedComboRewards || [];

  const list = ALL_CODEX_SUPER_EVOLUTIONS;
  const filtered = f === 'all'
    ? list
    : list.filter(item => item.a === f || item.b === f);

  // Update Progress Stats
  let discoveredCount = 0;
  let totalClaimed = 0;
  list.forEach(item => {
    const k1 = item.a + '_' + item.b;
    const k2 = item.b + '_' + item.a;
    if (seen.includes(k1) || seen.includes(k2)) discoveredCount++;
    if (claimed.includes(k1) || claimed.includes(k2)) totalClaimed += 10;
  });

  const progPct = Math.round((discoveredCount / list.length) * 100);
  const progFill = document.getElementById('codexProgressFill');
  const progTxt = document.getElementById('codexProgressText');
  const rewTxt = document.getElementById('codexRewardStat');

  if (progFill) progFill.style.width = progPct + '%';
  if (progTxt) progTxt.textContent = `${discoveredCount} / ${list.length} Keşfedildi (%${progPct})`;
  if (rewTxt) rewTxt.innerHTML = `${renderPixelIcon('gem', 'px-anim-shimmer', 13)} <b>${totalClaimed}</b> / ${list.length * 10} Kristal Alındı`;

  // Render cards
  container.innerHTML = filtered.map(item => {
    const k1 = item.a + '_' + item.b;
    const k2 = item.b + '_' + item.a;
    const isSeen = seen.includes(k1) || seen.includes(k2);
    const comboKey = isSeen ? (seen.includes(k1) ? k1 : k2) : k1;
    const isClaimed = claimed.includes(k1) || claimed.includes(k2);

    const ea = ELEMENTS[item.a] || { name: item.a, color: '#f87171' };
    const eb = ELEMENTS[item.b] || { name: item.b, color: '#38bdf8' };

    if (!isSeen) {
      // Locked Mystery Card
      return `
        <div class="codex-card locked">
          <div class="fusion-header">
            <div class="fusion-components">
              <span class="elem-pill ${item.a}" style="border:1px solid ${ea.color}60; color:${ea.color};">${renderPixelIcon(item.a, '', 12)} ${ea.name.toUpperCase()}</span>
              <span class="fusion-plus">+</span>
              <span class="elem-pill ${item.b}" style="border:1px solid ${eb.color}60; color:${eb.color};">${renderPixelIcon(item.b, '', 12)} ${eb.name.toUpperCase()}</span>
            </div>
            <div class="fusion-result-badge locked"><span class="px-icon px-shield"></span> GİZLİ SÜPER EVRİM</div>
          </div>
          <div class="fusion-desc locked-text">
            Bu kadim füzyon henüz savaşta açığa çıkarılmadı. Savaşta bu iki elementi birleştirerek bu Süper Evrimi mühürle ve <b>+10 Kristal</b> kazan!
          </div>
        </div>
      `;
    }

    const claimBtnHtml = isClaimed
      ? `<span class="codex-claimed-tag"><span class="px-icon px-star"></span> ALINDI (+10 ${renderPixelIcon('gem', '', 12)})</span>`
      : `<button type="button" class="codex-claim-btn pulse" onclick="claimCodexReward('${comboKey}')"><span class="px-icon px-gem px-anim-shimmer"></span> +10 KRİSTAL AL</button>`;

    return `
      <div class="codex-card discovered ${item.a}-${item.b}">
        <div class="fusion-header">
          <div class="fusion-components">
            <span class="elem-pill ${item.a}" style="border:1px solid ${ea.color}; color:${ea.color}; background:${ea.color}15;">${renderPixelIcon(item.a, '', 12)} ${ea.name.toUpperCase()}</span>
            <span class="fusion-plus">+</span>
            <span class="elem-pill ${item.b}" style="border:1px solid ${eb.color}; color:${eb.color}; background:${eb.color}15;">${renderPixelIcon(item.b, '', 12)} ${eb.name.toUpperCase()}</span>
