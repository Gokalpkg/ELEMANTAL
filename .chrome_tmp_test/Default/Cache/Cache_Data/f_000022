const _diskCanvasCache = new Map();
const MAX_DISK_CANVAS_CACHE = 160;
function getCachedDiskCanvas(r, hi, mid, lo) {
  const key = Math.round(r) + '_' + hi + '_' + mid + '_' + lo;
  let cv = _diskCanvasCache.get(key);
  if (cv) {
    _diskCanvasCache.delete(key);
    _diskCanvasCache.set(key, cv);
    return cv;
  }
  if (_diskCanvasCache.size >= MAX_DISK_CANVAS_CACHE) {
    const oldestKey = _diskCanvasCache.keys().next().value;
    const oldCv = _diskCanvasCache.get(oldestKey);
    if (oldCv) { oldCv.width = 0; oldCv.height = 0; }
    _diskCanvasCache.delete(oldestKey);
  }
  const P = 2;
  const ir = Math.max(2, Math.round(r / P));
  const diam = (ir * 2 + 1) * P;
  cv = document.createElement('canvas');
  cv.width = diam;
  cv.height = diam;
  const c = cv.getContext('2d');
  const ox = ir * P;
  const oy = ir * P;
  for (let j = -ir; j <= ir; j++) {
    for (let i = -ir; i <= ir; i++) {
      const d = i * i + j * j;
      if (d > ir * ir) continue;
      let col = mid;
      if (d < ir * ir * 0.08 && i <= 0 && j <= 0) col = '#ffffff';
      else if (d < ir * ir * 0.24 && i <= 0 && j <= 0) col = hi;
      else if (d > ir * ir * 0.62 || (i + j) > ir * 0.5) col = lo;
      else if (((i ^ j) & 1) && d > ir * ir * 0.35) col = lo;
      c.fillStyle = col;
      c.fillRect(ox + i * P, oy + j * P, P, P);
    }
  }
  _diskCanvasCache.set(key, cv);
  return cv;
}

function pixDisk(x, y, r, hi, mid, lo) {
  const cv = getCachedDiskCanvas(r, hi, mid, lo);
  const P = 2;
  const ir = Math.max(2, Math.round(r / P));
  ctx.drawImage(cv, Math.round(x - ir * P), Math.round(y - ir * P));
}
function drawBall3d(x, y, r, color, lift) {
  const up = lift || Math.max(3, r * 0.38);
  const cy = y - up;
  drawGroundShadow(x + 2, y + r * 0.55, r * 0.95, r * 0.28);
  pixDisk(x, cy, r, shadeHex(color, 70), color, shadeHex(color, -70));
  return cy;
}
function drawOval3d(x, y, r, color, lift) {
  const up = lift || Math.max(3, r * 0.36);
  const cy = y - up;
  drawGroundShadow(x + 2, y + r * 0.5, r * 1.1, r * 0.26);
  pixDisk(x, cy, r, shadeHex(color, 62), color, shadeHex(color, -72));
  ctx.fillStyle = shadeHex(color, -80);
  ctx.fillRect(Math.round(x - r * 1.05), Math.round(cy + r * 0.15), Math.round(r * 2.1), 4);
  return cy;
}
