// ─── STEP 7: DİNAMİK ZEMİN ÇEVRESEL KİMYA REAKSİYONLARI (Environmental Chemistry) ───
// Su göletini elektrikle tuzağa çevirme, zehir gazını alevle patlatma, lavı buzla obsidyene çevirme
function triggerEnvChemistry(srcX, srcY, el, radius, power) {
  if (!envDebris || !envDebris.length) return false;
  radius = radius || 30;
  power = power || 1.0;
  let triggered = false;

  for (let i = 0; i < envDebris.length; i++) {
    const d = envDebris[i];
    if (!d || d.life <= 0) continue;
    const maxDist = radius + (d.r || 16);
    const dx = d.x - srcX;
    if (dx > maxDist || dx < -maxDist) continue;
    const dy = d.y - srcY;
    if (dy > maxDist || dy < -maxDist) continue;
    if (dx * dx + dy * dy > maxDist * maxDist) continue;

    // 1. SU BİRİKİNTİSİ + ŞİMŞEK / ELEKTRİK -> İLETKEN ŞOK GÖLETİ
    if (d.kind === 'water_puddle' && (el === 'storm' || el === 'volt' || el === 'plasma')) {
      d.kind = 'electrified_pool';
      d.el = 'storm';
      d.r = Math.min(38, (d.r || 16) * 1.4);
      d.life = Math.max(d.life, 260);
      d.maxLife = Math.max(d.maxLife, 260);
      d.dmg = Math.round((9 + wave * 0.8) * power);
      d.hasGameplay = true;
      triggered = true;
      burst(d.x, d.y, '#38bdf8', 12, 2.5);
      burst(d.x, d.y, '#facc15', 6, 1.8);
      synthBlip('spark');
      spawnFloatText(d.x, d.y - 16, ' İLETKEN ŞOK!', '#38bdf8', 'crit');
      shake = Math.max(shake, 3.5);

      // ZİNCİRLEME İLETİM: Bitişik su birikintilerini de elektriklendir
      for (let j = 0; j < envDebris.length; j++) {
        const d2 = envDebris[j];
        if (d2 !== d && d2.kind === 'water_puddle' && Math.hypot(d.x - d2.x, d.y - d2.y) < d.r + (d2.r || 16) + 24) {
          d2.kind = 'electrified_pool';
          d2.el = 'storm';
          d2.r = Math.min(38, (d2.r || 16) * 1.3);
          d2.life = 240;
          d2.dmg = d.dmg;
          d2.hasGameplay = true;
          burst(d2.x, d2.y, '#38bdf8', 8, 2.0);
        }
      }
    }

    // 2. POLEN BULUTU / ZEHİR GAZI + ATEŞ -> GAZ İNFİLAKI (DEFLAGRATION)
    else if ((d.kind === 'spore_cloud' || d.kind === 'ground_thorns') && (el === 'fire' || el === 'magma' || el === 'lava')) {
      d.kind = 'gas_explosion';
      d.life = 20;
      d.maxLife = 20;
      const blastR = 85;
      d.r = blastR;
      d.hasGameplay = false;
      triggered = true;
      burst(d.x, d.y, '#ff4500', 18, 3.5);
      burst(d.x, d.y, '#fbbf24', 12, 2.8);
      puff(d.x, d.y, '#78350f', 6);
      synthBlip('nova');
      playSfx('explode', 0.45, 240);
      spawnFloatText(d.x, d.y - 20, ' GAZ İNFİLAKI!', '#ff5722', 'big');
      shake = Math.max(shake, 7.5);
      vibrate([30, 40, 30]);

      // Alan içindeki tüm canavarlara patlama hasarı & savurma
      const blastDmg = Math.round((22 + wave * 1.6) * power);
      for (let j = 0; j < enemies.length; j++) {
        const en = enemies[j];
        if (!en || en.hp <= 0) continue;
        const eDist = Math.hypot(en.x - d.x, en.y - d.y);
        if (eDist < blastR + en.r) {
          takeDamage(en, blastDmg, 'fire');
          applyEffect(en, 'burn', 2.8);
          punchEnemy(en, d.x, d.y, 22, true);
        }
      }

      // ZİNCİRLEME GAZ PATLAMASI: Yakındaki diğer gaz bulutlarını da infilak ettir
      for (let j = 0; j < envDebris.length; j++) {
        const d2 = envDebris[j];
        if (d2 !== d && (d2.kind === 'spore_cloud' || d2.kind === 'ground_thorns') && Math.hypot(d.x - d2.x, d.y - d2.y) < blastR + 25) {
          d2.kind = 'gas_explosion';
          d2.life = 18;
          d2.r = 75;
          d2.hasGameplay = false;
          burst(d2.x, d2.y, '#ff4500', 14, 3.0);
          synthBlip('nova');
        }
      }
    }

    // 3. LAV GÖLETİ + SU / BUZ -> KATILAŞMA & KIRILGAN OBSİDYEN ZEMİN
    else if (d.kind === 'lava_pool' && (el === 'water' || el === 'ice')) {
      d.kind = 'obsidian_crust';
      d.el = 'earth';
      d.r = Math.max(d.r || 16, 22);
      d.life = 340;
      d.maxLife = 340;
      d.hasGameplay = true;
      triggered = true;
      burst(d.x, d.y, '#c084fc', 14, 2.5);
      puff(d.x, d.y, '#e2e8f0', 8);
      synthBlip('steam');
      spawnFloatText(d.x, d.y - 18, ' OBSİDYEN KABUK!', '#c084fc', 'big');
      shake = Math.max(shake, 4.0);

      // Üzerindeki tüm düşmanları anında taşlaştır & dondur
      const nowD = performance.now();
      for (let j = 0; j < enemies.length; j++) {
        const en = enemies[j];
        if (!en || en.hp <= 0) continue;
        if (Math.hypot(en.x - d.x, en.y - d.y) < d.r + en.r + 10) {
          en.stunUntil = Math.max(en.stunUntil || 0, nowD + 1800);
          en._onObsidian = true;
          spawnFloatText(en.x, en.y - 28, ' TAŞLAŞTI!', '#c084fc');
        }
      }
    }

    // 4. BUZ TABAKASI + ATEŞ -> KAYNAR BUHAR PERDESİ
    else if (d.kind === 'frost_sheet' && (el === 'fire' || el === 'magma' || el === 'lava')) {
      d.kind = 'steam_cloud';
      d.el = 'water';
      d.r = Math.max((d.r || 16) * 1.5, 30);
      d.life = 240;
      d.maxLife = 240;
      d.dmg = Math.round((7 + wave * 0.5) * power);
      d.hasGameplay = true;
      triggered = true;
      puff(d.x, d.y, '#f1f5f9', 10);
      burst(d.x, d.y, '#38bdf8', 6, 1.8);
      synthBlip('steam');
      spawnFloatText(d.x, d.y - 16, ' KAYNAR BUHAR!', '#bae6fd');
    }
  }

  return triggered;
}

// ─── Piksel-Art Zemin Efektleri Çizimi ───
function drawEnvDebris() {
  if (!envDebris || !envDebris.length) return;
  const now = performance.now();
  for (let i = 0; i < envDebris.length; i++) {
    const d = envDebris[i];
    // Ekran dışı optimizasyonu (Frustum Culling) - kasmaları ve takılmaları önler
    const sx = toSX(d.x), sy = toSY(d.y);
    if (sx < -40 || sx > W + 40 || sy < -40 || sy > H + 40) continue;

    const alpha = Math.max(0, Math.min(1, d.life / (d.maxLife || 200)));
    ctx.save();
    ctx.translate(Math.round(d.x), Math.round(d.y));

    if (d.kind === 'lava_pool') {
      // Parlayan Lav Göleti (Piksel bloklu lav kırıntıları ve magma çatlakları)
      const pulse = 1 + Math.sin(time * 0.18 + d.seed) * 0.12;
      ctx.globalAlpha = alpha * 0.85;
      // Dış yanık kabuk (piksel bloklar)
      ctx.fillStyle = '#2b0907';
      ctx.fillRect(-12 * pulse, -7 * pulse, 24 * pulse, 14 * pulse);
      ctx.fillRect(-8 * pulse, -10 * pulse, 16 * pulse, 20 * pulse);
      // Kızgın lav çekirdeği
      ctx.fillStyle = '#ff4d00';
      ctx.fillRect(-9 * pulse, -5 * pulse, 18 * pulse, 10 * pulse);
      ctx.fillRect(-6 * pulse, -7 * pulse, 12 * pulse, 14 * pulse);
      // Sıcak akkor merkez
      ctx.fillStyle = '#ffe600';
      ctx.fillRect(-4 * pulse, -2 * pulse, 8 * pulse, 5 * pulse);
      // Ufak parlayan lav kıvılcımı pikselleri
      ctx.fillStyle = '#fff4cc';
      ctx.fillRect(Math.sin(time * 0.2 + d.seed) * 6, -6, 2, 2);
      ctx.fillRect(-Math.cos(time * 0.25 + d.seed) * 7, 5, 2, 2);
      // Kükreyen Alev Geyseri & Ateş Sütunu (Image 2: Flame Pillars)
      drawPixelFlameGeyser(0, 0, (d.r || 14) / 14, d.seed, alpha);

    } else if (d.kind === 'lava_ember') {
      // Sadece 1-2 sn arka planda tüten ufak lav kırıntısı
      ctx.globalAlpha = alpha * 0.70;
      ctx.fillStyle = '#ff6b35';
      ctx.fillRect(-3, -3, 6, 6);
      ctx.fillStyle = '#ffdd55';
      ctx.fillRect(-1, -1, 3, 3);
      ctx.fillStyle = '#4a0e08';
      ctx.fillRect(-4, -1, 1, 3); ctx.fillRect(3, -2, 1, 3);

    } else if (d.kind === 'water_puddle') {
      // Su Birikintisi (Dalgalanan mavi piksel havuzcuk + köpük kenarlar)
      const wavePhase = Math.sin(time * 0.14 + d.seed) * 1.5;
      ctx.globalAlpha = alpha * 0.65;
      // Koyu ıslak zemin izi
      ctx.fillStyle = 'rgba(10, 35, 65, 0.55)';
      ctx.fillRect(-14, -8, 28, 16);
      ctx.fillRect(-10, -11, 20, 22);
      // Berrak su katmanı
      ctx.fillStyle = '#38bdf8';
      ctx.fillRect(-11 + wavePhase * 0.3, -6, 22, 12);
