    }
    ctx.font = 'bold 11px monospace';
    ctx.fillStyle = '#ffd700';
    ctx.textAlign = 'center';
    ctx.fillText('✨ ARINMA MİHRABI', shX, shY - _respecShrine.r - 8);
    ctx.font = '9px monospace';
    ctx.fillStyle = '#e2e8f0';
    ctx.fillText('(Yetenekleri Sıfırla)', shX, shY - _respecShrine.r + 3);
    ctx.restore();
  }

  // Clean, luminous Invulnerability Shield Rim (Hero never disappears or gets blacked out)
  if (player.invuln > 0) {
    ctx.save();
    ctx.strokeStyle = (Math.floor(time * 12) % 2 === 0) ? '#38bdf8' : '#ffffff';
    ctx.lineWidth = 2.8;
    ctx.beginPath();
    ctx.arc(px, pcy, (player.r || 18) + 4, 0, Math.PI * 2);
    ctx.stroke();
