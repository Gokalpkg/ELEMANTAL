function checkElementalFusion(enemy, elementHit, dmg) {
  if (!enemy) return;
  const now = performance.now();

  // 1. FIRE + ICE = STEAM BLAST (Buhar Patlaması)
  if ((elementHit === 'fire' && enemy.frozen) || (elementHit === 'ice' && enemy.burning)) {
    enemy.frozen = false;
    enemy.burning = false;
    synthBlip('elem_water');
    if (typeof sparks !== 'undefined') {
      for (let s = 0; s < 16; s++) {
        const ang = Math.random() * Math.PI * 2;
        sparks.push({
          x: enemy.x, y: enemy.y,
          vx: Math.cos(ang) * (2 + Math.random() * 4),
          vy: Math.sin(ang) * (2 + Math.random() * 4),
          r: 4, life: 0.5, maxLife: 0.5,
          color: 'rgba(226, 232, 240, 0.75)'
        });
      }
    }
    // AoE Thermal Steam damage to nearby enemies
    if (enemies) {
      enemies.forEach(other => {
        if (other !== enemy && Math.hypot(other.x - enemy.x, other.y - enemy.y) < 140) {
          other.hp -= dmg * 0.8;
          other.slowUntil = now + 1200;
        }
      });
    }
    spawnFloatText(enemy.x, enemy.y - 12, ' BUHAR!', '#e2e8f0', true);
  }

  // 2. LIGHTNING + WATER = CONDUCTIVE SHOCK (İletken Fırtına)
  if (elementHit === 'storm' && (enemy.wet || currentBiome.key === 'water')) {
    synthBlip('elem_storm');
    let chainCount = 0;
    if (enemies) {
      enemies.forEach(other => {
        if (other !== enemy && chainCount < 5 && Math.hypot(other.x - enemy.x, other.y - enemy.y) < 180) {
          chainCount++;
          other.hp -= dmg * 1.0;
          other.shockedUntil = now + 800;
        }
      });
    }
    spawnFloatText(enemy.x, enemy.y - 16, ' İLETKEN ŞOK!', '#00e5ff', true);
  }

  // 3. NATURE + FIRE = WILDFIRE (Kavurucu Yangın)
  if (elementHit === 'fire' && enemy.poisoned) {
    synthBlip('elem_fire');
    if (enemies) {
      enemies.forEach(other => {
        if (other !== enemy && Math.hypot(other.x - enemy.x, other.y - enemy.y) < 120) {
          other.burning = true;
          other.burnTimer = 4;
        }
      });
    }
    spawnFloatText(enemy.x, enemy.y - 14, ' YANGIN!', '#ff5722', true);
  }
}

function applyEffect(enemy, effect, power = 1.0) {
  if (!effect || !enemy) return;
  power = (power === undefined || power === null) ? 1.0 : power;
  const isBoss = enemy.type === 'boss';
  const now = performance.now();
  const dur = skillDurMul();
  const ccDurationMul = statusCcMul(enemy);
  const slowT = (isBoss ? 400 : 900) * power * dur * biomeBonus('water').slow * ccDurationMul;
  const stunT = Math.min(isBoss ? 450 : 2400, (isBoss ? 80 : 240) * power * dur * biomeBonus('earth').stun * ccDurationMul);

  if (effect === 'burn') {
    const lava = typeof activeFusionClass === 'function' && activeFusionClass() === 'lava';
    const cap = lava ? (isBoss ? 5 : 8) : (isBoss ? 3 : 5);
    enemy.burnStack = Math.min(cap, (enemy.burnStack || 0) + 1);
    enemy.burnUntil = now + (isBoss ? 2000 : 3000) * power * dur;
    enemy.burnTick = enemy.burnTick || 0;
    noteFx('burn');
    plantMark(enemy.x, enemy.y, 'burn', 2000 * power * dur);
    addSteam(1);
    if (lava && enemy.burnStack >= 8) {
      const pop = Math.max(10, Math.round((enemy.hitDmgRef || 8) * 0.9));
      emitReactionBurst(enemy, 'KUL PATLAMA', '#ff8a65', 48, pop, ['burn'], 'fire');
      enemy.burnStack = 3;
    }
  }
  else if (effect === 'slow') {
    enemy.slowUntil = now + slowT;
    const mud = runFlags().mudSlow;
    enemy.slowFactor = isBoss ? 0.85 : (mud || 0.70);
    enemy.wetUntil = now + slowT;
    enemy.wetStack = (enemy.wetStack || 0) + 1;
    plantMark(enemy.x, enemy.y, 'slow', slowT);
    addSteam(2);
    const freezeNeed = runFlags().freezeAt || 3;
    if (typeof activeFusionClass === 'function' && activeFusionClass() === 'ocean' && enemy.wetStack >= freezeNeed && enemy.type !== 'boss') {
      enemy.stunUntil = Math.max(enemy.stunUntil || 0, now + (enemy.isElite ? 450 : 1100));
      enemy.slowFactor = 0.55;
      enemy.wetStack = 0;
      spawnFloatText(enemy.x, enemy.y - 18, 'DON', '#90caf9');
    }
  }
  else if (effect === 'stun') {
    enemy.stunUntil = now + stunT;
    statusStore.addShred(enemy, 0.12);
    noteFx('stun');
    plantMark(enemy.x, enemy.y, 'stun', stunT);
  }
  else if (effect === 'freeze') {
    enemy.slowUntil = now + (isBoss ? 500 : 1200) * power * dur;
    enemy.slowFactor = isBoss ? 0.80 : 0.60;
    enemy.wetUntil = now + 1200 * power * dur;
    plantMark(enemy.x, enemy.y, 'slow', 1200 * power * dur);
    addSteam(2);
  }
  else if (effect === 'lifesteal') {
    let h = 0.55 * (power || 1) * (1 + 0.28 * elCount('nature'));
    if (modValue('vamp')) h *= 1 + (modValue('vamp') || 0) * 0.35;
    h = Math.min(2.4, h);
    if (h >= 0.2) { player.hp = Math.min(player.maxHp, player.hp + h); updateHud(); }
    enemy.poisonStack = Math.min(4, (enemy.poisonStack || 0) + 1);
    enemy.poisonUntil = now + 3600 * power * dur * (isBoss ? 0.7 : 1);
    enemy.poisonTick = enemy.poisonTick || 0;
    statusStore.addShred(enemy, 0.04);
  }
  else if (effect === 'poison') {
    enemy.poisonStack = Math.min(4, (enemy.poisonStack || 0) + 1);
    enemy.poisonUntil = now + 3600 * power * dur * (isBoss ? 0.7 : 1);
    enemy.poisonTick = enemy.poisonTick || 0;
    statusStore.addShred(enemy, 0.04);
  }
  else if (effect === 'shock') {
    enemy.shockStack = Math.min(3, (enemy.shockStack || 0) + 1);
    enemy.shockUntil = now + (isBoss ? 1200 : 2000) * power * dur;
    plantMark(enemy.x, enemy.y, 'shock', 1500 * power * dur);
  }
  else if (effect === 'root') {
    if (!isBoss) {
      enemy.rootUntil = now + 900 * power * dur;
      enemy.slowUntil = now + 900 * power * dur;
      enemy.slowFactor = 0.60;
      statusStore.addShred(enemy, 0.12);
      plantMark(enemy.x, enemy.y, 'root', 900 * power * dur);
    } else {
      enemy.slowUntil = now + 350;
      enemy.slowFactor = 0.85;
    }
  }
  else if (effect === 'pull' || effect === 'mark') {
    statusStore.addMark(enemy, enemy.hitDmgRef || 8);
  }
  tryReactions(enemy, EFFECT_EL[effect], { dealt: enemy.hitDmgRef || 8 });
}

function markHitDmg(en, dealt, el) {
  dealt = Math.round(dealt * reactionResolver.peek(en, el));
  let armor = en.type === 'armored' ? 0.45 : en.type === 'boss' ? 0.18 : 0;
  armor = Math.max(0, armor - (en.shred || 0));
  dealt = Math.max(1, Math.round(dealt * Math.max(RESIST_FLOOR, 1 - armor)));
  if (en.shieldEl && el) {
    if (el === en.shieldEl) dealt = Math.max(1, Math.round(dealt * 0.4));
    else if (SHIELD_WEAK[en.shieldEl] === el) dealt = Math.round(dealt * 1.48);
  }
  if (en.type === 'boss' && pactArmed && el && el === pactEl) dealt = Math.round(dealt * 1.5);
  if (player && player.curseDmg && player.curseDmg !== 1) dealt = Math.round(dealt * player.curseDmg);
  if (player && player.hp / player.maxHp <= 0.22) dealt = Math.round(dealt * 1.14);
  if (flow > 40) dealt = Math.round(dealt * (1 + Math.min(0.12, (flow - 40) * 0.0018)));

  // SCOPE 5: Efsanevi Cam Top (Glass Cannon) 2.5x Hasar Çarpanı!
  if (runFlags().glassCannon || (player && player.cursed === 'glassCannon')) {
    dealt = Math.round(dealt * 2.5);
  }
  return dealt;
}
