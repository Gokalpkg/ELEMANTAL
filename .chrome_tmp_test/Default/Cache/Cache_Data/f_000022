function showModPick() {
  resetJoystick();
  paused = true;
  const row = document.getElementById('modRow');
  if (!row) { paused = false; return; }
  row.innerHTML = '';
  const available = MOD_POOL.filter(m => !modLv(m.id) && runAllowsMod(m) && !_banishedMods.has(m.id) && (player.mods[m.id] || 0) < (m.maxLv || 8));
  const fallback = MOD_POOL.filter(m => runAllowsMod(m) && !_banishedMods.has(m.id) && (player.mods[m.id] || 0) < (m.maxLv || 8));
  const pool = available.length >= 2 ? available : (fallback.length ? fallback : MOD_POOL);
  
  // Kumarbazın Zarı (Loaded Dice): Efsanevi kart çekme şansı artışı
  let poolCandidates = pool;
  if (player && player.mods && player.mods.loadedDice > 0) {
    const leg = pool.filter(m => m.rarity === 'legendary');
    if (leg.length && Math.random() < 0.40) poolCandidates = leg.concat(pool);
  }
  const picks = shuffle(poolCandidates).slice(0, 2);

  // Feature 17: Smart Perk Suggestion
  function scorePerk(m) {
    let s = 0;
    if (m.rarity === 'legendary') s += 100;
    else if (m.rarity === 'rare') s += 50;
    
    // Low HP -> highly value maxHp/regen/vamp
    if (player.hp < player.maxHp * 0.4 && (m.id === 'hpMax' || m.id === 'hpRegen' || m.id === 'leech' || m.id === 'bloodTithe')) s += 150;
    
    // Evolution check (if player has the required pair)
    if (typeof runLock !== 'undefined' && runLock.root && runLock.secondary) {
      if (m.id === runLock.root || m.id === runLock.secondary) s += 200;
    }
    
    // Low DPS -> value damage
    const dps = (typeof runStats !== 'undefined') ? (runStats.peakDps || 0) : 0;
    if (dps < 200 && (m.id === 'dmg' || m.id === 'multishot' || m.id === 'guillotine' || m.id === 'focalLens')) s += 80;
    
    return s;
  }
  
  let bestScore = -Infinity, bestPick = null;
  picks.forEach(m => {
    let s = scorePerk(m);
    if (s > bestScore) { bestScore = s; bestPick = m; }
  });

  picks.forEach((m) => {
    const wrap = document.createElement('div');
    wrap.style.cssText = 'display:flex;flex-direction:column;align-items:center;gap:4px;position:relative;';
    const btn = document.createElement('button');
    btn.type = 'button';
    const rar = m.rarity || 'common';
    const rarBadge = rar === 'legendary' ? 'EFSANEVİ' : rar === 'rare' ? 'NADİR' : 'YAYGIN';
    const badgeColor = rar === 'legendary' ? '#f59e0b' : rar === 'rare' ? '#c084fc' : '#34d399';
    const badgeBg = rar === 'legendary' ? 'rgba(245, 158, 11, 0.15)' : rar === 'rare' ? 'rgba(192, 132, 252, 0.15)' : 'rgba(52, 211, 153, 0.12)';
    const badgeShadow = rar === 'legendary' ? 'rgba(245, 158, 11, 0.45)' : rar === 'rare' ? 'rgba(192, 132, 252, 0.45)' : 'rgba(52, 211, 153, 0.35)';
    const curLv = player.mods[m.id] || 0;
    const maxL = m.maxLv || 8;
    const lvTag = curLv > 0 ? ` <span style="font-size:10px;color:#94a3b8;">(Lv ${curLv}/${maxL})</span>` : '';
    
    let recBadge = (m === bestPick && bestScore > 0) ? `<div style="position:absolute;top:-10px;right:-10px;background:#fbbf24;color:#000;font-size:10px;font-weight:900;padding:2px 6px;border-radius:6px;box-shadow:0 0 8px rgba(251,191,36,0.8);z-index:10;animation:px-anim-float 2s ease-in-out infinite;">⭐ ÖNERİLEN</div>` : '';

    let previewHtml = '';
    if (m.stats) {
      previewHtml = '<div style="margin-top:8px;padding:6px;background:rgba(0,0,0,0.3);border-radius:6px;font-size:10px;text-align:left;">';
      for (let k in m.stats) {
        let curVal = player[k] || 0;
        let pName = k;
        if (k==='hpMax') pName='Maks Can';
        if (k==='hpRegen') pName='Can Yenileme';
        if (k==='dmgMul') pName='Hasar Çarpanı';
        if (k==='attackSpeed') pName='Saldırı Hızı';
        if (k==='moveSpeed') pName='Hareket Hızı';
        if (k==='pickupRange') pName='Toplama Menzili';
        if (k==='armor') pName='Zırh';
        let isMult = (k==='dmgMul' || k==='attackSpeed');
        let diff = m.stats[k];
        let nVal = curVal + diff;
        let cStr = isMult ? (curVal*100).toFixed(0)+'%' : curVal.toFixed(1);
        let nStr = isMult ? (nVal*100).toFixed(0)+'%' : nVal.toFixed(1);
        let cColor = diff > 0 ? '#4ade80' : (diff < 0 ? '#f87171' : '#94a3b8');
        previewHtml += `<div style="display:flex;justify-content:space-between;margin-bottom:2px;">
          <span style="color:#cbd5e1;">${pName}</span>
          <span><span style="color:#94a3b8;text-decoration:line-through;margin-right:4px;">${cStr}</span><span style="color:${cColor};font-weight:bold;">${nStr}</span></span>
        </div>`;
      }
      previewHtml += '</div>';
    }

    btn.innerHTML = recBadge + `<div class="card-rarity-badge ${rar}">${rarBadge}</div>` +
                    `<div class="card-rune-wrap" style="width:48px;height:48px;margin:8px auto;display:flex;align-items:center;justify-content:center;border-radius:12px;background:${badgeBg};border:2px solid ${badgeColor};box-shadow:0 0 14px ${badgeShadow};">${renderPixelIcon(m.icon || m.emoji || "gem", "px-anim-float", 32)}</div>` +
                    `<span class="name" style="font-size:14.5px;font-weight:900;color:${rar==='legendary'?'#fbbf24':rar==='rare'?'#d8b4fe':'#a7f3d0'};margin-bottom:6px;">${m.name}${lvTag}</span>` +
                    `<span class="hint" style="font-size:11.5px;line-height:1.4;font-weight:600;color:#e2e8f0;">${m.desc}</span>` + previewHtml;
    let picked = false;
    bindTouchButton(btn, () => {
      if (picked) return;
      picked = true;
      btn.style.pointerEvents = 'none';
      applyMod(m);
    });
    wrap.appendChild(btn);
    // Sürgün (Banish) button
    const banishBtn = document.createElement('button');
    banishBtn.type = 'button';
    banishBtn.innerHTML = '🚫 Sürgün Et';
    banishBtn.style.cssText = 'padding:5px 14px;font-size:11px;font-weight:700;color:#f87171;background:rgba(248,113,113,0.10);border:1.5px solid rgba(248,113,113,0.30);border-radius:8px;cursor:pointer;letter-spacing:0.5px;margin-top:2px;';
    bindTouchButton(banishBtn, () => {
      _banishedMods.add(m.id);
      spawnFloatText(player.x, player.y - 20, m.name + ' Sürgün Edildi!', '#f87171');
      playSfx('hit', 0.3);
      showModPick();
    });
    wrap.appendChild(banishBtn);
    row.appendChild(wrap);
  });

  // Kumarbazın Zarı (Loaded Dice) Ücretsiz Yeniden Çevirme Butonu
  if (player && player.mods && player.mods.loadedDice > 0) {
    const diceBtn = document.createElement('button');
    diceBtn.type = 'button';
    diceBtn.style.cssText = 'grid-column: 1 / -1; width: 100%; max-width: 320px; margin: 8px auto 0; background: rgba(251,191,36,0.15); border: 1.5px solid #fbbf24; border-radius: 10px; color: #fbbf24; font-weight: 800; font-size: 12px; padding: 8px 16px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 6px; box-shadow: 0 0 10px rgba(251,191,36,0.3);';
    diceBtn.innerHTML = '🎲 Kumarbazın Zarı: Yeniden Çevir (Ücretsiz)';
    bindTouchButton(diceBtn, () => {
      spawnFloatText(player.x, player.y - 28, 'ZARLAR YENİDEN ATILDI!', '#fbbf24');
      playSfx('ui', 0.45);
      showModPick();
    });
    row.appendChild(diceBtn);
  }

  document.getElementById('modOverlay').classList.add('show');
  syncRerollFab();
}

