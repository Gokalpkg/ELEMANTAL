function tryMove(ent, mx, my) {
  if (!ent) return;
  if (!Number.isFinite(mx)) mx = 0;
  if (!Number.isFinite(my)) my = 0;
  if (Math.abs(mx) < 0.02) mx = 0;
  if (Math.abs(my) < 0.02) my = 0;
  if (!Number.isFinite(ent.x)) ent.x = 0;
  if (!Number.isFinite(ent.y)) ent.y = 0;
  if (mx === 0 && my === 0) return;

  // Player movement: buttery smooth continuous movement with obstacle pushout
  if (ent === player) {
    ent.x += mx;
    ent.y += my;
    pushOutOfObstacles(ent);
    softClamp(ent);
    return;
  }

  // Boss crushes breakable obstacles and smoothly glides past solid monuments
  if (ent.type === 'boss') {
    const nextObs = circleHitsObs(ent.x + mx, ent.y + my, ent.r + 4);
    if (nextObs && nextObs.breakable) {
      hurtBreakable(nextObs, 999);
    }
    ent.x += mx;
    ent.y += my;
    pushOutOfObstacles(ent);
    return;
  }

  // Regular Enemies: Smooth sliding along obstacles and unstick guarantee within 2 seconds
  const r = ent.r || 12;
  const nx = ent.x + mx;
  const ny = ent.y + my;
  const hitObs = circleHitsObs(nx, ny, r);

  if (!hitObs) {
    ent.x = nx;
    ent.y = ny;
    ent.stuckTimer = Math.max(0, (ent.stuckTimer || 0) - 1.2);
  } else {
    // Collision detected! Slide on X or Y axis so enemy doesn't snag
    let slid = false;
    if (mx !== 0 && !circleHitsObs(nx, ent.y, r)) {
      ent.x = nx;
      slid = true;
    } else if (my !== 0 && !circleHitsObs(ent.x, ny, r)) {
      ent.y = ny;
      slid = true;
    }

    if (!slid) {
      // Both axes blocked by obstacle corner
      ent.stuckTimer = (ent.stuckTimer || 0) + 1;
      pushOutOfObstacles(ent);
      if (ent.stuckTimer >= 120) {
        // UNSTICK: Takılma süresi 2 saniyeye (120 frame / 2 sn) ulaştı!
        // Engelin kenarından oyuncuya doğru güvenli bir noktaya hızla sıyrıl!
        const toPlayer = Math.atan2(player.y - ent.y, player.x - ent.x);
        const escapeDist = r + Math.max(hitObs.w, hitObs.h) * 0.75 + 16;
        ent.x = hitObs.x + hitObs.w / 2 + Math.cos(toPlayer) * escapeDist;
        ent.y = hitObs.y + hitObs.h / 2 + Math.sin(toPlayer) * escapeDist;
        pushOutOfObstacles(ent);
        softClamp(ent);
        ent.stuckTimer = 0;
        burst(ent.x, ent.y, '#ffffff', 8, 2.2);
      }
    } else {
      ent.stuckTimer = Math.max(0, (ent.stuckTimer || 0) - 0.5);
    }
  }
}
function expandWorld() {
  if (!player) return;
  const pad = 520;
  if (player.x < originX + pad) {
    const d = originX + pad - player.x;
    originX -= d;
    MAP_W += d;
  }
  if (player.y < originY + pad) {
    const d = originY + pad - player.y;
    originY -= d;
    MAP_H += d;
  }
  if (player.x > originX + MAP_W - pad) MAP_W += player.x - (originX + MAP_W - pad);
  if (player.y > originY + MAP_H - pad) MAP_H += player.y - (originY + MAP_H - pad);
}
function softClamp(ent) {
  if (!ent) return;
  if (!Number.isFinite(ent.x)) ent.x = 0;
  if (!Number.isFinite(ent.y)) ent.y = 0;
  const m = 40;
  if (ent.x < originX + m) ent.x = originX + m;
  if (ent.y < originY + m) ent.y = originY + m;
  if (ent.x > originX + MAP_W - m) ent.x = originX + MAP_W - m;
  if (ent.y > originY + MAP_H - m) ent.y = originY + MAP_H - m;
}
function clampWorldX(x, m) {
  m = m == null ? 20 : m;
  return Math.max(originX + m, Math.min(originX + MAP_W - m, x));
}
function clampWorldY(y, m) {
  m = m == null ? 20 : m;
  return Math.max(originY + m, Math.min(originY + MAP_H - m, y));
}
function randWorldX(pad) {
  pad = pad == null ? 80 : pad;
  return originX + pad + Math.random() * Math.max(40, MAP_W - pad * 2);
}
function randWorldY(pad) {
  pad = pad == null ? 80 : pad;
