function continueRun() {
  continuesLeft = 0;
  document.getElementById('continueOverlay').classList.remove('show');
  player.hp = Math.max(18, Math.floor(player.maxHp * 0.42));
  player.invuln = 120;
  player.slowUntil = 0;
  const R = 240;
  const px = player.x, py = player.y;
  for (let j = enemies.length - 1; j >= 0; j--) {
    const en = enemies[j];
    if (!en || en._dead) continue;
    const maxReach = R + (en.r || 12);
    const dx = en.x - px, dy = en.y - py;
    if (Math.abs(dx) > maxReach || Math.abs(dy) > maxReach) continue;
    if (dx * dx + dy * dy <= maxReach * maxReach) {
      en.type = en.type === 'exploder' ? 'walker' : en.type;
      killEnemy(j);
    }
  }
  burst(player.x, player.y, '#ffd740', 24, 4.5);
  burst(player.x, player.y, '#00e5ff', 18, 3.5);
  triggerScreenFlash('#ffd740', 0.4, 180);
  shake = Math.max(shake, 10);
  const isEn = (typeof getGameLang === 'function' && getGameLang() === 'en');
  spawnFloatText(player.x, player.y - 28, isEn ? ' PHOENIX REBIRTH!' : ' KÜLLERİNDEN DOĞUŞ!', '#ffd740', 'big');
  playSfx('legendary', 0.5);
  vibrate([40, 60, 40]);
  updateHud();
  running = true;
  paused = false;
}

