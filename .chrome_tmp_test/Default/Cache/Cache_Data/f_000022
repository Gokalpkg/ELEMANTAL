<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="format-detection" content="telephone=no">
<meta name="color-scheme" content="dark">
<title>Element Savaşı</title>
<style>
  /* HIGH-END MOBILE GAMING UI SYSTEM */
  * {
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
    user-select: none;
    -webkit-user-select: none;
    margin: 0; padding: 0;
  }
  html, body {
    height: 100%;
    width: 100%;
    min-height: 100dvh;
    background: #080a10;
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', Roboto, 'Inter', 'Helvetica Neue', Arial, sans-serif;
    color: #f1f5f9;
    overscroll-behavior: none;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    overflow: hidden;
    position: fixed;
    inset: 0;
  }
  button, .btn, .choice-card, .tree-node, .el-chip, .status-chip, .meter-pill {
    font-family: inherit;
    border-radius: 10px;
  }
  .overlay h1, .overlay h2, .menu-hero-title {
    font-family: inherit;
    letter-spacing: 0.04em;
    font-weight: 900;
  }
  #app {
    width: 100vw; height: 100dvh; height: 100vh; margin: 0 auto;
    padding: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    overflow: hidden;
  }
  @media (max-height: 760px) {
    h1 { font-size:18px; }
    .sub { display:none; }
    .combo-slot { min-height:36px; padding:4px; }
    .combo-slot .cdesc { font-size:8px; }
  }
  h1 { font-size:22px; text-align:center; margin-bottom:2px; letter-spacing:1.4px; text-shadow:0 0 18px rgba(120,160,255,.25); }
  .sub { font-size:12px; opacity:0.55; text-align:center; margin-bottom:8px; }

  /* Menüdeyken arkadaki HUD ve başlığı gizle, tertemiz minimalist görüntü sağla */
  body.in-menu #hud,
  body.in-menu h1,
  body.in-menu .sub {
    display: none !important;
  }
  body.in-menu #app {
    justify-content: center;
  }

  #hud {
    position: absolute;
    top: max(10px, env(safe-area-inset-top, 0px));
    left: max(10px, env(safe-area-inset-left, 0px));
    right: calc(max(10px, env(safe-area-inset-right, 0px)) + 52px);
    z-index: 6;
    display: flex; flex-direction: column; gap: 5px; margin-bottom: 0; pointer-events: none;
    transition: opacity .25s ease, transform .25s ease;
  }
  .hud-bars-row { display:flex; gap:8px; width:100%; }
  .meter-pill {
    flex:1; display:flex; align-items:center; gap:7px;
    background: linear-gradient(180deg, #1e293b, #0f172a);
    border: 2px solid #475569;
    border-radius: 12px; padding: 4px 10px;
    box-shadow: 0 3px 10px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.15);
    min-width:0;
  }
  .meter-icon { font-size:14px; line-height:1; filter: drop-shadow(0 0 4px rgba(255,23,68,0.6)); }
  .meter-track { flex:1; height:12px; background:#090d16; border-radius:6px; overflow:hidden; position:relative; border: 1px solid #1e293b; }
  .meter-fill { height:100%; border-radius:inherit; transition: width 0.18s ease; }
  .meter-fill.hp-fill { background: linear-gradient(90deg, #991b1b, #ef4444, #f87171); box-shadow: 0 0 8px rgba(239,68,68,0.6); }
  .meter-fill.xp-fill { background: linear-gradient(90deg, #0369a1, #0284c7, #38bdf8); box-shadow: 0 0 8px rgba(56,189,248,0.6); }
  @keyframes xpPulseGlow {
    0%, 100% { filter: drop-shadow(0 0 4px #ffd700) brightness(1.1); box-shadow: 0 0 10px rgba(250,204,21,0.6); }
    50% { filter: drop-shadow(0 0 12px #ffe57f) brightness(1.35); box-shadow: 0 0 18px rgba(250,204,21,0.95); }
  }
  .meter-fill.xp-fill.xp-ready-pulse {
    background: linear-gradient(90deg, #0284c7, #38bdf8, #facc15, #f59e0b) !important;
    animation: xpPulseGlow 0.75s ease-in-out infinite alternate !important;
  }
  .meter-val { font-size:11px; font-weight:900; color:#fff; min-width:34px; text-align:right; font-variant-numeric: tabular-nums; text-shadow: 0 1px 2px #000; }
  .meter-sub { font-size:10px; opacity:0.85; font-weight:800; margin-left:-2px; color:#38bdf8; }
  .meter-pill.wave-pill { flex: 0 0 auto; min-width: 64px; justify-content: center; background: linear-gradient(180deg, #272115, #14110b); border: 2px solid #b45309; }
  .meter-pill.wave-pill .meter-val { min-width: auto; text-align: center; color: #ffd740; }

  .hud-status-row {
    display:flex; align-items:center; justify-content:space-between;
    font-size:11px; font-weight:700; gap:4px;
  }
  .status-chip {
    font-size:11px; font-weight:700; background:rgba(20,24,34,0.85); border:1px solid rgba(255,255,255,0.08);
    border-radius:8px; padding:2px 7px; color:#eee; /* no blur */
  }
  .status-chip.auto { color:#ffd54f; border-color:rgba(255,213,79,0.25); max-width:140px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .status-chip.crystal { color:#c084fc; border-color:rgba(192,132,252,0.25); }
  .status-chip.rank { background:rgba(255,215,64,0.15); color:#f5c542; border-color:rgba(245,197,66,0.35); font-weight:900; min-width:20px; text-align:center; }

  .pause-btn {
    position: absolute;
    right: max(10px, env(safe-area-inset-right, 0px));
    top: max(10px, env(safe-area-inset-top, 0px));
    z-index: 99;
    width: 44px; height: 34px; border-radius: 12px;
    border: 2px solid #475569;
    background: linear-gradient(180deg, #1e293b, #0f172a);
    color: #eee; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 3px 10px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.15);
    touch-action: manipulation;
    user-select: none;
    -webkit-user-select: none;
    transition: transform .12s, border-color .2s;
  }
  .pause-btn:active { transform: scale(0.92); border-color: #38bdf8; }
  #sfxHudBtn, #vibHudBtn {
    display: none !important;
  }
  #devJumpBtn {
    position:absolute;
    right: calc(max(10px, env(safe-area-inset-right, 0px)) + 124px);
    top: max(10px, env(safe-area-inset-top, 0px));
    z-index:12;
    height:36px; padding:0 11px; border-radius:12px;
    border:1px solid #ea580c;
    background:linear-gradient(135deg, rgba(234, 88, 12, 0.95), rgba(194, 65, 12, 0.95));
    color:#fff; font-size:11.5px; font-weight:900; cursor:pointer;
    box-shadow:0 0 12px rgba(234, 88, 12, 0.55);
    display:none; align-items:center; justify-content:center; gap:4px;
    transition:transform .12s;
  }
  #devJumpBtn:active { transform:scale(0.92); }
  .overlay.settings-ov, .overlay.dev-select-ov {
    justify-content:flex-start;
    padding-top:max(22px, env(safe-area-inset-top, 0px));
    max-height:94vh;
    overflow-y:auto;
    -webkit-overflow-scrolling:touch;
  }
  .dev-wave-grid {
    display:grid;
    grid-template-columns:repeat(2, 1fr);
    gap:8px;
    max-height:62vh;
    overflow-y:auto;
    width:100%;
    max-width:440px;
    padding:6px 4px;
    touch-action: pan-y;
    -webkit-overflow-scrolling:touch;
  }
  .dev-wave-card {
    background:linear-gradient(180deg, rgba(30, 36, 50, 0.95), rgba(20, 24, 34, 0.95));
    border:1px solid #3b4256;
    border-radius:8px;
    padding:9px 10px;
    text-align:left;
    cursor:pointer;
    display:flex;
    flex-direction:column;
    gap:3px;
    width:100%;
    font-family:inherit;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
    -webkit-user-select: none;
    transition:transform .1s, border-color .12s, box-shadow .12s;
  }
  .dev-wave-card:active {
    transform:scale(0.96);
    border-color:#ea580c;
    box-shadow:0 0 10px rgba(234, 88, 12, 0.5);
  }
  .dev-wave-card.is-boss {
    background: linear-gradient(180deg, rgba(46, 32, 14, 0.96), rgba(26, 18, 8, 0.96));
    border: 1.5px solid #f59e0b;
    box-shadow: 0 0 12px rgba(245, 158, 11, 0.25);
    position: relative;
  }
  .dev-wave-card.is-boss:active {
    border-color: #fbbf24;
    box-shadow: 0 0 16px rgba(251, 191, 36, 0.6);
  }
  .dev-wave-card.is-boss .dev-wave-title {
    color: #fef08a;
  }
  .dev-wave-head {
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:6px;
  }
  .dev-wave-title {
    font-size:13px;
    font-weight:900;
    color:#fff;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
  }
  .dev-wave-badge {
    font-size:9px;
    font-weight:800;
    padding:2px 5px;
    border-radius:4px;
    color:#fff;
    white-space:nowrap;
    flex-shrink:0;
  }
  .dev-wave-boss-tag {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    font-size: 9px;
    font-weight: 900;
    background: rgba(245, 158, 11, 0.25);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.55);
    border-radius: 4px;
    padding: 1px 5px;
    margin-right: 4px;
  }
  .dev-wave-desc {
    font-size:11px;
    line-height:1.3;
    color:#cbd5e1;
  }
  .dev-boss-guide-box {
    width: 100%;
    max-width: 440px;
    background: rgba(245, 158, 11, 0.08);
    border: 1px solid rgba(245, 158, 11, 0.35);
    border-radius: 8px;
    padding: 7px 10px;
    margin-bottom: 8px;
    box-sizing: border-box;
  }
  .dev-boss-guide-title {
    font-size: 12px;
    font-weight: 800;
    color: #fbbf24;
    margin-bottom: 2px;
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .dev-boss-guide-text {
    font-size: 11px;
    color: #fed7aa;
    line-height: 1.35;
  }
  .dev-filter-tabs {
    display: flex;
    gap: 6px;
    width: 100%;
    max-width: 440px;
    margin-bottom: 8px;
  }
  .dev-filter-btn {
    flex: 1;
    background: #1e293b;
    border: 1px solid #475569;
    border-radius: 6px;
    color: #cbd5e1;
    font-size: 11px;
    font-weight: 700;
    padding: 6px 4px;
    cursor: pointer;
    transition: all 0.15s;
    font-family: inherit;
    text-align: center;
  }
  .dev-filter-btn.active {
    background: #ea580c;
    border-color: #fb923c;
    color: #fff;
    box-shadow: 0 0 8px rgba(234, 88, 12, 0.4);
  }
  .dev-filter-btn.boss-tab.active {
    background: linear-gradient(135deg, #d97706, #b45309);
    border-color: #fbbf24;
    color: #fff;
    box-shadow: 0 0 10px rgba(245, 158, 11, 0.5);
  }
  .dev-custom-status {
    font-size: 11px;
    font-weight: 700;
    margin-top: 4px;
    width: 100%;
    text-align: center;
    min-height: 16px;
    line-height: 1.3;
  }
  .sfx-row { display:flex; align-items:center; gap:8px; width:100%; }
  .sfx-row input[type=range] { flex:1; accent-color:#b08a6c; }

  .combo-row { display:flex; gap:6px; }
  .combo-slot {
    flex:1; background:rgba(20,24,34,.82); border:1.5px solid rgba(255,255,255,.08); border-radius:12px;
    padding:5px 6px 4px; font-size:11px; min-height:42px; display:flex; flex-direction:column; align-items:center; justify-content:center;
    text-align:center; opacity:0.55; /* no blur */ transition: all .2s cubic-bezier(.2,.85,.2,1);
  }
  .combo-slot.filled { opacity:1; background:rgba(26,30,42,.92); border-color:rgba(255,255,255,.2); }
  .combo-slot.pending { opacity:1; border-color:#f1c40f; box-shadow:0 0 12px rgba(241,196,15,.3); }
  .combo-slot.fire { border-color:#ef4444; box-shadow:0 0 10px rgba(239,68,68,.25); }
  .combo-slot.water { border-color:#3b82f6; box-shadow:0 0 10px rgba(59,130,246,.25); }
  .combo-slot.earth { border-color:#d97706; box-shadow:0 0 10px rgba(217,119,6,.25); }
  .combo-slot.nature { border-color:#22c55e; box-shadow:0 0 10px rgba(34,197,94,.25); }
  .combo-slot.storm { border-color:#eab308; box-shadow:0 0 10px rgba(234,179,8,.25); }
  .combo-slot.void { border-color:#a855f7; box-shadow:0 0 10px rgba(168,85,247,.25); }
  .combo-slot .icons { font-size:15px; line-height:1.2; }
  .combo-slot .cname { font-size:10px; font-weight:700; margin-top:1px; }
  .combo-slot .cdesc { font-size:8px; opacity:0.72; line-height:1.15; max-width:100%; margin-top:1px; }
  .mod-strip { width:100%; display:flex; gap:4px; flex-wrap:wrap; font-size:10px; min-height:12px; }
  .mod-chip { background:rgba(20,24,34,.88); border:1px solid rgba(255,255,255,.08); border-radius:7px; padding:2px 6px; opacity:0.92; }
  .micro-meters-row { display:flex; gap:6px; align-items:center; width:100%; }
  .micro-meters-row .split-hud { flex:1; }
  .micro-meters-row .press-micro { flex:1; margin-top:0; }

  #canvasWrap {
    position: relative; overflow: hidden; touch-action: none;
    width: 100vw; height: 100dvh; height: 100vh;
    border-radius: 0; border: none;
    box-shadow: none;
    display: flex; align-items: center; justify-content: center;
  }
  #game, #gameCanvas {
    display: block; background: #141821; width: 100%; height: 100%;
    object-fit: cover;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    touch-action: none !important;
    user-select: none !important;
    -webkit-user-select: none !important;
  }

  .overlay {
    position:absolute; inset:0; background:rgba(8,10,16,0.82); display:flex;
    align-items:center; justify-content:center; flex-direction:column; padding:16px; text-align:center; z-index:10;
    /* no blur */
    opacity:0; visibility:hidden; pointer-events:none;
    transform: translate3d(0, 18px, 0) scale(0.985);
    transition: opacity .26s cubic-bezier(.22,1,.36,1), transform .26s cubic-bezier(.22,1,.36,1), visibility .26s;
  }
  .overlay.show {
    opacity:1; visibility:visible; pointer-events:auto;
    transform: translate3d(0,0,0) scale(1);
    z-index: 25;
  }
  .overlay h2 { font-size:20px; margin-bottom:10px; }
  .overlay.guide-ov { justify-content:flex-start; padding-top:18px; }
  .guide-body {
    text-align:left; max-width:340px; width:100%; max-height:min(58vh, 420px);
    overflow-y:auto; font-size:12px; line-height:1.45; opacity:0.92;
    -webkit-overflow-scrolling:touch;
  }
  .guide-body h3 { font-size:13px; margin:10px 0 4px; opacity:1; }
  .guide-body p { font-size:12px; opacity:0.88; max-width:none; margin:0 0 6px; }
  .guide-chip {
    display:inline-block; margin:2px 4px 2px 0; padding:3px 7px; border-radius:8px;
    background:rgba(255,255,255,.06); border:1px solid #3d4150; font-size:11px;
  }
  .choice-row { display:flex; gap:10px; margin-top:10px; flex-wrap:wrap; justify-content:center; }
  .choice-card {
    background: linear-gradient(180deg, #1e293b, #0f172a);
    border: 2px solid #334155; border-radius: 16px; padding: 14px 12px;
    cursor: pointer; width: 132px;
    color: #f8fafc; font-family: inherit;
    touch-action: manipulation; -webkit-tap-highlight-color: transparent; user-select: none; -webkit-user-select: none;
    box-shadow: 0 8px 0 #090d16, 0 12px 24px rgba(0, 0, 0, 0.45);
    transition: transform .14s cubic-bezier(.2,.85,.2,1), box-shadow .14s cubic-bezier(.2,.85,.2,1), border-color .14s;
    animation: cardIn .34s cubic-bezier(.22,1,.36,1) both;
  }
  .choice-row .choice-card:nth-child(2) { animation-delay:.05s; }
  .choice-row .choice-card:nth-child(3) { animation-delay:.1s; }
  .choice-row .choice-card:nth-child(4) { animation-delay:.14s; }
  .choice-row .choice-card:nth-child(5) { animation-delay:.18s; }
  .choice-row .choice-card:nth-child(6) { animation-delay:.22s; }
  @keyframes cardIn {
    from { opacity:0; transform: translateY(16px) scale(.94); }
    to { opacity:1; transform: translateY(0) scale(1); }
  }
  .choice-card:active {
    transform: translateY(6px) scale(0.96);
    box-shadow: 0 2px 0 #090d16, 0 4px 12px rgba(0, 0, 0, 0.4);
  }
  .choice-card .emoji { font-size: 32px; display: block; margin-bottom: 6px; filter: drop-shadow(0 2px 6px rgba(0,0,0,0.6)); }
  .choice-card .name { font-size: 13.5px; font-weight: 900; display: block; letter-spacing: 0.2px; }
  .choice-card .hint { font-size: 10.5px; opacity: 0.85; margin-top: 5px; display: block; line-height: 1.3; color: #cbd5e1; }
  .choice-card.fire { border-color: #ef4444; box-shadow: 0 8px 0 #7f1d1d, 0 0 18px rgba(239, 68, 68, 0.35); }
  .choice-card.water { border-color: #38bdf8; box-shadow: 0 8px 0 #075985, 0 0 18px rgba(56, 189, 248, 0.35); }
  .choice-card.earth { border-color: #d97706; box-shadow: 0 8px 0 #78350f, 0 0 18px rgba(217, 119, 6, 0.35); }
  .choice-card.nature { border-color: #22c55e; box-shadow: 0 8px 0 #14532d, 0 0 18px rgba(34, 197, 94, 0.35); }
  .choice-card.storm { border-color: #facc15; box-shadow: 0 8px 0 #713f12, 0 0 18px rgba(250, 204, 21, 0.38); }
  .choice-card.curse { border-color: #dc2626; box-shadow: 0 8px 0 #450a0a, 0 0 18px rgba(220, 38, 38, 0.45); }
  .choice-card.sig { border-color: #ffd700; box-shadow: 0 8px 0 #78350f, 0 0 20px rgba(255, 215, 0, 0.4); }
  #reactHud { min-height:14px; opacity:0.92; }
  .react-chip { background:rgba(22,25,34,.92); border:1px solid #4a4158; border-radius:6px; padding:2px 6px; }

  .btn {
    border:none; border-radius:12px; padding:12px 22px; font-size:14px; font-weight:bold;
    background:linear-gradient(180deg,#c49a78,#8f7a66); color:#fff; cursor:pointer; margin-top:10px;
    touch-action: manipulation; -webkit-tap-highlight-color: transparent; user-select: none; -webkit-user-select: none;
    box-shadow: 0 5px 0 #5c4638, 0 10px 18px rgba(0,0,0,.32);
    transition: transform .12s cubic-bezier(.2,.85,.2,1), box-shadow .12s cubic-bezier(.2,.85,.2,1), filter .12s;
  }
  .btn:active { transform: translateY(4px); box-shadow: 0 1px 0 #5c4638, 0 3px 8px rgba(0,0,0,.28); filter: brightness(1.06); }
  .btn.ghost {
    background:rgba(255,255,255,.06); border:1px solid #5a534c; box-shadow: 0 4px 0 #2a2622, 0 8px 14px rgba(0,0,0,.25);
  }
  .btn.ghost:active { box-shadow: 0 1px 0 #2a2622; }
  .menu-btns { display:flex; flex-direction:column; gap:8px; margin-top:12px; width:220px; }
  .menu-btns .btn { margin-top:0; width:100%; }
  
  /* Temiz Menü İçi Envanter Paneli (Üstü tıkamaz, menüde şık görünür) */
  .pause-stat-grid {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px;
    width: 100%; max-width: 320px; margin-bottom: 8px;
  }
  .pause-stat-box {
    background: rgba(22, 26, 36, 0.88); border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px; padding: 6px 4px; text-align: center;
  }
  .pstat-lab { font-size: 8.5px; font-weight: 800; color: #ffd740; letter-spacing: .4px; }
  .pstat-val { font-size: 11.5px; font-weight: 800; color: #fff; margin-top: 2px; }

  .pause-inventory-card {
    width: 100%; max-width: 320px;
    background: rgba(22, 26, 36, 0.88);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    padding: 10px 12px;
    margin: 4px 0 6px;
    text-align: left;
    box-shadow: 0 4px 14px rgba(0,0,0,0.3);
  }
  .pause-sec-title {
    font-size: 11px; font-weight: 800; text-transform: uppercase;
    color: #ffd740; letter-spacing: 0.5px; margin-bottom: 6px;
    display: flex; align-items: center; gap: 4px;
  }
  .pause-attrs-grid {
    display: grid; grid-template-columns: repeat(2, 1fr); gap: 5px 8px;
  }
  .attr-item {
    display: flex; align-items: center; gap: 4px; font-size: 10.5px;
    background: rgba(255, 255, 255, 0.05); border-radius: 6px; padding: 3px 6px;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }
  .attr-icon { font-size: 12px; }
  .attr-k { opacity: 0.72; font-size: 10px; }
  .attr-v { font-weight: 800; color: #7dd3fc; margin-left: auto; font-size: 10.5px; }

  .pause-grid {
    display: flex; flex-wrap: wrap; gap: 6px;
  }
  .pause-badge-chip {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.14);
