}
function elemMul(el) {
  const b = currentBiome().key;
  const table = {
    fire:   { lava:1.22, forest:1.38, water:0.66, stone:1.0, ice:0.78, sand:1.12, night:1.06, pink:1.08, ketchup:1.05 },
    nature: { forest:1.18, lava:0.58, water:0.92, stone:0.95, ice:0.86, sand:0.88, night:1.1, pink:1.08, ketchup:1.05 },
    water:  { water:1.16, lava:1.32, forest:0.82, stone:1.0, ice:1.24, sand:0.72, night:1.0, pink:1.08, ketchup:1.05 },
    earth:  { stone:1.22, water:0.84, lava:1.1, forest:1.04, storm:1.08, ice:0.9, sand:1.2, night:1.04, pink:1.08, ketchup:1.05 },
    storm:  { storm:1.22, water:1.34, stone:1.12, forest:1.05, lava:0.9, ice:1.14, sand:0.94, night:1.2, pink:1.12, ketchup:1.05 }
  };
  let m = (table[el] && table[el][b]) || 1;
  if (runLock && runLock.root === el) m *= 1 + 0.08 * (runLock.rootNodes || 0);
  return m;
}
