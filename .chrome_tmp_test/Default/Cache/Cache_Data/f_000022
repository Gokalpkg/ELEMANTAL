function renderPauseStats() {
  const body = document.getElementById('pauseStatsBody');
  if (!body || typeof runStats === 'undefined') return;
  const totalDmg = (runStats.totalDmgDealt || 0);
  const kills = (runStats.kills || 0);
  const maxCrit = (runStats.maxCritHit || 0);
  const dps = (runStats.currentDps || 0);
  const peakDps = Math.round(runStats.peakDps || 0);
  const elapsed = Math.max(1, performance.now() - (runStats.startTime || performance.now()));
  const mins = Math.floor(elapsed / 60000);
  const secs = Math.floor((elapsed % 60000) / 1000);
  const avgDps = Math.round(totalDmg / Math.max(1, elapsed / 1000));

  // Element colors
  const EL_COLORS = { fire:'#ef4444', water:'#3b82f6', earth:'#a3a3a3', nature:'#22c55e', storm:'#a78bfa', void:'#8b5cf6', physical:'#94a3b8', ice:'#38bdf8' };
  const EL_NAMES = { fire:'Ateş', water:'Su', earth:'Toprak', nature:'Doğa', storm:'Fırtına', void:'Hiçlik', physical:'Fiziksel', ice:'Buz' };

  let dmgBreakdown = '';
  if (runStats.dmgByElement) {
    const sorted = Object.entries(runStats.dmgByElement).sort((a,b) => b[1] - a[1]);
    sorted.forEach(([el, dmg]) => {
      const pct = totalDmg > 0 ? Math.round(dmg / totalDmg * 100) : 0;
      const col = EL_COLORS[el] || '#94a3b8';
      const name = EL_NAMES[el] || el;
      dmgBreakdown += `<div style="display:flex;align-items:center;gap:6px;margin:3px 0;">
        <div style="width:10px;height:10px;border-radius:50%;background:${col};flex-shrink:0;"></div>
        <span style="flex:1;font-weight:600;">${name}</span>
        <span style="color:${col};font-weight:700;">${dmg.toLocaleString()}</span>
        <span style="color:#94a3b8;font-size:10px;min-width:32px;text-align:right;">${pct}%</span>
      </div>`;
    });
  }

  // Active perks list
  let perksHtml = '';
  if (player && player.mods) {
    const modKeys = Object.keys(player.mods).filter(k => player.mods[k] > 0);
    if (modKeys.length) {
      perksHtml = '<div style="margin-top:8px;padding-top:6px;border-top:1px solid rgba(148,163,184,0.2);"><b style="color:#fbbf24;">Aktif Perkler:</b><br>';
      modKeys.forEach(k => {
        const def = MOD_POOL.find(m => m.id === k);
        const name = def ? def.name : k;
        perksHtml += `<span style="display:inline-block;background:rgba(148,163,184,0.12);border-radius:6px;padding:2px 8px;margin:2px;font-size:11px;">${name} Lv${player.mods[k]}</span>`;
      });
      perksHtml += '</div>';
    }
  }

  body.innerHTML = `
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:6px 16px;margin-bottom:8px;">
      <div>⏱️ <b>Süre:</b> ${mins}dk ${secs}sn</div>
      <div>💀 <b>Öldürme:</b> ${kills.toLocaleString()}</div>
      <div>⚔️ <b>Toplam Hasar:</b> ${totalDmg.toLocaleString()}</div>
      <div>💥 <b>Max Krit:</b> ${maxCrit.toLocaleString()}</div>
      <div>📊 <b>Anlık DPS:</b> <span style="color:#34d399;font-weight:700;">${dps.toLocaleString()}</span></div>
      <div>🔥 <b>Zirve DPS:</b> <span style="color:#f59e0b;font-weight:700;">${peakDps.toLocaleString()}</span></div>
      <div>📈 <b>Ort. DPS:</b> ${avgDps.toLocaleString()}</div>
      <div>🎯 <b>Boss:</b> ${(runStats.bossKills || 0)}</div>
    </div>
    <div style="border-top:1px solid rgba(148,163,184,0.2);padding-top:6px;">
      <b style="color:#38bdf8;">Element Hasar Dağılımı:</b>
      ${dmgBreakdown || '<span style="color:#64748b;">Henüz veri yok</span>'}
    </div>
    ${perksHtml}
  `;
}

