function respecAncientTree() {
  const meta = loadMeta();
  let totalRefund = 0;
  if (meta.tree) {
    Object.keys(meta.tree).forEach(k => {
      const lv = meta.tree[k] || 0;
      totalRefund += lv * 50; // 50 crystals per tier
      meta.tree[k] = 0;
    });
