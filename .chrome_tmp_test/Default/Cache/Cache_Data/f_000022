      ctx.lineWidth = 1.8;
      ctx.beginPath();
      ctx.ellipse(fp.x, fp.y, fp.r * 0.8, fp.r * 0.4, 0, 0, Math.PI * 2);
      ctx.stroke();
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(fp.x - 1.5, fp.y - 1.5, 3, 3);
    } else if (fp.type === 'water') {
      // Expanding aquatic puddle ripple
      ctx.strokeStyle = 'rgba(0, 176, 255, ' + (0.65 * a) + ')';
      ctx.lineWidth = 1.8;
      ctx.beginPath();
      ctx.ellipse(fp.x, fp.y, fp.r * 0.45, 0, 0, Math.PI * 2);
      ctx.stroke();
      ctx.strokeStyle = 'rgba(224, 247, 250, ' + (0.4 * a) + ')';
      ctx.beginPath();
      ctx.ellipse(fp.x, fp.y, fp.r * 0.6, fp.r * 0.28, 0, 0, Math.PI * 2);
      ctx.stroke();
    } else if (fp.type === 'sand') {
      // Deep desert sand indentation & berm
      ctx.fillStyle = 'rgba(120, 80, 40, ' + (0.5 * a) + ')';
      ctx.beginPath();
      ctx.ellipse(fp.x, fp.y, fp.r * 0.9, fp.r * 0.45, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = '#ffd54f';
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.arc(fp.x, fp.y - 1, fp.r * 0.7, 0, Math.PI);
      ctx.stroke();
    } else if (fp.type === 'night') {
      // Void abyss pool with shadow smoke
      ctx.fillStyle = 'rgba(74, 20, 140, ' + (0.6 * a) + ')';
      ctx.beginPath();
      ctx.ellipse(fp.x, fp.y, fp.r * 0.5, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = '#d500f9';
      ctx.fillRect(fp.x - 1, fp.y - 1, 2, 2);
    } else if (fp.type === 'pink') {
      // Sweet sugar sprinkle stomp
      ctx.fillStyle = 'rgba(255, 64, 129, ' + (0.5 * a) + ')';
      ctx.beginPath();
      ctx.ellipse(fp.x, fp.y, fp.r * 0.85, fp.r * 0.45, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = '#00e5ff';
      ctx.fillRect(fp.x - 4, fp.y - 1, 2.5, 2.5);
      ctx.fillStyle = '#ffea00';
      ctx.fillRect(fp.x + 3, fp.y + 1, 2.5, 2.5);
    } else if (fp.type === 'ketchup') {
      // Savory gourmet sauce splatter
      ctx.fillStyle = 'rgba(198, 40, 40, ' + (0.75 * a) + ')';
      ctx.beginPath();
      ctx.ellipse(fp.x, fp.y, fp.r * 0.5, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = 'rgba(255, 255, 255, ' + (0.5 * a) + ')';
      ctx.fillRect(fp.x - 2, fp.y - 2, 2, 2);
    } else {
      // Bedrock fractured stone stomp
      ctx.fillStyle = 'rgba(60, 45, 35, ' + (0.5 * a) + ')';
      ctx.beginPath();
      ctx.ellipse(fp.x, fp.y, fp.r * 0.9, fp.r * 0.45, 0, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.restore();
  }
}

// Multi-Segment Serpentine Spine Renderer for Leviathan (Water Boss)
function drawLeviathanBodySegments(ctx, en, time) {
  if (!en || !en.segments || en.segments.length === 0) return;
  ctx.save();
  for (let s = en.segments.length - 1; s >= 0; s--) {
    const seg = en.segments[s];
    const segR = seg.r || 12;

    const ripT = time * 0.18 + s * 0.45;
    const ripR = segR * (1.15 + Math.sin(ripT) * 0.22);
    ctx.strokeStyle = 'rgba(0, 229, 255, 0.35)';
    ctx.lineWidth = 1.6;
    ctx.beginPath();
    ctx.ellipse(seg.x, seg.y + segR * 0.2, ripR, ripR * 0.45, seg.angle, 0, Math.PI * 2);
    ctx.stroke();

    const finLen = segR * 0.92;
    const normAngle = seg.angle - Math.PI / 2;
    ctx.fillStyle = (s % 2 === 0) ? '#00e5ff' : '#26c6da';
    ctx.beginPath();
    ctx.moveTo(seg.x - Math.cos(seg.angle) * (segR * 0.4), seg.y - Math.sin(seg.angle) * (segR * 0.4));
    ctx.lineTo(seg.x + Math.cos(normAngle) * finLen, seg.y + Math.sin(normAngle) * finLen);
    ctx.lineTo(seg.x + Math.cos(seg.angle) * (segR * 0.4), seg.y + Math.sin(seg.angle) * (segR * 0.4));
    ctx.closePath();
    ctx.fill();

    ctx.save();
    ctx.translate(seg.x, seg.y);
    ctx.rotate(seg.angle);

    ctx.fillStyle = '#004d40';
    ctx.beginPath();
    ctx.ellipse(0, 0, segR * 1.15, segR * 0.85, 0, 0, Math.PI * 2);
    ctx.fill();
    ctx.strokeStyle = '#00251a';
    ctx.lineWidth = 1.8;
    ctx.stroke();

    ctx.fillStyle = '#00838f';
    ctx.beginPath();
    ctx.ellipse(0, -segR * 0.1, segR * 0.8, segR * 0.55, 0, 0, Math.PI * 2);
    ctx.fill();

    ctx.strokeStyle = '#00e5ff';
    ctx.lineWidth = 1.6;
    ctx.shadowColor = '#00e5ff';
    ctx.shadowBlur = 0; /* 60fps */
    ctx.beginPath();
    ctx.moveTo(-segR * 0.6, 0);
    ctx.lineTo(segR * 0.6, 0);
    ctx.stroke();
    ctx.shadowBlur = 0;

    ctx.restore();
  }
  ctx.restore();
}

