function checkKillStreakHerald(streak) {
  let title = '';
  if (streak === 10) title = 'YİĞİT! (10 SERİ)';
  else if (streak === 25) title = 'ALP! (25 SERİ)';
  else if (streak === 50) title = 'BATUR! (50 SERİ)';
  else if (streak === 100) title = 'BAŞBUĞ! (100 SERİ)';

  if (title) {
    synthBlip('legendary');
    triggerGameHaptics('heavy');
    spawnFloatText(player.x, player.y - 30, title, '#facc15', true);
  }
}

function killEnemy(idx) {
  const en = enemies[idx];
  if (!en || en._dead) return;
  if (_killRecursionDepth > 6) {
    en._dead = true;
    en.hp = 0;
    const ji = enemies.indexOf(en);
    if (ji >= 0) enemies.splice(ji, 1);
    return;
  }
  _killRecursionDepth++;
  try {
    en._dead = true;
    const heat = (typeof getActiveHeat === 'function') ? getActiveHeat() : 0;
    const basePts = en.type==='boss' ? 80+wave*8 : en.type==='tank' ? 18 : 10 + wave;
    const pts = Math.round(basePts * (1 + heat * 0.25));
    if (player && player._transcendenceMode) {
      const tBonus = 1 + Math.max(0, wave - (player._transcendenceStartWave || 20)) * 0.25;
      score += Math.round(pts * tBonus);
    } else {
      score += pts;
    }

    // Ölümsüz Sözleşme (Death Pact): Her 25 öldürmede +%1 hasar (Maks %60)
    if (player && player.mods && player.mods.deathPact) {
      _deathPactKills = (_deathPactKills || 0) + 1;
      if (_deathPactKills % 25 === 0) {
        player._deathPactDmg = Math.min(0.60, (player._deathPactDmg || 0) + 0.01);
        spawnFloatText(player.x, player.y - 30, '💀 Ölümsüz Sözleşme: +%' + Math.round(player._deathPactDmg * 100) + ' Hasar!', '#c084fc');
      }
    }

    // Elite death rewards
    if (en.isElite) {
      if (typeof runStats !== 'undefined') runStats.eliteKills = (runStats.eliteKills || 0) + 1;
      // Extra XP gems
      for (let i = 0; i < 3; i++) {
        xpGems.push({ x: en.x + (Math.random()-0.5)*30, y: en.y + (Math.random()-0.5)*30, vx: (Math.random()-0.5)*3, vy: -2-Math.random()*2, value: 3, life: 1 });
      }
      // Chance for crystal
      if (Math.random() < 0.15 && typeof gainCrystals === 'function') gainCrystals(2, en.x, en.y);
      // Explosion effect if explosive affix
      if (en.eliteAffix && en.eliteAffix.id === 'patlamaci') {
        enemies.forEach(ne => {
          if (ne !== en && !ne._dead && Math.hypot(ne.x - en.x, ne.y - en.y) < 80) {
            takeDamage(ne, Math.round(en.maxHp * 0.3), 'fire', { noReact: true });
          }
        });
        burst(en.x, en.y, '#f59e0b', 20, 5);
        shake = Math.max((typeof shake !== 'undefined' ? shake : 0), 5);
      }
      // Split if splitting affix
      if (en.eliteAffix && en.eliteAffix.id === 'bolunen') {
        for (let i = 0; i < 2; i++) {
          const clone = Object.assign({}, en);
          clone._dead = false;
          clone.isElite = false;
          clone.hp = Math.round(en.maxHp * 0.3);
          clone.maxHp = clone.hp;
          clone.r = Math.max(6, (en.r || 12) - 4);
          clone.x = en.x + (Math.random()-0.5) * 30;
          clone.y = en.y + (Math.random()-0.5) * 30;
          clone.hit = new Set();
          enemies.push(clone);
        }
      }
      burst(en.x, en.y, en.eliteAffix ? en.eliteAffix.color : '#ffd700', 15, 4);
      spawnFloatText(en.x, en.y - 20, 'ELİT!', en.eliteAffix ? en.eliteAffix.color : '#ffd700');
    }

    // STEP 9: Cursed Shrine Elite Guardian Drops
    if (en.isShrineElite) {
      if (typeof spawnGroundDrop === 'function') spawnGroundDrop(en.x, en.y);
      if (typeof gainCrystals === 'function') gainCrystals(12, en.x, en.y);
      spawnFloatText(en.x, en.y - 32, ' MİHRAP MUHAFIZI KATLEDİLDİ!', '#ffd700', 'big');
      if (typeof synthBlip === 'function') synthBlip('legendary');
      playSfx('legendary', 0.5);
    }
    if (typeof runStats !== 'undefined' && runStats) {
      runStats.kills = (runStats.kills || 0) + 1;
      if (typeof updateAchStat === 'function') updateAchStat('totalKills', 1);
      if (en.type === 'boss') runStats.bossKills = (runStats.bossKills || 0) + 1;
      if (en.type === 'elite' && typeof updateAchStat === 'function') updateAchStat('eliteKills', 1);
    }
    if (typeof trackBountyKill === 'function') trackBountyKill(en);
    if (en.type === 'boss' && typeof addHeroMastery === 'function' && selectedHeroId) {
      addHeroMastery(selectedHeroId, 1);
    }
    // STEP 3: Ult Energy on Kills (+3.5 for mob, +25 for boss)
    if (typeof ultEnergy !== 'undefined' && ultEnergy < MAX_ULT_ENERGY) {
      ultEnergy = Math.min(MAX_ULT_ENERGY, ultEnergy + (en.type === 'boss' ? 25 : 3.5));
      if (ultEnergy >= MAX_ULT_ENERGY) {
        spawnFloatText(player.x, player.y - 36, ' KADİM ULTİ HAZIR! ', '#ffd700', 'big');
        synthBlip('legendary');
        playSfx('skill', 0.45, 880);
        vibrate([40, 60, 40]);
      }
      syncUltFab();
    }

    // SCOPE 5: Efsanevi Kan Büyüsü (Blood Pact) Katletmede Can Çalma
    if ((runFlags().bloodPact || (player && player.cursed === 'bloodPact')) && player && player.hp < player.maxHp) {
      player.hp = Math.min(player.maxHp, player.hp + 4.5);
      if (Math.random() < 0.35) {
        spawnFloatText(player.x, player.y - 22, '+4.5 Can', '#22c55e', 'small');
        burst(player.x, player.y, '#ef4444', 4, 1.5);
      }
    }
    killCombo++;
    killComboT = 110;
    if (typeof updateAchStat === 'function') updateAchStat('maxStreak', killCombo, true);
    addFlow(en.type === 'boss' ? 18 : 3);
  const isEnStreak = (typeof getGameLang === 'function' && getGameLang() === 'en');
  if (killCombo === 3) spawnFloatText(en.x, en.y - 28, isEnStreak ? ' TRIPLE STRIKE!' : ' ÜÇLÜ VURUŞ!', '#ffe08a');
  if (killCombo === 5) {
    showStreakBanner(isEnStreak ? ' STREAK UNLEASHED! (x5)' : 'SERİ BAŞLADI! (x5)', '#ff6b4a');
    playSfx('skill', 0.35, 520);
    vibrate([20, 30, 20]);
    addFlow(10);
  } else if (killCombo === 10) {
    showStreakBanner(isEnStreak ? ' ELEMENTAL WRATH! (x10)' : 'ELEMENTEL GAZAP! (x10)', '#facc15');
    playSfx('skill', 0.45, 600);
    vibrate([25, 35]);
    addFlow(16);
  } else if (killCombo === 15) {
    showStreakBanner(isEnStreak ? ' UNSTOPPABLE! (x15)' : 'DURDURULAMAZ! (x15)', '#ff1744');
    playSfx('explode', 0.45, 350);
    vibrate([35, 45]);
    addFlow(22);
  } else if (killCombo === 25) {
    showStreakBanner(isEnStreak ? ' LEGENDARY CATACLYSM! (x25)' : 'EFSANEVİ FELAKET! (x25)', '#ffd700');
    playSfx('skill', 0.6, 750);
    vibrate([50, 70]);
    addFlow(35);
  } else if (killCombo === 50) {
    showStreakBanner(isEnStreak ? ' GOD OF WAR! (x50 )' : 'SAVAŞ TANRISI! (x50 KATLİAM)', '#c084fc');
    playSfx('legendary', 0.75);
    triggerScreenFlash('#c084fc', 0.35, 180);
    vibrate([60, 90, 60]);
    addFlow(50);
    camKick = 8;
  } else if (killCombo === 100) {
    showStreakBanner(isEnStreak ? 'GODLIKE! ×100' : 'TANRISAL! ×100', '#ff00ff');
    triggerScreenFlash('#ff00ff', 0.4, 500);
    burst(player.x, player.y, '#ffd700', 30, 6);
    burst(player.x, player.y, '#ff00ff', 20, 5);
    vibrate([80, 40, 80, 40, 80]);
    if (typeof gainCrystals === 'function') gainCrystals(5, player.x, player.y);
  }
  spawnFloatText(en.x, en.y-16, '+'+pts, '#ffd740');

  // STEP 7: DYNAMIC RESIDUE ON ENEMY DEATH (Environmental Chemistry)
  if (typeof triggerEnvChemistry === 'function' && typeof statusStore !== 'undefined') {
    if (statusStore.has(en, 'burn') || en.affix === 'molten') {
      triggerEnvChemistry(en.x, en.y, 'fire', 36, 1.0);
    } else if (statusStore.has(en, 'shock')) {
      triggerEnvChemistry(en.x, en.y, 'storm', 36, 1.0);
    } else if (statusStore.has(en, 'wet') && Math.random() < 0.35) {
      spawnEnvDebris(en.x, en.y, 'water', 1, 'water_puddle');
    } else if (statusStore.has(en, 'root') && Math.random() < 0.35) {
      spawnEnvDebris(en.x, en.y, 'nature', 1, 'pollen');
    }
  }

  const isBoss = en.type === 'boss';
  const isTank = en.type === 'tank' || en.type === 'armored' || en.type === 'bearer';
  const isFast = en.type === 'fast';
  const isSlime = en.type === 'slime';
  const isShaman = en.type === 'shaman';
  const isShooter = en.type === 'shooter';
  const deathCol = isBoss ? '#ffd740' :
                   isTank ? '#8d6e63' :
                   isFast ? '#00e5ff' :
                   isSlime ? '#4ade80' :
                   isShaman ? '#c084fc' :
                   isShooter ? '#f472b6' : '#ff7b6b';

  burst(en.x, en.y, deathCol, isBoss ? 32 : isTank ? 18 : 10, isBoss ? 5.2 : isFast ? 3.8 : 2.8);
  if (isBoss || isTank) {
    burst(en.x, en.y, '#ffffff', isBoss ? 20 : 8, isBoss ? 4.2 : 2.8);
  }
  splatFloor(en.x, en.y, en.r * (isBoss ? 1.4 : 1.1));
  if (typeof isPactActive === 'function' && isPactActive('volatileEarth') && Math.random() < 0.25) {
    hazards.push({
      x: en.x, y: en.y, r: 24,
      type: 'lava',
      until: performance.now() + 3200
    });
    burst(en.x, en.y, '#ff3d00', 8, 2.2);
  }

  // ELEMENTAL PIXEL GIBS & DEATH DISSOLVE (Retro shattering pixel debris)
  const gibCount = isBoss ? 28 : isTank ? 14 : 6;
  for (let g = 0; g < gibCount; g++) {
    const ga = Math.random() * Math.PI * 2;
    const gSpd = (isBoss ? 3.5 : 2.0) + Math.random() * (isBoss ? 4.5 : 2.5);
    const gRad = 1.2 + Math.random() * 2.0;
    sparks.push({
      x: en.x + (Math.random() - 0.5) * en.r,
      y: en.y + (Math.random() - 0.5) * en.r,
      vx: Math.cos(ga) * gSpd,
      vy: Math.sin(ga) * gSpd - 0.6,
      r: gRad,
      life: 0.8,
      maxLife: 0.8,
      color: (g % 3 === 0) ? '#ffffff' : (g % 2 === 0) ? deathCol : (en.color || '#ff8a80'),
      rot: Math.random() * Math.PI,
      vr: (Math.random() - 0.5) * 0.3
    });
  }
  corpses.push({ x:en.x, y:en.y, r:en.r, life:1, color: visualMode==='ketchup' ? '#7a0b10' : visualMode==='pink' ? '#8e0a3a' : en.type==='boss' ? '#7d6608' : isTank ? '#4e342e' : isSlime ? '#2e7d32' : isShaman ? '#4a148c' : isShooter ? '#6c3483' : '#7b241c' });
  
  // Shockwave ring on enemy death (Boss & Tank only - normal swarmer deaths stay clean)
  if (isBoss || isTank) {
    particles.push({ x: en.x, y: en.y, r: 10, maxR: isBoss ? 150 : 75, life: 1.1, color: deathCol, lw: isBoss ? 6 : 4 });
    particles.push({ x: en.x, y: en.y, r: 6, maxR: isBoss ? 90 : 36, life: 0.9, color: '#ffffff', lw: 2 });
  }
  
  vibrate(isBoss ? [50, 40, 60, 40, 120] : isTank ? [30, 40] : [12]);
  if (isBoss) {
    slowUntil = performance.now() + 450;
    shake = Math.max(shake, 22);
    camKick = Math.max(camKick, 14);
    triggerHitStop(14);
  } else if (isTank) {
    shake = Math.max(shake, 6);
    camKick = Math.max(camKick, 3);
  }
  
  if (isBoss) {
    window.arenaFissures = [];
    hazards = hazards.filter(h => !h.isArenaRing);
    triggerScreenFlash('#ffd740', 0.45, 180);
    playSfx('explode', 0.42, 220);
    particles.push({ x: en.x, y: en.y, life: 1.5, maxLife: 1.5, type: 'mushroom', scale: 2.0 });
    particles.push({ x: en.x, y: en.y, life: 0.85, maxLife: 0.85, type: 'starburst', r: 38, rot: 0 });
    particles.push({ x: en.x, y: en.y, r: 16, maxR: 200, life: 1.3, color: '#ffd740', lw: 8 });
    const isEn = (typeof getGameLang === 'function' && getGameLang() === 'en');
    spawnFloatText(en.x, en.y - 52, isEn ? ' SOVEREIGN FALLEN! ' : ' LORD YIKILDI! ', '#ffd740', 'big');
    if (typeof vacuumAllPickups === 'function') vacuumAllPickups();
    rerollsLeft = (rerollsLeft || 0) + 1;
    if (typeof syncRerollFab === 'function') syncRerollFab();
    spawnFloatText(player.x, player.y - 36, isEn ? ' +1 REROLL REWARD!' : ' +1 YENİDEN SEÇİM HAKKI!', '#38bdf8', 'big');
    if (typeof synthBlip === 'function') synthBlip('sparkle');
    playSfx('explode', 0.32, 350);
    triggerScreenFlash('#ff6b4a', 0.25, 90);
    particles.push({ x: en.x, y: en.y, life: 1.1, maxLife: 1.1, type: 'mushroom', scale: 1.25 });
    particles.push({ x: en.x, y: en.y, life: 0.65, maxLife: 0.65, type: 'starburst', r: 24, rot: 0.4 });
    particles.push({ x:en.x, y:en.y, r:10, maxR:95, life:1, color:'#ff6b4a', lw: 4 });
    burst(en.x, en.y, '#ff6b4a', 20, 4.2);
    if (Math.hypot(en.x-player.x, en.y-player.y) < 78) damagePlayer(6);
    for (let k = 0; k < 4; k++) {
      const ma = k * (Math.PI / 2) + Math.PI / 4;
      enemyProjectiles.push({
        x: en.x, y: en.y,
        vx: Math.cos(ma) * 2.5, vy: Math.sin(ma) * 2.5,
        r: 5.5, dmg: 5, ox: en.x, oy: en.y, maxDist: 110,
        kind: 'magma', rot: 0
      });
    }
  } else if (isSlime) {
    playSfx('bubble', 0.38, 280);
    burst(en.x, en.y, '#22c55e', 18, 3.2);
    hazards.push({ x: en.x, y: en.y, r: 26, type: 'slime', until: performance.now() + 3500 });
  } else if (isTank) {
    playSfx('explode', 0.28, 170);
    shake = Math.max(shake, 9);
    particles.push({ x: en.x, y: en.y, life: 0.7, maxLife: 0.7, type: 'starburst', r: 26, rot: Math.random() * 6.28 });
    burst(en.x, en.y, '#5d4037', 18, 3.8);
    burst(en.x, en.y, '#ffd54f', 10, 2.8);
  } else if (isFast) {
    playSfx('skill2', 0.25, 520);
    burst(en.x, en.y, '#facc15', 14, 4.2);
  } else if (isShaman) {
    playSfx('skill', 0.30, 440);
    particles.push({ x: en.x, y: en.y, r: 8, maxR: 90, life: 1.1, color: '#c084fc', lw: 3.5 });
  } else {
    playSfx('kill', 0.24, 180 + Math.random() * 40);
  }
  if (modLv('chainExplode')) {
    burst(en.x, en.y, '#ff4500', 16, 3.5);
    playSfx('explode', 0.35);
    const toBoom = [];
    for (let k = 0; k < enemies.length; k++) {
      const other = enemies[k];
      if (!other || other === en || other._dead) continue;
      if (Math.hypot(other.x - en.x, other.y - en.y) <= 90 + other.r) {
        takeDamage(other, 30, 'fire');
        if (other.hp <= 0) toBoom.push(other);
      }
    }
    toBoom.forEach(o => { const j = enemies.indexOf(o); if (j >= 0) killEnemy(j); });
  }

  // AYAZ HAN PASİFİ: Mutlak Sıfır (Shatter)
  const isAyaz = (player && (player.heroId === 'ayaz' || selectedHeroId === 'ayaz'));
  const isEnFrozen = (typeof statusStore !== 'undefined' && statusStore && statusStore.has(en, 'freeze')) || en.frozen || (en.freezeUntil && en.freezeUntil > performance.now());
  if (isAyaz && isEnFrozen) {
    burst(en.x, en.y, '#00e5ff', 24, 4.2);
    burst(en.x, en.y, '#ffffff', 14, 2.8);
    if (typeof synthBlip === 'function') synthBlip('elem_water');
    if (typeof playPunchySubBass === 'function') playPunchySubBass(160, 0.22, 0.45);
    const isEnLang = (typeof getGameLang === 'function' && getGameLang() === 'en');
    spawnFloatText(en.x, en.y - 32, isEnLang ? ' ABSOLUTE ZERO!' : ' MUTLAK SIFIR!', '#00e5ff', 'big');
    shake = Math.max(shake, 8);
    const toShatter = [];
    const shatterR = 125;
    for (let k = 0; k < enemies.length; k++) {
      const other = enemies[k];
      if (!other || other === en || other._dead || other.hp <= 0) continue;
      const maxR = shatterR + (other.r || 12);
      const odx = other.x - en.x, ody = other.y - en.y;
      if (Math.abs(odx) > maxR || Math.abs(ody) > maxR) continue;
      if (odx * odx + ody * ody <= maxR * maxR) {
        takeDamage(other, Math.round(28 + wave * 3.5), 'ice');
        if (typeof statusStore !== 'undefined' && statusStore && typeof statusStore.add === 'function') {
          statusStore.add(other, 'freeze', 160, 1);
        } else {
          other.frozen = true;
          other.freezeUntil = performance.now() + 2800;
        }
        if (other.hp <= 0) toShatter.push(other);
      }
    }
    toShatter.forEach(o => { const j = enemies.indexOf(o); if (j >= 0) killEnemy(j); });
  }

  if (modLv('midas')) {
    gainCrystals(1, en.x, en.y);
    spawnXpGems(en.x, en.y, 1, 2);
  }
  if (modLv('clover') && Math.random() < 0.12) {
    if (Math.random() < 0.5) {
      spawnGroundOrb(en.x, en.y);
      spawnFloatText(en.x, en.y - 18, ' Can İksiri!', '#4ade80');
    } else {
      gainCrystals(1, en.x, en.y);
      spawnFloatText(en.x, en.y - 18, ' Şanslı Kristal!', '#ffd700');
    }
    vibrate('light');
  }
  const isTanky = en.type === 'tank' || en.type === 'armored' || en.type === 'bearer' || en.type === 'golem' || en.type === 'behemoth' || en.isElite;
  const isEarlyRun = (wave === 1 && player && player.level <= 2);
  const gemCount = isBoss ? 3 : isTanky ? 2 : (isEarlyRun ? 2 : 1);
  const waveScaling = 1 + Math.max(0, (wave || 1) - 1) * 0.08;
  const baseGemVal = isBoss ? 12 : isTanky ? 8 : (en.type === 'swarmer' ? 3 : (isEarlyRun ? 9 : 5));
  const gemVal = Math.round(baseGemVal * waveScaling);
  spawnXpGems(en.x, en.y, gemCount, gemVal, isBoss);

  // Boss öldüğünde efsanevi ganimet sandığı ve şifa küresi düşer!
