    }

    if (weaveNear && weavePts[0]) {
      ctx.globalAlpha = 0.55 + Math.sin(time * 0.25) * 0.3;
      ctx.strokeStyle = '#ffe08a';
      ctx.lineWidth = 2.5;
      ctx.beginPath(); ctx.arc(weavePts[0].x, weavePts[0].y, 18, 0, Math.PI * 2); ctx.stroke();
