// ── 5. HİLAL SU / DALGA BIÇAĞI (Image 3: Crescent Water Slash Blade) ──
function drawPixelWaterSlash(x, y, ang, r, alpha) {
  ctx.save();
  ctx.translate(Math.round(x), Math.round(y));
  ctx.rotate(ang || 0);
  ctx.globalAlpha = alpha != null ? alpha : 1;
  const rad = Math.max(16, r || 22);

  ctx.fillStyle = '#0284c7';
  ctx.beginPath();
  ctx.arc(0, 0, rad, -Math.PI * 0.45, Math.PI * 0.45);
  ctx.quadraticCurveTo(rad * 0.35, 0, Math.cos(-Math.PI * 0.45) * rad, Math.sin(-Math.PI * 0.45) * rad);
  ctx.closePath();
  ctx.fill();

  ctx.fillStyle = '#38bdf8';
  ctx.beginPath();
  ctx.arc(0, 0, rad * 0.88, -Math.PI * 0.40, Math.PI * 0.40);
  ctx.quadraticCurveTo(rad * 0.45, 0, Math.cos(-Math.PI * 0.40) * rad * 0.88, Math.sin(-Math.PI * 0.40) * rad * 0.88);
  ctx.closePath();
  ctx.fill();

  ctx.fillStyle = '#ffffff';
  ctx.beginPath();
  ctx.arc(0, 0, rad * 0.76, -Math.PI * 0.32, Math.PI * 0.32);
  ctx.quadraticCurveTo(rad * 0.58, 0, Math.cos(-Math.PI * 0.32) * rad * 0.76, Math.sin(-Math.PI * 0.32) * rad * 0.76);
  ctx.closePath();
  ctx.fill();

  ctx.fillStyle = '#bae6fd';
  const tip1X = Math.cos(-Math.PI * 0.45) * rad;
  const tip1Y = Math.sin(-Math.PI * 0.45) * rad;
  const tip2X = Math.cos(Math.PI * 0.45) * rad;
  const tip2Y = Math.sin(Math.PI * 0.45) * rad;
  ctx.fillRect(tip1X - 3, tip1Y - 4, 3, 3);
  ctx.fillRect(tip1X + 2, tip1Y - 6, 2, 2);
  ctx.fillRect(tip2X - 3, tip2Y + 2, 3, 3);
  ctx.fillRect(tip2X + 2, tip2Y + 4, 2, 2);
  ctx.fillRect(rad + 4, -2, 3, 3);
  ctx.fillRect(rad + 8, 3, 2, 2);

  ctx.restore();
}

