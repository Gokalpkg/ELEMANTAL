function markComboSeen(key) {
  if (!key) return;
  const m = loadMeta();
  m.seenCombos = m.seenCombos || [];
  if (m.seenCombos.indexOf(key) < 0) {
    m.seenCombos.push(key);
    saveMeta(m);
  }
}
function hasSeenCombo(key) {
  const m = loadMeta();
  return !!(m.seenCombos && m.seenCombos.indexOf(key) >= 0);
}
function ownedComboKeys() {
  return (lockedCombos || []).map(c => c.key).filter(Boolean);
}
function sigEligibleForBuild() {
  const kinds = new Set((lockedCombos || []).map(c => c.kind));
  const puffs = (lockedCombos || []).some(c => c.extra && c.extra.puff);
  return SIGNATURES.filter(s => {
    if (!s.need) return true;
    if (s.need === 'puff') return puffs;
    return kinds.has(s.need);
  });
}
function sigHintForCombo(combo) {
  if (!combo) return [];
  const out = [];
  SIGNATURES.forEach(s => {
    if (!s.need) return;
    if (s.need === 'puff' && combo.extra && combo.extra.puff) out.push(s);
    else if (s.need === combo.kind) out.push(s);
  });
  return out;
}
