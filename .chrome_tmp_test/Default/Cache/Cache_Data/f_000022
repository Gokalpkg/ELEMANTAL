    ctx.arc(cx, cy, w * 0.32, 0, Math.PI * 2);
    ctx.stroke();
    // 'M' emblem
    ctx.fillStyle = '#d50000';
    ctx.font = 'bold 12px sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText('M', cx, cy);
  } else if (o.kind === 'diner_counter') {
    // BİSTRO TEZGAHI (Ketçap Salonu Solid)
    ctx.fillStyle = '#212121';
    ctx.fillRect(x, y + h - 6, w, d + 6);
    ctx.fillStyle = '#c62828';
    ctx.fillRect(x, y + 8, w, h - 14);
    // Checkered border on top
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(x, y, w, 8);
    ctx.fillStyle = '#212121';
    for (let ci = 0; ci < w; ci += 8) {
      ctx.fillRect(x + ci, y, 4, 8);
    }
  } else if (o.kind === 'tesla_pylon') {
    // TESLA PARATONERİ (Fırtına Tepesi)
    ctx.fillStyle = '#263238';
    ctx.fillRect(cx - 4, y + 8, 8, h - 12);
    // Copper coils
    ctx.fillStyle = '#ff8f00';
    for (let cy_i = y + 10; cy_i < y + h - 10; cy_i += 7) {
      ctx.fillRect(cx - 7, cy_i, 14, 3);
    }
    // Conductive silver sphere on top
    ctx.fillStyle = '#eceff1';
    ctx.beginPath();
    ctx.arc(cx, y + 6, 7, 0, Math.PI * 2);
    ctx.fill();
    // Electric discharge arc
    ctx.strokeStyle = '#00e5ff';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(cx - 8, y + 2);
    ctx.lineTo(cx, y + 6);
    ctx.lineTo(cx + 8, y + 3);
    ctx.stroke();
  } else if (o.kind === 'fulgurite') {
    // FULGURİT CAM DİKİTİ (Fırtına Tepesi)
    ctx.fillStyle = '#fbc02d';
    ctx.beginPath();
    ctx.moveTo(cx, y - 6);
    ctx.lineTo(x + w, y + h);
    ctx.lineTo(x, y + h);
    ctx.closePath();
    ctx.fill();
    ctx.fillStyle = '#fff9c4';
    ctx.beginPath();
    ctx.moveTo(cx, y - 4);
    ctx.lineTo(cx + 3, y + h - 6);
    ctx.lineTo(cx - 4, y + h - 6);
    ctx.closePath();
    ctx.fill();
  } else if (o.kind === 'thunder_spire') {
    // FIRTINA MONOLİTİ (Fırtına Tepesi Solid)
    ctx.fillStyle = '#10101a';
    ctx.fillRect(x, y + h - 6, w, d + 6);
    ctx.fillStyle = '#1e1e2f';
    ctx.fillRect(x, y, w, h - 6);
    // Electric blue lightning bolt
    ctx.strokeStyle = '#ffd600';
    ctx.lineWidth = 2.5;
    ctx.beginPath();
    ctx.moveTo(cx + 2, y + 4);
    ctx.lineTo(cx - 4, cy);
    ctx.lineTo(cx + 4, cy + 2);
    ctx.lineTo(cx - 2, y + h - 12);
    ctx.stroke();
  } else if (o.kind === 'glacier_shard') {
    // SİVRİ BUZUL DİKİTİ (Buz Geçidi)
    ctx.fillStyle = '#0288d1';
    ctx.beginPath();
    ctx.moveTo(cx, y - 8);
    ctx.lineTo(x + w, y + h);
    ctx.lineTo(x, y + h);
    ctx.closePath();
    ctx.fill();
    ctx.fillStyle = '#81d4fa';
    ctx.beginPath();
    ctx.moveTo(cx, y - 8);
    ctx.lineTo(cx, y + h);
    ctx.lineTo(x, y + h);
    ctx.closePath();
    ctx.fill();
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(cx - 1, y - 6, 2, h * 0.4);
  } else if (o.kind === 'ice_fossil') {
    // DONMUŞ FOSİL (Buz Geçidi)
    ctx.fillStyle = '#29b6f6';
    ctx.fillRect(x, y, w, h);
    ctx.strokeStyle = '#e1f5fe';
    ctx.lineWidth = 1.5;
    ctx.strokeRect(x + 2, y + 2, w - 4, h - 4);
    // Amber fossil silhouette
    ctx.fillStyle = '#ff8f00';
    ctx.beginPath();
    ctx.arc(cx, cy, 6, 0, Math.PI * 2);
    ctx.fill();
  } else if (o.kind === 'permafrost_pillar') {
    // EBEDİ BUZ SÜTUNU (Buz Geçidi Solid)
    ctx.fillStyle = '#01579b';
    ctx.fillRect(x, y + h - 6, w, d + 6);
    ctx.fillStyle = '#0288d1';
    ctx.fillRect(x, y + 6, w, h - 12);
    // Snow cap on top
    ctx.fillStyle = '#ffffff';
    ctx.beginPath();
    ctx.roundRect(x - 2, y, w + 4, 10, [5, 5, 0, 0]);
    ctx.fill();
  } else if (o.kind === 'desert_cactus') {
    // DEV ÇÖL KAKTÜSÜ (Kum Ovası)
    const cw = w * 0.36;
    ctx.fillStyle = '#2e7d32';
    // Main trunk
    ctx.beginPath();
    ctx.roundRect(cx - cw / 2, y + 2, cw, h + 2, [cw / 2, cw / 2, 2, 2]);
    ctx.fill();
    // Left branch arm
    ctx.fillRect(cx - cw * 1.4, cy - 2, cw, 5);
    ctx.fillRect(cx - cw * 1.4, cy - 10, 5, 10);
    // Right branch arm
    ctx.fillRect(cx + cw * 0.4, cy + 2, cw, 5);
    ctx.fillRect(cx + cw * 1.2, cy - 6, 5, 10);
    // Yellow prickles
    ctx.fillStyle = '#fff59d';
    ctx.fillRect(cx - 2, y + 10, 1.5, 1.5);
    ctx.fillRect(cx + 1, y + 18, 1.5, 1.5);
    ctx.fillRect(cx - 2, y + 26, 1.5, 1.5);
    // Red blossom on top
    ctx.fillStyle = '#e91e63';
    ctx.beginPath();
    ctx.arc(cx, y + 2, 3, 0, Math.PI * 2);
    ctx.fill();
  } else if (o.kind === 'sandstone_obelisk') {
    // KUMTAŞI HİYEROGLİF OBELİSKİ (Kum Ovası)
    ctx.fillStyle = '#6d4c41';
    ctx.fillRect(x, y + h - 6, w, d + 6);
    ctx.fillStyle = '#d7ccc8';
    ctx.fillRect(x, y + 6, w, h - 12);
    // Pyramidion top
    ctx.fillStyle = '#ffb300';
    ctx.beginPath();
    ctx.moveTo(cx, y - 6);
    ctx.lineTo(x + w, y + 6);
    ctx.lineTo(x, y + 6);
    ctx.closePath();
    ctx.fill();
    // Hieroglyphic glyphs
    ctx.fillStyle = '#8d6e63';
    ctx.font = 'bold 10px sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.fillText('𓀀', cx, cy - 6);
    ctx.fillText('𓃠', cx, cy + 8);
  } else if (o.kind === 'behemoth_skull') {
    // KADİM CANAVAR KAFATASI (Kum Ovası Solid)
    ctx.fillStyle = '#3e2723';
    ctx.fillRect(x, y + h - 6, w, d + 6);
    ctx.fillStyle = '#efebe9';
    ctx.beginPath();
    ctx.ellipse(cx, cy, w * 0.44, h * 0.42, 0, 0, Math.PI * 2);
    ctx.fill();
    // Horns
    ctx.strokeStyle = '#d7ccc8';
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.moveTo(cx - 10, cy - 6);
    ctx.quadraticCurveTo(x - 4, y - 4, x, y + 12);
    ctx.moveTo(cx + 10, cy - 6);
    ctx.quadraticCurveTo(x + w + 4, y - 4, x + w, y + 12);
    ctx.stroke();
    // Eye sockets
    ctx.fillStyle = '#212121';
    ctx.beginPath();
    ctx.arc(cx - 6, cy, 3, 0, Math.PI * 2);
    ctx.arc(cx + 6, cy, 3, 0, Math.PI * 2);
    ctx.fill();
  } else if (o.kind === 'void_altar') {
    // HİÇLİK SUNAĞI (Gece Harabesi)
    ctx.fillStyle = '#0a0512';
    ctx.fillRect(x, y + h - 6, w, d + 6);
    ctx.fillStyle = '#1f132e';
    ctx.fillRect(x, y + 10, w, h - 16);
    ctx.fillStyle = '#392154';
    ctx.fillRect(x + 2, y + 8, w - 4, 6);
    // Levitating violet void flame / orb
    ctx.fillStyle = '#ba68c8';
    ctx.shadowColor = '#e040fb';
    ctx.shadowBlur = 0; /* 60fps */
    ctx.beginPath();
    ctx.arc(cx, y + 2, 6, 0, Math.PI * 2);
    ctx.fill();
    ctx.shadowBlur = 0;
  } else if (o.kind === 'shadow_crypt') {
    // GÖLGE LAHDİ (Gece Harabesi)
    ctx.fillStyle = '#100a18';
    ctx.fillRect(x, y + h - 6, w, d + 6);
    ctx.fillStyle = '#2a1a38';
    ctx.beginPath();
    ctx.roundRect(x + 2, y + 2, w - 4, h - 6, [8, 8, 2, 2]);
    ctx.fill();
    // Skull or cross engraving
    ctx.strokeStyle = '#ab47bc';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(cx, cy - 6); ctx.lineTo(cx, cy + 6);
    ctx.moveTo(cx - 5, cy - 2); ctx.lineTo(cx + 5, cy - 2);
    ctx.stroke();
  } else if (o.kind === 'gothic_spire') {
    // GOTİK KATEDRAL SÜTUNU (Gece Harabesi Solid)
    ctx.fillStyle = '#0b0610';
    ctx.fillRect(x, y + h - 6, w, d + 6);
    ctx.fillStyle = '#180f24';
    ctx.fillRect(x, y + 8, w, h - 14);
    // Tall pointed pinnacle
    ctx.fillStyle = '#2c1942';
    ctx.beginPath();
    ctx.moveTo(cx, y - 8);
    ctx.lineTo(x + w - 2, y + 8);
    ctx.lineTo(x + 2, y + 8);
    ctx.closePath();
    ctx.fill();
  } else if (o.kind === 'barrel') {
    // PATLAYICI KIRMIZI VARİL
    ctx.fillStyle = '#b71c1c';
    ctx.beginPath();
    ctx.ellipse(cx, cy, w * 0.46, h * 0.52, 0, 0, Math.PI * 2);
    ctx.fill();
    ctx.strokeStyle = '#212121';
    ctx.lineWidth = 2.5;
    ctx.stroke();
    // Metal rims
    ctx.strokeStyle = '#ff8f00';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.arc(cx, cy, w * 0.32, 0, Math.PI * 2);
    ctx.stroke();
    // Danger flame symbol
    ctx.fillStyle = '#ffeb3b';
    ctx.font = 'bold 12px sans-serif';
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    
    // PROCEDURAL PIXEL FLAME DRAW (Zero emoji)
    ctx.fillStyle = '#dc2626';
    ctx.fillRect(cx - 6, cy - 8, 12, 16);
    ctx.fillStyle = '#f97316';
    ctx.fillRect(cx - 4, cy - 5, 8, 11);
    ctx.fillStyle = '#fde047';
    ctx.fillRect(cx - 2, cy - 2, 4, 6);
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(cx - 1, cy - 1, 2, 3);

  } else if (o.kind === 'vase') {
    // ANTİK ALTIN VAZO
    ctx.fillStyle = '#fbc02d';
    ctx.beginPath();
    ctx.ellipse(cx, cy + 2, w * 0.42, h * 0.48, 0, 0, Math.PI * 2);
    ctx.fill();
    ctx.strokeStyle = '#fff9c4';
    ctx.lineWidth = 2;
    ctx.stroke();
    // Handles
    ctx.fillStyle = '#f57f17';
    ctx.fillRect(cx - 5, cy - h * 0.45, 10, 5);
    ctx.strokeStyle = '#ffd54f';
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.arc(cx - w * 0.35, cy, 4, 0, Math.PI * 2);
    ctx.arc(cx + w * 0.35, cy, 4, 0, Math.PI * 2);
    ctx.stroke();
  } else {
    // Standart / Genel 3D Blok
    const top = visHex(biome.accent || '#6a5a4e', 'floor');
    const front = visHex('#263238', 'floor');
    ctx.fillStyle = front;
    ctx.fillRect(x, y + 8, w, h - 8);
    ctx.fillStyle = top;
    ctx.beginPath();
    ctx.roundRect(x, y, w, 10, 3);
    ctx.fill();
  }

  // Draw fracture cracks across damaged obstacles
  if (isDamaged) {
    ctx.strokeStyle = 'rgba(0,0,0,0.55)';
    ctx.lineWidth = 2;
    ctx.beginPath();
    ctx.moveTo(x + w * 0.25, y + 6);
    ctx.lineTo(cx, cy);
    ctx.lineTo(x + w * 0.78, y + h * 0.65);
    ctx.stroke();
  }
}

function glowCircle(x, y, r, color, alpha) {
  ctx.save();
  ctx.globalAlpha = alpha;
  pixDisk(x, y, r, shadeHex(color, 55), color, shadeHex(color, -60));
  ctx.restore();
}
function drawPixSprite(x, y, ang, cells, pal) {
  ctx.save();
  ctx.translate(Math.round(x), Math.round(y));
  ctx.rotate(ang || 0);
  const P = 2;
  cells.forEach(c => {
    ctx.fillStyle = pal[c[2]] || pal[0];
    ctx.fillRect(c[0] * P, c[1] * P, P, P);
  });
  ctx.restore();
}

// ── 1. DÖNEN FASETLİ KAYA METEORU / MERMİSİ (Image 1: Top Rock Boulder) ──
function drawFacetedRockBoulder(x, y, ang, r, c) {
  ctx.save();
  ctx.translate(Math.round(x), Math.round(y));
  ctx.rotate(ang || 0);

  const rad = Math.max(7, r || 10);
  const s = rad / 10;

  // Gölge & Dış Gövde Fasetleri (Koyu Umber & Taş Kahvesi)
  ctx.fillStyle = '#3e2723';
  ctx.beginPath();
  ctx.moveTo(0 * s, -10 * s);
  ctx.lineTo(8 * s, -4 * s);
  ctx.lineTo(10 * s, 4 * s);
  ctx.lineTo(3 * s, 10 * s);
  ctx.lineTo(-7 * s, 8 * s);
  ctx.lineTo(-10 * s, -2 * s);
  ctx.closePath();
  ctx.fill();

  // Orta Gövde Faset (Ilık Toprak)
  ctx.fillStyle = '#795548';
  ctx.beginPath();
  ctx.moveTo(-1 * s, -8 * s);
  ctx.lineTo(6 * s, -3 * s);
  ctx.lineTo(4 * s, 4 * s);
  ctx.lineTo(-4 * s, 5 * s);
  ctx.lineTo(-7 * s, -1 * s);
  ctx.closePath();
  ctx.fill();

  // Işık Alan Sol/Üst Faset (Sıcak Toprak / Hardal Sarısı)
  ctx.fillStyle = '#bcaaa4';
  ctx.beginPath();
  ctx.moveTo(-1 * s, -8 * s);
  ctx.lineTo(2 * s, -7 * s);
  ctx.lineTo(0 * s, -1 * s);
  ctx.lineTo(-6 * s, -2 * s);
  ctx.closePath();
  ctx.fill();

  // Keskin Sırt Işıltısı (Specular Ridge)
  ctx.fillStyle = '#ffecb3';
  ctx.fillRect(-2 * s, -7 * s, 2 * s, 2 * s);
  ctx.fillRect(3 * s, -4 * s, 2 * s, 2 * s);

  // Kaya etrafındaki küçük yüzen çakıl kırıntıları
  ctx.fillStyle = '#8d6e63';
  ctx.fillRect(-12 * s, 6 * s, 2 * s, 2 * s);
  ctx.fillRect(11 * s, -7 * s, 2 * s, 2 * s);
  ctx.fillRect(8 * s, 9 * s, 1.5 * s, 1.5 * s);

  // Kırmızı/altın kor kıvılcım noktaları
  ctx.fillStyle = '#ff9800';
  ctx.fillRect(-4 * s, 2 * s, 1.5 * s, 1.5 * s);

  ctx.restore();
}

// ── 2. TEKTONİK KAYA SÜTUNU & İKİZ DİKİTLER (Image 1: Bottom Left & Right) ──
function drawPixelRockSpire(x, y, scale, seed, alpha) {
  ctx.save();
  ctx.translate(Math.round(x), Math.round(y));
  ctx.globalAlpha = alpha != null ? alpha : 1;
  const s = (scale || 1) * 1.25;
  const isTwin = (Math.floor(seed || 0) % 2 === 1);

  if (isTwin) {
    // ── İKİZ KRİSTAL KAYA DİKİTLERİ (Image 1: Sağ Alt) ──
    ctx.fillStyle = 'rgba(28, 25, 23, 0.75)';
    ctx.beginPath();
    ctx.ellipse(0, 2 * s, 18 * s, 6 * s, 0, 0, Math.PI * 2);
    ctx.fill();

    // Sol Ana Kule (Gölge sağ taraf)
    ctx.fillStyle = '#5d4037';
    ctx.beginPath();
    ctx.moveTo(3 * s, -32 * s);
    ctx.lineTo(6 * s, 0);
    ctx.lineTo(-14 * s, 0);
    ctx.closePath();
    ctx.fill();

    // Sol Ana Kule (Işıklı sol taraf)
    ctx.fillStyle = '#a1887f';
    ctx.beginPath();
    ctx.moveTo(3 * s, -32 * s);
    ctx.lineTo(-4 * s, -14 * s);
    ctx.lineTo(-14 * s, 0);
    ctx.lineTo(-3 * s, 0);
    ctx.closePath();
    ctx.fill();

    // Sol Ana Kule Parlak Sırt
    ctx.fillStyle = '#d7ccc8';
    ctx.beginPath();
    ctx.moveTo(3 * s, -32 * s);
    ctx.lineTo(0 * s, -16 * s);
    ctx.lineTo(-3 * s, 0);
    ctx.closePath();
    ctx.fill();

    // Sağ İkincil Kule
    ctx.fillStyle = '#3e2723';
    ctx.beginPath();
    ctx.moveTo(12 * s, -26 * s);
    ctx.lineTo(17 * s, 0);
    ctx.lineTo(2 * s, 0);
    ctx.closePath();
    ctx.fill();

    ctx.fillStyle = '#8d6e63';
    ctx.beginPath();
    ctx.moveTo(12 * s, -26 * s);
    ctx.lineTo(7 * s, -12 * s);
    ctx.lineTo(2 * s, 0);
    ctx.closePath();
    ctx.fill();

    // Sırt Işıltısı
    ctx.fillStyle = '#ffecb3';
    ctx.fillRect(2 * s, -30 * s, 2 * s, 3 * s);
    ctx.fillRect(11 * s, -24 * s, 2 * s, 2 * s);

    // Taban çakıl ve taş blokları
    ctx.fillStyle = '#6d4c41';
    ctx.fillRect(-12 * s, -3 * s, 5 * s, 4 * s);
    ctx.fillRect(11 * s, -4 * s, 6 * s, 5 * s);
  } else {
    // ── AÇILI TEKTONİK KAYA RAMPASI & KAYA FIRLAMASI (Image 1: Sol Alt) ──
    const dir = ((seed * 10) % 2 === 0) ? 1 : -1;
    ctx.scale(dir, 1);

    // Taban duman / toz bulutları
    ctx.fillStyle = '#706558';
    ctx.beginPath();
    ctx.arc(-14 * s, 0, 7 * s, 0, Math.PI * 2);
    ctx.arc(-8 * s, -3 * s, 6 * s, 0, Math.PI * 2);
    ctx.arc(10 * s, -1 * s, 6 * s, 0, Math.PI * 2);
    ctx.fill();

    // Taban zemin kırılma alevi / sarı kor kıvılcımları
    ctx.fillStyle = '#ff9800';
    ctx.beginPath();
    ctx.moveTo(-10 * s, 2 * s);
    ctx.lineTo(-4 * s, -7 * s);
    ctx.lineTo(4 * s, 2 * s);
    ctx.lineTo(10 * s, -6 * s);
    ctx.lineTo(15 * s, 3 * s);
    ctx.lineTo(-10 * s, 3 * s);
    ctx.closePath();
    ctx.fill();

    ctx.fillStyle = '#ffd54f';
    ctx.beginPath();
    ctx.moveTo(-6 * s, 2 * s);
    ctx.lineTo(-2 * s, -4 * s);
    ctx.lineTo(3 * s, 2 * s);
    ctx.lineTo(8 * s, -3 * s);
    ctx.lineTo(12 * s, 2 * s);
    ctx.closePath();
    ctx.fill();

    // Ana Açılı Kaya Sütunu (45 Derece Yukarı & İleri Fırlayan Sivri Monolit)
    ctx.fillStyle = '#3e2723';
    ctx.beginPath();
    ctx.moveTo(-18 * s, -28 * s);
    ctx.lineTo(6 * s, 0);
    ctx.lineTo(-10 * s, 2 * s);
    ctx.closePath();
    ctx.fill();

    ctx.fillStyle = '#795548';
    ctx.beginPath();
    ctx.moveTo(-18 * s, -28 * s);
    ctx.lineTo(-2 * s, -10 * s);
    ctx.lineTo(2 * s, 0);
    ctx.lineTo(-8 * s, 0);
    ctx.closePath();
    ctx.fill();

    ctx.fillStyle = '#b08968';
    ctx.beginPath();
    ctx.moveTo(-18 * s, -28 * s);
    ctx.lineTo(-12 * s, -18 * s);
    ctx.lineTo(-4 * s, -16 * s);
    ctx.lineTo(-14 * s, 0);
    ctx.closePath();
    ctx.fill();

    ctx.fillStyle = '#ffecb3';
    ctx.beginPath();
    ctx.moveTo(-18 * s, -28 * s);
    ctx.lineTo(-14 * s, -20 * s);
    ctx.lineTo(-11 * s, -20 * s);
    ctx.closePath();
    ctx.fill();

    // Uçuşan taş parçaları
    ctx.fillStyle = '#5d4037';
    ctx.fillRect(-12 * s, -4 * s, 5 * s, 4 * s);
    ctx.fillRect(8 * s, -6 * s, 4 * s, 4 * s);
    ctx.fillRect(-22 * s, -20 * s, 3 * s, 3 * s);
    ctx.fillStyle = '#d7ccc8';
    ctx.fillRect(-22 * s, -20 * s, 1.5 * s, 1.5 * s);
  }

  ctx.restore();
}

// ── 3. KRİSTAL BUZ İĞNESİ & BUZUL RAMPASI (Image 5: Crystal Ice Spires) ──
function drawPixelIceSpire(x, y, scale, seed, alpha) {
  ctx.save();
  ctx.translate(Math.round(x), Math.round(y));
  ctx.globalAlpha = alpha != null ? alpha : 1;
  const s = (scale || 1) * 1.3;
  const isGlacier = (Math.floor(seed || 0) % 2 === 1);

  if (isGlacier) {
    // ── AÇILI BUZUL RAMPASI & KARLI BUZ DİKENİ (Image 5: Sağ) ──
    const dir = ((seed * 10) % 2 === 0) ? 1 : -1;
    ctx.scale(dir, 1);

    ctx.fillStyle = 'rgba(3, 105, 161, 0.4)';
    ctx.beginPath();
    ctx.ellipse(0, 2 * s, 16 * s, 5 * s, 0, 0, Math.PI * 2);
    ctx.fill();

    ctx.fillStyle = '#0284c7';
    ctx.beginPath();
    ctx.moveTo(14 * s, -30 * s);
    ctx.lineTo(16 * s, 0);
    ctx.lineTo(-12 * s, 0);
    ctx.closePath();
    ctx.fill();

    ctx.fillStyle = '#38bdf8';
    ctx.beginPath();
    ctx.moveTo(14 * s, -30 * s);
    ctx.lineTo(4 * s, -14 * s);
    ctx.lineTo(-6 * s, 0);
    ctx.lineTo(8 * s, 0);
    ctx.closePath();
    ctx.fill();

    ctx.fillStyle = '#ffffff';
    ctx.beginPath();
    ctx.moveTo(14 * s, -30 * s);
    ctx.lineTo(8 * s, -22 * s);
    ctx.lineTo(-4 * s, -8 * s);
    ctx.lineTo(2 * s, -6 * s);
    ctx.lineTo(12 * s, -20 * s);
    ctx.closePath();
    ctx.fill();

    ctx.fillStyle = '#e0f2fe';
    ctx.fillRect(13 * s, -28 * s, 2 * s, 2 * s);
    ctx.fillRect(-2 * s, -14 * s, 2 * s, 2 * s);

  } else {
    // ── DİKEY İĞNE KRİSTAL BUZ SÜTUNU & PARILTI YILDIZLARI (Image 5: Orta) ──
    ctx.fillStyle = '#0284c7';
    ctx.beginPath();
