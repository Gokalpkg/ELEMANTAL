  for (let i = 0, j = pts.length - 1; i < pts.length; j = i++) {
    const xi = pts[i].x, yi = pts[i].y, xj = pts[j].x, yj = pts[j].y;
    if (((yi > y) !== (yj > y)) && (x < (xj - xi) * (y - yi) / ((yj - yi) || 1e-9) + xi)) inside = !inside;
  }
  return inside;
}
function closeWeave(poly) {
  const area = polyArea(poly);
  let cx = 0, cy = 0;
  poly.forEach(p => { cx += p.x; cy += p.y; });
  cx /= poly.length; cy /= poly.length;
  let nHit = 0;
  enemies.forEach(en => { if (pointInPoly(en.x, en.y, poly)) nHit++; });
  spawnFloatText(cx, cy - 16, nHit >= 3 ? 'Kafes!' : 'İlmek!', '#ff8a65');
  playSfx('skill', 0.32);
  shake = Math.max(shake, nHit >= 3 ? 11 : 7);
  burst(cx, cy, '#ff6b4a', 16, 3.2);
  weaveFires.push({ poly, life: 1.2, cx, cy, r: Math.sqrt(area / Math.PI) });
  enemies.forEach(en => {
    if (!pointInPoly(en.x, en.y, poly)) return;
    const dealt = takeDamage(en, 14 + Math.floor(wave * 0.7) + (nHit >= 3 ? 6 : 0), 'fire');
    spawnFloatText(en.x, en.y - 10, '-' + dealt, '#ff6b4a');
