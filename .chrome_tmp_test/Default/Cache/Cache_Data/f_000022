// --- EVRENSEL DOKUNMATİK VE BUTON YÖNETİMİ (UNIFIED TOUCH & BUTTON BINDINGS) ---
function bindTouchButton(el, callback, options = {}) {
  if (!el) return;
  el.style.touchAction = 'manipulation';
  el.style.webkitUserSelect = 'none';
  el.style.userSelect = 'none';

  let startX = 0, startY = 0, startTime = 0;
  let lastTrigger = 0;

  const triggerAction = (e) => {
    const now = Date.now();
    if (now - lastTrigger < 160) return;
    lastTrigger = now;
    if (e && e.cancelable && e.type !== 'click') {
      try { e.preventDefault(); } catch (_) {}
    }
    if (e && e.stopPropagation) {
      try { e.stopPropagation(); } catch (_) {}
    }
    try {
      callback(e);
    } catch (err) {
      console.error('[Button Error]', err);
    }
  };

  // Immediate mode for rapid action buttons like Dash & Ult
  if (options.immediate) {
    el.addEventListener('touchstart', (e) => {
      triggerAction(e);
    }, { passive: false });
    el.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'touch') triggerAction(e);
    }, { passive: false });
    el.addEventListener('click', (e) => {
      triggerAction(e);
    });
    return;
  }

  // Touch tracking with touch slop (32px) for menu buttons & cards
  el.addEventListener('touchstart', (e) => {
    if (e.touches && e.touches[0]) {
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
      startTime = Date.now();
    }
  }, { passive: true });

  el.addEventListener('touchend', (e) => {
    if (e.changedTouches && e.changedTouches[0]) {
      const endX = e.changedTouches[0].clientX;
      const endY = e.changedTouches[0].clientY;
      const dist = Math.hypot(endX - startX, endY - startY);
      const elapsed = Date.now() - startTime;
      if (dist < 32 && elapsed < 900) {
        triggerAction(e);
      }
    }
  }, { passive: false });

  // Pointerup fallback for mouse / pen
  el.addEventListener('pointerup', (e) => {
    if (e.pointerType !== 'touch') {
      triggerAction(e);
    }
  }, { passive: false });

  // Native click fallback
  el.addEventListener('click', (e) => {
    triggerAction(e);
  });
}
function showAscensionTree() {
  let existing = document.getElementById('ascensionOverlay');
  if (existing) { existing.remove(); return; }
  
  const asc = getAscension();
  const crystalCount = typeof meta !== 'undefined' ? (meta.crystals || 0) : (typeof crystals !== 'undefined' ? crystals : 0);
  
  let html = '<div id="ascensionOverlay" style="position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.85);z-index:9999;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:16px;overflow-y:auto;">';
  html += '<h2 style="color:#fbbf24;font-size:20px;margin-bottom:12px;">🌳 YETENEK AĞACI</h2>';
  html += '<p style="color:#94a3b8;margin-bottom:12px;">💎 Kristal: <b style="color:#38bdf8;">' + crystalCount + '</b></p>';
  html += '<div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;max-width:380px;width:100%;">';
  
  ASCENSION_TREE.forEach(node => {
    const lv = asc[node.id] || 0;
    const maxed = lv >= node.max;
    const canBuy = !maxed && crystalCount >= node.cost;
    const bgCol = maxed ? 'rgba(34,197,94,0.15)' : canBuy ? 'rgba(251,191,36,0.15)' : 'rgba(100,116,139,0.1)';
    const borderCol = maxed ? '#22c55e' : canBuy ? '#fbbf24' : '#334155';
    html += '<div style="background:' + bgCol + ';border:1px solid ' + borderCol + ';border-radius:10px;padding:10px;text-align:center;">';
    html += '<div style="font-weight:700;color:#e2e8f0;font-size:12px;">' + node.name + '</div>';
    html += '<div style="color:#94a3b8;font-size:10px;">' + node.desc + '</div>';
    html += '<div style="color:#fbbf24;font-size:11px;margin:4px 0;">Lv ' + lv + '/' + node.max + '</div>';
    if (!maxed) {
      html += '<button onclick="buyAscension(\'' + node.id + '\')" style="background:' + (canBuy ? '#fbbf24' : '#334155') + ';color:#000;border:none;border-radius:6px;padding:4px 12px;font-size:11px;font-weight:700;cursor:pointer;">' + (canBuy ? '💎 ' + node.cost : '🔒 ' + node.cost) + '</button>';
    } else {
      html += '<span style="color:#22c55e;font-size:11px;font-weight:700;">✅ MAX</span>';
    }
    html += '</div>';
  });
  
  html += '</div>';
  html += '<button onclick="document.getElementById(\'ascensionOverlay\').remove()" style="margin-top:16px;background:#334155;color:#e2e8f0;border:none;border-radius:8px;padding:8px 24px;font-size:14px;cursor:pointer;">KAPAT</button>';
  html += '</div>';
  
  document.body.insertAdjacentHTML('beforeend', html);
}

window.buyAscension = function(nodeId) {
  const node = ASCENSION_TREE.find(n => n.id === nodeId);
  if (!node) return;
  const asc = getAscension();
  const lv = asc[nodeId] || 0;
  if (lv >= node.max) return;
  
  let m = typeof meta !== 'undefined' ? meta : loadMeta();
  let crystalCount = typeof m !== 'undefined' ? (m.crystals || 0) : (typeof crystals !== 'undefined' ? crystals : 0);
  if (crystalCount < node.cost) return;
  
  crystalCount -= node.cost;
  if (typeof m !== 'undefined') { m.crystals = crystalCount; saveMeta(m); }
  else if (typeof crystals !== 'undefined') { crystals = crystalCount; }
  
  asc[nodeId] = lv + 1;
  saveAscension(asc);
  
  if (typeof saveCrystals === 'function') saveCrystals();
  else { try { localStorage.setItem('elementer_crystals', crystalCount); } catch(e) {} }
  
  const existing = document.getElementById('ascensionOverlay');
  if (existing) existing.remove();
  showAscensionTree(); // Refresh
  if (typeof playSfx === 'function') playSfx('legendary', 0.4);
};

