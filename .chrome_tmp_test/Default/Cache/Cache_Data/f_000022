function pickNodeCards(kind) {
  const taken = new Set((runLock && runLock.nodes) || []);
  const shuf = (arr) => shuffle(arr.slice());
  if (kind === 'core') return shuf(CORE_NODES.filter(n => !taken.has(n.id))).slice(0, 2);
  const cls = activeFusionClass() || 'stain';
  const clsPool = shuf((CLASS_NODES[cls] || CLASS_NODES.stain).filter(n => !taken.has(n.id)));
  const uni = shuf(UNIV_NODES.filter(n => !taken.has(n.id)));
  const cards = [];
  clsPool.forEach(n => { if (cards.length < 2) cards.push(n); });
  if (cards.length < 2 && uni[0]) cards.push(uni[0]);
  const extra = shuf(CORE_NODES.filter(n => !taken.has(n.id) && cards.indexOf(n) < 0));
  extra.forEach(n => { if (cards.length < 2) cards.push(n); });
  return cards.slice(0, 2);
}

