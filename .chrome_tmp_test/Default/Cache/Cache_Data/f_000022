      ctx.quadraticCurveTo(weavePts[i - 1].x, weavePts[i - 1].y, xc, yc);
    }
    ctx.lineTo(weavePts[nPts - 1].x, weavePts[nPts - 1].y);
    ctx.strokeStyle = weaveNear ? 'rgba(255, 215, 0, 0.35)' : 'rgba(255, 120, 50, 0.22)';
    ctx.lineWidth = weaveNear ? 12 : 8;
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    ctx.stroke();

    // 2. Akışkan neon alev çekirdeği
    ctx.beginPath();
    ctx.moveTo(weavePts[0].x, weavePts[0].y);
    for (let i = 1; i < nPts; i++) {
      const xc = (weavePts[i - 1].x + weavePts[i].x) / 2;
      const yc = (weavePts[i - 1].y + weavePts[i].y) / 2;
