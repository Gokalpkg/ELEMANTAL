// ── 10. YATAY YANAN ALEV DUVARI / HALISI (Image 2: Horizontal Fire Wall & Flame Strip) ──
function drawPixelFireWall(x, y, len, seed, alpha) {
  ctx.save();
  ctx.translate(Math.round(x), Math.round(y));
  ctx.globalAlpha = alpha != null ? alpha : 1;
  const l = len || 28;
  const half = l / 2;

  // Koyu Köz Zemin Tabanı
  ctx.fillStyle = '#450a0a';
  ctx.fillRect(-half, 0, l, 5);

  // Alev Dilleri Basamakları
  const step = 3.5;
  for (let px = -half; px < half; px += step) {
    const pNoise = Math.sin(time * 0.35 + px * 0.4 + (seed || 0));
    const h = Math.max(5, Math.round(9 + pNoise * 5));

    // Kırmızı Dış Alev
    ctx.fillStyle = '#dc2626';
    ctx.fillRect(px, -h, step, h);

    // Turuncu Orta Katman
    ctx.fillStyle = '#ea580c';
    ctx.fillRect(px + 0.5, -h * 0.75, step - 1, h * 0.75);

    // Sarı İç Katman
    ctx.fillStyle = '#facc15';
    ctx.fillRect(px + 1, -h * 0.45, step - 2, h * 0.45);

    // Akkor Beyaz Merkez
    if (pNoise > 0.2) {
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(px + 1, -h * 0.2, step - 2, h * 0.2);
    }
  }

  // Yukarı Uçuşan Köz Parçacıkları
  ctx.fillStyle = '#fef08a';
  for (let k = 0; k < 3; k++) {
    const ex = -half + ((k * 11 + time * 14 + (seed || 0) * 8) % l);
    const ey = -8 - ((k * 7 + time * 18) % 14);
    ctx.fillRect(ex, ey, 1.5, 1.5);
  }

  ctx.restore();
}

// ── 11. KESKİN 8-KÖŞELİ PATLAMA YILDIZI (Image 1: Jagged 8-Point Starburst Explosion) ──
function drawPixelImpactBurst(x, y, scale, rot, alpha) {
  ctx.save();
  ctx.translate(Math.round(x), Math.round(y));
  ctx.rotate(rot || 0);
  ctx.globalAlpha = alpha != null ? alpha : 1;
  const s = (scale || 1) * 1.3;

  // Dış Koyu Kızıl / Yanık Kenar (8 Sivri Uç)
  ctx.fillStyle = '#991b1b';
  ctx.beginPath();
  const pts = 8;
  for (let i = 0; i < pts * 2; i++) {
    const ang = (i * Math.PI) / pts;
    const r = (i % 2 === 0) ? (16 * s) : (7 * s);
    const px = Math.cos(ang) * r;
    const py = Math.sin(ang) * r;
    if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
  }
  ctx.closePath();
  ctx.fill();

  // Turuncu Patlama Gövdesi
  ctx.fillStyle = '#ea580c';
  ctx.beginPath();
  for (let i = 0; i < pts * 2; i++) {
    const ang = (i * Math.PI) / pts;
    const r = (i % 2 === 0) ? (12 * s) : (5 * s);
    const px = Math.cos(ang) * r;
    const py = Math.sin(ang) * r;
    if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
  }
  ctx.closePath();
  ctx.fill();

  // Canlı Sarı İç Işınlar
  ctx.fillStyle = '#fde047';
  ctx.beginPath();
  for (let i = 0; i < pts * 2; i++) {
    const ang = (i * Math.PI) / pts;
    const r = (i % 2 === 0) ? (8 * s) : (3 * s);
    const px = Math.cos(ang) * r;
    const py = Math.sin(ang) * r;
    if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
  }
  ctx.closePath();
  ctx.fill();

  // Akkor Beyaz Merkez Parlaması
  ctx.fillStyle = '#ffffff';
  ctx.fillRect(-2 * s, -2 * s, 4 * s, 4 * s);

  ctx.restore();
}

