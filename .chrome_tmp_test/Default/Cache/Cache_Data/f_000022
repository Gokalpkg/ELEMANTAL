      { x: player.x - 280, y: player.y - 280 },
      { x: player.x + 280, y: player.y - 280 },
      { x: player.x - 280, y: player.y + 280 },
      { x: player.x + 280, y: player.y + 280 }
    ];

    if (hazards) {
      corners.forEach(c => {
        hazards.push({
