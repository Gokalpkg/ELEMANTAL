function pickNextBiome() {
  const keys = BIOMES.map(b => b.key);
  const unvisited = keys.filter(k => biomeHist.indexOf(k) < 0);
  if (unvisited.length > 0) return unvisited[0];
  const last = biomeHist.slice(-2);
  let pool = keys.filter(k => last.indexOf(k) < 0);
  if (!pool.length) pool = keys.filter(k => k !== last[last.length - 1]);
  if (!pool.length) pool = keys.slice();
  return pool[(Math.random() * pool.length) | 0];
}
function biomeIndexOf(key) {
  const i = BIOMES.findIndex(b => b.key === key);
  return i >= 0 ? i : 0;
}
function punchEnemy(en, fromX, fromY, force, crit) {
  if (!en) return;
  const isBoss = en.type === 'boss';
  const isElite = en.isElite || en.type === 'tank' || en.type === 'bearer';
  // Boss is virtually immune to knockback (0.05), so it can stride forward into combat!
  // Elite enemies receive 0.25, regular enemies receive 0.40.
  const bossMul = isBoss ? 0.05 : isElite ? 0.25 : 0.40;
  const actualForce = (force || 8) * bossMul;
  if (actualForce >= 0.2) {
    const dx = en.x - fromX, dy = en.y - fromY;
    const d = Math.hypot(dx, dy) || 1;
    tryMove(en, (dx / d) * actualForce, (dy / d) * actualForce);
  }
  shake = Math.max(shake, crit ? (isBoss ? 7 : 5) : 1.8);
}
