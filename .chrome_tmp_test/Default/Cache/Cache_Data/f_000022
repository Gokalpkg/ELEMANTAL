function steerDir(x, y, tx, ty, r) {
  let dx = tx-x, dy = ty-y;
  const dist = Math.hypot(dx,dy) || 1;
  dx /= dist; dy /= dist;
  const look = 42;
  if (!circleHitsObs(x+dx*look, y+dy*look, r+3)) return { x:dx, y:dy, dist };
  const lx = -dy, ly = dx;
  const left = !circleHitsObs(x+lx*look, y+ly*look, r+3);
  const right = !circleHitsObs(x-lx*look, y-ly*look, r+3);
  if (left && !right) return { x: lx*0.85+dx*0.2, y: ly*0.85+dy*0.2, dist };
  if (right && !left) return { x: -lx*0.85+dx*0.2, y: -ly*0.85+dy*0.2, dist };
  if (left) return { x: lx*0.7+dx*0.3, y: ly*0.7+dy*0.3, dist };
  return { x: -lx*0.7+dx*0.3, y: -ly*0.7+dy*0.3, dist };
}

