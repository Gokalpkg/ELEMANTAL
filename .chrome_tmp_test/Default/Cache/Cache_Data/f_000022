      ctx2.fillRect(ox - 2.5 * ps, oy - 2.5 * ps, ps, ps);
      ctx2.fillRect(ox + 1.5 * ps, oy - 2.5 * ps, ps, ps);
      ctx2.fillRect(ox - 2.5 * ps, oy + 1.5 * ps, ps, ps);
