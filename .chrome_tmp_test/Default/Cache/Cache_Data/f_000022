  if (document.getElementById('devSelectOverlay') && document.getElementById('devSelectOverlay').classList.contains('show')) {
    closeDevSelect();
    return true;
  }
  if (document.getElementById('settingsOverlay') && document.getElementById('settingsOverlay').classList.contains('show')) {
    closeSettings();
    return true;
  }
  if (document.getElementById('guideOverlay') && document.getElementById('guideOverlay').classList.contains('show')) {
    document.getElementById('guideOverlay').classList.remove('show');
    playSfx('tick', 0.25);
    return true;
  }
  if (document.getElementById('lookOverlay') && document.getElementById('lookOverlay').classList.contains('show')) {
    closeLook();
    return true;
  }
  if (document.getElementById('elTreeOverlay') && document.getElementById('elTreeOverlay').classList.contains('show')) {
    closeElTree();
    return true;
  }
  if (document.getElementById('shrineOverlay') && document.getElementById('shrineOverlay').classList.contains('show')) {
    closeShrineModal();
    return true;
  }
  if (document.getElementById('merchantOverlay') && document.getElementById('merchantOverlay').classList.contains('show')) {
    closeMerchant();
    return true;
  }
  if (document.getElementById('treeOverlay') && document.getElementById('treeOverlay').classList.contains('show')) {
    closeTree();
    return true;
  }
  // 2. Oyun içi duraklatma menüsü açıksa devam et veya kapat
  if (document.getElementById('pauseOverlay') && document.getElementById('pauseOverlay').classList.contains('show')) {
    menuOpen = false;
    paused = false;
    document.getElementById('pauseOverlay').classList.remove('show');
    playSfx('tick', 0.25);
    if (running && enemies && enemies.length === 0 && !overlayBusy()) scheduleWaveClear(200);
    return true;
  }
  // 3. Devam etme / Oyun bitti ekranında ana menüye dön
  if (document.getElementById('continueOverlay') && document.getElementById('continueOverlay').classList.contains('show')) {
    finishRun();
    return true;
  }
  if (document.getElementById('gameOverOverlay') && document.getElementById('gameOverOverlay').classList.contains('show')) {
    goMainMenu();
    return true;
  }
  // 4. Ödül/seçim/nefes ekranları hariç oyun akıyorsa duraklat
  if (running && !overlayBusy()) {
    togglePause();
    return true;
  }
  // 5. Oyun devam ederken herhangi bir seçim (Nefes, Seviye, Eklenti) ekranındaysa oyundan atılmasını önle
  if (running && overlayBusy()) {
    return true;
  }
  // 6. Ana menüdeyse uygulamadan çık veya simge durumuna küçült
  if (!running && document.getElementById('startOverlay') && document.getElementById('startOverlay').classList.contains('show')) {
    if (window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.App && window.Capacitor.Plugins.App.exitApp) {
      window.Capacitor.Plugins.App.exitApp();
      return true;
    }
    if (navigator.app && navigator.app.exitApp) {
      navigator.app.exitApp();
      return true;
    }
  }
  return false;
}

