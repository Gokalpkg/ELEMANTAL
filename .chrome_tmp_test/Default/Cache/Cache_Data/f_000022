    if (!st) skillState[i] = st = { charge: combo.cd || 260, ready: true };
    btn.classList.add('locked');
    const sp = splitOf(combo.kind);
    if (sp === 'push') btn.classList.add('push');
    if (sp === 'pull') btn.classList.add('pull');
    const col = combo.color || (ELEMENTS[combo.a] && ELEMENTS[combo.a].color) || '#ffd740';
    btn.style.borderColor = col;
    btn.style.boxShadow = '0 0 14px ' + col + '77';
    btn.style.background = col + '20';
    icon.innerHTML = combo.icons || (renderPixelIcon(combo.a, '', 16) + renderPixelIcon(combo.b, '', 16));
    icon.style.color = '';
    if (howEl) howEl.textContent = combo.tag || combo.how || '';
    const pct = Math.min(1, st.charge / combo.cd);
    fill.style.height = (pct*100) + '%';
    btn.title = combo.name + ' — ' + combo.desc;
    btn.dataset.elem = combo.a || 'fire';
    if (st.ready) {
      btn.classList.add('ready');
      timer.textContent = combo.tag || 'VUR!';
    } else {
      timer.textContent = Math.ceil((1-pct) * (combo.cd/60)) + 's';
    }
  });
}

function tryUseSkill(slot) {
  if (!running || paused || menuOpen) return;
  const combo = lockedCombos[slot];
  const st = skillState[slot];
  if (!combo) {
    if (pendingElement && slot === lockedCombos.length) {
      spawnFloatText(player.x, player.y - 28, ELEMENTS[pendingElement].name + ' füzyon bekliyor', ELEMENTS[pendingElement].color);
    } else {
      spawnFloatText(player.x, player.y - 28, 'Slot ' + (slot + 1) + ' kilitli', '#aaa');
    }
    playSfx('hit', 0.2);
    return;
  }
  if (!st || !st.ready) return;
  // Kesinlikle 'Menzil dışı' iptali yapma! Oyuncu butona bastığında yetenek her koşulda gümbür gümbür çalışsın.
  playSfx('skill', 0.45, 480);
  vibrate([15, 20, 15]);
  burst(player.x, player.y, ELEMENTS[combo.a] ? ELEMENTS[combo.a].color : '#ffd740', 8, 2.5);

  const now = performance.now();
  skillSeq.push({ t: now, slot });
  skillSeq = skillSeq.filter(s => now - s.t < 2200);
  let finisher = false;
  if (skillSeq.length >= 3) {
    const last = skillSeq.slice(-3);
    const ids = last.map(s => s.slot);
    if (ids[0] === 0 && ids[1] === 1 && ids[2] === 2) finisher = true;
  }
  activateSkill(combo, finisher);
  noteElemUse([combo.a, combo.b], 18);
  st.charge = 0; st.ready = false;
  refreshSkillUI(true);
}

function distToSeg(px, py, x1, y1, x2, y2) {
  const dx = x2 - x1, dy = y2 - y1;
  const l2 = dx * dx + dy * dy || 1;
  let t = ((px - x1) * dx + (py - y1) * dy) / l2;
  t = Math.max(0, Math.min(1, t));
  return Math.hypot(px - (x1 + t * dx), py - (y1 + t * dy));
}
function addBolt(x1, y1, x2, y2, color, life, wide) {
  bolts.push({ x1, y1, x2, y2, color: color || '#f4d03f', life: life || 0.28, max: life || 0.28, wide: wide || 2.2 });
}
function chainLightning(origin, dmg, jumps, jumpR, color, effect) {
  let from = origin;
  const hit = new Set();
  for (let j = 0; j < jumps; j++) {
    let best = null, bd = jumpR;
    for (let i = 0; i < enemies.length; i++) {
      const en = enemies[i];
      if (hit.has(en)) continue;
      const d = Math.hypot(en.x - from.x, en.y - from.y);
      if (d <= jumpR && d < bd) { bd = d; best = en; }
    }
    if (!best) break;
    addBolt(from.x, from.y, best.x, best.y, color, 0.32, 2.4);
    hit.add(best);
    const dealt = takeDamage(best, Math.max(2, Math.round(dmg * (1 - j * 0.14))), 'storm');
    spawnFloatText(best.x, best.y - 10, '-' + dealt, color);
    if (effect) applyEffect(best, effect, 0.5);
    burst(best.x, best.y, color, 7, 2);
    from = best;
  }
  pruneDeadEnemies();
}
function beamStrike(ang, len, width, dmg, color, effect, el) {
  const x2 = player.x + Math.cos(ang) * len;
  const y2 = player.y + Math.sin(ang) * len;
  addBolt(player.x, player.y, x2, y2, color, 0.42, width);
  enemies.forEach(en => {
    if (distToSeg(en.x, en.y, player.x, player.y, x2, y2) < width + en.r) {
      const dealt = takeDamage(en, dmg, el);
      spawnFloatText(en.x, en.y - 10, '-' + dealt, color);
      if (effect) applyEffect(en, effect, 0.7);
      burst(en.x, en.y, color, 8, 2.4);
    }
  });
  pruneDeadEnemies();
}
function pullEnemies(cx, cy, range, strength, options) {
  options = options || {};
  const safeFromPlayer = options.safeFromPlayer !== false;
  const minPlayerDist = options.minPlayerDist || 68;
  const stunDuration = options.stunDuration != null ? options.stunDuration : 400;
  const shock = options.shock !== false;
  const now = performance.now();

  enemies.forEach(en => {
    if (!en || en.hp <= 0) return;
    if (en.type === 'boss') {
      if (shock) applyEffect(en, 'shock', 0.8);
      return;
    }
    const d = Math.hypot(en.x - cx, en.y - cy) || 1;
    if (d < range && d > 14) {
      const k = Math.min(strength, Math.max(3, (d - 12) * 0.52));
      const nx = en.x + (cx - en.x) / d * k;
      const ny = en.y + (cy - en.y) / d * k;

      if (safeFromPlayer && player) {
        const pd = Math.hypot(nx - player.x, ny - player.y);
        if (pd < minPlayerDist) {
          const pAng = Math.atan2(ny - player.y, nx - player.x);
          const safeX = player.x + Math.cos(pAng) * minPlayerDist;
          const safeY = player.y + Math.sin(pAng) * minPlayerDist;
          tryMove(en, safeX - en.x, safeY - en.y);
        } else {
          tryMove(en, nx - en.x, ny - en.y);
        }
      } else {
        tryMove(en, nx - en.x, ny - en.y);
      }

      if (stunDuration > 0) {
        en.stunUntil = Math.max(en.stunUntil || 0, now + stunDuration);
      }
      if (shock) {
        applyEffect(en, 'shock', 1.2);
      }
    }
  });
}
function vacuumPickups(range) {
  const pull = (p) => {
    const py = pickupY(p);
    const d = Math.hypot(player.x - p.x, player.y - py) || 1;
    if (d < range) {
      p.x += (player.x - p.x) * 0.55;
      p.by += (player.y - py) * 0.55;
    }
  };
  xpGems.forEach(pull);
  orbs.forEach(pull);
  drops.forEach(pull);
  crystals.forEach(pull);
}

function activateSkill(raw, finisher) {
  lastElemUsed = raw.a || raw.b || lastElemUsed;
  const extra0 = Object.assign({}, raw.extra || {});
  if (finisher) {
    extra0.r = (extra0.r || raw.range || 180) * 1.28;
    extra0.shots = (extra0.shots || 8) + 2;
    extra0.exec = (extra0.exec || 0.34) + 0.12;
    extra0.knock = (extra0.knock || 72) + 30;
    extra0.stun = (extra0.stun || 2.4) + 0.6;
    extra0.ball = (extra0.ball || 12) + 2;
  }
  if (runFlags().exec) extra0.exec = (extra0.exec || 0.34) + runFlags().exec;
  if (playerSig) {
    if (playerSig.id === 'execPlus') extra0.exec = (extra0.exec || 0.34) + 0.11;
    if (playerSig.id === 'puffPlus') extra0.shots = (extra0.shots || 8) + 2;
    if (playerSig.id === 'wavePlus') { extra0.knock = (extra0.knock || 72) + 22; extra0.stun = (extra0.stun || 2.4) + 0.5; extra0.r = (extra0.r || raw.range) * 1.12; }
  }
  const scaleA = elemMul(raw.a);
  const scaleB = elemMul(raw.b);
  const harmony = 1 - Math.abs(scaleA - scaleB) / Math.max(scaleA + scaleB, 0.001);
  const hybrid = (raw.a && raw.b && raw.a !== raw.b) ? (1 + FUSION_HYBRID_K * harmony) : 1.12;
  const skillLinear = (modValue('skillDmg') || 0) / 100 * synMul('skillDmg', 0.35);
  let dmgMul = (scaleA * FUSION_WEIGHT_ROOT + scaleB * FUSION_WEIGHT_SEC)
    * (fatigueMul(raw.a) * 0.5 + fatigueMul(raw.b) * 0.5)
    * hybrid
    * (splitFlow || 1)
    * softMul(skillLinear);
  const steamOn = typeof activeFusionClass === 'function' && activeFusionClass() === 'steam';
  const prHad = pressure;
  let pr = { m: 1, g: '' };
  if (steamOn) {
    dmgMul *= steamSkillMul();
    extra0.r = (extra0.r || raw.range || 180) * (steamBand() === 'crit' ? 1.22 : steamBand() === 'mid' ? 1.08 : 1);
  } else {
    pr = consumePressure();
    dmgMul *= pr.m;
    if (pr.g === 'sweet') extra0.r = (extra0.r || raw.range || 180) * 1.16;
