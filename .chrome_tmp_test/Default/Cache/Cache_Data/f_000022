  enemyProjectiles.forEach(p => drawEnemyShot(p, time));

  drawLookTrail();
  if (echoTape.length > 2 && !echoGhost) {
    ctx.save();
    ctx.strokeStyle = 'rgba(155,125,255,0.28)';
