    for (let i = 0; i < nPts; i += 3) {
      const p = weavePts[i];
      const pulseR = 2.5 + Math.sin(time * 0.3 + i) * 1.2;
      ctx.fillStyle = (i % 2 === 0) ? '#ffffff' : '#ffd700';
      ctx.beginPath();
      ctx.arc(p.x, p.y, pulseR, 0, Math.PI * 2);
