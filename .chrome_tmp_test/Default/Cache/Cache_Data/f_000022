function getWaveBossInfo(targetWave) {
  const w = parseInt(targetWave, 10) || 1;
  const isBoss = (w >= 5 && w % 5 === 0);
  if (!isBoss) {
    const nextBossWave = Math.ceil(w / 5) * 5;
    return {
      isBoss: false,
      title: 'Normal Dalga',
      biomeName: '',
      text: `Dalga ${w} normal düşman dalgasıdır. (Boss yok · Sonraki Boss: Dalga ${nextBossWave})`,
      color: '#94a3b8'
    };
  }
  const bIdx = Math.floor((w - 1) / 5) % BIOMES.length;
  const biome = BIOMES[bIdx] || BIOMES[0];
  const cfg = getBiomeBossConfig(biome.key, w);
  const bossNum = Math.floor(w / 5);
  return {
    isBoss: true,
    bossNum,
    title: cfg.title,
    biomeName: biome.name,
    text: `BOSS BÖLÜMÜ: ${cfg.title} (${biome.name} · ${bossNum}. Boss)`,
    color: '#fbbf24'
  };
}

