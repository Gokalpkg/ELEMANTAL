let _cachedAuto = null;
let _cachedAutoKey = '';

function currentAuto() {
  const els = autoRoots();
  if (!els.length) {
    return { els:['fire'], name: 'Ateş Kıvılcımı', interval: 20, speed: 7.6, dmg: 7, r: 5.2, range: 270, color: '#ff6b4a', effects: ['burn'], specialEvery: 4, special: 'burst', shots: [{ key: 'fire', speed: 7.6, r: 5.2, dmg: 7, range: 270, color: '#ff6b4a', effects: ['burn'] }] };
  }
  const cacheKey = els.join(',') + '_' + (modValue('dmg') || 0) + '_' + (modValue('reach') || 0) + '_' + autoSpeedBonus() + '_' + (overchargeEl || '') + '_' + (runFlags().specialEvery || 0);
  if (_cachedAuto && _cachedAutoKey === cacheKey) {
    return _cachedAuto;
  }
  const n = els.length;
  const freq = {};
  els.forEach(k => { freq[k] = (freq[k] || 0) + 1; });
  const uniq = [...new Set(els)].sort((a, b) => (freq[b] - freq[a]) || (els.lastIndexOf(b) - els.lastIndexOf(a)));
  const primaryKey = uniq[0];
  const primary = AUTO_BASE[primaryKey];
  const first = ELEMENTS[primaryKey];
  const same = freq[primaryKey] || 1;
  const mono = uniq.length === 1 && n >= 2;
  const speedMul = 1 - autoSpeedBonus();
  const dmgMod = softMul((modValue('dmg') || 0) / 100 * synMul('dmg', 0.35)) * resolveFusionMul(primaryKey);
  const extraMul = 1 + (uniq.length === 1 ? (n - 1) * 0.22 : 0.18);
  const maxRange = Math.max(...els.map(k => AUTO_BASE[k].range));
  let name = first.name + ' vuruşu';
  if (mono && same === 2) name = 'Çifte ' + first.name;
  if (mono && same === 3) name = 'Üçlü ' + first.name + ' uyumu';
  if (overchargeEl && overchargeEl === primaryKey && mono) name = 'Süper ' + first.name;
  let shots;
  let special = mono && same >= 3 ? 'focus' : primary.special;
  let specialEvery = mono && same >= 3 ? 4 : (primary.specialEvery || 5);
  let interval = primary.interval;
  let color = first.color;
  const kitHome = (k) => !!(AUTO_BASE[k] && AUTO_BASE[k].home);
  const fusePair = !mono && uniq.length >= 2 ? pairKey(uniq[0], uniq[1]) : null;
  const pKey = !mono && uniq.length >= 2 ? pairKey(uniq[0], uniq[1]) : null;
  const apexMatch = pKey && APEX_EVOLUTIONS[pKey];
  const isApexUnlocked = !!(apexMatch && player && (player._hasApexEvolution === apexMatch.id || player.level >= 6));
  if (isApexUnlocked && !player._hasApexEvolution) {
    triggerApexEvolution(apexMatch, pKey);
  }

  if (!mono && uniq.length >= 2) {
    const fuse = isApexUnlocked ? apexMatch : AUTO_FUSE[pairKey(uniq[0], uniq[1])];
    const effects = statusList(uniq);
    name = uniq.length >= 3 ? 'Üçlü karışım' : (fuse ? fuse.name : first.name + ' karışımı');
    color = fuse ? fuse.color : first.color;
    interval = fuse ? fuse.interval : (primary.interval + AUTO_BASE[uniq[1]].interval) / 2;
    special = fuse ? fuse.special : primary.special;
    specialEvery = 5;
    const dmg = Math.round(((fuse ? fuse.dmg : primary.dmg + 1.2) * extraMul * dmgMod * elemMul(primaryKey) * fatigueMul(primaryKey) * (splitFlow || 1)) + wave * 0.22);
    shots = [{
      key: primaryKey,
      speed: fuse ? fuse.speed : primary.speed,
      r: fuse ? fuse.r : primary.r + 1,
      dmg,
      range: Math.max(maxRange, fuse ? fuse.range : 0),
      color,
      effects,
      special,
      home: uniq.some(kitHome),
      fuse: fusePair
    }];
  } else {
    const b = AUTO_BASE[primaryKey];
    shots = [{
      key: primaryKey,
      speed: b.speed,
      r: b.r,
      dmg: Math.round((b.dmg * extraMul * dmgMod * elemMul(primaryKey) * fatigueMul(primaryKey) * (splitFlow || 1)) + wave * 0.22),
      range: b.range,
      color: ELEMENTS[primaryKey].color,
      effects: b.effect ? [b.effect] : [],
      special: b.special,
      home: kitHome(primaryKey)
    }];
  }
  if (overchargeEl) {
    const oc = AUTO_BASE[overchargeEl];
    if (oc && shots[0]) {
      shots[0].dmg = Math.round(shots[0].dmg * 1.32);
      shots[0].r = (shots[0].r || 6) + 2.2;
      shots[0].speed = (shots[0].speed || 7) * 1.08;
      specialEvery = Math.max(3, (specialEvery || 5) - 1);
      interval *= 0.84;
      if (!name.startsWith('Süper')) name = 'Süper ' + name;
    }
  }
  const reach = Math.round((modValue('reach') || 0) * synMul('reach', 0.5));
  shots.forEach(s => { s.range = (s.range || maxRange) + reach; });
  const cls = typeof activeFusionClass === 'function' ? activeFusionClass() : null;
  if (cls && CLASS_LABEL[cls] && runLock && runLock.forkDone) {
    name = CLASS_LABEL[cls] + ' vurusu';
    if (cls === 'lava') { special = 'burst'; specialEvery = 5; }
    else if (cls === 'ocean') { special = 'freeze'; specialEvery = 4; }
    else if (cls === 'thunder') { special = 'chain'; specialEvery = 4; }
    else if (cls === 'stone') { special = 'heavy'; specialEvery = 4; }
    else if (cls === 'shadow') { special = 'blackhole'; specialEvery = 4; }
    else if (cls === 'sprout') { special = 'sap'; specialEvery = 4; }
    if (shots[0]) shots[0].special = special;
  }
  if (runFlags().specialEvery) {
    specialEvery = runFlags().specialEvery;
    if (shots[0]) shots[0].special = special;
  }
  return {
    els,
    name,
    interval: interval * speedMul * (mono && same >= 3 ? 0.9 : 1),
    speed: shots[0].speed,
    dmg: shots[0].dmg,
    r: shots[0].r,
    range: shots[0].range || maxRange,
    color,
    effects: shots[0].effects,
    specialEvery,
    special,
    count: 1,
    shots
  };
  _cachedAuto = res;
  _cachedAutoKey = cacheKey;
  return res;
}

