    ctx.beginPath();
    ctx.moveTo(x + r * 0.3, cy);
    ctx.lineTo(x + r * 1.5, cy - r * 0.8 + flap * 4);
    ctx.lineTo(x + r * 0.8, cy + r * 0.3);
