function resolveIconKey(rawKey) {
  if (!rawKey) return 'star';
  if (EMOJI_TO_PX[rawKey]) return EMOJI_TO_PX[rawKey];
  const s = String(rawKey).toLowerCase();
  if (PX_ICONS[s]) return s;

  // Semantic pattern matching for abilities, perks, talents, elements
  if (s.includes('magnet') || s.includes('mag') || s.includes('mıknatıs') || s.includes('manyetik')) return 'magnet';
  if (s.includes('glass') || s.includes('cannon') || s.includes('crystal') || s.includes('kristal')) return 'crystal';
  if (s.includes('blood') || s.includes('kan') || s.includes('pact')) return 'blood';
  if (s.includes('vortex') || s.includes('girdap') || s.includes('area') || s.includes('alan')) return 'vortex';
  if (s.includes('hourglass') || s.includes('time') || s.includes('cd') || s.includes('zaman')) return 'hourglass';
  if (s.includes('bomb') || s.includes('explode') || s.includes('infilak') || s.includes('patla')) return 'bomb';
  if (s.includes('fang') || s.includes('leech') || s.includes('vampir') || s.includes('emme')) return 'fang';
  if (s.includes('target') || s.includes('sniper') || s.includes('reach') || s.includes('odak') || s.includes('nisan')) return 'target';
  if (s.includes('tesla') || s.includes('bolt') || s.includes('shock') || s.includes('şimşek')) return 'tesla';
  if (s.includes('clover') || s.includes('luck') || s.includes('yonca') || s.includes('kader')) return 'clover';
  if (s.includes('antimatter') || s.includes('singularity') || s.includes('madde')) return 'antimatter';
  if (s.includes('multi') || s.includes('arrow') || s.includes('bow') || s.includes('yay')) return 'bow';
  if (s.includes('shield') || s.includes('kalkan') || s.includes('zırh') || s.includes('armor')) return 'shield';
  if (s.includes('dagger') || s.includes('exec') || s.includes('bıçak') || s.includes('infaz')) return 'dagger';
  if (s.includes('sword') || s.includes('damage') || s.includes('invest') || s.includes('hasar') || s.includes('kılıç')) return 'swords';
  if (s.includes('speed') || s.includes('wind') || s.includes('dash') || s.includes('hız') || s.includes('rüzgar')) return 'wind';
  if (s.includes('heart') || s.includes('hp') || s.includes('health') || s.includes('can')) return 'heart';
  if (s.includes('fire') || s.includes('lava') || s.includes('flame') || s.includes('alev') || s.includes('ateş')) return 'fire';
  if (s.includes('water') || s.includes('ocean') || s.includes('wave') || s.includes('su') || s.includes('dalga')) return 'water';
  if (s.includes('ice') || s.includes('frost') || s.includes('buz') || s.includes('don')) return 'ice';
  if (s.includes('lightning') || s.includes('storm') || s.includes('thun') || s.includes('elektrik') || s.includes('yıldırım') || s.includes('tempo')) return 'lightning';
  if (s.includes('nature') || s.includes('spr') || s.includes('leaf') || s.includes('doğa') || s.includes('filiz') || s.includes('bitki')) return 'nature';
  if (s.includes('earth') || s.includes('stone') || s.includes('rock') || s.includes('toprak') || s.includes('taş') || s.includes('kaya')) return 'earth';
  if (s.includes('void') || s.includes('dark') || s.includes('shadow') || s.includes('karanlık') || s.includes('gölge') || s.includes('hiçlik')) return 'moon';
  if (s.includes('crit') || s.includes('focus') || s.includes('şok')) return 'crit';
  if (s.includes('crown') || s.includes('midas') || s.includes('kral') || s.includes('hazine')) return 'crown';
  if (s.includes('skull') || s.includes('curse') || s.includes('lanet') || s.includes('ölüm')) return 'skull';
  if (s.includes('potion') || s.includes('iksir') || s.includes('şifa')) return 'potion';
  if (s.includes('chest') || s.includes('kutu') || s.includes('sandık')) return 'chest';
  if (s.includes('trophy') || s.includes('kupa') || s.includes('başarım')) return 'trophy';

  return 'star';
}

function renderPixelIcon(key, animClass, size) {
  const k = resolveIconKey(key);
  const svg = PX_ICONS[k] || PX_ICONS.star;
  const anim = animClass || (
    k === 'heart' ? 'px-anim-beat' :
    k === 'gem' ? 'px-anim-shimmer' :
    k === 'star' ? 'px-anim-twinkle' :
    k === 'gear' ? 'px-anim-spin' :
    k === 'fire' ? 'px-anim-flame' :
    k === 'lightning' || k === 'tesla' ? 'px-anim-zap' :
    k === 'trophy' ? 'px-anim-glow' :
    k === 'wind' || k === 'vortex' ? 'px-anim-float' : ''
  );
  const sizeStyle = size ? ('style="width:' + size + 'px;height:' + size + 'px;"') : '';
  return '<span class="px-icon px-' + k + ' ' + anim + '" ' + sizeStyle + '>' + svg + '</span>';
}

function cleanEmojiText(text) {
  if (!text || typeof text !== 'string') return text;
  return text.replace(/(\p{Extended_Pictographic}|\uD83C[\uDF00-\uDFFF]|\uD83D[\uDC00-\uDFFF]|\uD83E[\uDD00-\uDFFF])/gu, '')
             .replace(/\s{2,}/g, ' ')
             .trim();
}

function replaceEmojisWithPx(html) {
  if (!html || typeof html !== 'string') return html;
  return html.replace(/(\p{Extended_Pictographic}|\uD83C[\uDF00-\uDFFF]|[\u2600-\u27BF]|\uD83D[\uDC00-\uDFFF]|\uD83E[\uDD00-\uDFFF])/gu, function(m) {
    return renderPixelIcon(m);
  });
}

function hydrateStaticPixelIcons(root) {
  try {
    const parent = root || document;
    if (!parent || !parent.querySelectorAll) return;
    parent.querySelectorAll('.px-icon').forEach(el => {
      if (!el.innerHTML || !el.innerHTML.trim()) {
        for (const cls of el.classList) {
          if (cls.startsWith('px-') && cls !== 'px-icon' && !cls.startsWith('px-anim-')) {
            const key = cls.replace('px-', '');
            const k = resolveIconKey(key);
            const svg = PX_ICONS[k] || PX_ICONS[key];
            if (svg) {
              el.innerHTML = svg;
              break;
            }
          }
        }
      }
    });
  } catch (_) {}
}
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', () => hydrateStaticPixelIcons());
} else {
  hydrateStaticPixelIcons();
