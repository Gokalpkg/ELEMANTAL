    ctx.fillStyle = '#ffffff';
    ctx.beginPath();
    ctx.arc(x - r * 0.32, y - r * 0.08, 3.5, 0, Math.PI * 2);
    ctx.arc(x + r * 0.32, y - r * 0.08, 3.5, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = '#102027';
    ctx.beginPath();
    ctx.arc(x - r * 0.32, y - r * 0.08, 1.8, 0, Math.PI * 2);
    ctx.arc(x + r * 0.32, y - r * 0.08, 1.8, 0, Math.PI * 2);
    ctx.fill();
  }
}

// 7.11 Master Biome Enemy Dispatcher
function drawBiomeEnemy(ctx, en, time, biome, fogged) {
  const bk = (biome && biome.key) || 'stone';
  // High-Contrast Silhouette: Guarantee enemies pop out from red/lava floors!
  ctx.save();
  ctx.shadowColor = (bk === 'lava' || bk === 'ketchup') ? 'rgba(0, 229, 255, 0.45)' : 'rgba(0, 0, 0, 0.75)';
  ctx.shadowBlur = 0; /* 60fps */
  const type = en.type;

  let role = 'swarmer';
  if (type === 'tank' || type === 'armored' || type === 'bearer' || type === 'walker') {
    role = 'heavy';
  } else if (type === 'shooter' || type === 'shaman') {
    role = 'caster';
  } else if (type === 'fast' || type === 'exploder') {
    role = 'rusher';
  }

  // Lift & Ground Shadow computation
  let lift = 4;
  if (role === 'heavy') {
    lift = 4 + en.r * 0.12 + Math.abs(Math.sin(time * 0.18 + en.phase)) * 2.2;
    drawGroundShadow(en.x + 2, en.y + en.r * 0.5, en.r * 1.15, en.r * 0.3);
  } else if (role === 'caster') {
    lift = 5 + en.r * 0.16 + Math.abs(Math.sin(time * 0.22 + en.phase)) * 2.8;
    drawGroundShadow(en.x + 2, en.y + en.r * 0.52, en.r * 1.05, en.r * 0.26);
  } else if (role === 'rusher') {
    lift = 4 + en.r * 0.12 + Math.abs(Math.sin(time * 0.32 + en.phase)) * 3.2;
    drawGroundShadow(en.x + 2, en.y + en.r * 0.48, en.r * 1.05, en.r * 0.24);
  } else {
    // Swarmer / Slime / Mob Yürüyüş Animasyonu (Adım atan bacaklar & çırpınış)
    const squash = Math.sin(time * 0.32 + en.phase);
    lift = 3 + Math.abs(squash) * 3.8;
    drawGroundShadow(en.x + 2, en.y + en.r * 0.52, en.r * (1.18 + squash * 0.18), en.r * 0.28);

    // Minik yürüyüş bacakları (mob ayakları adımlarla hareket eder)
    const legW = Math.sin(time * 0.4 + en.phase) * (en.r * 0.4);
    ctx.fillStyle = 'rgba(0, 0, 0, 0.65)';
    ctx.fillRect(en.x - en.r * 0.45 - legW, en.y + en.r * 0.2, 3, 4);
    ctx.fillRect(en.x + en.r * 0.25 + legW, en.y + en.r * 0.2, 3, 4);
  }

  const cy = en.y - lift;
  // High-contrast enemy grounding ring so enemies never camouflage into floor tiles
  ctx.save();
  ctx.fillStyle = 'rgba(0, 0, 0, 0.45)';
  ctx.beginPath();
  ctx.arc(en.x, cy, en.r + 1.5, 0, Math.PI * 2);
  ctx.fill();
  ctx.restore();

  if (type === 'golem') {
    const gy = cy + Math.sin(time * 0.14 + en.phase) * 1.5;
    pixDisk(en.x, gy, en.r, '#a8a29e', '#57534e', '#292524');
    pixDisk(en.x - en.r * 0.9, gy - en.r * 0.3, en.r * 0.45, '#78716c', '#44403c', '#1c1917');
    pixDisk(en.x + en.r * 0.9, gy - en.r * 0.3, en.r * 0.45, '#78716c', '#44403c', '#1c1917');
    ctx.fillStyle = '#f59e0b';
    ctx.shadowColor = '#f59e0b';
    ctx.shadowBlur = 0; /* 60fps */
    ctx.fillRect(Math.round(en.x - 3), Math.round(gy - 3), 6, 6);
    ctx.shadowBlur = 0;
    ctx.fillStyle = '#10b981';
    ctx.fillRect(Math.round(en.x - en.r * 0.35), Math.round(gy - en.r * 0.25), 3, 2);
    ctx.fillRect(Math.round(en.x + en.r * 0.15), Math.round(gy - en.r * 0.25), 3, 2);
    ctx.restore();
    return cy;
  }

  if (type === 'specter') {
    const sy = cy + Math.sin(time * 0.24 + en.phase) * 3.5;
    ctx.save();
    ctx.globalAlpha = 0.85 + Math.sin(time * 0.3) * 0.12;
    pixDisk(en.x, sy, en.r, '#c084fc', '#6b21a8', '#3b0764');
    ctx.fillStyle = '#581c87';
    ctx.beginPath();
    ctx.moveTo(en.x - en.r * 0.7, sy + en.r * 0.3);
    ctx.lineTo(en.x - en.r * 0.3, sy + en.r * 1.2 + Math.sin(time * 0.4) * 3);
    ctx.lineTo(en.x, sy + en.r * 0.5);
    ctx.lineTo(en.x + en.r * 0.3, sy + en.r * 1.2 + Math.cos(time * 0.4) * 3);
    ctx.lineTo(en.x + en.r * 0.7, sy + en.r * 0.3);
    ctx.closePath();
    ctx.fill();
    ctx.fillStyle = '#06b6d4';
    ctx.shadowColor = '#00e5ff';
    ctx.shadowBlur = 0; /* 60fps */
    ctx.fillRect(Math.round(en.x - en.r * 0.32), Math.round(sy - en.r * 0.15), 3, 2);
    ctx.fillRect(Math.round(en.x + en.r * 0.12), Math.round(sy - en.r * 0.15), 3, 2);
    ctx.restore();
    ctx.restore();
    return cy;
  }

  if (type === 'behemoth') {
    const by = cy + Math.sin(time * 0.18 + en.phase) * 1.8;
    pixDisk(en.x, by, en.r, '#f97316', '#c2410c', '#7c2d12');
    ctx.fillStyle = '#ef4444';
    ctx.beginPath();
    ctx.moveTo(en.x - en.r * 0.6, by - en.r * 0.4);
    ctx.lineTo(en.x - en.r * 0.8, by - en.r * 1.15);
    ctx.lineTo(en.x - en.r * 0.2, by - en.r * 0.5);
    ctx.closePath();
    ctx.fill();
    ctx.beginPath();
    ctx.moveTo(en.x + en.r * 0.2, by - en.r * 0.5);
    ctx.lineTo(en.x + en.r * 0.8, by - en.r * 1.15);
    ctx.lineTo(en.x + en.r * 0.6, by - en.r * 0.4);
    ctx.closePath();
    ctx.fill();
    ctx.fillStyle = '#fde047';
    ctx.shadowColor = '#fbbf24';
    ctx.shadowBlur = 0; /* 60fps */
    ctx.fillRect(Math.round(en.x - 4), Math.round(by - 2), 8, 5);
    ctx.shadowBlur = 0;
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(Math.round(en.x - en.r * 0.35), Math.round(by - en.r * 0.25), 3, 2.5);
    ctx.fillRect(Math.round(en.x + en.r * 0.15), Math.round(by - en.r * 0.25), 3, 2.5);
    ctx.restore();
    return cy;
  }

  ctx.save();
  if (bk === 'lava') {
    ctx.beginPath();
    ctx.arc(en.x, cy, en.r + 2.5, 0, Math.PI * 2);
    ctx.fillStyle = 'rgba(5, 5, 8, 0.75)';
    ctx.fill();
    ctx.strokeStyle = 'rgba(250, 204, 21, 0.9)';
    ctx.lineWidth = 1.4;
    ctx.stroke();
  }
  switch (bk) {
    case 'stone':
      drawStonePixelEnemy(ctx, en, en.x, cy, en.r, role, time);
      break;
    case 'lava':
      drawLavaPixelEnemy(ctx, en, en.x, cy, en.r, role, time);
      break;
    case 'ice':
      drawIcePixelEnemy(ctx, en, en.x, cy, en.r, role, time);
      break;
    case 'storm':
      drawStormPixelEnemy(ctx, en, en.x, cy, en.r, role, time);
      break;
    case 'water':
      drawWaterPixelEnemy(ctx, en, en.x, cy, en.r, role, time);
      break;
    case 'forest':
      drawForestPixelEnemy(ctx, en, en.x, cy, en.r, role, time);
      break;
    case 'sand':
      drawSandPixelEnemy(ctx, en, en.x, cy, en.r, role, time);
      break;
    case 'night':
      drawNightPixelEnemy(ctx, en, en.x, cy, en.r, role, time);
      break;
    case 'pink':
      drawPinkPixelEnemy(ctx, en, en.x, cy, en.r, role, time);
      break;
    case 'ketchup':
    default:
      drawKetchupPixelEnemy(ctx, en, en.x, cy, en.r, role, time);
      break;
  }
  ctx.restore();

  // STEP 5: VISUAL DRAWING FOR SPECIAL ENEMY ROLES
  if (type === 'bearer') {
    // Kalkan Taşıyıcı: Yöne doğru kıvrılan neon enerji kalkanı
    const fa = en.facingAngle != null ? en.facingAngle : Math.atan2(player.y - en.y, player.x - en.x);
    ctx.save();
    ctx.strokeStyle = (en.shieldBlocked && en.shieldBlocked > 0) ? '#ffffff' : '#38bdf8';
    ctx.shadowColor = '#38bdf8';
    ctx.shadowBlur = 0;
    ctx.lineWidth = 4.2;
    ctx.lineCap = 'round';
    ctx.beginPath();
    ctx.arc(en.x, cy, en.r + 5, fa - 0.95, fa + 0.95);
    ctx.stroke();
    // Inner shield glow line
    ctx.strokeStyle = 'rgba(255, 255, 255, 0.75)';
    ctx.lineWidth = 1.6;
    ctx.beginPath();
    ctx.arc(en.x, cy, en.r + 3.5, fa - 0.70, fa + 0.70);
    ctx.stroke();
    ctx.restore();
  } else if (type === 'marksman') {
    // Keskin Nişancı: Siber kırmızı hedefleme gözü
    ctx.save();
    ctx.fillStyle = '#ef4444';
    ctx.shadowColor = '#ff1744';
    ctx.shadowBlur = 0; /* 60fps */
    ctx.fillRect(Math.round(en.x - 3), Math.round(cy - 4), 6, 4);
    ctx.shadowBlur = 0;
    // Nişan alma aşamasında kırmızı lazer uyarısı
    if (en.snipeAimT > 0) {
      const aimP = en.snipeAimT / 48;
      const isAboutToShoot = en.snipeAimT <= 16;
      const sang = Math.atan2(en.aimY - cy, en.aimX - en.x);
      
      // Uzayan keskin nişancı hedefleme lazer çizgisi
      const beamLen = 420;
      const endX = en.x + Math.cos(sang) * beamLen;
      const endY = cy + Math.sin(sang) * beamLen;

      ctx.save();
      ctx.strokeStyle = isAboutToShoot ? '#ffffff' : ('rgba(239, 68, 68, ' + (0.45 + Math.sin(time * 0.6) * 0.35) + ')');
      ctx.shadowColor = '#ef4444';
      ctx.shadowBlur = 0; /* 60fps */
      ctx.lineWidth = isAboutToShoot ? 2.8 : 1.6;
      ctx.setLineDash(isAboutToShoot ? [] : [7, 4]);
      ctx.beginPath();
      ctx.moveTo(en.x, cy);
      ctx.lineTo(endX, endY);
      ctx.stroke();

      // Kırmızı lazer hedef artı göstergesi
      ctx.strokeStyle = isAboutToShoot ? '#ffffff' : '#ef4444';
      ctx.lineWidth = 2.2;
      ctx.setLineDash([]);
      ctx.strokeRect(en.aimX - 8, en.aimY - 8, 16, 16);
      ctx.beginPath();
      ctx.moveTo(en.aimX - 12, en.aimY); ctx.lineTo(en.aimX + 12, en.aimY);
      ctx.moveTo(en.aimX, en.aimY - 12); ctx.lineTo(en.aimX, en.aimY + 12);
      ctx.stroke();
      ctx.restore();
    }
    ctx.restore();
  } else if (type === 'disruptor') {
    // Bozucu: Mor kozmik rün aurası
    ctx.save();
    const aPulse = Math.sin(time * 0.18 + en.phase) * 0.15;
    ctx.strokeStyle = 'rgba(168, 85, 247, ' + (0.32 + aPulse) + ')';
    ctx.lineWidth = 2.0;
    ctx.setLineDash([6, 5]);
    ctx.beginPath();
    ctx.arc(en.x, cy, 115, 0, Math.PI * 2);
    ctx.stroke();
    // Inner orbital rune motes
    for (let rk = 0; rk < 3; rk++) {
      const ma = time * 0.08 + (rk * Math.PI * 2 / 3);
      const mx = en.x + Math.cos(ma) * 38;
      const my = cy + Math.sin(ma) * 22;
      ctx.fillStyle = '#c084fc';
      ctx.shadowColor = '#c084fc';
      ctx.shadowBlur = 0; /* 60fps */
      ctx.fillRect(Math.round(mx - 2), Math.round(my - 2), 4, 4);
    }
    ctx.restore();
  }

  // STEP 6: Disruptor Fortification Hex Shield on Buffed Mobs
  if (en.hasDisruptorBuff && en.type !== 'disruptor') {
    ctx.save();
    ctx.strokeStyle = 'rgba(192, 132, 252, ' + (0.45 + Math.sin(time * 0.25) * 0.2) + ')';
    ctx.shadowColor = '#c084fc';
    ctx.shadowBlur = 0; /* 60fps */
    ctx.lineWidth = 1.8;
    ctx.setLineDash([4, 3]);
    ctx.beginPath();
    ctx.arc(en.x, cy, en.r + 4.5, 0, Math.PI * 2);
    ctx.stroke();
    ctx.restore();
  }

  ctx.restore();
  return cy;
}

// 8. Hero Player (Chibi Elementalist Champion)

