const weatherParticles = [];
for (let wp = 0; wp < 28; wp++) {
  weatherParticles.push({
    x: Math.random() * 640,
    y: Math.random() * 1024,
    vx: (Math.random() - 0.5) * 1.6,
    vy: 1.5 + Math.random() * 2.2,
