function spawnAroundPlayer(minD, maxD) {
  // Kesinlikle ekran dışı: Oyuncu kameranın (cam.x, cam.y, W, H) dışındaki alandan gelsin
  const margin = 75;
  for (let attempt = 0; attempt < 24; attempt++) {
    const side = Math.floor(Math.random() * 4); // 0: Sol, 1: Sağ, 2: Üst, 3: Alt
    let x, y;
    if (side === 0) { // Sol
      x = cam.x - (margin + Math.random() * 90);
      y = cam.y + (Math.random() - 0.1) * (H * 1.2);
    } else if (side === 1) { // Sağ
      x = cam.x + W + (margin + Math.random() * 90);
      y = cam.y + (Math.random() - 0.1) * (H * 1.2);
    } else if (side === 2) { // Üst
      x = cam.x + (Math.random() - 0.1) * (W * 1.2);
      y = cam.y - (margin + Math.random() * 90);
    } else { // Alt
      x = cam.x + (Math.random() - 0.1) * (W * 1.2);
      y = cam.y + H + (margin + Math.random() * 90);
    }
    x = clampWorldX(x, 24);
    y = clampWorldY(y, 24);
    const onScreen = (x >= cam.x - 25 && x <= cam.x + W + 25 && y >= cam.y - 25 && y <= cam.y + H + 25);
    if (!onScreen && !circleHitsObs(x, y, 18)) {
      return { x, y };
    }
  }
  const fallbackDist = Math.max(W, H) * 0.75 + 80;
  const ang = Math.random() * Math.PI * 2;
  const fx = clampWorldX(player.x + Math.cos(ang) * fallbackDist, 24);
  const fy = clampWorldY(player.y + Math.sin(ang) * fallbackDist, 24);
  return { x: fx, y: fy };
}

