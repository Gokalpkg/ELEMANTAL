    return { a:a, b:b, key:'', name: '—', desc: '', icons:'', color:'#9aa3b2', glow:'#ccc', tag:'', effects:[], effect:null, style:'flame', cd:260, kind:'nova', dmg:8, extra:{}, range:180, rangeTag:'Orta' };
